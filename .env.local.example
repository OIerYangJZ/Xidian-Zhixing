AUTH_URL=
# Keep this aligned with AUTH_URL: next-auth/react uses NEXTAUTH_URL for client-side redirects.
NEXTAUTH_URL=
AUTH_SECRET=
DATABASE_URL=postgresql://zhixing:zhixing@127.0.0.1:5432/zhixing?schema=public
LOCAL_TEST_AUTH=true
NEXT_PUBLIC_LOCAL_TEST_AUTH=true

XIDIAN_PUBLIC_ORIGIN=
XIDIAN_CAS_ISSUER=https://ids.xidian.edu.cn/authserver
# Comma-separated Xidian student numbers. The verified IDS identity is synced to ADMIN on login.
ADMIN_STUDENT_NUMBERS=

# Private hybrid retrieval service and server-owned model provider.
BACKEND_RAG_URL=http://127.0.0.1:8091
BACKEND_RAG_API_KEY=
BACKEND_AI_BASE_URL=
BACKEND_AI_API_KEY=
BACKEND_AI_MODEL=
BACKEND_AI_QUERY_TIMEOUT=20
BACKEND_AI_GENERATION_TIMEOUT=90
BACKEND_AI_CONTEXT_ITEMS=8

MEDIA_STORAGE_DIR=./data/media
