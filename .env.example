# 本地开发环境示例。复制为 .env 后再填写本机值；.env 不会提交到 Git。
BACKEND_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_PASSWORD
BACKEND_DB_FILE=backend/data/treehole.db
BACKEND_STORAGE_DIR=backend/storage/objects
BACKEND_WEB_ROOT=build/web
BACKEND_OBJECT_STORAGE_BACKEND=local
BACKEND_SEED_DEMO_DATA=true
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
BACKEND_AUTH_ALLOWED_STUDENT_IDS=
BACKEND_MAX_REQUEST_BODY_MB=20
# 本地地址未登记为 CAS service，默认禁用；仅在授权域名环境启用。
BACKEND_ENABLE_XIDIAN_AUTH=false
BACKEND_XIDIAN_PUBLIC_ORIGIN=https://zhixing.xidian.edu.cn
BACKEND_ALLOW_DEBUG_VERIFY_CODE=false
BACKEND_INCLUDE_DEBUG_CODE=false
BACKEND_AI_BASE_URL=
BACKEND_AI_API_KEY=
BACKEND_AI_MODEL=gpt-4o-mini
BACKEND_AI_EMBEDDING_MODEL=
