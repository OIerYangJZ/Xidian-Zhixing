<script language="javascript" src="../../_dwr/interface/NewsvoteDWR.js"></script><script language="javascript" src="../../_dwr/engine.js"></script><script language="javascript" src="/system/resource/js/news/newscontent.js"></script><LINK href="/system/resource/js/photoswipe/3.0.5.1/photoswipe.css" type="text/css" rel="stylesheet"><script language="javascript" src="/system/resource/js/photoswipe/3.0.5.1/pw.js"></script><script language="javascript" src="/system/resource/js/ajax.js"></script><form name="_newscontent_fromname">
<div style="min-height:300px;">
    <h1 align="center">丁香书院新生导师、计算机科学与技术学院高海昌教授在华为西安研究所开展新生导学</h1>
    <div align="center" style="line-height:60px;color:#aaa;">时间：2023-11-29&nbsp;&nbsp;阅读次数：<script>_showDynClicks("wbnews", 1370093333, 11347)</script>&nbsp;</div>
    <div id="vsb_content" style="line-height:24px;"><div class="v_news_content">
<style><!--  /* Font Definitions */  @font-face {font-family:宋体; panose-1:2 1 6 0 3 1 1 1 1 1;} @font-face {font-family:"Cambria Math"; panose-1:2 4 5 3 5 4 6 3 2 4;} @font-face {font-family:Calibri; panose-1:2 15 5 2 2 2 4 3 2 4;} @font-face {font-family:微软雅黑; panose-1:2 11 5 3 2 2 4 2 2 4;} @font-face {font-family:"\@微软雅黑"; panose-1:2 11 5 3 2 2 4 2 2 4;} @font-face {font-family:"\@宋体"; panose-1:2 1 6 0 3 1 1 1 1 1;}  /* Style Definitions */  p.MsoNormal, li.MsoNormal, div.MsoNormal {margin:0cm; margin-bottom:.0001pt; text-align:justify; text-justify:inter-ideograph; font-size:10.5pt; font-family:"Calibri","sans-serif";} a:link, span.MsoHyperlink {color:blue; text-decoration:underline;} a:visited, span.MsoHyperlinkFollowed {color:#7E1FAD; text-decoration:underline;} p {margin-right:0cm; margin-left:0cm; font-size:12.0pt; font-family:"Calibri","sans-serif";} p.MsoAcetate, li.MsoAcetate, div.MsoAcetate {mso-style-link:"批注框文本 Char"; margin:0cm; margin-bottom:.0001pt; text-align:justify; text-justify:inter-ideograph; font-size:9.0pt; font-family:"Calibri","sans-serif";} p.a, li.a, div.a {mso-style-name:""; margin:0cm; margin-bottom:.0001pt; text-align:center; border:none; padding:0cm; font-size:8.0pt; font-family:"Arial","sans-serif"; display:none;} p.a0, li.a0, div.a0 {mso-style-name:""; margin:0cm; margin-bottom:.0001pt; text-align:center; border:none; padding:0cm; font-size:8.0pt; font-family:"Arial","sans-serif"; display:none;} span.Char {mso-style-name:"批注框文本 Char"; mso-style-link:批注框文本; font-family:"Calibri","sans-serif";} .MsoChpDefault {font-size:10.0pt;} @page Section1 {size:595.3pt 841.9pt; margin:72.0pt 90.0pt 72.0pt 90.0pt; vsb_temp:15.6pt;} div.Section1 {page:Section1;} --></style>
<div class="Section1" style="vsb_temp: 15.6pt;">
 <p style="background: white; text-align: left; line-height: 2em;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 9.5pt;"><span lang="EN-US">&nbsp;</span><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;">11月10日，丁香书院新生导师、计算机科学与技术学院高海昌教授组织学生前往华为西安研究所开展第十周新生研讨课，帮助同学们明确职业规划，树立积极求职观念。</span></span></p>
 <p style="margin: 6pt 0cm; text-align: center; line-height: 2em;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;"><img width="620" height="349" id="图片 1" alt="IMG_256" src="/__local/2/B7/7A/9E06EA887C2270FF760B3510CF8_57A838FA_9EC0.jpg" border="0" vsbhref="vurl" vurl="/_vsl/2B77A9E06EA887C2270FF760B3510CF8/57A838FA/9EC0" vheight="349" vwidth="620" orisrc="/__local/2/B7/7A/9E06EA887C2270FF760B3510CF8_57A838FA_9EC0.jpg" class="img_vsb_content"></span></p>
 <p style="margin: 6pt 0cm; line-height: 2em; text-indent: 21pt;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;">在办理完入园手续后，同学们在门口望着研究所内的楼宇景物，随后在师姐的带领下开始了游览。花草树木伴着写字楼引入眼帘，植物布局多样且具有艺术气息。同学们接着参观了宽敞明亮的地下餐厅，感受着华为员工生活的便捷与人性化。同学们纷纷拿出手机拍照留念，记录下园区内的美景。</span></p>
 <p style="margin: 6pt 0cm; line-height: 2em; text-indent: 21pt;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;">为了帮助同学们提前了解企业文化，感受企业氛围，华为研究所组织了宣讲。在讲解员的讲解下，同学们了解到了华为发展历程、企业布局、标志性成就以及部分正在开展的研发项目。同学们不仅感受到了科技魅力，更感受到华为的核心竞争力及对核心技术的追求与投入。</span></p>
 <p style="margin: 6pt 0cm; line-height: 2em; text-indent: 21pt;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;">在宣讲过后，同学们自由探索起了手表、手机、智能家居等先进的电子设备。在一碰即连的音响上感受了细腻通透的人声，在Mate60上感受高速下载，在这一系列亲身体验后，同学们无不折服于华为“遥遥领先”的魅力。</span></p>
 <p style="margin: 6pt 0cm; text-align: center; line-height: 2em;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;"><img width="620" height="288" id="图片 2" alt="IMG_257" src="/__local/E/61/83/4F136054BFED719F6EEF64C2235_E92AA1D3_B289.jpg" border="0" vsbhref="vurl" vurl="/_vsl/E61834F136054BFED719F6EEF64C2235/E92AA1D3/B289" vheight="288" vwidth="620" orisrc="/__local/E/61/83/4F136054BFED719F6EEF64C2235_E92AA1D3_B289.jpg" class="img_vsb_content"></span></p>
 <p style="margin: 6pt 0cm; line-height: 2em; text-indent: 21pt;"><span style="background: white; color: rgb(34, 34, 34); font-family: 宋体; font-size: 16px;">通过这次游览，同学们不仅对研究所有了更深入的了解，也增强了对科学研究的热爱和追求。同学们纷纷表示将以此次新生研讨课为契机，不断努力学习，提高自己的科研能力，为国家的科技进步贡献力量。</span></p>
</div>
</div></div><div id="div_vote_id"></div>
