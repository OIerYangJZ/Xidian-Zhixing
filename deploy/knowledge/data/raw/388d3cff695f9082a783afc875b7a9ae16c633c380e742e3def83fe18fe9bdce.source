        if(keyCode == 13){
          onSubmitu2();
        }
      };

      function onSubmitu2(e) {
        queryInfou2.query.keyWord= $("#appu2  .qwss").val();
        
        var url = "/aop_views/search/modules/resultpc/soso.html";      
