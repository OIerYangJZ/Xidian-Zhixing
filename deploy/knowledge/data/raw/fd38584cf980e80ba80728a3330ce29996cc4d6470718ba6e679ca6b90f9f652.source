     <td width="113" valign="top" style="border-width: medium 1pt 1pt medium; border-style: none solid solid none; border-color: rgb(0, 0, 0); padding: 0cm 5.4pt; width: 3cm; height: 15.4pt;"><p class="MsoNormal" style="line-height: 18pt;"><strong><span lang="EN-US" style="color: black; font-family: 仿宋; font-size: 16pt;">09:00-12:00</span></strong></p></td>
