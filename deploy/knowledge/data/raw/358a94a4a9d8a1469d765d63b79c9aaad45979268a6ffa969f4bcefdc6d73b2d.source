                returnDefault: true //鼠标从.sideMen移走后返回默认状态（默认false）
            });
        </script><script type="text/javascript">
            jQuery(".kyxx").slide();
            jQuery(".bkjx").slide();
            jQuery(".rsdt").slide();
            jQuery(".bkzs").slide();
            jQuery(".zhbgs").slide();
            jQuery(".dwzzb").slide();
            jQuery(".rlzy").slide();
            jQuery(".zybzb").slide();
        </script><script>
            AOS.init({
                easing: 'ease-out-back',
                duration: 1000
            });
        </script>

</BODY></HTML>
