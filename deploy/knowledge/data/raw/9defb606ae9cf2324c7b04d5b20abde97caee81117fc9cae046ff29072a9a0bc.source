                                        document.getElementById("lj3").style.color="#8797a6";
                                    
                                        
                                        
                                        document.getElementById("main2").style.display="block";
                                        document.getElementById("main1").style.display="none";
                                        document.getElementById("main3").style.display="none";
                                        
                                    }
                                    document.getElementById("lj3").onmouseover=function(){
                                        document.getElementById("lj3").style.color="#fff";
                                        document.getElementById("lj3").style.background="#276fb2";
                                        document.getElementById("lj1").style.background="none";
                                        document.getElementById("lj2").style.background="none";
                                        document.getElementById("lj2").style.color="#8797a6";
                                        document.getElementById("lj1").style.color="#8797a6";
                                    
                                        
                                        document.getElementById("main3").style.display="block";
                                        document.getElementById("main2").style.display="none";
                                        document.getElementById("main1").style.display="none";
                                        
                                    }
                                    document.getElementById("lj1").onmouseout=function(){
                                        document.getElementById("lj1").style.color="#fff";
                                        
                                    }
                                    document.getElementById("lj2").onmouseout=function(){
                                        document.getElementById("lj2").style.color="#fff";
                                        
                                        
                                    }
                                    document.getElementById("lj3").onmouseout=function(){
                                        document.getElementById("lj3").style.color="#fff";
                                        
                                    }
                                    
                                    
                                }
</script>
<script>
    $(window).scroll(function(){
        var scrollTop = $(window).scrollTop();
        if(scrollTop > 1000){
            $('.header_xx').addClass("fix");
        }
        else{
            $('.header_xx').removeClass("fix");
        }
    });
</script>
</BODY></HTML>
