    text-indent: 8px;
    font-size: 12px;
    color: #999999;
    padding-right: 16.5%;}
    #appu9 .tj{
    
    width: 13.5%;
    height: 29px;
    background:url(../../2020images/search_btn.png) no-repeat 8px center #d2d2d2;
