 Times New Roman;  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_ad p {  text-align: left;  text-indent: 10.00pt;}span.docx_ad {  min-height: 9.00pt;  font-size: 9.00pt;  font-family: Times New Roman;}span.docx_ae {  color: #0563C1;  text-decoration: underline;}span.docx_11 {  color: #605E5C;  background-color: #E1DFDD;}table.docx_af td {  border-top: 0.50pt solid black;  border-left: 0.50pt solid black;  border-bottom: 0.50pt solid black;  border-right: 0.50pt solid black;  padding-top: 0.00pt;  padding-left: 5.40pt;  padding-bottom: 0.00pt;  padding-right: 5.40pt;}p.docx_af0 {  text-indent: 31.60pt;  text-align: justify;}p.docx_af0 span {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}p.docx_af0 span {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af1 {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af1 p {  text-indent: 31.60pt;  text-align: justify;}span.docx_af1 {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af2 {  min-height: 10.50pt;  font-size: 10.50pt;}p.docx_af3 {  text-align: left;  text-indent: 10.00pt;}p.docx_af3 span {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}p.docx_af3 span {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af4 {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af4 p {  text-align: left;  text-indent: 10.00pt;}span.docx_af4 {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}p.docx_af5 span {  font-weight: bold;  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}p.docx_af5 {  text-align: left;  text-indent: 10.00pt;}p.docx_af5 span {  font-family: Times New Roman;  font-weight: bold;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af6 {  font-family: Times New Roman;  font-weight: bold;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af6 {  font-weight: bold;  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}span.docx_af6 p {  text-align: left;  text-indent: 10.00pt;}p.docx_af7 span {  font-family: Times New Roman;  min-height: 16.00pt;  font-size: 16.00pt;}</style><section class="docx"><header><p class="docx_a6" style="text-indent: 18pt;"><br></p></header><p style="text-indent: 0pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">各位同学<span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px; text-align: justify; text-indent: 36px; white-space: pre-wrap;">、</span>各有关单位：</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">为紧抓新一轮科技革命和产业变革机遇，加速培育新质生产力，探索拔尖创新人才培养新模式，发挥教育教学改革引领示范作用，更好地开放优质资源让更多学生受益，现面向2026级新生遴选部分优秀学生进入实验班学习，相关事宜通知如下：</span></p><section class="docx"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;"><section class="docx"><strong>一、实验班类型和计划选拔名额</strong></section></span></section><p style="text-indent: 2em; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">本次21个实验班合计选拔395人，各实验班专业主管学院（部）及选拔人数如下，各实验班介绍请在“六、各实验班简介”中具体查看。</span></p><p style="text-align: center"><img src="/__local/D/8D/84/B1ED5410AED89A10351DAC73E5F_5D7351DE_86200.jpg" width="719" vurl="/_vsl/D8D84B1ED5410AED89A10351DAC73E5F/5D7351DE/86200" vsbhref="vurl" vheight=" 921px" vwidth=" 719px" height="921" orisrc="/__local/F/D8/F7/0772BC238349FCC6CDC486EEB98_C48A78A9_A30F6.jpg" class="img_vsb_content" style="width: 719px; height: 921px;"></p><p style="text-indent: 0pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; min-height: 12pt;">注：1.“本研贯通”一栏标注“</span><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; min-height: 11pt;">——</span><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; min-height: 12pt;">”的实验班不限制校内外推免。</span></span></p><p style="text-indent: 2em; font-size: 14px;"><span style="min-height: 12pt; text-align: justify; text-indent: 31.4667px; white-space: pre-wrap; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">2.“本研贯通”实验班实施本硕/本博一体化贯通培养模式，本科与硕士（或博士）阶段均在本校就读完成，推免需达到培养要求。</span></p><p style="text-indent: 2em; font-size: 14px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; text-indent: 23.6pt; font-size: 14px;">3.凡进入实验班的学生，本科期间不能参与转专业及其他实验班选拔。</span></p><section class="docx"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;"><strong>二、报名资格</strong></span></section><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">符合条件的学生可自愿报名参加选拔，报名不限专业大类。</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">1.报名资格范围：（1）除新疆、西藏外其他省、自治区、直辖市选考“物理+化学”科目的新生；</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（2）新疆、西藏理科新生；</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（3）预科转入的理科新生；</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（4）港澳台理科新生。</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">2.本次选拔不包括以下学生：</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（1）中外合作办学学生；</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（2）保送生、运动训练专业及艺术类学生；</span></p><p style="text-indent: 31.6pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（3）已经通过高考录取到下列表格中12个实验班的学生。</span></p><table class="first-row first-col no-vband" style="width: 441.7pt; margin-left: auto; margin-right: auto;"><colgroup><col style="width: 35.2pt;"><col style="width: 120.5pt;"><col style="width: 170.1pt;"><col style="width: 115.9pt;"></colgroup><tbody><tr class="firstRow" style="height: 26.75pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="font-weight: bold; min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">序号</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="font-weight: bold; min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">实验班名称</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="font-weight: bold; min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">高考招生专业(类)名称</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="font-weight: bold; min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">学院</span></p></td></tr><tr style="height: 23.4pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">1</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 24pt; line-height: 24pt; text-indent: 0pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">铁军电子工程卓越班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">电子信息工程（铁军院士班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">电子工程学院</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">2</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 24pt; line-height: 24pt; text-indent: 0pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">筑梦计算机拔尖班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">计算机科学与技术（筑梦院士班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">计算机科学与技术学院</span></p></td></tr><tr style="height: 42.15pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">3</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">逐日智能制造创新班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 20pt; line-height: 20pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">机械设计制造及其自动化</span></p><p style="min-height: 20pt; line-height: 20pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">（逐日智能制造院士班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">机电工程学院</span></p></td></tr><tr style="height: 23.4pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">4</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 24pt; line-height: 24pt; text-indent: 0pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">中林班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">应用物理学（中林院士班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">物理学院</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">5</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 24pt; line-height: 24pt; text-indent: 0pt;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">正跃微电子科学创新班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">微电子科学与工程（正跃院士班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">集成电路学部</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">6</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">通信工程卓越班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">通信工程（卓越班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">通信工程学院</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">7</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">计算机卓越班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">计算机科学与技术（卓越班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">计算机科学与技术学院</span></p></td></tr><tr style="height: 23.4pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">8</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">通信工程创新班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">通信工程（创新班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">通信工程学院</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">9</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">毕德显电子信息创新班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">电子信息工程（创新班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">电子工程学院</span></p></td></tr><tr style="height: 27.15pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">10</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">集成电路创新班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">集成电路设计与集成系统（实验班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">集成电路学部</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">11</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">网络空间安全实验班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">网络空间安全（实验班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">网络安全与密码学部</span></p></td></tr><tr style="height: 22.3pt; text-align: center;"><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">12</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">图灵人工智能实验班</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">人工智能（图灵实验班）</span></p></td><td style="vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p style="min-height: 24pt; line-height: 24pt; text-indent: 0pt; text-align: center;"><span style="min-height: 10.5pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 14px;">人工智能学院</span></p></td></tr></tbody></table><p class="docx_1" style="text-indent: 0pt;"><br></p><section class="docx"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;"><section class="docx"><section class="docx"><strong>三、选拔时间及程序</strong></section></section></span></section><p class="docx_2" style="text-indent: 31.7pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">1.报名申请&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;<span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; background-color: yellow;">8月30日—9月5日</span></span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">报名实验班的同学登录一站式网上办事大厅（https://ehall.xidian.edu.cn）转专业模块进行报名，报名时注意选择实验班对应的专业和专业方向进行报名。系统操作指南见“附件1 实验班选拔系统操作指南”。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">特别注意：（1）在选拔的21个实验班中，<span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; background-color: yellow;">每人只能填报1个志愿，</span>如报名后需要更改，请在报名截止前，登录系统撤销原志愿后，方可再次报名。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">（2）为避免资源浪费，15人及以下实验班不得成班，当年停办，并将通知学生改报其他实验班，请务必保证系统中填写正确的手机号码，并保持电话畅通。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">报名截止后，开展报名资格审核和学生笔试成绩上传。</span></p><p class="docx_2" style="text-indent: 31.7pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">2.心理健康测评 &nbsp;&nbsp; &nbsp; &nbsp; &nbsp; <span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; background-color: yellow;">8月30日—9月5日</span></span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">通过心理健康教育大数据平台网站（https://xlzx.xidian.edu.cn）或手机扫描下方二维码进入平台完成心理健康测评，操作指南见“附件2 心理健康测评平台操作指南”。<span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; background-color: yellow; text-decoration: underline;">未按时参加心理健康测评的学生，不予安排面试等后续考核环节。</span></span></p><p style="text-indent: 31.6pt; text-align: center;"><span style="position: relative; text-indent: 0px; width: 152.06pt; height: 152.06pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;"><img src="/__local/5/6F/B5/DE952E1C4CB8B36931C38FC2AB3_CC8B5E14_12A7.png" vsbhref="vurl" vurl="/_vsl/56FB5DE952E1C4CB8B36931C38FC2AB3/CC8B5E14/12A7" vheight=" 152.9pt" vwidth=" 152.9pt" orisrc="/__local/5/6F/B5/DE952E1C4CB8B36931C38FC2AB3_CC8B5E14_12A7.png" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 152.9pt; height: 152.9pt;"></span></p><p class="docx_2" style="text-indent: 31.7pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">3.发布面试通知 &nbsp;&nbsp; &nbsp; &nbsp; &nbsp; 9月7日</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">9月7日，各学院（部）根据新生能力测试成绩进行筛选和面试分组，在各学院（部）网站公布面试分组、时间、地点等信息，请报名同学及时查看实验班主管学院（部）的网站通知。各学院（部）网站可在学校主页点击“机构设置-教学科研机构”查询（https://www.xidian.edu.cn/jgsz.htm#jxkyjg）。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="background-color: yellow; text-decoration: underline; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">面试为双盲随机面试，面试中不得介绍姓名、学号等个人信息，面试身份码为唯一身份标识，面试自我介绍时说明身份码即可。面试身份码查询方式将在各学院（部）网站面试通知中公布。</span></p><p class="docx_2" style="text-indent: 31.7pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">4.面试考核 &nbsp;&nbsp; &nbsp; &nbsp; &nbsp; 9月8日全天<span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px; text-align: justify; text-indent: 36px; white-space: pre-wrap;">、</span>9月9日下午</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">9月8日全天及9月9日下午，各学院（部）组织面试等相关考核环节。</span></p><p class="docx_2" style="text-indent: 31.7pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">5.录取公示 &nbsp;&nbsp; &nbsp; &nbsp; &nbsp; 9月10日—9月12日</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">各学院（部）确定预录取学生名单，报本科生院备案；学校对拟录取名单进行公示，公示期三天。<span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; background-color: yellow; text-decoration: underline;">学生自9月14日起按各实验班课程安排上课，请及时查看更新后的课表。</span></span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">学校在公示期内接受考生申诉，对申诉问题经调查属实的，责成有关人员或专家复议；若考生对复议结果仍有异议，由本科生院组织有关专家复议。</span></p><p class="docx_2" style="text-indent: 31.7pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">6.公布结果</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">经公示无异议后，发文公布各实验班录取结果，办理相关手续。</span></p><p class="docx_1" style="text-indent: 0pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">四、录取规则</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">1.根据笔试和面试总成绩排定名次<span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; background-color: yellow; text-decoration: underline;">（其中基础学科拔尖学生培养实验班排名时总成绩=笔试成绩×50%+面试成绩×50%；其他实验班排名时总成绩=笔试成绩×70%+面试成绩×30%）</span><span style="font-size: 18px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; text-decoration: underline;">，</span>按照分数从高到低的顺序确定预录取名单。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">2.笔试成绩为新生能力测试综合成绩=数学×50%+英语×25%+物理×25%，成绩查询方式见附件1。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">3.面试主要考察学生的综合素质，包括知识面、逻辑思维能力、表达能力、心理承受能力、团队精神及实践动手能力等。竞赛获奖需提供获奖证书的原件或加盖公章的复印件，竞赛获奖情况在面试时由评委予以综合考虑，并纳入面试成绩。</span></p><p class="docx_1" style="text-indent: 0pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">五、其他</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">1.各实验班录取学生学费自2026—2027学年起按照录取实验班所在专业的收费标准收取，多退少补。</span></p><p style="text-indent: 31.6pt; font-size: 18px;"><span style="font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 18px;">2.各实验班相关事项咨询方式：</span></p><table class="first-row first-col no-vband" style="width: 628px; background-color: rgb(255, 255, 255); margin-left: auto; margin-right: auto; table-layout: fixed;"><colgroup><col data-offset-left="217" data-offset-right="273.625" data-resize-pixel="56.625" data-resize-percent="9.01671974522293" style="width: 9.0167%;"><col data-offset-left="273.625" data-offset-right="480.96875" data-resize-pixel="207.34375" data-resize-percent="33.016520700636946" style="width: 33.0165%;"><col data-offset-left="461.96875" data-offset-right="572.84375" data-resize-pixel="110.875" data-resize-percent="17.655254777070066" style="width: 17.6553%;"><col data-offset-left="572.84375" data-offset-right="825" data-resize-pixel="252.15625" data-resize-percent="40.15226910828025" style="width: 40.1523%;"></colgroup><tbody><tr class="firstRow" style="height: 19.85pt; text-align: center;"><td style="background-color: rgb(255, 255, 255); padding: 0pt 5.4pt; vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 22pt; line-height: 22pt; text-indent: 0pt;"><span style="font-weight: bold; min-height: 12pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 16px;">序号</span></p></td><td style="background-color: rgb(255, 255, 255); padding: 0pt 5.4pt; vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 22pt; line-height: 22pt; text-indent: 0pt;"><span style="font-weight: bold; min-height: 12pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 16px;">学院（部）</span></p></td><td style="background-color: rgb(255, 255, 255); padding: 0pt 5.4pt; vertical-align: middle; border-width: 0.5pt; border-style: solid; border-color: black;"><p class="docx_a8" style="min-height: 22pt; line-height: 22pt; text-indent: 0pt;"><span style="font-weight: bold; min-height: 12pt; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;; font-size: 16px;">联系人</span></p></td><td style="background-color: rgb(255, 255, 255); padding: 0pt 5.4pt; vertical-align: middle; border-width: 0.5pt; border-style: solid; border-col