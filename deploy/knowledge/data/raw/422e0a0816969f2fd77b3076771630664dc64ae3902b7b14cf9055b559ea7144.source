        <!-- 头部固定开始 -->
        <script type="text/javascript">
            var doc = $(document),
                win = $(window);
            win.scroll(function() {
                if (doc.scrollTop() >= 200) {
                    $('.head3').addClass('head4');
                    $('.back').fadeIn();
                } else {
                    $('.head3').removeClass('head4');
                    $('.back').fadeOut();
                }
            })
            $('.back').click(function() {
                $('html, body').animate({
                    scrollTop: 0
                }, 1000);
            })
        </script>
        <!-- 头部固定结束 -->
        <script type="text/javascript">
