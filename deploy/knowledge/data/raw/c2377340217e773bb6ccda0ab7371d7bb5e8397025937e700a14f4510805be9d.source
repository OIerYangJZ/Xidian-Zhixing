        var query = queryInfou3.query;
        if (url.indexOf("?") > -1) {
            url = url.split("?")[0];
        }
        if (query.keyWord) {
            var query = new Base64().encode(JSON.stringify(query));
            window.open(url + "?query=" + query);
        } else {
            alert("请填写搜索内容")
        }
      };
   }
