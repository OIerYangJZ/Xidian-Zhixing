display: none; border-left: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-left: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span lang="en-US" style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">蛙泳（200米）</span></p></td><td style="display: none; border-width: 0.5pt 1pt 0.5pt 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-width: 0.5pt 0.5pt 0.5pt 1pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><br></p></td></tr><tr style="height: 18pt;"><td style="display: none; border-left: 1pt solid black; border-bottom: none; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-left: 1pt solid black; border-bottom: none; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span lang="en-US" style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">蝶泳（100米）</span></p></td><td style="display: none; border-width: 0.5pt 1pt 0.5pt 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-width: 0.5pt 0.5pt 0.5pt 1pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><br></p></td></tr><tr style="height: 18pt;"><td style="border-width: 1pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">5</span></p></td><td style="border-top: 1pt solid black; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">乒乓球</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">　</span></p></td><td style="border-top: 0.5pt solid black; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">男</span></p></td><td style="border-top: 0.5pt solid black; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">3</span></p></td><td style="display: none; border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><br></p></td></tr><tr style="height: 18pt;"><td style="border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">6</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">乒乓球</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">　</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">女</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">2</span></p></td><td style="display: none; border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent: 0pt;"><br></p></td></tr><tr style="height: 18pt;"><td style="border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">7</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">网球</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">　</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">男</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">3</span></p></td><td rowspan="6" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">国家二级运动员(含)以上</span></p></td></tr><tr style="height: 18pt;"><td style="border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">8</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">网球</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">　</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">女</span></p></td><td style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(51, 51, 51); min-height: 12pt; font-size: 12pt;">2</span></p></td><td style="display: none; border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle; padding: 0pt 5.4pt;"><p style="text-align: left; text-indent