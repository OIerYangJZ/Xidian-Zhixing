            </div>
            
            
            <!-- footer -->
               <div class="w10 footer">
                <div class="w14">
                    <div class="footer-top clear">
                        <div class="footer-l fl"><script language="javascript" src="/system/resource/js/news/mp4video.js"></script>
<p>South Campus: 266 Xinglong Section of Xifeng Road, Xi’an, Shaanxi 710126</p> 
<p>North Campus: No. 2 South Taibai Road, Xi’an, Shaanxi 710071</p></div>
