pt;}p.docx-num-2-4 {  counter-reset: docx-num-2-5 0;}p.docx-num-2-5:before {  content: "\9";  counter-increment: docx-num-2-5;  font-family: Wingdings;}p.docx-num-2-5 {  display: list-item;  list-style-position: inside;  list-style-type: none;  text-indent: -22.00pt;  margin-left: 163.60pt;}p.docx-num-2-5 {  counter-reset: docx-num-2-6 0;}p.docx-num-2-6:before {  content: "\9";  counter-increment: docx-num-2-6;  font-family: Wingdings;}p.docx-num-2-6 {  display: list-item;  list-style-position: inside;  list-style-type: none;  text-indent: -22.00pt;  margin-left: 185.60pt;}p.docx-num-2-6 {  counter-reset: docx-num-2-7 0;}p.docx-num-2-7:before {  content: "\9";  counter-increment: docx-num-2-7;  font-family: Wingdings;}p.docx-num-2-7 {  display: list-item;  list-style-position: inside;  list-style-type: none;  text-indent: -22.00pt;  margin-left: 207.60pt;}p.docx-num-2-7 {  counter-reset: docx-num-2-8 0;}p.docx-num-2-8:before {  content: "\9";  counter-increment: docx-num-2-8;  font-family: Wingdings;}p.docx-num-2-8 {  display: list-item;  list-style-position: inside;  list-style-type: none;  text-indent: -22.00pt;  margin-left: 229.60pt;}:root {  counter-reset: docx-num-1-0 0 docx-num-1-1 0 docx-num-1-2 0 docx-num-1-3 0 docx-num-1-4 0 docx-num-1-5 0 docx-num-1-6 0 docx-num-1-7 0 docx-num-1-8 0 docx-num-2-0 0 docx-num-2-1 0 docx-num-2-2 0 docx-num-2-3 0 docx-num-2-4 0 docx-num-2-5 0 docx-num-2-6 0 docx-num-2-7 0 docx-num-2-8 0;}</style><section class="docx"><header><p class="docx_a6" style="text-indent: 18pt;"><br></p></header><article><p class="docx_a3" style="text-indent: 0pt;"><br></p><p style="text-indent: 31.6pt;">本科教学成果奖，是学校人才培养成效与教育教学改革成果的集中检阅，更是西电深耕本科教育的生动注脚。2025年，学校共评选出42项校级本科教育教学成果奖，并首次为获奖成果颁发区块链证书——7×24小时随查随验，让每一份荣誉都自带“防篡改、可追溯”的硬核保障。</p><p style="text-indent: 31.6pt;">近年来，学校深入推进《本科人才培养质量提升行动计划》（人才培养20条），不断创新人才培养模式，推进专业优化升级，推动课程内涵建设，深化实践教学改革。从拔尖人才培养模式创新到教研共同体建设，从“理论+实验”课程教学体系改革到数智一体化育人，全方位发力、多维度突破，最终收获42项沉甸甸的本科教育教学成果（详细获奖名单见文末）。</p><p style="text-indent: 31.6pt;">依托西电教链平台，学校首次为获奖成果颁发了区块链证书，实现“发放－接收－管理－查验”全链条数字化、无纸化。这份区块链证书有多实用？答案藏在全链条数字化服务里：</p><p class="docx_ae docx-num-2-0" style="text-indent: 35.45pt; margin-left: 0pt;">校内获奖教师登录西电教链平台（icert.xidian.edu.cn），就能自助查询、下载、打印电子证书，全程无纸化更便捷；</p><p class="docx_a5" style="text-indent: 0pt;">&nbsp;<span lang="null" style="background-color: rgb(255, 255, 255);"><span style=" position: relative; text-indent: 0px; width: 167.6pt; height: 237.1pt;"><img src="/__local/6/0F/13/F39064D6E73BDF3BBD3FC3BBACA_E8331BF4_34F06.png" vsbhref="vurl" vurl="/_vsl/60F13F39064D6E73BDF3BBD3FC3BBACA/E8331BF4/34F06" vheight=" 237.1pt" vwidth=" 167.6pt" orisrc="/__local/6/0F/13/F39064D6E73BDF3BBD3FC3BBACA_E8331BF4_34F06.png" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 167.6pt; height: 237.1pt;"></span></span><span lang="null" style="background-color: rgb(255, 255, 255);"><span style=" position: relative; text-indent: 0px; width: 169.75pt; height: 235.7pt;"><img src="/__local/1/71/EE/AAEECD3898F0A8FF903B1AFA6D3_8DF7CC06_D50D.png" vsbhref="vurl" vurl="/_vsl/171EEAAEECD3898F0A8FF903B1AFA6D3/8DF7CC06/D50D" vheight=" 235.7pt" vwidth=" 169.75pt" orisrc="/__local/4/4D/DC/31A93116139401A1208E77A6309_6687D820_2A80E.png" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 169.75pt; height: 235.7pt;"></span></span></p><p class="docx_ae docx-num-2-0" style="text-indent: 35.45pt; margin-left: 0pt;">每份证书都配有唯一Hash值，扫描证书二维码就能一键验证真伪，链上存证数据实时比对，从根源杜绝证书造假、数据篡改问题。</p><p style="text-indent: 31.6pt;">下一步，本科生院将牢记为党育人、为国育才的初心使命，持续深化教育教学改革，以数智化赋能教学管理升级，用心做好师生服务保障，让办事智能“无梗阻”，让服务精准“有温度”。</p><p style="text-indent: 31.6pt;"><br></p><p class="docx_a5" style="text-indent: 0pt;">2025年校级本科教育教学成果奖获奖名单</p><table class="first-row first-col no-vband" style="width: 785px; margin-left: auto; margin-right: auto; table-layout: fixed;"><colgroup><col data-offset-left="116.5999984741211" data-offset-right="172.58749771118164" data-resize-pixel="55.98749923706055" data-resize-percent="7.132165507905802" style="width: 7.1322%;"><col data-offset-left="172.58750915527344" data-offset-right="569.7125091552734" data-resize-pixel="397.125" data-resize-percent="50.589171974522294" style="width: 50.5892%;"><col data-offset-left="558.7125244140625" data-offset-right="769.7125244140625" data-resize-pixel="211" data-resize-percent="26.878980891719745" style="width: 26.879%;"><col data-offset-left="769.7125244140625" data-offset-right="889.8000259399414" data-resize-pixel="120.0875015258789" data-resize-percent="15.297770895016422" style="width: 15.2978%;"></colgroup><tbody><tr class="firstRow" style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="font-family: 黑体; min-height: 10.5pt; font-size: 10.5pt;">序号</span></p></td><td width="150" style="border-top: 0.5pt solid black; border-left: none; border-bottom: 0.5pt solid black; border-right: 0.5pt solid black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="font-family: 黑体; min-height: 10.5pt; font-size: 10.5pt;">成果名称</span></p></td><td width="150" style="border-top: 0.5pt solid black; border-left: none; border-bottom: 0.5pt solid black; border-right: 0.5pt solid black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="font-family: 黑体; min-height: 10.5pt; font-size: 10.5pt;">成果完成单位</span></p></td><td width="150" style="border-top: 0.5pt solid black; border-left: none; border-bottom: 0.5pt solid black; border-right: 0.5pt solid black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="font-family: 黑体; min-height: 10.5pt; font-size: 10.5pt;">成果等级</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">1</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">四元协同、数字赋能、科教</span><span style="min-height: 10.5pt; font-size: 10.5pt;">融汇</span><span style="min-height: 10.5pt; font-size: 10.5pt;">、产教融合，高校新型教研共同体构建与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">通信工程学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">2</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">红色基因引领，系统能力筑基，电子信息系统级领军型人才培养体系创新与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">电子工程学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">3</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">实训筑基</span><span style="min-height: 10.5pt; font-size: 10.5pt;">，科教</span><span style="min-height: 10.5pt; font-size: 10.5pt;">融汇</span><span style="min-height: 10.5pt; font-size: 10.5pt;">，计算机拔尖人才培养新模式探索与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">计算机科学与技术学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">4</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">基于“产教科教融合</span><span style="min-height: 10.5pt; font-size: 10.5pt;">-</span><span style="min-height: 10.5pt; font-size: 10.5pt;">多种专业贯通</span><span style="min-height: 10.5pt; font-size: 10.5pt;">-</span><span style="min-height: 10.5pt; font-size: 10.5pt;">师生协同发展”的实践能力培养模式创新与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">机电工程学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">5</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">提师能</span><span style="min-height: 10.5pt; font-size: 10.5pt;">、</span><span style="min-height: 10.5pt; font-size: 10.5pt;">建金课</span><span style="min-height: 10.5pt; font-size: 10.5pt;">、抓竞赛——新工科大学数学教学改革与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">数学与统计学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">6</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">“跨界融创，多元启导，智鉴云评，前沿产出”的电子信息特色生物医学工程</span><span style="min-height: 10.5pt; font-size: 10.5pt;">专业数智一体</span><span style="min-height: 10.5pt; font-size: 10.5pt;">化育人及实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">生命科学技术学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">7</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">航天精神“多重嵌入”构建“大思政课”铸魂育人体系的探索与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">空间科学与技术学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">8</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">服务国家战略，</span><span style="min-height: 10.5pt; font-size: 10.5pt;">三域交叉</span><span style="min-height: 10.5pt; font-size: 10.5pt;">融合，新时代卓越型电子材料人才培养模式创新与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">先进材料与纳米科技学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">特等奖</span></p></td></tr><tr style="height: 1pt; text-align: center;"><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">9</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">德能识创融合</span><span style="min-height: 10.5pt; font-size: 10.5pt;"> </span><span style="min-height: 10.5pt; font-size: 10.5pt;">攻防</span><span style="min-height: 10.5pt; font-size: 10.5pt;">训战并进</span><span style="min-height: 10.5pt; font-size: 10.5pt;">：“</span><span style="min-height: 10.5pt; font-size: 10.5pt;">1+1+2</span><span style="min-height: 10.5pt; font-size: 10.5pt;">”贯通渐进式网络安全人才培养模式构建与实践</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style="text-indent: 0pt;"><span style="min-height: 10.5pt; font-size: 10.5pt;">网络与信息安全学院</span></p></td><td width="150" style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p class="docx_a5" style