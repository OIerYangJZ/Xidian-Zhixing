<!-- 锁屏开始 -->
<div class="dj" id="lock_screen_dj"></div>
<div class="warm-prompt" id='input_div_' style="display: none">
		<div class="warm-prompt-close">
		</div>
		<div class="warm-prompt-form">
			<div class="warm-prompt-form-1">
				<p>
					支付完成前，不要关闭此支付验证窗口。
				</p>
			</div>
			<div class="warm-prompt-form-1">
				<p>
					支付完成后，根据支付情况点击下面的按钮。
				</p>
				<p>&nbsp;</p>
			</div>
			<div >
				<div class="button-1" style="margin-left: 80px">
					<input type="button" value="遇到问题" name="Button-1" id="lock_problem">
				</div>
				<div class="button-1" style="margin-left: 230px">
					<input type="button" value="支付成功" name="Button-1" id="lock_success">
				</div>
				
			</div>
		</div>
	</div>			
<div class="sp_box"></div>
<script type="text/javascript">
		var rootel=document.documentElement; //XHTMl
		// var rootel=document.body //HTML
		var bto=document.getElementById('footbt');
		function bt(){
			var screenHeight = (rootel.clientHeight-bto.offsetHeight)+rootel.scrollTop;
			if(screenHeight<722){
				bto.style.top = "722px";
			}else{
				bto.style.top=screenHeight+'px';
			}
		}
		setInterval("bt()",1);
		$(function(){
			//遇到问题
			$("#lock_problem").click(function() {//遇到问题
				//var checkArr = $("input[name='payType']:checked").val();
				var checkArr=$("#payType").val();
				var orderno = $("#orderno").val();
				$(".warm-prompt").hide();//弹出提示层消失
				$(".sp_box").hide();//锁屏层消失
				window.location.href="/payFinish16"+orderno+"=77"+checkArr;
				
			});
			//支付成功
			$("#lock_success").click(function() {//交易完成
				//var checkArr = $("input[name='payType']:checked").val();
				var checkArr=$("#payType").val();
				var orderno = $("#orderno").val();
				$(".warm-prompt").css("display","none");//弹出提示层消失
				$(".sp_box").hide();//锁屏层消失
				window.location.href="/payFinish16"+orderno+"=77"+checkArr;
			});	
		})
</script>
	<!-- <a class="btn-32-green grid-r" href="#" onclick="javascript:history.go(-1);" style="float: right;">返回</a> -->
	<script>
			//根据账号显示账号基本信息
			function onchange_accinfo(obj){
				if(obj!=-1){
					var strs= new Array(); //定义一数组
					strs=obj.split("	"); //字符分割
					document.getElementById("netNo").value=strs[0];  //账号
					if(strs[1]=="0"){ //0 停机  1 正常 
						document.getElementById("zhzt").innerHTML="停机 ";  //可用状态
						document.getElementById("netStatus").value="0";
					}else{
						document.getElementById("zhzt").innerHTML="正常";  //可用状态
						document.getElementById("netStatus").value="1";
					}
					document.getElementById("czje").innerHTML=strs[2]+" 元";  //储值余额
				}else{
					document.getElementById("netNo").value="";
					document.getElementById("netStatus").value="";
					document.getElementById("zhzt").innerHTML="";
					document.getElementById("czje").innerHTML="";
				}
			}
			
			
				//支付
				function pay(){
					var netNo = $("#netNo").val();
					var payAmt = $("#payAmt").val();
					var payProjectId = $("#payProjectId").val();
					var netStatus = $("#netStatus").val();
					$("#errormsg").hide();
					
					if(isEmpty(netNo) || null == netNo){
						$("#errormsg").html("请选择上网账号");
						$("#errormsg").show();
						return false;
					}
					
					if( null == payAmt||isEmpty(payAmt) ){
						$("#errormsg").html("请输入缴费金额");
						$("#errormsg").show();
						return false;
					}
					
					if(!isCurrency($("#payAmt").val())){
						$("#errormsg").html("*输入数字，最多2位小数");
						$("#errormsg").show();
						return false;
					}
					if($("#payAmt").val() * 1 <=0){
						$("#errormsg").html("*缴费金额不可为0");
						$("#errormsg").show();
						return false;
					}
					var users = '<s:property value="#session.payUserInfo.username"/>';
					if(users == null || "" == users || typeof user == undefined){
						document.getElementById("lock_screen_dj").click();//锁屏
						return false;
					}
					//提交订单
					$.ajax({
				    	type:'post',
				    	async:false,
				    	url:'/netCreateOrder',
				    	data:{
				    		"netNo":netNo,
							"payAmt":payAmt,
							"netStatus":netStatus,
							"payProjectId":payProjectId
				    	},
				    	success:function(data){
				    		var jsonData = eval("("+data+")");
							if(jsonData.returncode == "SUCCESS"){
								window.location.href="/showUserSelectPayType25"+jsonData.payOrderTrade.id
					        }else{
					        	$("#errormsg").empty();
								$("#errormsg").html("*"+jsonData.returnmsg);
								$("#errormsg").show();
					        }
				    	}
				    });
				}
			</script>
</body>
</html>
