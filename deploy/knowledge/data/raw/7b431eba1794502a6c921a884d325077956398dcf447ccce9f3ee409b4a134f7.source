ttom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 0.5pt solid black; border-right: 1pt solid black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">数学与统计学院</span></p></td></tr><tr style="height: 19.85pt; text-align: center;"><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 0.5pt solid black; border-right: 1pt solid black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">微电子学院</span></p></td></tr><tr style="height: 19.85pt; text-align: center;"><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 0.5pt solid black; border-right: 1pt solid black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">生命科学技术学院</span></p></td></tr><tr style="height: 19.85pt; text-align: center;"><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 0.5pt solid black; border-right: 1pt solid black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">先进材料与纳米科技学院</span></p></td></tr><tr style="height: 19.85pt; text-align: center;"><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-top: none; border-left: none; border-bottom: 0.5pt solid black; border-right: 1pt solid black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">信息力学与感知工程学院</span></p></td></tr><tr style="height: 18.45pt; text-align: center;"><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 1pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="display: none; border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid rgb(0, 0, 0); border-right: 0.5pt solid black; vertical-align: middle;"><p style="text-align: left; text-indent: 0pt;"><br></p></td><td style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">网络与信息安全学院</span></p></td></tr><tr style="height: 28.8pt; text-align: center;"><td style="border-top: none; border-left: 1pt solid black; border-bottom: 1pt solid black; border-right: 1pt solid black; vertical-align: middle;"><p style="min-height: 20pt; line-height: 20pt; text-indent: 0pt;"><span style="font-family: 仿宋_GB2312; color: rgb(0, 0, 0); min-height: 11pt; font-size: 11pt;">第二阶段</span></p></td><td colspan="2" style="border-top: none; border-left: none; border-bottom: 1pt solid black; border-right: 0.5pt solid black; vertical-align: middle;"><p style="text-indent: 11pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0); min-height: 11pt; font-size: 11pt;">9月11日（周五）20:00之后</span></p></td><td style="border-width: 0.5pt; border-style: solid; border-color: black; vertical-align: middle;"><p style="text-indent: 0pt;"><span style="font-family: 宋体; color: rgb(0, 0, 0);">完全放开，所有学生随时可选</span></p></td></tr></tbody></table><p style="min-height: 28pt; line-height: 28pt; text-indent: 31.5pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; min-height: 16pt;">本期实验学生仍需注册并设置密码</span><span style="font-family: 仿宋_gb2312, fangsong_gb2312; min-height: 16pt;">，选课方法及注意事项详见附件1,实验报告网络提交、虚拟仿真实验及试题库测试系统详见附件2。</span></span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 48pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; min-height: 16pt; font-size: 21px;">二、《物理实验（Ⅰ）》（24PY2009）补考安排</span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 31.35pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;"><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; min-height: 16pt;">物理实验中心定于</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; color: rgb(0, 0, 0); min-height: 16pt; text-decoration: underline;">2026年9月16日（周三）14:00～15:30</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; min-height: 16pt;">进行《物理实验（Ⅰ）》课程补考（闭卷、笔试）。</span></span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 31.35pt; font-size: 21px;"><span style="min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">考试地点：F楼各物理实验室（考场安排于考前1天在F楼二楼大厅公布，可带计算器）。</span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 31.35pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;"><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; color: rgb(0, 0, 0); min-height: 16pt;">请</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; color: rgb(0, 0, 0); min-height: 16pt;">已于教务系统完成补考预约的学生</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; color: rgb(0, 0, 0); min-height: 16pt;">提前准备，按时赴考。</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; color: rgb(0, 0, 0); min-height: 16pt;">未进行网上预约的学生，不得参加补考；预约成功而未参加考试的同学成绩按零分记录。</span></span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 32.15pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; color: rgb(0, 0, 0); min-height: 16pt; font-size: 21px;">提醒：该补考科目为《物理实验（Ⅰ）》（24PY2009），不是“物理实验能力达标测试”（C1-2）。</span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 32.15pt; font-size: 21px;"><br></p><p style="line-height: 1.5; text-indent: 0pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; min-height: 16pt; font-size: 21px;">物理实验（Ⅰ）补考、物理实验选课、实验报告网络提交，咨询：</span></p><p style="line-height: 1.5; text-indent: -328pt; margin-left: 364.75pt; text-align: center; font-size: 21px;"><span style="color: rgb(0, 0, 0); min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">15191438745，81891123（赵老师）</span></p><p style="line-height: 1.5; text-indent: -328pt; margin-left: 364.75pt; text-align: center; font-size: 21px;"><span style="color: rgb(0, 0, 0); min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">18092159730（李老师）</span></p><p style="line-height: 1.5; text-indent: -328pt; margin-left: 364.75pt; text-align: center; font-size: 21px;"><span style="color: rgb(0, 0, 0); min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">15909207668，xlwu@xidian.edu.cn（吴老师）</span></p><p style="line-height: 1.5; text-indent: 0pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;"><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; min-height: 16pt;">物理实验试题库测试，咨询：</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; min-height: 16pt;">18392868169（武老师）</span></span></p><p style="line-height: 1.5; text-indent: 0pt; font-size: 21px;"><span style="font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;"><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; font-weight: bold; min-height: 16pt;">物理虚拟仿真实验，咨询：</span><span style="font-size: 21px; font-family: 仿宋_gb2312, fangsong_gb2312; min-height: 16pt;">13572824490（代老师）</span></span></p><p style="line-height: 1.5; text-indent: -344pt; margin-left: 370.25pt; font-size: 21px;"><br></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 0pt; font-size: 21px;"><span style="min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">附件1: “物理实验”选课注意事项</span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 0pt; font-size: 21px;"><span style="min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">附件2：实验报告网络提交及线上虚拟仿真实验及测试方法</span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 0pt; font-size: 21px;"><br></p><p style="min-height: 28pt; line-height: 28pt; text-indent: -344pt; margin-left: 370.25pt; text-align: right; font-size: 21px;"><span style="min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;">本科生院 &nbsp;&nbsp;物理学院 </span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: -344pt; margin-left: 370.25pt; text-align: right;"><span style="min-height: 16pt; font-family: 仿宋_gb2312, fangsong_gb2312; font-size: 21px;"> &nbsp;&nbsp;2026年9月7日</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;"> &nbsp;</span></p><p style="min-height: 28pt; line-height: 28pt; text-indent: 0pt;"><br></p></article></section><section class="docx"><article><p style="min-height: 28pt; line-height: 28pt; text-indent: 0pt;"><span style="font-family: 黑体; font-weight: bold; min-height: 15pt; font-size: 15pt;"><br></span><span style="font-weight: bold; min-height: 16pt; font-size: 16pt;"></span></p></article></section>
