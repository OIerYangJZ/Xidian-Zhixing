<script>
   var appElementu3 = document.querySelector("#appu3");
   if (appElementu3 && appElementu3.__vue__) {

   } else {
      $("#divu3").html($("#htmlu3").text());
      var appOwner = "1827564999";   
      var urlPrefix = "/aop_component/";
