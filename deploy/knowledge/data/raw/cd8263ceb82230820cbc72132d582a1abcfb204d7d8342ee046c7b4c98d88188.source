<script language="javascript" src="../../_dwr/interface/NewsvoteDWR.js"></script><script language="javascript" src="../../_dwr/engine.js"></script><script language="javascript" src="/system/resource/js/news/newscontent.js"></script><LINK href="/system/resource/js/photoswipe/3.0.5.1/photoswipe.css" type="text/css" rel="stylesheet"><script language="javascript" src="/system/resource/js/photoswipe/3.0.5.1/pw.js"></script><script language="javascript" src="/system/resource/js/ajax.js"></script><form name="_newscontent_fromname">
    <h2>李平平</h2>
			<h3><span>作者：</span><span>时间：2025-04-01</span><span>点击数：<script>_showDynClicks("wbnews", 1827564999, 1501)</script></span></h3>
<div class="con_con"><p>
    <div id="vsb_content"><div class="v_news_content">
<p style="text-align: center"><img src="/__local/3/BF/ED/ED7306694DBBE67A68570F0D8F2_82FDB3EC_2DBD4.jpg" width="400" vsbhref="vurl" vurl="/_vsl/3BFEDED7306694DBBE67A68570F0D8F2/82FDB3EC/2DBD4" vheight="" vwidth="400" orisrc="/__local/D/79/42/223D25F29673533CDF1A47AAB41_96F6AD6D_894B18.jpg" class="img_vsb_content"></p><p style="text-indent: 2em; line-height: 2em;"><span style="font-size: 21px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;">李平平，女，中西医结合内科主任医师。1995年毕业于陕西中医学院，医学硕士，陕西省中医药科技开发研究会委员，曾在西安交大一附院心血管内科进修学习一年，多次参加全国及省级中西医结合呼吸科、内分泌科等短期的学习。自工作以来一直从事临床一线，熟悉内科常见病、多发病的诊断和治疗，在中西医结合治疗冠心病、心律失常、高血压病、扩张型心肌病、病毒性心肌炎、心力衰竭、糖尿病、脑血管疾病、慢性阻塞性肺部疾病等方面有丰富的经验。曾多次成功抢救危重病人。发表论文10余篇，参编专著2部。</span></p><p style="text-align: center"><img src="/__local/8/A9/38/C7108B6ACBCCF81AC86F311A170_452A4E7F_2EEE.jpg" width="459" height="71" vsbhref="vurl" vurl="/_vsl/8A938C7108B6ACBCCF81AC86F311A170/452A4E7F/2EEE" vheight=" 71px" vwidth=" 459px" orisrc="/__local/0/27/59/79F63DA2825D38C178688EECCCC_DCBB911F_3DD9.jpg" class="img_vsb_content" style="width: 459px; height: 71px;"></p><p style="text-indent: 2em;"><span style="font-family: 仿宋_gb2312,fangsong_gb2312; font-size: 21px;"></span><br></p><p><br></p><p>&nbsp;</p>
</div></div><div id="div_vote_id"></div></p>
</div>
    




