<script>
   var appElementu4 = document.querySelector("#appu4");
   if (appElementu4 && appElementu4.__vue__) {

   } else {
      $("#divu4").html($("#htmlu4").text());
      var appOwner = "1281831001";   
      var urlPrefix = "/aop_component/";
      var ifLogin="";
