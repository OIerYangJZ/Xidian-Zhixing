<script language="javascript" src="../../_dwr/interface/NewsvoteDWR.js"></script><script language="javascript" src="../../_dwr/engine.js"></script><script language="javascript" src="/system/resource/js/news/newscontent.js"></script><LINK href="/system/resource/js/photoswipe/3.0.5.1/photoswipe.css" type="text/css" rel="stylesheet"><script language="javascript" src="/system/resource/js/photoswipe/3.0.5.1/pw.js"></script><script language="javascript" src="/system/resource/js/ajax.js"></script><form name="_newscontent_fromname">
<div style="min-height:300px;">
    <h1 align="center">忆觉醒年代，悟青春担当｜西电举办第八期资助育人·悦读会</h1>
    <div align="center" style="line-height:60px;color:#aaa;">时间：2025-04-28&nbsp;&nbsp;阅读次数：<script>_showDynClicks("wbnews", 1370093333, 12474)</script>&nbsp;</div>
    <div id="vsb_content" style="line-height:24px;"><div class="v_news_content">
<style>.docx-wrapper { background: gray; padding: 30px; padding-bottom: 0px; display: flex; flex-flow: column; align-items: center;} .docx-wrapper>section.docx { background: white; box-shadow: 0 0 10px rgba(0, 0, 0, 0.5); margin-bottom: 30px;}.docx { color: black; hyphens: auto;}section.docx { box-sizing: border-box; display: flex; flex-flow: column nowrap; position: relative; overflow: hidden;}section.docx>article { margin-bottom: auto; z-index: 1;}section.docx>footer { z-index: 1;}.docx table { border-collapse: collapse;}.docx table td, .docx table th { vertical-align: top;}.docx p { margin: 0pt !important; min-height: 1em;}.docx span { white-space: pre-wrap; overflow-wrap: break-word;}.docx a { color: inherit; text-decoration: inherit;}</style><style>.docx {  --docx-majorhansi-font: Calibri Light;  --docx-minorhansi-font: Calibri;  --docx-dk1-color: #000000;  --docx-lt1-color: #FFFFFF;  --docx-dk2-color: #44546A;  --docx-lt2-color: #E7E6E6;  --docx-accent1-color: #4874CB;  --docx-accent2-color: #EE822F;  --docx-accent3-color: #F2BA02;  --docx-accent4-color: #75BD42;  --docx-accent5-color: #30C0B4;  --docx-accent6-color: #E54C5E;  --docx-hlink-color: #0026E5;  --docx-folhlink-color: #7E1FAD;}</style><style>.docx span {  font-family: Times New Roman;}.docx p, p.docx_1 {  text-align: justify;}.docx p, p.docx_1 span {  font-family: var(--docx-minorHAnsi-font);  min-height: 10.50pt;  font-size: 10.50pt;}p.docx_2 {  margin-top: 0.00pt;  margin-bottom: 0.00pt;  text-align: left;}p.docx_2 span {  font-family: 宋体;  font-weight: bold;  min-height: 18.00pt;  font-size: 18.00pt;}p.docx_3 {  margin-top: 0.00pt;  margin-bottom: 0.00pt;  text-align: left;}p.docx_3 span {  font-family: 宋体;  font-weight: bold;  min-height: 12.00pt;  font-size: 12.00pt;}.docx table, table.docx_5 td {  padding-top: 0.00pt;  padding-left: 5.40pt;  padding-bottom: 0.00pt;  padding-right: 5.40pt;}p.docx_4 {  margin-top: 0.00pt;  margin-bottom: 0.00pt;  margin-left: 0.00pt;  margin-right: 0.00pt;  text-align: left;}p.docx_4 span {  min-height: 12.00pt;  font-size: 12.00pt;  font-family: var(--docx-minorHAnsi-font);}span.docx_7 {  font-weight: bold;}</style><section class="docx"><article><p style="line-height: 2; text-indent: 32pt; vertical-align: baseline;"><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">为鼓励学子积极参与阅读，</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">以经典阅读培育积极人生</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">态度，赋能成长成才新动能</span><span lang="null" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">，</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">4月23日，在第</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">30</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">个世界读书日当天，学生资助管理中心举办第</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">八期</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">“</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">资助育人·悦读会</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">”</span><span lang="null" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">，</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">学生资助宣传大使代表</span><span lang="null" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">、</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">阅读爱好者</span><span lang="null" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">、</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">学生资助管理中心工作人员共计30余人，</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">共同走进《</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">觉醒年代</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">》一书，以“经典朗读+感悟分享+纸笔言志”模式，</span><span lang="en-US" style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">开启一场跨越百年、与革命先辈对话的思想觉醒之旅</span><span style="text-indent: 32pt; font-family: 宋体; min-height: 12pt; font-size: 12pt;">。</span><br></p><p style="line-height: 2; text-indent: 0pt; text-align: center; vertical-align: baseline;"><span style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;"><span style=" position: relative; text-indent: 0px; width: 415.25pt; height: 169.85pt;"><img src="/__local/A/82/6E/96BEC3A78E42EBE7652A517A5F7_D53B7F25_1AAFB.jpeg" vsbhref="vurl" vurl="/_vsl/A826E96BEC3A78E42EBE7652A517A5F7/D53B7F25/1AAFB" vheight=" 169.85pt" vwidth=" 415.25pt" orisrc="/__local/8/9A/45/0C67D6FA1899A4E8D4578496B4A_9F238AB3_60C02.jpeg" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 415.25pt; height: 169.85pt;"></span></span></p><p style="line-height: 2; text-indent: 32pt; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">《觉醒年代》一书</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">呈现了由新文化运动、五四运动和中国共产党成立这三大历史事件为主体构成的巨幅历史画卷，生动展现了中国共</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">产党建党先驱的初心之纯、信仰之坚、理想之美，艺术再现了一百年前中国先进知识分子和热血青年演绎出的追求真理、燃烧理想的如歌岁月。</span></p><p style="line-height: 2; text-align: center; vertical-align: baseline; text-indent: 0pt;"><span lang="en-US" style="font-family: 宋体; font-weight: bold; min-height: 12pt; font-size: 12pt;">经典语录，致敬先辈风骨</span></p><p style="line-height: 2; text-indent: 32pt; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">活动伊始</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">，人文学院黄艳茹</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">同学为大家简要介绍了书籍创作的背景和主要内容，并通过同名电视剧《觉醒年代》精彩片段回顾</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">，将同学们带回到那个风云变幻、思想激荡的“觉醒年代”，沉浸式感受历史的厚重与先辈的热血。</span></p><p style="line-height: 2; text-indent: 32pt; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">沉浸式阅读前，主持人以互动小游戏开场，随机展示陈独秀、李大钊等革命先辈的经典名言，读书爱好者们在字里行间探寻思想原点，竞猜名言出处，并通过深情朗读，生动还原了历史人物的独特风采，表达对革命先辈的敬仰之情。</span></p><p style="line-height: 2; text-align: center; vertical-align: baseline; text-indent: 0pt;"><span lang="en-US" style="font-family: 宋体; font-weight: bold; min-height: 12pt; font-size: 12pt;">畅谈感悟，传承奋斗精神</span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">经典诵读环节，同学们紧密围绕书中的历史脉络与人物精神内核，结合当代青年所处的时代背景与现实境遇，分享自己的深刻体会。</span></p><p style="line-height: 2; text-indent: 0pt; text-align: center; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;"><span style=" position: relative; text-indent: 0px; width: 414.7pt; height: 288pt;"><img src="/__local/D/83/9B/980727E8391ACE22176417388AE_7468D6C1_3FCA5.jpeg" vsbhref="vurl" vurl="/_vsl/D839B980727E8391ACE22176417388AE/7468D6C1/3FCA5" vheight=" 288pt" vwidth=" 414.7pt" orisrc="/__local/2/AF/DE/37E83E107EF2390F61AFD2024FD_B218733C_9F3FF.jpeg" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 414.7pt; height: 288pt;"></span></span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">学生</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">资助宣传大使李震华</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">分享道</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">：“先辈们通过倡导新文化、新思想唤醒民众，推动社会进步，这是教育的力量；如今，教育依然是唤醒人们觉醒意识的关键，它能帮助我们认识自身价值与潜力，追逐梦想。</span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">通信工程学院焦亦嶶同学感慨道：“‘天下者我们的天下；国家者，我们的国家；社会者，我们的社会。我们不说，谁说？我们不干，谁干’那个时代，许多青年与我们年龄相仿，却为了理想壮烈牺牲。他们的勇敢、信仰与精神，永远值得我们学习。面对学业与就业压力，我时刻提醒自己要慎独自律，合理规划，以无畏的勇气直面困难、解决问题。”</span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">经济与管理学院王梓譞同学谈到：</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">“《觉醒年代》中五四运动的爆发最令我动容。书中青年为民族存亡奔走，如今作为西电学子，我们更应思考如何赋予‘觉醒’新的时代内涵</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">要像书中青年一样敢于突破、勇于创新，将论文写在祖国大地上，让‘觉醒’之火永不熄灭。”</span></p><p style="line-height: 2; text-align: center; vertical-align: baseline; text-indent: 0pt;"><span lang="en-US" style="font-family: 宋体; font-weight: bold; min-height: 12pt; font-size: 12pt;">与觉醒者书，跨越时空对话</span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">纸笔言志</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">环节，同学们以书信为载体，深情抒发对革命先辈的崇高敬意，庄重表达传承使命、砥砺前行的坚定决心。以《觉醒年代》为纽带，引领青年学子在书页间对话历史，畅谈时代浪潮中的选择与坚守。</span></p><p style="line-height: 2; text-indent: 0pt; text-align: center; vertical-align: baseline;"><span style="font-family: 宋体; min-height: 12pt; font-size: 12pt;"><span style=" position: relative; text-indent: 0px; width: 415.05pt; height: 116.95pt;"><img src="/__local/E/13/D5/230483C854A18A1755726DE5D85_3E4F476F_ACF2.jpeg" vsbhref="vurl" vurl="/_vsl/E13D5230483C854A18A1755726DE5D85/3E4F476F/ACF2" vheight=" 116.95pt" vwidth=" 415.05pt" orisrc="/__local/C/A1/C4/77EBB2F62751CB0BCAB55143CF7_84CF75E5_27558.jpeg" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 415.05pt; height: 116.95pt;"></span></span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">忆觉醒年代，悟青春担当。本次读书活动以世界读书日为契机，师生共读一本书，走进100年前的那群“新青年”，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">学习他们坚定理想信念，不断学习进步，团结合作共进，坚持艰苦奋斗的意志品质。作为新时代的青年，应该明确自己的责任和使命，将个人的理想融入到国家和民族的发展大局中，敢于面对挑战，勇于承担责任，为实现中华民族伟大复兴的中国梦贡献自己的力量。</span></p><p style="line-height: 2; text-align: center; vertical-align: baseline; text-indent: 0pt;"><span id="_GoBack"></span><span style="font-family: 宋体; min-height: 12pt; font-size: 12pt;"><span style=" position: relative; text-indent: 0px; width: 356.55pt; height: 200.6pt;"><img src="/__local/E/73/E8/F5030405DE4C049DCAFE7AAC7F3_B525B66B_57E8E.png" vsbhref="vurl" vurl="/_vsl/E73E8F5030405DE4C049DCAFE7AAC7F3/B525B66B/57E8E" vheight=" 200.6pt" vwidth=" 356.55pt" orisrc="/__local/3/C3/DE/9CD0DD8A48D7AF006E2632EBA32_4AFD0058_14305F.png" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 356.55pt; height: 200.6pt;"></span></span></p><p style="line-height: 2; text-indent: 32pt; text-align: justify; vertical-align: baseline;"><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">资助育人·悦读会是学校发展型资助育人</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">计划</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">的</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">重要</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">内容</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">通过引导学生多读书，读好书，善读书，感受时代气象，体悟文化意涵，涵养精神境界，将书中知识内化为指引人生道路的灯塔。</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">下一步，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">学校</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">将</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">持续</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">以</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">学生</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">成长</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">发展为</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">目标</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">通过</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">“</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">筑梦</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">活动</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">”</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">“</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">发展型</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">资助</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">育人</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">计划</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">”</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">“</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">笃行班</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">”</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">等</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">多种</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">途径，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">持续营造“人人都有梦想，个个都在成长”</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">氛围，</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">并</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">分层分类</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">帮扶</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">学生</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">发展</span><span lang="en-US" style="font-family: 宋体; font-weight: normal; min-height: 12pt; font-size: 12pt;">。</span></p></article></section>
</div></div><div id="div_vote_id"></div>
