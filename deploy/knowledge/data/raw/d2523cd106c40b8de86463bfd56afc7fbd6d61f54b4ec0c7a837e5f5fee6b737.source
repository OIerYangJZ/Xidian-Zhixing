        c_Calendar256272ShowString= "";
    }

    RunGLNL256272();

    function update() {
        $.ajax({
            type: "post",
            data: {
                "sdate": "2013-02-06",
                "edate": "2099-12-31",
                "showtext": "第",
                "isNotStart": "学期未开始",
                "isEnd": "学期已结束",
            },
