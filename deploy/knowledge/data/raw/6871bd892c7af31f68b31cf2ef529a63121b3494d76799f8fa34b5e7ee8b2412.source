: 14.00pt;}span.docx_27 p {  text-align: center;  margin-bottom: 8.00pt;  line-height: 1.16;}span.docx_27 {  font-family: var(--docx-majorHAnsi-font);  color: #595959;  min-height: 14.00pt;  font-size: 14.00pt;}p.docx_28 {  margin-top: 8.00pt;  text-align: center;  margin-bottom: 8.00pt;  line-height: 1.16;}p.docx_28 span {  font-style: italic;  color: #404040;  font-family: var(--docx-minorHAnsi-font);  min-height: 11.00pt;  font-size: 11.00pt;}p.docx_28 span {  font-style: italic;  color: #404040;}span.docx_29 {  font-style: italic;  color: #404040;}span.docx_29 p {  margin-top: 8.00pt;  text-align: center;  margin-bottom: 8.00pt;  line-height: 1.16;}span.docx_29 {  font-style: italic;  color: #404040;  font-family: var(--docx-minorHAnsi-font);  min-height: 11.00pt;  font-size: 11.00pt;}p.docx_30 {  margin-left: 36.00pt;  margin-bottom: 8.00pt;  line-height: 1.16;}p.docx_30 span {  font-family: var(--docx-minorHAnsi-font);  min-height: 11.00pt;  font-size: 11.00pt;}span.docx_31 {  font-style: italic;  color: #2F5597;}p.docx_32 {  border-top: 0.50pt solid #2F5496;  border-bottom: 0.50pt solid #2F5496;  margin-top: 18.00pt;  margin-bottom: 18.00pt;  margin-left: 43.20pt;  margin-right: 43.20pt;  text-align: center;  line-height: 1.16;}p.docx_32 span {  font-style: italic;  color: #2F5597;  font-family: var(--docx-minorHAnsi-font);  min-height: 11.00pt;  font-size: 11.00pt;}p.docx_32 span {  font-style: italic;  color: #2F5597;}span.docx_33 {  font-style: italic;  color: #2F5597;}span.docx_33 p {  border-top: 0.50pt solid #2F5496;  border-bottom: 0.50pt solid #2F5496;  margin-top: 18.00pt;  margin-bottom: 18.00pt;  margin-left: 43.20pt;  margin-right: 43.20pt;  text-align: center;  line-height: 1.16;}span.docx_33 {  font-style: italic;  color: #2F5597;  font-family: var(--docx-minorHAnsi-font);  min-height: 11.00pt;  font-size: 11.00pt;}span.docx_34 {  font-weight: bold;  text-transform: lowercase;  color: #2F5597;}span.docx_35 {  font-family: var(--docx-minorHAnsi-font);  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_35 p {  line-height: 1.00;  text-align: center;  margin-bottom: 8.00pt;}span.docx_35 {  min-height: 9.00pt;  font-size: 9.00pt;  font-family: var(--docx-minorHAnsi-font);}span.docx_36 {  font-family: var(--docx-minorHAnsi-font);  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_36 p {  line-height: 1.00;  margin-bottom: 8.00pt;}span.docx_36 {  min-height: 9.00pt;  font-size: 9.00pt;  font-family: var(--docx-minorHAnsi-font);}</style><section class="docx"><article><p style="margin-bottom: 0pt; min-height: 28pt; line-height: 28pt; text-align: center; text-indent: 0pt;"><br></p><p style="margin-bottom: 7.8pt; min-height: 28pt; line-height: 28pt; text-indent: 32pt; text-align: justify;"><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">7月10日下午，副校长张进成赴国家卓越工程师学院督导树立和践行正确政绩观学习教育开展情况，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">并列席指导国卓院</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">党委理论学习中心组</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">（</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">扩大</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">）</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">学习会议。党委教师工作部部长、人力资源部部长于磊</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">到会</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">巡听。</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">领导班子全体成员</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">党委研究生工作部、研究生院科级以上全体党员</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">参</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">加</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">会议</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">。</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">会议由</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">党委研究生工作部部长、国家卓越工程师学院党委书记</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">张君博主持。</span></p><p style="margin-bottom: 7.8pt; line-height: 1; text-align: center; vertical-align: baseline; text-indent: 0pt;"><span style="font-family: 仿宋_GB2312; font-weight: normal; min-height: 16pt; font-size: 16pt;"><span style=" position: relative; text-indent: 0px; width: 415.3pt; height: 276.85pt;"><img src="/__local/A/55/E0/375E6B62B5201975A0CB5F384FF_BB102AB9_25CBD.jpeg" vsbhref="vurl" vurl="/_vsl/A55E0375E6B62B5201975A0CB5F384FF/BB102AB9/25CBD" vheight=" 276.85pt" vwidth=" 415.3pt" orisrc="/__local/4/84/56/FC9B7F701E3FA1144845D66191C_75D7B9E0_4ABE1.jpeg" class="img_vsb_content" style="position: relative; left: 0pt; top: 0pt; width: 415.3pt; height: 276.85pt;"></span></span></p><p style="margin-bottom: 0pt; min-height: 28pt; line-height: 28pt; text-indent: 32pt; text-align: justify;"><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">会上，国卓院领导班子成员依次领学了习近平总书记在庆祝中国共产党成立105周年大会上的重要</span><span id="_GoBack"></span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">讲话</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">、习近平党建思想、</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">《一体推进教育科技人才发展》</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">、</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">学校落实新时代立德树人工程实施方案等学习内容，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">张君博</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">从</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">聚焦思想铸魂</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">、聚焦实践转化、聚焦问题导向、聚焦载体创新四个方面汇报</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">了国卓院党委树立和践行正确政绩观学习教育开展情况，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">研究生院院长</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">、</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国家卓越工程师学院执行院长</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">王爽围绕卓越工程师</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">教育</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">认证标准作专题导学。</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">与会人员</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">围绕学习主题，结合工作实际开展研讨交流。</span></p><p style="margin-bottom: 0pt; min-height: 28pt; line-height: 28pt; text-indent: 32pt; text-align: justify;"><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">张进成对</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院树立和践行</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">正确政绩观</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">学习教育开展情况及理论中心组学习</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">成效予以肯定</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">。</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">他</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">指出</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">本次学习</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">主题鲜明，内容充实，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">紧扣</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">战略定位，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">促进了</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">理论学习与中心工作深度</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">融合。</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">他强调，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">是新时代高等工程教育改革的重要试验田</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">要在服务国家战略急需、发挥企业主体作用、校企双导师队伍建设等方面持续发力，久久为功</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">。</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">张进成</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">就</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">持续深化学习教育</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">、</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">以正确政绩观引领事业高质量发展提出明确要求</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">一是</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">持续深化理论武装</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，把学习教育与</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">重点任务</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">深度融合，切实推动正确政绩观见行见效</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">二是</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">对标国家认证标准深耕产教融合</span><span lang="null" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">完善育人体系，聚焦国家战略需求培育高质量工程人才，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">三是</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">坚持以师生为中心抓实问题整改，持续推进</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">建设迭代升级。</span></p><p style="margin-bottom: 0pt; min-height: 28pt; line-height: 28pt; text-indent: 32pt; text-align: justify;"><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">于磊</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">在</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">巡听点评</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">时指出，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">本次中心组学习组织规范、</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">重点突出</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">、成效</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">显著</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国卓院作为</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">教育科技人才一体化发展的重要交汇点，</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">要坚持以理论学习为载体，发挥班子成员“关键少数”示范引领作用，深化学用结合，</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">扎实推进</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">国家卓越工程师学院内涵</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">建设、认证攻坚等重点工作，持续提升</span><span lang="en-US" style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">学校</span><span style="font-family: 仿宋_GB2312; min-height: 16pt; font-size: 16pt;">卓越工程师培养质量。</span></p></article></section>
</div></div><div id="div_vote_id"></div>
    
