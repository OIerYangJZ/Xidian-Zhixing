# Merge these variables into the Next.js service environment.
# Keep this key identical to KNOWLEDGE_API_KEY in knowledge.env.
BACKEND_RAG_URL=http://127.0.0.1:8091
BACKEND_RAG_API_KEY=REPLACE_WITH_SAME_KNOWLEDGE_API_KEY
XIDIAN_PUBLIC_ORIGIN=https://zhixing.xidian.edu.cn
XIDIAN_CAS_ISSUER=https://ids.xidian.edu.cn/authserver

# Provider credentials stay on the server. The provider must offer an
# OpenAI-compatible /v1/chat/completions endpoint with JSON mode support.
BACKEND_AI_BASE_URL=REPLACE_WITH_PROVIDER_V1_URL
BACKEND_AI_API_KEY=REPLACE_WITH_PROVIDER_KEY
BACKEND_AI_MODEL=REPLACE_WITH_ACCEPTED_MODEL
BACKEND_AI_QUERY_TIMEOUT=20
BACKEND_AI_GENERATION_TIMEOUT=90
BACKEND_AI_CONTEXT_ITEMS=8
