# Core service settings
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_OF_AT_LEAST_12_CHARACTERS
BACKEND_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
BACKEND_CORS_ALLOWED_ORIGINS=https://zhixing.xidian.edu.cn
BACKEND_AUTH_ALLOWED_EMAILS=REPLACE_WITH_TEST_ACCOUNT_EMAILS
BACKEND_MAX_REQUEST_BODY_MB=20
BACKEND_ENABLE_XIDIAN_AUTH=false
BACKEND_DB_FILE=/home/ubuntu/treehole/shared/data/treehole.db
BACKEND_STORAGE_DIR=/home/ubuntu/treehole/shared/storage/objects
BACKEND_WEB_ROOT=/home/ubuntu/treehole/current/web
BACKEND_OBJECT_STORAGE_BACKEND=local
BACKEND_SEED_DEMO_DATA=false
# Optional: only set this when enabling IDS callback bridging.
# Must be an HTTPS origin after the production domain is approved.
BACKEND_XIDIAN_PUBLIC_ORIGIN=

# Optional server-owned OpenAI-compatible provider. These values are never returned to clients.
# To disable AI, leave both BACKEND_AI_BASE_URL and BACKEND_AI_API_KEY empty.
BACKEND_AI_BASE_URL=
BACKEND_AI_API_KEY=
BACKEND_AI_MODEL=gpt-4o-mini
BACKEND_AI_EMBEDDING_MODEL=

# SMTP settings
BACKEND_SMTP_HOST=smtp.qq.com
BACKEND_SMTP_PORT=465
BACKEND_SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
BACKEND_SMTP_PASSWORD=REPLACE_WITH_SMTP_AUTH_CODE
BACKEND_SMTP_FROM_EMAIL=REPLACE_WITH_FROM_EMAIL
BACKEND_SMTP_FROM_NAME=XDU Treehole
BACKEND_SMTP_USE_SSL=true
BACKEND_SMTP_USE_STARTTLS=false

# Debug settings
# WARNING: MUST be false in production. When true, any verify code defaults to "123456".
BACKEND_ALLOW_DEBUG_VERIFY_CODE=false
# WARNING: MUST be false in production. When true, HTTP responses may include extra debug fields.
BACKEND_INCLUDE_DEBUG_CODE=false
