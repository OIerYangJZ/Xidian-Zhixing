[Unit]
Description=SeeRadio Treehole Backend API Server
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=treehole
Group=treehole
WorkingDirectory=/home/ubuntu/treehole/current
EnvironmentFile=/home/ubuntu/treehole/shared/config/backend.env
Environment="BACKEND_HOST=127.0.0.1"
Environment="BACKEND_PORT=8080"
ExecStartPre=/home/ubuntu/treehole/shared/venv/bin/python scripts/validate_production_env.py /home/ubuntu/treehole/shared/config/backend.env
ExecStart=/home/ubuntu/treehole/shared/venv/bin/python backend/server.py
Restart=always
RestartSec=3
UMask=0027

# 启动顺序：等待依赖服务就绪
TimeoutStartSec=30
TimeoutStopSec=10

# 日志输出到 journald + 文件双写
StandardOutput=journal
StandardError=journal
SyslogIdentifier=treehole

# 安全加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/treehole/shared/data
ReadWritePaths=/home/ubuntu/treehole/shared/storage
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096
MemoryMax=2G

[Install]
WantedBy=multi-user.target
