upstream treehole_backend {
    server 127.0.0.1:8080;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://__DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate __CERTIFICATE__;
    ssl_certificate_key __PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /home/ubuntu/treehole/current/web;
    index index.html;
    client_max_body_size 20m;
    client_header_timeout 15s;
    client_body_timeout 15s;

    access_log /var/log/nginx/treehole.access.log;
    error_log  /var/log/nginx/treehole.error.log;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' https://www.gstatic.com; worker-src 'self' blob:; manifest-src 'self'" always;

    gzip on;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml application/wasm;

    # nginx add_header does NOT inherit into a location that declares its own
    # add_header.  Every one of these must therefore stay free of add_header —
    # caching is expressed with `expires` instead — or the location silently
    # serves the document with no CSP, no HSTS and no X-Frame-Options.
    location = /index.html {
        expires -1;
        try_files $uri =404;
    }

    location = /flutter_service_worker.js {
        expires -1;
        try_files $uri =404;
    }

    location ~* ^/(?:main\.dart\.js|flutter(?:_bootstrap)?\.js|manifest\.json|version\.json|assets/(?:AssetManifest\.(?:bin|bin\.json|json)|FontManifest\.json))$ {
        expires -1;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # nginx's packaged mime.types carries no wasm entry, so CanvasKit's .wasm
    # went out as application/octet-stream and the browser refused it:
    #   TypeError: Failed to execute 'compile' on 'WebAssembly':
    #   Incorrect response MIME type. Expected 'application/wasm'.
    # That rejection is an unhandled promise, so the app just never paints its
    # first frame instead of reporting an error.
    #
    # The empty `types {}` scopes the override to this location.  A bare
    # `types { application/wasm wasm; }` at server level would REPLACE the
    # whole inherited map and serve js/css as octet-stream too.
    #
    # Must stay above any location that would otherwise match \.wasm$ —
    # nginx takes the first matching regex location.
    location ~* \.wasm$ {
        types { }
        default_type application/wasm;
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|wasm)$ {
        expires 7d;
        access_log off;
        try_files $uri =404;
    }

    # APK 上传（管理后台发版）单独放宽体积上限，其余 /api/ 仍受 20m 限制。
    # 后端 ANDROID_RELEASE_MAX_BYTES 为 300MB，此处留出 multipart 封装余量。
    location = /api/admin/releases/android {
        client_max_body_size 320m;
        proxy_pass http://treehole_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_request_buffering off;
    }

    location /api/ {
        proxy_pass http://treehole_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_request_buffering on;
    }

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ~ /\. {
        deny all;
    }
}
