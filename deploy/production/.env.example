# =============================================================================
# XDU WhisperBox 生产环境配置模板
# 复制此文件为 .env 并填入实际值
# =============================================================================

# 必填：核心服务设置
# =============================================================================

BACKEND_ENV=production
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
BACKEND_CORS_ALLOWED_ORIGINS=https://zhixing.xidian.edu.cn
# 可选学号白名单：留空允许所有统一认证用户；非空时使用英文逗号分隔。
BACKEND_AUTH_ALLOWED_STUDENT_IDS=
BACKEND_MAX_REQUEST_BODY_MB=20

# 允许设置 X-Forwarded-For / X-Real-IP 的可信代理网段（逗号分隔 CIDR）。
# 只有来自这些网段的连接，其转发头才会被采信；否则一律使用 TCP 对端地址。
# 留空表示"不信任任何代理"，适用于后端直接对外暴露的场景。
BACKEND_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
BACKEND_ENABLE_XIDIAN_AUTH=true
# 必填：西电 IDS 已授权登记的固定 HTTPS Origin。
# CAS service/callback 固定为 https://zhixing.xidian.edu.cn/api/auth/xidian/callback。
BACKEND_XIDIAN_PUBLIC_ORIGIN=https://zhixing.xidian.edu.cn

# 必填：管理员账号（生产环境必须修改默认密码）
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_OF_AT_LEAST_12_CHARACTERS
BACKEND_SEED_DEMO_DATA=false

# 可选：服务器持有的 OpenAI 兼容 AI 服务。若不启用，请让 BASE_URL 和 API_KEY 同时留空。
BACKEND_AI_BASE_URL=
BACKEND_AI_API_KEY=
BACKEND_AI_MODEL=gpt-4o-mini
BACKEND_AI_EMBEDDING_MODEL=

# 当前在线后端只支持 SQLite。PostgreSQL/MySQL 文件仅供离线迁移评估，
# 不能通过环境变量切换在线 Repository。
BACKEND_DB_FILE=/home/ubuntu/treehole/shared/data/treehole.db

# 必填：对象存储配置（local / s3 / oss）
BACKEND_OBJECT_STORAGE_BACKEND=local
BACKEND_STORAGE_DIR=/home/ubuntu/treehole/shared/storage/objects

# S3 兼容存储（如腾讯云COS、AWS S3、阿里云OSS等）
# BACKEND_S3_BUCKET=REPLACE_WITH_BUCKET
# BACKEND_S3_ENDPOINT=https://REPLACE_WITH_ENDPOINT
# BACKEND_S3_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# BACKEND_S3_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# BACKEND_S3_REGION=REPLACE_WITH_REGION

# 本地存储（仅开发/演示使用，生产不推荐）
# BACKEND_OBJECT_STORAGE_BACKEND=local
# BACKEND_STORAGE_DIR=/home/ubuntu/treehole/shared/storage/objects

# Web 构建产物路径（Flutter build web 输出目录）
BACKEND_WEB_ROOT=/home/ubuntu/treehole/current/web

# =============================================================================
# 安全配置（生产环境必须为 false）
# =============================================================================

BACKEND_ALLOW_DEBUG_VERIFY_CODE=false
BACKEND_INCLUDE_DEBUG_CODE=false

# =============================================================================
# 可选：运行参数
# =============================================================================

# BACKEND_LOG_LEVEL=INFO
# BACKEND_MAX_WORKERS=4
