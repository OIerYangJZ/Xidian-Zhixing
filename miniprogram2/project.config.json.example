{
  "miniprogramRoot": "./",
  "projectname": "xduwhisperbox-miniprogram",
  "description": "电台小程序",
  "appid": "wxxxxxxxxxxxxxxxx",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "postcss": true,
    "minified": true,
    "compileWorklet": false,
    "uglifyFileName": false,
    "uploadWithSourceMap": false,
    "enhance": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "minifyWXML": true,
    "localPlugins": false,
    "disableUseStrict": false,
    "useCompilerPlugins": false,
    "condition": false,
    "swc": false,
    "disableSWC": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "compileType": "miniprogram",
  "simulatorPluginLibVersion": {},
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "file",
        "value": "API_FREEZE.md"
      },
      {
        "type": "file",
        "value": "config/env.local.example.js"
      }
    ],
    "include": []
  },
  "editorSetting": {},
  "libVersion": "3.16.1"
}