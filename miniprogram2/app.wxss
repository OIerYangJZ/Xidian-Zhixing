@import "./styles/tokens.wxss";
@import "./styles/icons.wxss";
@import "./styles/surfaces.wxss";
@import "./styles/motion.wxss";
@import "./styles/section-tabs.wxss";

page {
  min-height: 100vh;
  background: var(--app-background);
  color: var(--app-text-primary);
  font-family: var(--font-body);
  font-size: 15px;
  letter-spacing: 0;
  overflow-wrap: anywhere;
}
view, text, input, textarea, button, picker, scroll-view { box-sizing: border-box; font-family: inherit; }
button { margin: 0; padding: 0; border-radius: 0; line-height: normal; }
button::after { border: 0; }
.page, .container { min-height: 100vh; background: var(--app-background); color: var(--app-text-primary); }
.theme-reference input, .theme-reference textarea { color:var(--app-text-primary); }
.input-placeholder, .textarea-placeholder, .anonymous-placeholder, .custom-tag-placeholder { color:var(--app-text-secondary); }
button { transition: transform .14s ease, opacity .14s ease, background-color .18s ease, color .18s ease; }
.button-hover, .tap-active { opacity: .72; transform: scale(.97); }
.primary-button, .secondary-button, .pill-button, .app-chip, .channel-chip, .sort-chip, .tag-chip,
.menu-item, .app-list-row, .mobile-tile { transition: transform .14s ease, opacity .14s ease, background-color .18s ease, border-color .18s ease, color .18s ease; }
.primary-button:active, .secondary-button:active, .pill-button:active, .app-chip:active,
.channel-chip:active, .sort-chip:active, .tag-chip:active, .menu-item:active,
.app-list-row:active, .mobile-tile:active { opacity: .78; transform: scale(.985); }
.safe-bottom { padding-bottom: calc(16px + env(safe-area-inset-bottom)); }
.empty, .loading-state, .empty-state, .no-more {
  padding: 32px 24px; font-size: 14px; line-height: 1.5;
  text-align: center; color: var(--app-text-secondary);
}
.primary-button {
  display: flex; align-items: center; justify-content: center;
  min-height: 44px; padding: 0 24px; border-radius: 24px;
  background: var(--app-primary); color: var(--app-on-primary);
  font-size: 15px; font-weight: 700;
}
.primary-button[disabled], .send-btn[disabled] { opacity: .45; }
.secondary-button, .pill-button {
  display: flex; align-items: center; justify-content: center;
  min-height: 36px; padding: 0 16px; border: 1px solid var(--app-divider);
  border-radius: 20px; background: var(--app-surface); color: var(--app-text-primary);
  font-size: 14px; font-weight: 700;
}
.app-input, .app-textarea {
  width: 100%; min-height: 44px; padding: 12px 16px; border: 1px solid var(--app-divider);
  border-radius: 8px; background: var(--app-surface); color: var(--app-text-primary); font-size: 16px;
}
.app-textarea { min-height: 120px; line-height: 1.5; }
.app-avatar, .seal-avatar, .nav-avatar { flex: 0 0 auto; border-radius: 50%; background: var(--app-control); color: var(--app-text-secondary); text-align: center; }
.nav-avatar-button { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: transparent; }
.nav-avatar { display: block; width: 32px; height: 32px; line-height: 32px; font-size: 15px; font-weight: 700; }
.seal-avatar { width: 44px; height: 44px; line-height: 44px; font-size: 18px; font-weight: 700; }
.seal-badge-solid, .seal-badge-hollow, .seal-badge-light {
  flex: 0 0 auto; padding: 2px 5px; border-radius: 4px;
  background: var(--app-primary-soft); color: var(--app-primary);
  font-size: 11px; font-weight: 500; line-height: 1.4;
}
.post-tools { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; color: var(--app-text-secondary); font-size: 13px; }
.app-badge, .badge, .header-badge { min-width: 18px; height: 18px; padding: 0 5px; border-radius: 10px; background: var(--app-primary); color: var(--app-on-primary); font-size: 11px; line-height: 18px; text-align: center; }
.badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--app-primary); }
.app-chip, .channel-chip, .sort-chip, .tag-chip {
  min-height: 32px; padding: 7px 14px; border-radius: 18px;
  background: var(--app-control); color: var(--app-text-secondary); font-size: 13px; line-height: 18px;
}
.app-chip.active, .channel-chip.active, .sort-chip.active, .tag-chip.active { background: var(--app-primary-soft); color: var(--app-primary); font-weight: 700; }
.menu-list, .app-list { background: var(--app-surface); }
.menu-item, .app-list-row { display: flex; align-items: center; justify-content: space-between; min-height: 52px; padding: 12px 16px; border-bottom: 1px solid var(--app-divider); }
.menu-text, .menu-title { color: var(--app-text-primary); font-size: 16px; }
.menu-arrow { color: var(--app-text-tertiary); font-size: 16px; }
.bottom-input-bar { position: fixed; inset: auto 0 0; z-index: 20; display: flex; align-items: center; gap: 8px; padding: 8px 16px calc(8px + env(safe-area-inset-bottom)); border-top: 1px solid var(--app-divider); background: var(--app-surface); }
.empty-state-container { max-width: 360px; margin: 0 auto; padding: 48px 32px; }
.empty-state-title { font-size: 26px; font-weight: 800; line-height: 1.2; color: var(--app-text-primary); }
.empty-state-desc { margin-top: 10px; font-size: 15px; line-height: 1.5; color: var(--app-text-secondary); }
.empty-state-btn { width: auto; margin-top: 24px; }

@keyframes app-page-enter {
  from { opacity: .72; }
  to { opacity: 1; }
}
@keyframes app-content-enter {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes app-indicator-enter {
  from { opacity: 0; transform: scaleX(.35); }
  to { opacity: 1; transform: scaleX(1); }
}
@media (prefers-reduced-motion: reduce) {
  .page { animation: none; }
  button, .primary-button, .secondary-button, .pill-button,
  .app-chip, .channel-chip, .sort-chip, .tag-chip, .menu-item, .app-list-row,
  .mobile-tile { transition: none; }
}
