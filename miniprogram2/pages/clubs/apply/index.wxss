.apply-page { padding: 28rpx 32rpx 80rpx; background: var(--app-background); }
.field-label { margin: 24rpx 0 10rpx; color: var(--app-text-primary); font-size: 13px; font-weight: 650; }
.submit-btn { margin-top: 30rpx; height: 82rpx; border-radius: 20rpx; background: var(--app-primary); color: var(--app-on-primary); font-size: 14.5px; line-height: 82rpx; }
.history-title { margin-top: 46rpx; color: var(--app-text-secondary); font-size: 12.5px; font-weight: 650; }
.history-row { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--app-divider); }
.history-name { color: var(--app-text-primary); font-size: 14px; font-weight: 650; }
.history-status { color: var(--app-primary); font-size: 12.5px; }

/* Approved reference layout. */
.page { padding:24rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.field-label { font-size:15px; margin:24rpx 0 12rpx; }
.submit-btn { min-height:44px; border-radius:26px; }
.history-row { border:0; border-bottom:1px solid var(--app-divider); border-radius:0; margin:0; padding:24rpx 0; }
