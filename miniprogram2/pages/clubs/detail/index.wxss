.club-detail { padding: 32rpx 0; background: var(--app-background); }
.club-title { color: var(--app-text-primary); font-size: 21px; font-weight: 750; line-height: 1.25; }
.club-title,
.club-owner,
.club-text,
.section-title { margin-left: 32rpx; margin-right: 32rpx; }
.club-owner { margin-top: 12rpx; color: var(--app-primary); font-size: 12.5px; font-weight: 650; }
.club-text { margin-top: 24rpx; color: var(--app-text-primary); font-size: 14.5px; line-height: 1.6; }
.section-title { margin-top: 36rpx; color: var(--app-text-secondary); font-size: 12.5px; font-weight: 650; }
.empty-posts { padding: 28rpx 0; color: var(--app-text-secondary); font-size: 13px; text-align: center; }

/* Approved reference layout. */
.page { padding:24rpx 36rpx; }
.club-title { font-size:20px; }
.club-owner { font-size:14px; color:var(--app-text-secondary); }
.club-text { font-size:17px; line-height:1.7; margin:24rpx 0; }
.section-title { border-top:1px solid var(--app-divider); padding-top:24rpx; font-size:17px; }
