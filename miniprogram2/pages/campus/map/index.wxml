<view class="{{pageMotion}} map-page {{themeClass}}">
  <view class="map-head">
    <view class="map-subtitle">南校区常用地点索引，导航由学校官方系统提供。</view>
    <button class="map-button" bindtap="openOfficialMap">打开学校导航系统</button>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载地图索引</view>
  <view wx:elif="{{errorMessage}}" class="loading-state">
    <view>{{errorMessage}}</view>
    <button bindtap="retryLoad">重新加载</button>
  </view>

  <block wx:else>
    <view class="map-group" wx:for="{{maps}}" wx:key="id">
      <view class="group-head">
        <view>
          <view class="group-title">{{item.name}}</view>
          <view class="group-subtitle">{{item.description}}</view>
        </view>
        <view class="group-status">{{item.status}}</view>
      </view>
      <view class="place-list">
        <view class="place-row" wx:for="{{item.items}}" wx:for-item="place" wx:key="name">
          <view class="place-main">
            <view class="place-name">{{place.name}}</view>
            <view class="place-location">{{place.location}}</view>
          </view>
          <view class="place-category">{{place.category}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
