@import "../../styles/campus-icons.wxss";

.campus-page { height:100vh; overflow:hidden; animation:none; --campus-study:#086f91; --campus-life:#147c68; --campus-affairs:#956019; --campus-tools:#6e51a1; --campus-exam:#936000; --campus-experiment:#7455a3; }
.campus-page.color-mode-dark { --campus-study:#72d4ed; --campus-life:#71d4b6; --campus-affairs:#e9c276; --campus-tools:#c5b1ed; --campus-exam:#f2c56b; --campus-experiment:#c5b1ed; }
/* Keep native button sizing inside this page's explicit layout slots. */
.campus-page button { min-width:0; max-width:100%; margin:0 !important; box-sizing:border-box; line-height:normal; }
.campus-customize-button { display:flex; align-items:center; justify-content:center; flex:0 0 36px; width:36px !important; max-width:36px; height:32px; padding:0; background:transparent; color:var(--app-text-primary); }
.campus-customize-button .ui-icon { width:21px; height:21px; }
.workbench-tabs { position:fixed; left:0; right:0; height:48px; z-index:55; display:flex; border-bottom:1px solid var(--app-divider); background:var(--app-background); }
.workbench-tab { flex:1 1 0%; width:0 !important; height:48px; display:flex; align-items:center; justify-content:center; padding:0; color:var(--app-text-secondary); background:transparent; font-size:15px; font-weight:600; }
.workbench-tab text { position:relative; display:flex; align-items:center; height:100%; }
.workbench-tab.active { color:var(--app-text-primary); }
.campus-scroll { position:fixed; left:0; right:0; width:100%; bottom:var(--tab-height); background:var(--app-background); }
.workbench-heading { display:flex; align-items:center; justify-content:space-between; padding:20px 20px 16px; }
.workbench-heading > view { flex:1; min-width:0; }
.date-heading { font-size:23px; font-weight:800; line-height:1.3; color:var(--app-text-primary); }
.date-caption { margin-top:6px; color:var(--app-text-secondary); font-size:12px; line-height:1.4; }
.heading-action, .section-icon-button { display:flex; align-items:center; justify-content:center; flex:0 0 40px; width:40px !important; max-width:40px; height:40px; padding:0; background:transparent; color:var(--app-text-secondary); }
.heading-action .ui-icon, .section-icon-button .ui-icon { width:21px; height:21px; }
.week-strip { display:flex; width:100%; padding:0 14px 12px; }
.week-slot { flex:1 1 0%; width:0; min-width:0; padding:0 2px; }
.week-day { width:100% !important; height:64px; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:6px 0; border-radius:8px; background:transparent; color:var(--app-text-secondary); }
.week-day.selected { background:var(--app-accent-soft); color:var(--app-accent); }
.weekday { font-size:11px; line-height:15px; }
.day-number { margin-top:4px; font-size:19px; line-height:24px; font-weight:700; }
.day-indicator { width:4px; height:4px; margin-top:4px; border-radius:50%; background:transparent; }
.day-indicator.has-schedule { background:currentColor; }
.next-schedule { margin:0 20px 8px; padding:4px 0 4px 15px; border-left:3px solid var(--campus-study); --schedule-color:var(--campus-study); }
.schedule-exam { --schedule-color:var(--campus-exam); border-left-color:var(--campus-exam); }
.schedule-experiment { --schedule-color:var(--campus-experiment); border-left-color:var(--campus-experiment); }
.schedule-course { --schedule-color:var(--campus-study); }
.next-label { display:flex; align-items:center; gap:7px; color:var(--schedule-color); font-size:12px; font-weight:600; }
.status-mark { width:6px; height:6px; border-radius:50%; background:currentColor; flex-shrink:0; }
.next-countdown { margin-left:auto; color:var(--app-text-secondary); font-size:11px; font-weight:400; }
.next-title { margin-top:12px; font-size:22px; line-height:1.35; font-weight:750; overflow-wrap:anywhere; }
.next-meta { display:flex; align-items:flex-start; gap:6px; margin-top:10px; color:var(--app-text-secondary); font-size:13px; line-height:1.5; }
.next-time { flex-shrink:0; }
.next-meta .ui-icon { width:16px; height:16px; flex:0 0 16px; margin:2px 0 0 8px; }
.next-location { min-width:0; overflow-wrap:anywhere; }
.schedule-progress { height:3px; margin-top:14px; background:var(--app-control); overflow:hidden; border-radius:3px; }
.progress-fill { height:100%; background:var(--schedule-color); transition:width .5s ease; }
.agenda-section { padding:18px 20px 20px; border-bottom:1px solid var(--app-divider); }
.section-heading { display:flex; align-items:center; justify-content:space-between; min-height:44px; margin-bottom:6px; font-size:17px; font-weight:750; }
.section-count { color:var(--app-text-secondary); font-size:12px; font-weight:400; }
.agenda-row { display:flex; gap:12px; min-height:93px; }
.agenda-time { display:flex; flex-direction:column; flex:0 0 46px; width:46px; padding-top:14px; font-size:14px; font-weight:650; color:var(--app-text-primary); }
.agenda-end { margin-top:5px; color:var(--app-text-secondary); font-size:11px; font-weight:400; }
.timeline-track { position:relative; flex:0 0 8px; }
.timeline-track::after { content:''; position:absolute; top:25px; bottom:-18px; left:3px; width:1px; background:var(--app-divider); }
.agenda-row:last-child .timeline-track::after { display:none; }
.timeline-dot { position:relative; z-index:1; width:7px; height:7px; margin-top:19px; border-radius:50%; background:var(--schedule-color); }
.agenda-body { flex:1; min-width:0; padding:10px 0 16px; }
.agenda-label { display:flex; align-items:center; gap:8px; font-size:11px; line-height:1.4; }
.source-label { color:var(--schedule-color); }
.current-label { color:var(--app-text-secondary); }
.agenda-title { margin-top:5px; font-size:15px; font-weight:650; line-height:1.4; overflow-wrap:anywhere; }
.agenda-meta { margin-top:5px; color:var(--app-text-secondary); font-size:12px; line-height:1.5; overflow-wrap:anywhere; }
.ended .timeline-dot { background:var(--app-text-tertiary); }
.ended .agenda-title { color:var(--app-text-secondary); }
.shortcuts-section { padding:12px 16px 0; border-top:1px solid var(--app-divider); border-bottom:1px solid var(--app-divider); }
.shortcuts-section .section-heading { padding:0 4px; }
.shortcut-grid { display:flex; flex-wrap:wrap; width:100%; padding:6px 0 4px; }
.shortcut-slot { flex:0 0 25%; width:25%; min-width:0; padding:0 2px 8px; }
.shortcut { width:100% !important; height:100px; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; padding:8px 2px; background:transparent; color:var(--app-text-primary); }
.shortcut-icon { display:flex; align-items:center; justify-content:center; flex:0 0 42px; width:42px; height:42px; border-radius:8px; background:var(--app-control); }
.shortcut-icon .ui-icon { width:24px; height:24px; }
.shortcut-name { display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; width:100%; max-height:34px; overflow:hidden; margin-top:8px; font-size:12px; font-weight:500; line-height:17px; text-align:center; overflow-wrap:anywhere; }
.shortcut-pressed { opacity:.6; transform:scale(.95); }
.tone-study { color:var(--campus-study); }
.tone-life { color:var(--campus-life); }
.tone-affairs { color:var(--campus-affairs); }
.tone-tools { color:var(--campus-tools); }
.all-services-link { display:flex; align-items:center; justify-content:center; gap:8px; width:100% !important; min-height:46px; border-top:1px solid var(--app-divider); background:transparent; color:var(--app-text-secondary); font-size:13px; }
.all-services-link .ui-icon { width:15px; height:15px; }
.connection-body { flex:1; min-width:0; font-size:14px; font-weight:650; }
.connection-caption { margin-top:5px; font-size:12px; font-weight:400; color:var(--app-text-secondary); line-height:1.5; }
.module-state { padding:24px 20px; }
.state-title { font-size:16px; font-weight:700; line-height:1.4; }
.state-copy { margin-top:8px; color:var(--app-text-secondary); font-size:13px; line-height:1.6; overflow-wrap:anywhere; }
.text-command { display:inline-flex; align-items:center; justify-content:center; width:auto !important; min-height:40px; padding:0; background:transparent; color:var(--app-accent); font-size:13px; font-weight:600; }
.empty-schedule { display:flex; align-items:center; gap:12px; padding:8px 20px 18px; }
.empty-schedule-copy { flex:1; min-width:0; }
.empty-schedule .state-title { font-size:14px; font-weight:600; }
.empty-schedule .state-copy { margin-top:4px; font-size:12px; line-height:1.5; }
.empty-schedule .text-command { flex-shrink:0; }
.shortcut-empty { padding:8px 4px 18px; font-size:13px; color:var(--app-text-secondary); }
.shortcut-empty .text-command { margin-left:12px !important; }
.directory-heading { display:flex; align-items:center; justify-content:space-between; padding:24px 20px 18px; }
.directory-count { color:var(--app-text-secondary); font-size:12px; }
.service-search { display:flex; align-items:center; gap:10px; min-height:44px; margin:0 16px 16px; padding:0 14px; border-radius:8px; background:var(--app-control); color:var(--app-text-secondary); }
.service-search .ui-icon { width:18px; height:18px; flex-shrink:0; }
.service-search input { height:44px; flex:1; min-width:0; background:transparent; color:var(--app-text-primary); font-size:14px; }
.search-clear { display:flex; align-items:center; justify-content:center; flex:0 0 28px; width:28px !important; max-width:28px; height:44px; padding:0; background:transparent; color:var(--app-text-secondary); }
.service-categories { white-space:nowrap; width:100%; border-bottom:1px solid var(--app-divider); }
.category-track { display:inline-flex; padding:0 12px; gap:6px; }
.category { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:auto !important; height:42px; min-width:52px; padding:0 12px; border-bottom:3px solid transparent; background:transparent; color:var(--app-text-secondary); font-size:13px; font-weight:600; }
.category.active { border-bottom-color:var(--app-accent); color:var(--app-text-primary); }
.service-row { display:flex; align-items:center; gap:14px; min-height:80px; padding:14px 20px; border-bottom:1px solid var(--app-divider); }
.service-icon { display:flex; align-items:center; justify-content:center; width:40px; height:40px; flex:0 0 40px; border-radius:8px; background:var(--app-control); }
.service-icon .ui-icon { width:22px; height:22px; }
.service-info { flex:1; min-width:0; }
.service-name { font-size:15px; font-weight:650; line-height:1.4; overflow-wrap:anywhere; }
.service-caption { margin-top:4px; color:var(--app-text-secondary); font-size:12px; line-height:1.5; }
.service-arrow { width:18px; height:18px; flex-shrink:0; color:var(--app-text-secondary); }
.limited .service-icon { color:var(--app-text-secondary); }
.workbench-bottom { height:24px; }
.campus-loading { padding:16px 20px 24px; }
.skeleton { height:16px; border-radius:4px; background:var(--app-control); margin-bottom:12px; animation:campus-pulse 1.2s ease-in-out infinite; }
.skeleton-heading { width:60%; height:24px; }
.skeleton-line { width:88%; }
.skeleton-line.short { width:48%; }
.customizer-layer { position:fixed; inset:0; z-index:1200; }
.customizer-mask { position:absolute; inset:0; background:var(--app-scrim); }
.customizer-sheet { position:absolute; left:0; right:0; top:12%; bottom:0; display:flex; flex-direction:column; background:var(--app-background); border-radius:8px 8px 0 0; animation:customizer-in .28s cubic-bezier(.2,.72,.24,1) both; }
.customizer-header { display:flex; align-items:center; justify-content:space-between; flex-shrink:0; min-height:56px; padding:0 16px 0 20px; border-bottom:1px solid var(--app-divider); font-size:19px; font-weight:750; }
.editor-close { display:flex; align-items:center; justify-content:center; flex:0 0 40px; width:40px !important; max-width:40px; height:44px; padding:0; background:transparent; color:var(--app-text-primary); }
.editor-close .ui-icon { width:22px; height:22px; }
.customizer-scroll { flex:1; min-height:0; height:0; }
.editor-section-heading { display:flex; align-items:center; justify-content:space-between; padding:20px 20px 12px; font-size:15px; font-weight:700; }
.editor-count { color:var(--app-text-secondary); font-size:12px; font-weight:400; }
.editor-order-row { display:flex; align-items:center; gap:10px; min-height:52px; padding:0 16px 0 20px; border-bottom:1px solid var(--app-divider); }
.editor-order-row > .ui-icon { width:19px; height:19px; flex-shrink:0; }
.editor-service-name { flex:1; min-width:0; font-size:14px; line-height:1.4; overflow-wrap:anywhere; }
.order-button { display:flex; align-items:center; justify-content:center; width:32px !important; max-width:32px; height:44px; flex:0 0 32px; padding:0; background:transparent; color:var(--app-text-secondary); }
.order-button .ui-icon { width:17px; height:17px; }
.order-button[disabled] { opacity:.3; }
.down { transform:rotate(180deg); }
.editor-empty { padding:0 20px 12px; color:var(--app-text-secondary); font-size:13px; }
.editor-service-grid { display:flex; flex-wrap:wrap; width:100%; padding:0 16px 8px; }
.editor-service-slot { display:flex; flex:0 0 50%; width:50%; min-width:0; padding:0 4px 8px; }
.editor-service { width:100% !important; display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:44px; padding:10px 12px; border:1px solid var(--app-divider); border-radius:8px; background:transparent; color:var(--app-text-secondary); font-size:12px; text-align:left; }
.editor-service text { flex:1; min-width:0; overflow-wrap:anywhere; line-height:1.5; }
.editor-service .ui-icon { width:15px; height:15px; flex-shrink:0; }
.editor-service.selected { border-color:var(--app-accent); background:var(--app-accent-soft); color:var(--app-text-primary); }
.preference-row { display:flex; align-items:center; justify-content:space-between; min-height:62px; margin:0 20px; border-bottom:1px solid var(--app-divider); gap:12px; font-size:14px; }
.customizer-footer { display:flex; gap:12px; flex-shrink:0; padding:12px 20px calc(16px + env(safe-area-inset-bottom)); border-top:1px solid var(--app-divider); }
.reset-button { display:flex; align-items:center; justify-content:center; width:44px !important; max-width:44px; height:44px; flex:0 0 44px; border:1px solid var(--app-divider); border-radius:8px; background:transparent; color:var(--app-text-secondary); }
.reset-button .ui-icon { width:20px; height:20px; }
.save-layout { display:flex; align-items:center; justify-content:center; flex:1 1 0%; width:0 !important; height:44px; border-radius:8px; background:var(--app-primary); color:var(--app-on-primary); font-size:15px; font-weight:700; }
.compact .workbench-heading, .compact .directory-heading { padding-top:16px; padding-bottom:12px; }
.compact .week-day { height:58px; }
.compact .agenda-row { min-height:76px; }
.compact .agenda-body { padding-bottom:10px; }
.compact .shortcut { height:94px; }
.compact .shortcut-name { margin-top:6px; max-height:30px; line-height:15px; }
.compact .service-row { min-height:68px; padding-top:10px; padding-bottom:10px; }
@keyframes campus-pulse { 0%,100% { opacity:.6; } 50% { opacity:1; } }
@keyframes customizer-in { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
@media (prefers-reduced-motion:reduce) { .skeleton, .customizer-sheet, .workbench-view { animation:none; } .progress-fill { transition:none; } }
