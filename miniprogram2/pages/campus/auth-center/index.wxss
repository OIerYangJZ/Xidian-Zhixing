@import "../../../styles/settings.wxss";
.connection-record { padding-top:16px; }
.connection-form { padding-top:0; }
.captcha-row { display:flex; gap:10px; align-items:center; }
.captcha-row .settings-input { flex:1; min-width:0; width:0; }
.captcha-button, .sms-button { display:flex; flex:0 0 116px; width:116px !important; min-width:0; height:46px; align-items:center; justify-content:center; padding:0 8px; border:1px solid var(--app-divider); border-radius:8px; background:var(--app-control); color:var(--settings-link); font-size:12px; line-height:1.3; }
.captcha-button { padding:0; overflow:hidden; }
.captcha-image { display:block; width:116px; height:44px; background:#ffffff; }
.password-field { display:flex; border:1px solid var(--app-divider); border-radius:8px; align-items:center; background:var(--app-control); }
.password-field .settings-input { flex:1; width:0; border:0; background:transparent; }
.password-field .settings-icon-button { margin-right:6px !important; }
.connection-clear { padding:0 20px; }
.connection-clear .settings-text-button { color:var(--app-text-secondary); }
.connection-retry { color:var(--settings-link); }
