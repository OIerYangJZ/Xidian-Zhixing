@keyframes create-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.reply-permission { display:flex; align-items:center; gap:8px; min-height:40px; width:100%; padding:8px 16px; background:transparent; color:var(--app-accent); text-align:left; font-size:13px; font-weight:600; }
.reply-permission .ui-icon { width:17px; height:17px; }
.toolbar-icon-button { margin:0; padding:0; border:0; background:transparent; }
.toolbar-icon-button[disabled] { background:transparent; color:var(--app-text-tertiary); }
.keyboard-open .toolbar-row { padding-bottom:4px; }
.setting-row, .setting-link { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:48px; width:100%; padding:8px 0; background:transparent; color:var(--app-text-primary); font-size:14px; border-bottom:1px solid var(--app-divider); }
.setting-link text { color:var(--app-text-secondary); }
.sheet-close { display:flex; align-items:center; justify-content:center; flex:0 0 40px; width:40px !important; min-width:40px; max-width:40px; height:40px; margin:0 !important; background:transparent; color:var(--app-text-primary); }
