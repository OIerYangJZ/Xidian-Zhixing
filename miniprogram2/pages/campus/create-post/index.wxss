.create-page { position:fixed; inset:0; height:100%; min-height:0; padding:0; overflow:hidden; background:var(--app-surface); color:var(--app-text-primary); }
.create-appbar { position:absolute; top:0; right:0; left:0; z-index:60; display:flex; align-items:center; justify-content:space-between; padding-left:4px; padding-bottom:8px; box-sizing:border-box; background:var(--app-surface); }
.appbar-icon-button { display: flex; align-items: center; justify-content: center; flex: 0 0 48px; width: 48px; height: 36px; }
.content-counter { flex-shrink:0; padding:0 12px; color:var(--app-text-secondary); font-size:12px; white-space:nowrap; }
.content-counter.error { color: var(--app-error); }
.publish-button { display:flex; align-items:center; justify-content:center; flex:0 0 68px; width:68px; height:32px; min-width:68px; max-width:68px; padding:0; margin:0 8px 0 0; border-radius:18px; background:var(--app-accent); color:#ffffff; font-size:14px; font-weight:700; }
.publish-button[disabled] { background:var(--app-accent); color:#ffffff; opacity:.4; }
.publish-button { width:68px !important; margin:0 8px 0 0 !important; }
.create-content { position:absolute; left:0; width:100%; padding:0 16px; background:var(--app-surface); }
.composer-shell { display:flex; align-items:flex-start; gap:12px; padding:16px 0 32px; }
.composer-main { flex: 1; min-width: 0; }
.composer-identity { display: inline-flex; align-items: center; gap: 3px; min-height: 28px; padding: 0 10px; margin-bottom: 4px; border: 1px solid var(--app-accent); border-radius: 16px; color: var(--app-accent); font-size: 13px; font-weight: 700; }
.composer-identity .ui-icon { width: 14px; height: 14px; transform: rotate(90deg); }
.composer-avatar { display: flex; align-items: center; justify-content: center; width: 42px; height: 42px; flex: 0 0 42px; overflow: hidden; border-radius: 50%; background: var(--app-control); color: var(--app-text-secondary); font-size: 18px; font-weight: 700; }
.composer-avatar image { width: 100%; height: 100%; }
.compact-selector { margin-left: 0; }
.compact-selector-row { display: flex; align-items: center; gap: 8px; min-height: 38px; }
.compact-selector-label { font-size: 12px; color: var(--app-text-secondary); }
.compact-selector-pill { padding: 3px 12px; max-width: calc(100% - 70px); border: 1px solid var(--app-divider); border-radius: 16px; font-size: 13px; font-weight: 600; color: var(--app-accent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selector-arrow { font-size: 16px; color: var(--app-accent); }
.selector-chip-wrap, .tag-option-wrap { display: flex; flex-wrap: wrap; gap: 8px; padding: 8px 0; }
.section-rule-tip { padding: 8px 0; font-size: 13px; line-height: 1.5; color: var(--app-text-secondary); }
.create-divider { height: 8px; }
.title-input { width: 100%; height: 40px; border: 0; background: transparent; font-size: 17px; color: var(--app-text-primary); }
.input-placeholder { font-size: 17px; color: var(--app-text-secondary); }
.content-editor { position: relative; min-height: 250px; }
.content-input { width:100%; min-height:180px; padding:14px 0 20px; border:0; background:transparent; font-size:20px; line-height:30px; color:var(--app-text-primary); overflow-wrap:anywhere; white-space:pre-wrap; }
.textarea-placeholder { font-size: 20px; color: var(--app-text-secondary); }
.inline-tag { color: var(--app-accent); }
.anonymous-row { display: flex; align-items: center; min-height: 40px; color: var(--app-text-secondary); }
.anonymous-input { flex: 1; min-width: 0; border: 0; background: transparent; font-size: 14px; color: var(--app-text-primary); }
.status-badge-row { display: flex; margin-bottom: 12px; }
.status-badge { padding: 3px 8px; border-radius: 4px; background: var(--app-control); color: var(--app-text-secondary); font-size: 12px; }
.status-badge.resolved { color: var(--app-success); }
.image-preview-list { width: 100%; height: 160px; margin: 12px 0; white-space: nowrap; }
.image-preview-strip { display: inline-flex; gap: 8px; height: 160px; }
.image-preview-cell, .image-preview-add { position:relative; width:180px; height:160px; overflow:hidden; border-radius:8px; background:var(--app-control); }
.image-preview-cell image { width: 100%; height: 100%; }
.image-preview-add { display: flex; align-items: center; justify-content: center; width: 72px; color: var(--app-accent); }
.image-loading { position: absolute; bottom: 0; left: 0; right: 0; padding: 8px; background: rgba(0,0,0,.6); color: #ffffff; font-size: 12px; text-align: center; }
.image-remove { position: absolute; top: 6px; right: 6px; display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: rgba(0,0,0,.7); color: #ffffff; }
.image-remove .ui-icon { width: 18px; height: 18px; }
.bottom-editor-bar { position:absolute; right:0; bottom:0; left:0; z-index:50; background:var(--app-surface); }
.inline-selector-area { max-height:42vh; overflow-y:auto; padding:16px; border-top:1px solid var(--app-divider); border-bottom:1px solid var(--app-divider); background:var(--app-surface); }
.status-selector { display: flex; flex-wrap: wrap; gap: 8px; }
.selector-head, .selector-actions { display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 14px; }
.selector-done { color: var(--app-accent); }
.selector-close { font-size: 22px; }
.pill-chip, .option-pill { display: flex; align-items: center; min-height: 34px; padding: 6px 12px; border: 1px solid var(--app-divider); border-radius: 18px; font-size: 13px; }
.pill-chip.active, .option-pill.active { border-color: var(--app-accent); background: var(--app-accent-soft); color: var(--app-accent); }
.custom-tag-row { display: flex; align-items: center; gap: 12px; margin-top: 8px; }
.custom-tag-input { flex: 1; min-width: 0; height: 40px; padding: 0 12px; border: 1px solid var(--app-divider); border-radius: 8px; color: var(--app-text-primary); font-size: 14px; }
.custom-tag-add { padding: 12px 0; color: var(--app-accent); font-size: 14px; }
.pin-selector-title { display: flex; align-items: center; font-size: 14px; }
.visibility-selector { width: 100%; }
.visibility-item { display: flex; align-items: center; gap: 8px; min-height: 44px; font-size: 14px; }
.visibility-item.active { color: var(--app-accent); }
.visibility-check { margin-left: auto; }
.upload-row { display: flex; align-items: center; gap: 10px; padding: 8px 16px; font-size: 13px; color: var(--app-text-secondary); }
.upload-spinner { width: 14px; height: 14px; border: 2px solid var(--app-divider); border-top-color: var(--app-accent); border-radius: 50%; animation: create-spin .8s linear infinite; }
.toolbar-row { display:flex; align-items:center; min-height:52px; border-top:1px solid var(--app-divider); padding:4px 8px calc(4px + env(safe-area-inset-bottom)); }
.toolbar-icon-button, .visibility-trigger { display: flex; align-items: center; justify-content: center; width: 42px; height: 44px; flex: 0 0 42px; color: var(--app-accent); }
.toolbar-icon-button.active { background: var(--app-accent-soft); border-radius: 50%; }
.toolbar-spacer { flex: 1; }
.visibility-arrow { font-size: 12px; }
.image-outline-icon,
.tag-icon,
.status-toolbar-icon,
.status-option-icon,
.eye-off-icon,
.pin-icon,
.visibility-icon {
  width: 44rpx;
  height: 44rpx;
  background-color: currentColor;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
}

