.search-page { height: 100vh; overflow: hidden; padding-bottom: 0; }
.type-row { position: fixed; left: 0; right: 0; z-index: 55; display: flex; height: 48px; border-bottom: 1px solid var(--app-divider); background: var(--app-translucent-surface); }
.search-results { position: fixed; left: 0; right: 0; bottom: 0; width: 100%; background: var(--app-background); }
.search-results ::-webkit-scrollbar { display: none; width: 0; height: 0; }
.type-chip { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; height: 48px; color: var(--app-text-secondary); font-size: 15px; font-weight: 500; }
.type-chip.active { font-weight: 700; color: var(--app-text-primary); }
.type-chip.active::after { content: ''; position: absolute; bottom: 0; width: 40px; height: 4px; background: var(--app-accent); border-radius: 4px; }
.sort-row { display: flex; gap: 8px; padding: 12px 16px; }
.history { padding: 16px; border-bottom: 1px solid var(--app-divider); }
.section-head { display: flex; align-items: center; justify-content: space-between; }
.section-title, .hot-title { font-size: 20px; font-weight: 800; }
.clear, .hot-summary-btn { min-height: 36px; display: flex; align-items: center; color: var(--app-accent); font-size: 13px; }
.history-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.history-tag { padding: 7px 14px; border: 1px solid var(--app-divider); border-radius: 20px; font-size: 14px; overflow-wrap: anywhere; }
.hot-tools { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px 4px; }
.hot-row { display: flex; gap: 12px; padding: 14px 16px; }
.hot-rank { flex: 0 0 18px; padding-top: 2px; color: var(--app-text-secondary); font-size: 13px; }
.hot-body { flex: 1; min-width: 0; }
.hot-name { font-size: 16px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.hot-summary, .hot-meta { margin-top: 4px; color: var(--app-text-secondary); font-size: 13px; line-height: 1.5; }
.hot-summary { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hot-summary-card { margin: 0; padding: 16px; border-block: 1px solid var(--app-divider); font-size: 14px; line-height: 1.6; background: var(--app-control); }
.user-card { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--app-divider); }
.user-avatar { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: 0 0 40px; overflow: hidden; border-radius: 50%; background: var(--app-control); font-size: 18px; font-weight: 700; }
.user-avatar image { width: 100%; height: 100%; }
.user-main { flex: 1; min-width: 0; }
.user-name { font-size: 15px; font-weight: 700; overflow-wrap: anywhere; }
.user-bio { margin-top: 4px; font-size: 14px; line-height: 1.5; color: var(--app-text-secondary); overflow-wrap: anywhere; }
.user-action { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; color: var(--app-text-secondary); }
