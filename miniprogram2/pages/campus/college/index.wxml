<view class="{{pageMotion}} page college-page safe-bottom {{themeClass}}">
  <scroll-view class="college-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="college-row">
      <view
        wx:for="{{colleges}}"
        wx:key="*this"
        class="college-chip {{activeCollege === item ? 'active' : ''}}"
        data-name="{{item}}"
        bindtap="onCollegeTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view class="college-card">
    <view class="college-name">{{activeCollege}}</view>
    <view class="college-actions">
      <view class="secondary-button" bindtap="searchCollege">搜索内容</view>
      <view class="secondary-button" bindtap="askCollege">问 AI</view>
    </view>
  </view>

  <view class="section-title">相关讨论</view>
  <status-view wx:if="{{loading}}" mode="loading" text="加载中..." />
  <status-view wx:elif="{{errorMessage}}" mode="error" text="{{errorMessage}}" show-retry="true" bind:retry="retryLoad" />
  <status-view wx:elif="{{!posts.length}}" mode="empty" text="暂无相关讨论" />
  <view wx:else>
    <post-row
      wx:for="{{posts}}"
      wx:key="id"
      item="{{item}}"
      index="{{index}}"
      bind:open="goPostDetail"
      bind:like="togglePostLike"
      bind:favorite="togglePostFavorite"
    />
  </view>
</view>
