.report-page {
  padding: 24rpx;
}

.section {
  margin-bottom: 22rpx;
  border-radius: 16rpx;
  background: var(--app-surface);
  overflow: hidden;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 14px;
  align-items: center;
}

.row:last-child {
  border-bottom: none;
}

.row text:last-child {
  color: var(--app-text-secondary);
  text-align: right;
}

.block-title {
  padding: 24rpx 24rpx 8rpx;
  color: var(--app-text-primary);
  font-size: 15px;
  font-weight: 700;
}

.block-text {
  padding: 0 24rpx 24rpx;
  color: var(--app-text-secondary);
  font-size: 13.5px;
  line-height: 1.6;
}

.primary-button {
  height: 82rpx;
  border-radius: 14rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-size: 14.5px;
  line-height: 82rpx;
}

/* Approved reference layout. */
.report-page { padding:0 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.section { margin:0; padding:28rpx 0; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.row { min-height:104rpx; gap:20rpx; font-size:15px; }
.block-title { font-size:17px; }
.block-text { font-size:16px; line-height:1.7; }
.section { background:transparent; }
.row { padding:12px 0; align-items:flex-start; }
.row text:first-child { flex:0 0 72px; }
.row text:last-child { flex:1; min-width:0; overflow-wrap:anywhere; }
.block-text { overflow-wrap:anywhere; }
