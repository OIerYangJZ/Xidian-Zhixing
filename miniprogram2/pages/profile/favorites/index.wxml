<view class="{{pageMotion}} page favorite-page {{themeClass}}">
  <status-view wx:if="{{loading}}" mode="loading" text="加载中..." />
  <status-view wx:elif="{{errorMessage}}" mode="error" text="{{errorMessage}}" show-retry="true" bind:retry="retryLoad" />
  <status-view wx:elif="{{!posts.length}}" mode="empty" text="暂无收藏" />
  <view wx:else>
    <view class="favorite-item" wx:for="{{posts}}" wx:key="id">
      <post-row
        item="{{item}}"
        index="{{index}}"
        bind:open="goPostDetail"
        bind:like="togglePostLike"
        bind:favorite="removeFavorite"
      />
      <view class="post-tools">
        <text class="remove" data-index="{{index}}" catchtap="removeFavorite">取消收藏</text>
      </view>
    </view>
  </view>
</view>
