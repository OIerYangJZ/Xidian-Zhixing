.user-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.avatar {
  width: 82rpx;
  height: 82rpx;
  border-radius: 20rpx;
  background: var(--app-control);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-primary);
  font-size: 15px;
  font-weight: 700;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar.fallback {
  background: var(--app-primary-soft);
}

.user-body {
  flex: 1;
  min-width: 0;
}

.name {
  color: var(--app-text-primary);
  font-size: 15px;
  font-weight: 700;
}

.bio {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 12.5px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-button {
  width: 108rpx;
  height: 60rpx;
  border-radius: 12rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 13px;
  line-height: 60rpx;
}

/* Approved reference layout. */
.page { padding:0 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.user-row { padding:28rpx 0; min-height:132rpx; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; margin:0; }
.avatar { border-radius:50%; width:88rpx; height:88rpx; }
.name { font-size:17px; }
.bio { font-size:14px; line-height:1.5; }
.message-button, .unblock-button { min-height:44px; border-radius:26px; border:1px solid var(--app-divider); background:transparent; color:var(--app-text-primary); }
.avatar { flex:0 0 40px; width:40px; height:40px; }
.message-button { display:flex; align-items:center; justify-content:center; flex:0 0 60px; width:60px !important; max-width:60px; margin:0 !important; line-height:1.4; }
.name { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
