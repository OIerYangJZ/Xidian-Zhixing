@import "../../../styles/settings.wxss";
.account-profile { padding-top:8px; }
.account-summary { padding-bottom:18px; }
.account-summary .settings-text-button { flex:0 0 auto; max-width:35%; }
.request-actions { display:flex; gap:12px; margin-top:14px; }
.request-actions .settings-button { flex:1 1 0%; width:0 !important; }
.request-textarea { min-height:110px; height:110px; }
.request-record { padding:12px 0; border-bottom:1px solid var(--app-divider); }
.request-record:last-child { border:0; }
.request-heading { display:flex; gap:12px; justify-content:space-between; align-items:center; }
.request-heading .settings-title { flex:1; min-width:0; }
.request-note { margin-top:8px; font-size:13px; line-height:1.7; color:var(--app-text-secondary); overflow-wrap:anywhere; }
.account-danger { margin-top:8px !important; color:var(--app-error); }

.identity-field { display:block; padding:14px 0; }
.identity-field .settings-title { font-size:12px; color:var(--app-text-secondary); font-weight:400; }
.identity-field .settings-value { display:block; max-width:none; text-align:left; color:var(--app-text-primary); margin-top:5px; font-size:14px; }
