.public-page { padding-bottom: env(safe-area-inset-bottom); }
.profile-head { position: relative; padding: 0 16px 12px; }
.cover-wrap { height: 128px; margin: 0 -16px; background: var(--app-control); }
.cover { display: block; width: 100%; height: 128px; }
.avatar { position: relative; display: flex; align-items: center; justify-content: center; width: 84px; height: 84px; margin-top: -34px; border: 4px solid var(--app-surface); border-radius: 50%; background: var(--app-control); overflow: hidden; font-size: 28px; font-weight: 700; color: var(--app-text-secondary); }
.avatar image { width: 100%; height: 100%; }
.name { margin-top: 10px; font-size: 22px; font-weight: 800; line-height: 1.3; overflow-wrap: anywhere; }
.school-meta { margin-top: 6px; color: var(--app-text-secondary); font-size: 14px; line-height: 1.5; }
.bio { margin-top: 10px; font-size: 15px; line-height: 1.5; overflow-wrap: anywhere; }
.stats { display: flex; gap: 20px; margin-top: 14px; font-size: 14px; color: var(--app-text-secondary); }
.actions { display: flex; gap: 10px; padding: 0 16px 16px; }
.primary, .secondary { display: flex; align-items: center; justify-content: center; min-height: 34px; padding: 0 20px; border: 1px solid var(--app-text-tertiary); border-radius: 20px; font-size: 14px; font-weight: 700; }
.primary { background: var(--app-primary); color: var(--app-on-primary); }
.secondary { background: var(--app-surface); color: var(--app-text-primary); }
.actions .primary, .actions .secondary { flex:1 1 0; width:0 !important; min-width:0; margin:0 !important; min-height:40px; }
.section-title { position: relative; display: flex; align-items: center; justify-content: center; height: 48px; border-bottom: 1px solid var(--app-divider); font-size: 15px; font-weight: 700; }
.section-title::after { content: ''; position: absolute; bottom: 0; width: 60px; height: 4px; background: var(--app-accent); border-radius: 4px; }
.empty-small { padding: 40px 16px; text-align: center; color: var(--app-text-secondary); font-size: 14px; }
