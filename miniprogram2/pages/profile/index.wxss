.profile-page { min-height: 100vh; padding: 0 0 env(safe-area-inset-bottom); background: var(--app-background); animation:none; }
.ios-nav { position: fixed; top: 0; right: 0; left: 0; z-index: 60; display: flex; align-items: center; gap: 12px; padding-bottom: 8px; background: var(--app-translucent-surface); }
.profile-back-button { display: flex; align-items: center; justify-content: center; width: 48px; height: 36px; flex: 0 0 48px; transition:transform .14s ease, opacity .14s ease; }
.profile-back-button:active { opacity:.65; transform:scale(.88); }
.nav-title { flex: 1; min-width: 0; }
.nav-name { font-size: 19px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.nav-subtitle { margin-top: 1px; color: var(--app-text-secondary); font-size: 12px; line-height: 1.2; }
.profile-header { background:var(--app-surface); }
.profile-background { position: relative; width:100%; height:250rpx; min-height:120px; overflow: hidden; background: var(--app-card); border-bottom:1px solid var(--app-divider); }
.profile-cover-empty { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:8px; color:var(--app-text-secondary); font-size:13px; }
.profile-cover-empty .ui-icon { width:18px; height:18px; }
.profile-background-image { display: block; width: 100%; height: 100%; }
.profile-background-overlay { display: none; }
.profile-background.has-image .profile-background-overlay { display:block; position:absolute; inset:0; background:linear-gradient(to bottom,rgba(0,0,0,.5),rgba(0,0,0,.15) 45%,transparent 75%); pointer-events:none; }
.ios-nav.over-cover { background:transparent; color:#ffffff; }
.ios-nav.over-cover .nav-subtitle { color:rgba(255,255,255,.85); }
.ios-nav.over-cover .nav-name, .ios-nav.over-cover .nav-subtitle { text-shadow:0 1px 3px rgba(0,0,0,.35); }
.profile-avatar-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; min-height: 60px; padding: 0 16px; }
.profile-avatar-wrap { position: relative; width: 84px; height: 84px; margin-top: -34px; flex: 0 0 84px; border: 4px solid var(--app-surface); border-radius: 50%; overflow: hidden; background: var(--app-control); }
.profile-avatar { display: block; width: 76px; height: 76px; border-radius: 50%; background: var(--app-control); color: var(--app-text-secondary); font-size: 28px; font-weight: 700; line-height: 76px; text-align: center; }
.profile-actions { display: flex; align-items: center; gap: 8px; padding-top: 10px; }
.profile-pill-button, .profile-icon-button { display: flex; align-items: center; justify-content: center; height: 34px; border: 1px solid var(--app-divider); border-radius: 20px; background:var(--app-card); font-size: 13px; font-weight: 700; transition:transform .14s ease, opacity .14s ease, background-color .18s ease; }
.profile-pill-button:active, .profile-icon-button:active { transform:scale(.94); opacity:.7; }
.profile-pill-button { padding: 0 16px; }
.profile-icon-button { width: 34px; }
.profile-icon-button .ui-icon { width: 18px; height: 18px; }
.profile-info { padding: 0 16px 12px; }
.profile-name { font-size: 22px; font-weight: 800; line-height: 1.3; overflow-wrap: anywhere; }
.profile-bio { margin-top: 10px; font-size: 15px; line-height: 1.5; overflow-wrap: anywhere; }
.profile-school-meta, .profile-gender { display: flex; align-items: center; gap: 6px; margin-top: 6px; color: var(--app-text-secondary); font-size: 14px; line-height: 1.4; }
.profile-stats { display: flex; align-items: center; gap: 18px; margin-top: 12px; }
.profile-stat { display: flex; align-items: center; gap: 5px; min-height: 28px; font-size: 14px; }
.profile-stat-value { font-weight: 700; }
.profile-stat-label { color: var(--app-text-secondary); }
.profile-level { margin-left: auto; padding: 3px 6px; border-radius: 4px; font-size: 11px; }
.profile-divider { height:1px; border:0; background:var(--app-divider); }
.profile-tabs { position:relative; display: flex; height: 48px; border-bottom: 1px solid var(--app-divider); }
.profile-tab { position: relative; flex: 1; display: flex; align-items: center; justify-content: center; height: 48px; font-size: 15px; color: var(--app-text-secondary); transition:color .18s ease, opacity .14s ease, transform .14s ease; }
.profile-tab.active { font-weight: 700; color: var(--app-text-primary); }
.profile-tab-body { min-height: 40vh; background:var(--app-background); }
.profile-feed, .activity-list { background:var(--app-surface); }
.profile-loading, .profile-empty { padding: 40px 16px; color: var(--app-text-secondary); text-align: center; font-size: 14px; }
.activity-item { padding: 16px; border-bottom: 1px solid var(--app-divider); background:var(--app-surface); }
.activity-item { transition:background-color .18s ease, opacity .14s ease; }
.activity-item:active { opacity:.72; background:var(--app-control); }
@media (prefers-reduced-motion: reduce) { .profile-pill-button, .profile-icon-button, .profile-tab, .activity-item { transition:none; } }
.activity-post { color: var(--app-text-secondary); font-size: 13px; overflow-wrap: anywhere; }
.activity-content { margin-top: 6px; font-size: 15px; line-height: 1.5; overflow-wrap: anywhere; }
.activity-time { margin-top: 8px; color: var(--app-text-secondary); font-size: 12px; }
.follow-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: var(--app-scrim);
}

.follow-sheet {
  width: 100%;
  max-height: 78vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 32rpx 32rpx 0 0;
  background: var(--app-card);
  overflow: hidden;
}

.follow-sheet-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 20rpx auto;
  border-radius: 4rpx;
  background: var(--app-divider);
}

.follow-sheet-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 24rpx;
}

.follow-sheet-title {
  color: var(--app-text-primary);
  font-size: 17px;
  font-weight: 600;
}

.follow-sheet-count {
  color: var(--app-text-secondary);
  font-size: 14px;
}

.follow-sheet-divider {
  height: 1rpx;
  background: var(--app-divider);
}

.follow-sheet-list {
  max-height: calc(78vh - 100px - env(safe-area-inset-bottom));
}
.follow-layer { position:fixed; inset:0; z-index:100; display:flex; align-items:flex-end; }
.follow-layer .follow-sheet-mask { position:absolute; z-index:0; }
.follow-layer .follow-sheet { position:relative; z-index:1; }
.follow-sheet-close { display:flex; align-items:center; justify-content:center; flex:0 0 40px; width:40px !important; height:40px; margin:0 0 0 auto !important; background:transparent; color:var(--app-text-primary); }

.follow-sheet-empty {
  padding: 96rpx 32rpx;
  color: var(--app-text-tertiary);
  font-size: 14px;
  text-align: center;
}

.follow-sheet-section {
  padding: 24rpx 32rpx 8rpx;
  color: var(--app-text-secondary);
  font-size: 12px;
  font-weight: 600;
}

.follow-user-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 32rpx;
  transition:background-color .18s ease, opacity .14s ease;
}
.follow-user-row:active { opacity:.72; background:var(--app-control); }

.follow-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 15px;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

.follow-avatar-text {
  display: block;
}

.follow-name {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: var(--app-text-primary);
  font-size: 15px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-mutual-badge {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 50%;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 12px;
  font-weight: 600;
  line-height: 40rpx;
}
