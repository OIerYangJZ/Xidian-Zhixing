@import "../../../styles/settings.wxss";
.settings-account { display:flex; align-items:center; gap:14px; min-height:104px; padding:24px 20px; border-bottom:1px solid var(--app-divider); }
.account-name { font-size:18px; font-weight:700; line-height:1.4; overflow-wrap:anywhere; }
.account-state { display:flex; align-items:center; gap:12px; padding:4px 20px; font-size:12px; color:var(--app-text-secondary); }
.appearance-options { display:flex; margin:14px -4px 0; }
.appearance-slot { flex:1 1 0%; min-width:0; width:0; padding:0 4px; }
.appearance-option { display:flex; flex-direction:column; align-items:center; width:100% !important; padding:0; background:transparent; color:var(--app-text-secondary); border-radius:8px; }
.appearance-preview { position:relative; width:100%; height:62px; padding:12px; border:1px solid var(--app-divider); border-radius:8px; box-sizing:border-box; overflow:hidden; }
.preview-light { background:#ffffff; --preview-line:#d9e1e6; --preview-control:#eff3f4; }
.preview-dark { background:#000000; --preview-line:#2f3336; --preview-control:#16181c; }
.preview-system { background:var(--app-control); --preview-line:var(--app-text-tertiary); --preview-control:var(--app-divider); }
.preview-system::before { content:''; position:absolute; right:0; top:0; bottom:0; width:50%; background:var(--app-surface); }
.preview-line { position:relative; width:58%; height:4px; margin-bottom:5px; border-radius:2px; background:var(--preview-line); }
.preview-line.short { width:36%; }
.preview-control { position:relative; display:flex; justify-content:space-between; margin-top:9px; padding:4px 8px; border-radius:3px; background:var(--preview-control); }
.preview-control view { width:5px; height:5px; border-radius:2px; background:var(--preview-line); }
.appearance-label { margin-top:8px; min-height:20px; font-size:12px; line-height:20px; text-align:center; }
.active .appearance-preview { border:2px solid var(--app-accent); padding:11px; }
.active .appearance-label { color:var(--settings-link); font-weight:650; }
.preview-check { position:absolute; right:6px; top:6px; width:14px; height:14px; color:var(--app-accent); }
