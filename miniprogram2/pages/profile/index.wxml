<view class="{{pageMotion}} page profile-page {{themeClass}}">
  <view class="ios-nav {{userInfo && userInfo.backgroundImageUrl ? 'over-cover' : ''}}" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px; padding-right: {{navRight}}px;">
    <view class="profile-back-button" bindtap="goBack" aria-label="返回">
      <view class="ui-icon icon-back"></view>
    </view>
    <view class="nav-title">
      <view class="nav-name">{{userInfo.nickname || userInfo.alias || '个人资料'}}</view>
      <view class="nav-subtitle">{{posts.length}} 帖子</view>
    </view>
  </view>

  <view class="profile-header">
    <view class="profile-background {{userInfo && userInfo.backgroundImageUrl ? 'has-image' : ''}}" style="height:calc(250rpx + {{navTop + navHeight + 8}}px);" bindtap="goToEditProfile" role="button" aria-label="编辑主页背景图">
      <image wx:if="{{userInfo && userInfo.backgroundImageUrl}}" class="profile-background-image" src="{{userInfo.backgroundImageUrl}}" mode="aspectFill"></image>
      <view wx:else class="profile-cover-empty"><view class="ui-icon icon-plus"></view><text>添加背景图</text></view>
      <view wx:if="{{userInfo && userInfo.backgroundImageUrl}}" class="profile-background-overlay"></view>
    </view>

    <view class="profile-avatar-row">
      <view class="profile-avatar-wrap" bindtap="goToEditProfile">
        <image wx:if="{{userInfo && userInfo.avatarUrl}}" class="profile-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="profile-avatar profile-avatar-text">{{userInfo ? userInfo.avatarInitial : '匿'}}</view>
      </view>
      <view class="profile-actions">
        <view class="profile-pill-button" bindtap="goToEditProfile">编辑资料</view>
        <view class="profile-icon-button" bindtap="goToSettings" role="button" aria-label="设置"><view class="ui-icon icon-settings"></view></view>
      </view>
    </view>

    <view class="profile-info {{userInfo && userInfo.backgroundImageUrl ? 'with-background' : ''}}">
      <view wx:if="{{profileError}}" class="profile-loading" bindtap="refreshProfile">{{profileError}} · 点击重试</view>
      <view class="profile-name-row" style="display: flex; align-items: center; gap: 12rpx;">
        <view class="profile-name" style="color: var(--brand-deep);">{{userInfo ? (userInfo.nickname || userInfo.alias || '匿名同学') : ''}}</view>
        <view class="seal-badge-hollow" wx:if="{{userInfo && (userInfo.isVerified || userInfo.verified)}}" style="font-size: 18rpx; height: 32rpx; line-height: 28rpx; padding: 0 8rpx;">校内认证</view>
      </view>
      <view wx:if="{{userInfo && (userInfo.college || userInfo.major)}}" class="profile-school-meta">
        {{userInfo.college}}{{userInfo.college && userInfo.major ? ' · ' : ''}}{{userInfo.major}}
      </view>
      <view wx:if="{{userInfo && userInfo.bio}}" class="profile-bio">{{userInfo.bio}}</view>
      <view wx:if="{{userInfo && userInfo.gender}}" class="profile-gender">
        <text class="profile-gender-icon">{{userInfo.gender === '男' ? '♂' : '♀'}}</text>
        <text>{{userInfo.gender}}</text>
      </view>
      <view class="profile-stats">
        <view class="profile-stat" data-type="followers" bindtap="openFollowSheet">
          <text class="profile-stat-value">{{profileError ? '--' : followers.length}}</text>
          <text class="profile-stat-label">粉丝</text>
        </view>
        <view class="profile-stat" data-type="following" bindtap="openFollowSheet">
          <text class="profile-stat-value">{{profileError ? '--' : following.length}}</text>
          <text class="profile-stat-label">关注</text>
        </view>
        <view class="profile-level" style="background: var(--background-softRed); color: var(--brand-primary);">{{(userInfo && userInfo.userLevelLabel) || 'Lv.1'}}</view>
      </view>
    </view>

    <view class="profile-divider"></view>
    <view class="profile-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="profile-tab section-tab {{activeTab === item.key ? 'active' : ''}}"
        data-tab="{{item.key}}"
        bindtap="switchProfileTab"
        hover-class="section-tab-pressed"
      >
        <text>{{item.label}}</text>
      </view>
      <view class="section-tab-cursor" style="width:33.333333%; transform:translateX({{activeTab === 'posts' ? 0 : activeTab === 'activities' ? 100 : 200}}%);" aria-hidden="true"><view class="section-tab-line"></view></view>
    </view>
  </view>

  <view class="profile-tab-body motion-content {{contentMotion}}">
    <block wx:if="{{activeTab === 'posts'}}">
      <view wx:if="{{loadingPosts}}" class="profile-loading">加载中...</view>
      <view wx:elif="{{postsError}}" class="profile-loading" bindtap="loadPosts">{{postsError}} · 点击重试</view>
      <view wx:elif="{{!posts.length}}" class="empty-state-container" style="padding: 100rpx 40rpx;">
        <view class="social-empty-illustration ui-icon icon-chat" aria-hidden="true"></view>
        <view class="empty-state-title">还没有发过帖子</view>
        <view class="empty-state-desc">分享你的第一条校园动态。</view>
      </view>
      <view wx:else class="profile-feed">
        <post-row
          wx:for="{{posts}}"
          wx:key="id"
          item="{{item}}"
          index="{{index}}"
          list-key="posts"
          preview-images="true"
          bind:open="goPostDetail"
          bind:image="previewPostImage"
          bind:like="toggleLike"
          bind:favorite="toggleFavorite"
        />
      </view>
    </block>

    <block wx:elif="{{activeTab === 'favorites'}}">
      <view wx:if="{{loadingFavorites}}" class="profile-loading">加载中...</view>
      <view wx:elif="{{favoritesError}}" class="profile-loading" bindtap="loadFavorites">{{favoritesError}} · 点击重试</view>
      <view wx:elif="{{!favoritePosts.length}}" class="empty-state-container" style="padding: 100rpx 40rpx;">
        <view class="social-empty-illustration ui-icon icon-bookmark"></view>
        <view class="empty-state-title">还没有收藏</view>
        <view class="empty-state-desc">收藏的帖子会显示在这里。</view>
      </view>
      <view wx:else class="profile-feed">
        <post-row
          wx:for="{{favoritePosts}}"
          wx:key="id"
          item="{{item}}"
          index="{{index}}"
          list-key="favoritePosts"
          preview-images="true"
          bind:open="goPostDetail"
          bind:image="previewPostImage"
          bind:like="toggleLike"
          bind:favorite="toggleFavorite"
        />
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{loadingComments}}" class="profile-loading">加载中...</view>
      <view wx:elif="{{commentsError}}" class="profile-loading" bindtap="loadComments">{{commentsError}} · 点击重试</view>
      <view wx:elif="{{!comments.length}}" class="empty-state-container" style="padding: 100rpx 40rpx;">
        <view class="empty-image-placeholder"></view>
        <view class="empty-state-title">还没有评论过</view>
        <view class="empty-state-desc">你的回复会显示在这里。</view>
      </view>
      <view wx:else class="activity-list">
        <view
          class="activity-item"
          wx:for="{{comments}}"
          wx:key="id"
          data-post-id="{{item.postId}}"
          data-comment-id="{{item.id}}"
          bindtap="openCommentDetail"
        >
          <view class="activity-post">{{item.postTitle}}</view>
          <view class="activity-content">{{item.content}}</view>
          <view class="activity-time">{{item.timeText}}</view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{showFollowSheet || showFollowSheetLeaving}}" class="follow-layer {{showFollowSheetLeaving && !showFollowSheet ? 'is-leaving' : ''}}">
    <view class="follow-sheet-mask motion-mask" bindtap="closeFollowSheet" catchtouchmove="stopTouchMove"></view>
    <view class="follow-sheet motion-sheet" catchtap="stopTouchMove">
      <view class="follow-sheet-handle"></view>
      <view class="follow-sheet-head">
        <text class="follow-sheet-title">{{followSheetTitle}}</text>
        <text class="follow-sheet-count">{{followSheetUsers.length}}</text>
        <button class="follow-sheet-close" bindtap="closeFollowSheet" aria-label="关闭列表"><view class="ui-icon icon-close"></view></button>
      </view>
      <view class="follow-sheet-divider"></view>
      <scroll-view class="follow-sheet-list" scroll-y enhanced show-scrollbar="{{false}}">
        <view wx:if="{{!followSheetUsers.length}}" class="follow-sheet-empty">暂无数据</view>
        <block wx:else>
          <view wx:if="{{followSheetMutualUsers.length}}" class="follow-sheet-section">好友</view>
          <view class="follow-user-row" wx:for="{{followSheetMutualUsers}}" wx:key="id" data-id="{{item.id}}" bindtap="openFollowUser" role="button" hover-class="motion-press">
            <image wx:if="{{item.avatarUrl}}" class="follow-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="follow-avatar follow-avatar-text">{{item.avatarInitial}}</view>
            <view class="follow-name">{{item.nickname}}</view>
            <view class="follow-mutual-badge">好友</view>
          </view>
          <view wx:if="{{followSheetMutualUsers.length && followSheetOtherUsers.length}}" class="follow-sheet-section">其他</view>
          <view class="follow-user-row" wx:for="{{followSheetOtherUsers}}" wx:key="id" data-id="{{item.id}}" bindtap="openFollowUser" role="button" hover-class="motion-press">
            <image wx:if="{{item.avatarUrl}}" class="follow-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="follow-avatar follow-avatar-text">{{item.avatarInitial}}</view>
            <view class="follow-name">{{item.nickname}}</view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
