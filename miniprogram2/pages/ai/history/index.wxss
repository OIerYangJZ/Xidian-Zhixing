.history-page { min-height: 100vh; padding: 0 0 calc(24px + env(safe-area-inset-bottom)); background: var(--app-background); }
.head { display: flex; align-items: center; justify-content: space-between; min-height: 56px; padding: 0 16px; border-bottom: 1px solid var(--app-divider); }
.count { color: var(--app-text-secondary); font-size: 13px; }
.clear { display: flex; align-items: center; min-height: 44px; color: var(--app-error); font-size: 13px; font-weight: 600; }
.empty { padding: 96px 16px; color: var(--app-text-secondary); font-size: 14px; text-align: center; }
.history-list { width: 100%; }
.history-card { display: flex; align-items: flex-start; gap: 12px; min-height: 92px; padding: 14px 16px; border-bottom: 1px solid var(--app-divider); background: var(--app-background); }
.history-card:active { background: var(--app-control); }
.history-avatar { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; flex: 0 0 40px; overflow: hidden; border-radius: 50%; background: var(--app-control); color: var(--app-text-secondary); font-size: 15px; font-weight: 700; }
.history-avatar-image { display: block; width: 100%; min-width: 0; max-width: 100%; height: 100%; }
.history-avatar-text { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.history-main { flex: 1; min-width: 0; }
.history-meta { display: flex; gap: 4px; color: var(--app-text-secondary); font-size: 12px; }
.history-meta text:first-child { color: var(--app-text-primary); font-weight: 600; }
.history-title { margin-top: 4px; color: var(--app-text-primary); font-size: 15px; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; }
.history-summary { margin-top: 3px; color: var(--app-text-secondary); font-size: 13px; line-height: 1.45; overflow-wrap: anywhere; }
.history-section { margin-top: 6px; color: var(--app-accent); font-size: 12px; }
.history-chevron { align-self: center; width: 18px; height: 18px; flex: 0 0 18px; color: var(--app-text-secondary); }
