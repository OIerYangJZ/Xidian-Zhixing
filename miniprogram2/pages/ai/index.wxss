.ai-page { height:100vh; overflow:hidden; background:var(--app-background); animation:none; }
.ai-header { position:fixed; inset:0 0 auto; z-index:70; display:flex; align-items:center; gap:4px; box-sizing:border-box; padding-left:8px; padding-bottom:8px; border-bottom:1px solid var(--app-divider); background:var(--app-translucent-surface); }
.ai-header-button, .ai-sidebar-close { display:flex; align-items:center; justify-content:center; width:40px; height:36px; flex:0 0 40px; margin:0; padding:0; border-radius:8px; background:transparent; color:var(--app-text-primary); }
.ai-header-button .ui-icon, .ai-sidebar-close .ui-icon { width:23px; height:23px; }
.ai-header-title { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:16px; font-weight:700; text-align:center; }
.ai-new-button { margin-left:auto; }
.pressed { opacity:.62; transform:scale(.88); }

.ai-workspace { display:flex; flex-direction:column; height:100%; padding-bottom:var(--tab-height); box-sizing:border-box; }
.ai-config-bar { flex:0 0 auto; min-height:32px; padding:7px 16px; border-bottom:1px solid var(--app-divider); background:var(--app-surface); color:var(--app-text-secondary); font-size:12px; text-align:center; }
.ai-config-bar.error { color:var(--app-error); }
.ai-empty-workspace { flex:1; min-height:0; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px 22px; animation:ai-empty-in .24s cubic-bezier(.2,.72,.24,1) both; }
.ai-emblem { width:64px; height:64px; color:var(--app-text-primary); }
.ai-greeting { margin-top:20px; font-size:24px; font-weight:700; line-height:1.3; text-align:center; }
.ai-suggestions { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:26px; }
.ai-suggestion { max-width:260px; padding:9px 14px; border:1px solid var(--app-divider); border-radius:20px; background:var(--app-surface); color:var(--app-text-secondary); font-size:13px; line-height:1.35; transition:transform .14s ease, opacity .14s ease, background-color .18s ease; }
.ai-suggestion:active { opacity:.7; transform:scale(.97); background:var(--app-control); }

.ai-chat-scroll { flex:1; min-height:0; }
.ai-chat-scroll ::-webkit-scrollbar, .ai-conversation-scroll ::-webkit-scrollbar { display:none; width:0; height:0; }
.ai-chat-list { padding:18px 16px 28px; }
.ai-message { display:flex; align-items:flex-start; gap:10px; margin:0 auto 24px; max-width:720px; animation:ai-message-in .2s ease-out both; }
.ai-message.user { justify-content:flex-end; }
.ai-assistant-mark { display:flex; align-items:center; justify-content:center; width:28px; height:28px; flex:0 0 28px; margin-top:2px; color:var(--app-text-primary); }
.ai-assistant-mark .ui-icon { width:24px; height:24px; }
.ai-message-content { min-width:0; max-width:calc(100% - 38px); color:var(--app-text-primary); }
.ai-message.user .ai-message-content { max-width:86%; padding:10px 14px; border:1px solid var(--app-divider); border-radius:20px 20px 5px 20px; background:var(--app-control); }
.ai-message.assistant .ai-message-content { flex:1; padding:3px 4px 0; }
.ai-message-text { display:block; white-space:pre-wrap; overflow-wrap:anywhere; font-size:16px; line-height:1.65; }
.ai-references { margin-top:14px; padding-top:12px; border-top:1px solid var(--app-divider); }
.ai-reference-label { margin-bottom:5px; color:var(--app-text-secondary); font-size:12px; font-weight:600; }
.ai-reference { min-height:34px; display:flex; align-items:center; color:var(--app-accent); font-size:13px; line-height:1.4; }
.ai-reference:active { opacity:.65; }
.ai-typing { display:flex; align-items:center; gap:5px; height:28px; padding:3px 4px; }
.ai-typing view { width:6px; height:6px; border-radius:50%; background:var(--app-text-tertiary); animation:ai-typing 1.25s infinite ease-in-out both; }
.ai-typing view:nth-child(1) { animation-delay:-.28s; }
.ai-typing view:nth-child(2) { animation-delay:-.14s; }

.ai-composer-wrap { flex:0 0 auto; padding:8px 14px calc(8px + env(safe-area-inset-bottom)); background:var(--app-background); }
.ai-composer { display:flex; align-items:center; gap:8px; min-height:52px; padding:5px 6px 5px 16px; border:1px solid var(--app-divider); border-radius:27px; background:var(--app-surface); box-shadow:0 3px 14px rgba(3,6,10,.08); }
.ai-composer input { flex:1; min-width:0; height:42px; color:var(--app-text-primary); font-size:16px; }
.ai-send { display:flex; align-items:center; justify-content:center; width:42px; height:42px; flex:0 0 42px; margin:0; padding:0; border-radius:50%; background:var(--app-primary); color:var(--app-on-primary); }
.ai-send .ui-icon { width:20px; height:20px; }
.ai-send[disabled] { background:var(--app-control); color:var(--app-text-tertiary); opacity:1; }
.ai-disclaimer { padding-top:6px; color:var(--app-text-tertiary); font-size:10px; line-height:1.3; text-align:center; }

.ai-sidebar-layer { position:fixed; inset:0; z-index:1000; }
.ai-sidebar-mask { position:absolute; inset:0; background:var(--app-scrim); animation:ai-mask-in .2s ease-out both; }
.ai-sidebar { position:absolute; inset:0 auto 0 0; display:flex; flex-direction:column; width:84vw; max-width:330px; padding-right:12px; padding-bottom:calc(12px + env(safe-area-inset-bottom)); padding-left:12px; box-sizing:border-box; border-right:1px solid var(--app-divider); background:var(--app-card); animation:ai-sidebar-in .24s cubic-bezier(.2,.78,.2,1) both; }
.ai-sidebar-head { display:flex; align-items:center; min-height:52px; }
.ai-sidebar-head { height:40px; min-height:40px; margin-bottom:12px; }
.ai-header-button, .ai-sidebar-close { width:40px !important; min-width:40px; max-width:40px; margin:0 !important; }
.ai-sidebar-brand { display:flex; align-items:center; gap:10px; flex:1; min-width:0; padding-left:8px; font-size:18px; font-weight:700; }
.ai-sidebar-brand .ui-icon { width:24px; height:24px; }
.ai-sidebar-new, .ai-sidebar-settings { display:flex; align-items:center; gap:12px; width:100%; min-height:48px; padding:0 14px; border-radius:10px; background:transparent; color:var(--app-text-primary); font-size:15px; font-weight:600; text-align:left; }
.ai-sidebar-new { margin-top:4px; border:1px solid var(--app-divider); background:var(--app-surface); }
.ai-sidebar-new .ui-icon, .ai-sidebar-settings .ui-icon { width:20px; height:20px; }
.ai-sidebar-label { padding:22px 12px 8px; color:var(--app-text-tertiary); font-size:12px; font-weight:600; }
.ai-conversation-scroll { flex:1; min-height:0; }
.ai-sidebar-empty { padding:22px 12px; color:var(--app-text-secondary); font-size:13px; }
.ai-conversation-row { display:flex; align-items:center; gap:8px; min-height:58px; padding:7px 12px; border-radius:10px; transition:background-color .18s ease, opacity .14s ease, transform .14s ease; }
.ai-conversation-row.active { background:var(--app-control); }
.ai-conversation-row:active { opacity:.72; transform:scale(.985); }
.ai-conversation-main { flex:1; min-width:0; }
.ai-conversation-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--app-text-primary); font-size:14px; line-height:1.35; }
.ai-conversation-date { margin-top:3px; color:var(--app-text-tertiary); font-size:11px; }
.ai-sidebar-settings { flex:0 0 auto; margin-top:8px; border-top:1px solid var(--app-divider); border-radius:0; }

.ai-conversation-menu-layer { position:fixed; inset:0; z-index:1200; display:flex; align-items:flex-end; }
.ai-conversation-menu-mask { position:absolute; inset:0; background:rgba(3,6,10,.72); animation:ai-mask-in .18s ease-out both; }
.ai-conversation-menu { position:relative; z-index:1; width:100%; max-height:80vh; box-sizing:border-box; overflow-y:auto; padding:8px 16px calc(20px + env(safe-area-inset-bottom)); border-top:1px solid var(--app-divider); border-radius:8px 8px 0 0; background:var(--app-card); box-shadow:0 -12px 34px rgba(3,6,10,.28); animation:ai-menu-in .22s cubic-bezier(.2,.78,.2,1) both; }
.ai-menu-handle { width:38px; height:4px; margin:2px auto 12px; border-radius:3px; background:var(--app-text-tertiary); opacity:.55; }
.ai-menu-title { padding:2px 8px 12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--app-text-secondary); font-size:13px; text-align:center; }
.ai-menu-action { display:flex; align-items:center; gap:14px; width:100%; min-height:52px; padding:0 16px; border-radius:10px; background:transparent; color:var(--app-text-primary); font-size:16px; text-align:left; }
.ai-menu-action .ui-icon { width:21px; height:21px; }
.ai-menu-action.danger { color:var(--app-error); }
.ai-menu-action:active { background:var(--app-control); }
.ai-menu-cancel { width:100%; min-height:48px; margin-top:8px; border-radius:12px; background:var(--app-control); color:var(--app-text-primary); font-size:15px; font-weight:600; }
.ai-menu-cancel, .ai-menu-buttons button { display:flex; align-items:center; justify-content:center; padding:0 16px; line-height:1.4; }
.ai-rename-input { width:100%; height:48px; padding:0 14px; border:1px solid var(--app-accent); border-radius:10px; background:var(--app-surface); color:var(--app-text-primary); font-size:16px; }
.ai-delete-confirm { padding:12px 8px 20px; color:var(--app-text-secondary); font-size:14px; line-height:1.5; text-align:center; }
.ai-menu-buttons { display:flex; gap:10px; margin-top:14px; }
.ai-menu-buttons button { flex:1; min-width:0; min-height:46px; border-radius:12px; background:var(--app-control); color:var(--app-text-primary); font-size:15px; font-weight:600; }
.ai-menu-buttons .primary { background:var(--app-primary); color:var(--app-on-primary); }
.ai-menu-buttons .danger-solid { background:var(--app-error); color:var(--app-on-error); }
.ai-menu-buttons button[disabled] { opacity:.45; }
.ai-sidebar-new, .ai-sidebar-settings, .ai-menu-action, .ai-menu-cancel { width:100% !important; margin-left:0 !important; margin-right:0 !important; }
.ai-send { width:34px !important; max-width:34px; margin:0 !important; }

@keyframes ai-empty-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
@keyframes ai-message-in { from { opacity:0; transform:translateY(7px); } to { opacity:1; transform:translateY(0); } }
@keyframes ai-typing { 0%,80%,100% { transform:scale(.55); opacity:.45; } 40% { transform:scale(1); opacity:1; } }
@keyframes ai-mask-in { from { opacity:0; } to { opacity:1; } }
@keyframes ai-sidebar-in { from { opacity:.75; transform:translateX(-30px); } to { opacity:1; transform:translateX(0); } }
@keyframes ai-menu-in { from { opacity:.7; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
@media (prefers-reduced-motion: reduce) { .ai-empty-workspace, .ai-message, .ai-sidebar-mask, .ai-sidebar, .ai-conversation-menu-mask, .ai-conversation-menu { animation:none; } .ai-suggestion, .ai-conversation-row { transition:none; } }
