/* Shared palette and typography matching the Zhixing Web mobile presentation. */
.theme-reference {
  --app-background: #ffffff;
  --app-surface: #ffffff;
  --app-card: #f7f8fa;
  --app-text-primary: #0f1419;
  --app-text-secondary: #536471;
  --app-text-tertiary: #657786;
  --app-divider: #eff3f4;
  --app-control: #eff3f4;
  --app-primary: #cb0305;
  --app-on-primary: #ffffff;
  --app-primary-dark: #a80305;
  --app-primary-soft: #fff1f2;
  --app-accent: #cb0305;
  --app-accent-soft: #fff1f2;
  --app-dark-panel: var(--app-primary);
  --app-on-dark-panel: var(--app-on-primary);
  --app-like: #cb0305;
  --app-favorite: var(--app-accent);
  --app-error: #b42318;
  --app-on-error: #ffffff;
  --app-success: #00875a;
  --app-warning: #936000;
  --app-scrim: rgba(15, 20, 25, .4);
  --app-translucent-surface: rgba(255, 255, 255, .96);
  --app-surface-translucent: var(--app-translucent-surface);
  --app-coral: var(--app-primary);
  --app-apricot: var(--app-control);
  --brand-primary: var(--app-primary);
  --brand-deep: var(--app-text-primary);
  --brand-bright: var(--app-primary);
  --brand-seal: var(--app-primary);
  --background-paper: var(--app-background);
  --background-softRed: var(--app-primary-soft);
  --text-primary: var(--app-text-primary);
  --text-secondary: var(--app-text-secondary);
  --border-default: var(--app-divider);
  --state-success: var(--app-success);
  --state-warning: var(--app-warning);
  --state-danger: var(--app-error);
  --font-body: "华文中宋", "STZhongsong", "Songti SC", "SimSun", serif;
  --font-display: var(--font-body);
  --font-accent: var(--font-body);
  --font-serif: var(--font-body);
  --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-quote: var(--font-body);
  --font-en-body: var(--font-body);
  --font-en-display: var(--font-body);
  --font-en-accent: var(--font-body);
  --font-zh-body: var(--font-body);
  --font-zh-display: var(--font-body);
  --font-zh-accent: var(--font-body);
  --tab-height: calc(64px + env(safe-area-inset-bottom));
}
.color-mode-dark {
  --app-background: #000000;
  --app-surface: #000000;
  --app-card: #16181c;
  --app-text-primary: #e7e9ea;
  --app-text-secondary: #71767b;
  --app-text-tertiary: #71767b;
  --app-divider: #2f3336;
  --app-control: #16181c;
  --app-primary: #cb0305;
  --app-on-primary: #ffffff;
  --app-primary-dark: #a80305;
  --app-primary-soft: #241416;
  --app-accent: #cb0305;
  --app-accent-soft: #241416;
  --app-error: #f4212e;
  --app-on-error: #ffffff;
  --app-success: #00ba7c;
  --app-warning: #ffd166;
  --app-scrim: rgba(0, 0, 0, .62);
  --app-translucent-surface: rgba(0, 0, 0, .94);
}
