<view class="social-header {{fixed ? 'fixed' : ''}} {{collapsed ? 'collapsed' : ''}}" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px; padding-right: {{navRight}}px;">
  <button wx:if="{{back}}" class="back-button" bindtap="goBack" aria-label="返回" hover-class="pressed"><view class="ui-icon icon-back"></view></button>
  <button wx:else class="avatar-button {{profileError ? 'profile-error' : ''}}" bindtap="openDrawer" aria-label="{{profileError ? (english ? 'Profile unavailable. Open navigation to retry' : '资料加载失败，打开导航重试') : (english ? 'Open navigation' : '打开导航')}}" hover-class="pressed">
    <image wx:if="{{(profile && profile.avatarUrl) || (user && user.avatarUrl)}}" class="avatar" src="{{(profile && profile.avatarUrl) || user.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar">{{(profile && profile.avatarInitial) || initial}}<view wx:if="{{!((profile && profile.avatarInitial) || initial)}}" class="ui-icon icon-person"></view></view>
  </button>
  <view class="header-center"><view wx:if="{{brand}}" class="header-brand" aria-label="西电知行">知行</view><slot name="center"></slot></view>
  <view class="header-actions" style="top: {{navTop}}px; right: {{navRight}}px; height: {{navHeight}}px;"><slot name="actions"></slot></view>
</view>
<radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer" />
