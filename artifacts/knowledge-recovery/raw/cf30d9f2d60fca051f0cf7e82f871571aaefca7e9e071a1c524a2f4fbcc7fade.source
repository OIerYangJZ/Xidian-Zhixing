span {  font-style: italic;  color: #0F4761;  min-height: 10.50pt;  font-size: 10.50pt;}p.docx_ab span {  font-style: italic;  color: #0F4761;}span.docx_ac {  font-style: italic;  color: #0F4761;}span.docx_ac p {  border-top: 0.50pt solid #0F4761;  border-bottom: 0.50pt solid #0F4761;  margin-top: 18.00pt;  margin-bottom: 18.00pt;  margin-left: 43.20pt;  margin-right: 43.20pt;  text-align: center;}span.docx_ac {  font-style: italic;  color: #0F4761;  min-height: 10.50pt;  font-size: 10.50pt;}span.docx_12 {  font-weight: bold;  text-transform: lowercase;  color: #0F4761;}span.docx_ad {  color: #467886;  text-decoration: underline;}span.docx_ae {  color: #605E5C;  background-color: #E1DFDD;}p.docx_af {  text-align: center;}p.docx_af span {  min-height: 9.00pt;  font-size: 9.00pt;}p.docx_af span {  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_af0 {  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_af0 p {  text-align: center;}span.docx_af0 {  min-height: 9.00pt;  font-size: 9.00pt;}p.docx_af1 {  text-align: left;}p.docx_af1 span {  min-height: 9.00pt;  font-size: 9.00pt;}p.docx_af1 span {  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_af2 {  min-height: 9.00pt;  font-size: 9.00pt;}span.docx_af2 p {  text-align: left;}span.docx_af2 {  min-height: 9.00pt;  font-size: 9.00pt;}</style><section class="docx"><article><p style="text-align: center; text-indent: 0pt;"><span style="font-family: 方正小标宋简体; font-weight: bold; min-height: 14pt; font-size: 14pt;">关于西安电子科技大学中国国际大学生创新大赛（2026）校级初赛获奖名单的公示</span></p><p style="text-align: center; text-indent: 0pt;"><br></p><p style="text-indent: 0pt;"><span style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">各学院、相关单位：</span></p><p style="line-height: 1.5; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">根据《关于举办西安电子科技大学中国国际大学生创新大赛（2026）校级初赛的预通知》，我校于2026年5月至6月举办了西安电子科技大学中国国际大学生创新大赛（2026）校级初赛，经材料评审、路演答辩等环节，现将高教主赛道（不含国际参赛项目）、“青年红色筑梦之旅”赛道获奖名单进行公示，名单见附件。如有异议，请在公示期内实名反映。产业赛道、主赛道国际项目、特色专项赛道获奖项目另行通知。</span></p><p style="line-height: 1.5; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">公示时间：8月27日-8月31日</span></p><p style="line-height: 1.5; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">邮 &nbsp; &nbsp;箱：</span><a href="mailto:cxcy@xidian.edu.cn"><span class="docx_ad" style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">cxcy@xidian.edu.cn</span></a></p><p style="line-height: 1.5; text-indent: 28pt; text-align: right;"><span style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">创新创业学院 &nbsp;</span></p><p style="line-height: 1.5; text-indent: 28pt; text-align: right;"><span style="font-family: 仿宋_GB2312; min-height: 14pt; font-size: 14pt;">2026年8月27日</span></p><p style="text-indent: 0pt;"><br></p></article></section>
</div></div><div id="div_vote_id"></div>
