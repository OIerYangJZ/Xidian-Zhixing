e-name:"页脚 Char"; mso-style-link:页脚; font-family:"Calibri","sans-serif";} .MsoChpDefault {font-size:10.0pt;}  /* Page Definitions */  @page Section1 {size:841.9pt 595.3pt; margin:90.0pt 72.0pt 90.0pt 72.0pt; vsb_temp:15.6pt;} div.Section1 {page:Section1;} --></style>
<div class="Section1" style="vsb_temp: 15.6pt;">
 <p class="MsoNormal" style="text-align: center; line-height: 28pt;"><a name="_GoBack"></a><span lang="EN-US" style="font-family: 方正小标宋简体; font-size: 18pt;">2023</span><span style="font-family: 方正小标宋简体; font-size: 18pt;">年西安电子科技大学校级教改项目拟立项公示</span></p>
 <p class="MsoNormal" style="line-height: 28pt;"><span style="font-family: 仿宋_GB2312; font-size: 14pt;">各单位：</span></p>
 <p class="MsoNormal" style="line-height: 28pt; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; font-size: 14pt;">根据《西安电子科技大学关于组织申报<span lang="EN-US">2023</span>年校级教改项目的通知》（本字〔<span lang="EN-US">2023</span>〕<span lang="EN-US">199</span>号）精神，拟批准研究类和实践类共<span lang="EN-US">114</span>项进行立项建设，其中研究类重点项目<span lang="EN-US">20</span>项，一般项目<span lang="EN-US">40</span>项；实践类重点攻关项目<span lang="EN-US">13</span>项，重点项目<span lang="EN-US">41</span>项。</span></p>
 <p class="MsoNormal" style="line-height: 28pt; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; font-size: 14pt;">现将拟立项目名单予以公示，请各项目组务必认真核对项目信息，若有问题请与本学院联系，在公示期结束后各学院将核对情况报本科生院教研科。</span></p>
 <p class="MsoNormal" style="line-height: 28pt; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; font-size: 14pt;">公示时间：<span lang="EN-US">2024</span>年<span lang="EN-US">1</span>月<span lang="EN-US">17</span>日<span lang="EN-US">- 1</span>月<span lang="EN-US">19</span>日</span></p>
 <p class="MsoNormal" style="line-height: 28pt; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; font-size: 14pt;">联系地址：南校区行政楼<span lang="EN-US">201</span>室</span></p>
 <p class="MsoNormal" style="line-height: 28pt; text-indent: 28pt;"><span style="font-family: 仿宋_GB2312; font-size: 14pt;">联系电话：<span lang="EN-US">029-81891764</span></span></p>
 <p class="MsoNormal" style="line-height: 28pt; text-indent: 28pt;"><span lang="EN-US" style="font-family: 仿宋_GB2312; font-size: 14pt;">Email</span><span style="font-family: 仿宋_GB2312; font-size: 14pt;">：<span lang="EN-US">jyk@xidian.edu.cn</span></span></p>
