<script>
window.onload=function(){
                                    
                                    document.getElementById("lj1").onmouseover=function(){
                                        document.getElementById("lj1").style.color="#fff";
                                        document.getElementById("lj1").style.background="#276fb2";
                                        document.getElementById("lj2").style.background="none";
                                        document.getElementById("lj3").style.background="none";
