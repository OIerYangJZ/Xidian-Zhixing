<script type="text/javascript">
$(function(){
	$('body').on('keyup','textarea[data-toggle="counttext"]',function(e){
		$t = $(this);
		var id = $t.attr('id');
		if($('[data-count='+id+']')){
			var maxlength = $t.attr('maxlength');
			var v = $t.val().length;
			$('[data-count='+id+']').text(v+'/'+maxlength);
		}
	});
});
var ctxPath=getCtxPath();
var waitTime = 180;
var flag = true;
var timeOut;
var orderIndex = {
		appealType:function(src){
			$('#appealType').attr("src",src);
		},

		changeIframeWin:function(){
			var iframeWin = document.getElementById('appealType');
			if(iframeWin){
				var bHeight = iframeWin.contentWindow.document.body.scrollHeight;
				var dHeight = iframeWin.contentWindow.document.documentElement.scrollHeight;
				//iframeWin.contentDocument.body.scrollHeight
				var element = iframeWin.contentWindow.document.getElementById('contentDiv');
				$('#iframeWin').css('height',element.scrollHeight);
			}
		},
		sendMsg : function(){
			// if(orderIndex.getSessionId()){
				// if(confirm("继续查找该手机号码诉求？")){
			var phoneMD5 =$.base64.encode("");

					orderIndex.appealType(ctxPath+"/page/frameMine?pageNum=1");


		// 		}else{
		// 			layer.open({
		// 		        type: 1
		// 		        ,title:'发送短信验证码'
		// 		        ,offset: 'auto'
		// 		        ,id: 'layerAuto'
		// 		        ,area: ['500px', '330px']
		// 		        ,content: div_open
		// 		        ,btn: '关闭'
		// 		        ,btn: ['确认', '取消']
		// 		        ,btnAlign: 'c'
		// 		        ,shade: 0.8
		// 		        ,yes: function(){
		// 		        	orderIndex.selectMine();
		// 		        }
		// 		      });
		// 		}
		// 	}else{
		// 		layer.open({
		// 	        type: 1
		// 	        ,title:'发送短信验证码'
		// 	        ,offset: 'auto'
		// 	        ,id: 'layerAuto'
		// 	        ,area: ['500px', '330px']
		// 	        ,content: div_open
		// 	        ,btn: '关闭'
		// 	        ,btn: ['确认', '取消']
		// 	        ,btnAlign: 'c'
		// 	        ,shade: 0.8
		// 	        ,yes: function(){
		// 	        	orderIndex.selectMine();
		// 	        }
		// 	      });
		// 	}
		},
		selectMine:function(){
			var contactTel = $('#contact_tel').val();
			if(contactTel==""||contactTel==undefined){
				contactTel = $('#telephone').val();
			}
			var code = $('#smsCode').val();
			var rightPhone = /^[1][3,4,5,7,8][0-9]{9}$/;
			if (!rightPhone.test(contactTel)) {
				alert("请输入正确的联系方式!");
			    return;
			}
			if(!orderIndex.verifyCode(contactTel,code)){
				alert('短信验证码错误!')
				return;
			}else{
				orderIndex.appealType(ctxPath+"/page/frameMine?pageNum=1");
	        	$("#j_imagecode").val("");
	        	orderIndex.reloadImageCode();
	        	clearTimeout(timeOut);
	        	waitTime = 180;
	        	flag=true;
	        	layer.closeAll();
			}
		},
		sendSms:function(ele) {
		    if (waitTime == 0) {
		        $("#"+ele).attr('disabled',false);
		        $("#"+ele).text("获取验证码");
		        waitTime = 180;// 恢复计时
		        flag=true;
		    } else {
		    	if(flag){
		    		if(orderIndex.smsVerify()){
		    			flag=false;
		    		}else{
		    			return;
		    		}
		        }
		    	$("#"+ele).attr('disabled',true);
		    	$("#"+ele).text("有效时间"+waitTime + "s");
		        waitTime--;
		        timeOut = setTimeout(function() {
		        	orderIndex.sendSms(ele)// 关键处-定时循环调用
		        }, 1000)
		    }
		},
		smsVerify:function(){
			var result_flag = false;
			var rightPhone = /^[1][3,4,5,7,8][0-9]{9}$/;
			//判断是否为电话或手机号码
			var telephone = $('#contact_tel').val();
			var j_imagecode = $('#j_imagecode').val();
			if (!rightPhone.test(telephone)) {
				alert("请输入正确的联系方式!");
			    return;
			}
			if(j_imagecode==""){
				alert("图形验证码不能为空!");
				return;
			}
			ajax.remoteCall(ctxPath+"/servlet/orderQuery?action=smsVerify", {telephone:telephone,j_imagecode:j_imagecode}, function (result) {
				if(result.state=='1') {
					/* $('#myOrder').css("padding-top","50px");
					$('#smsSpan').html("");
					$('#smsCol').css("display","none"); */
					result_flag = true;
		        } else {
					alert(result.msg);
		        }
				$("#j_imagecode").val("");
				orderIndex.reloadImageCode();
			},{async:false});
			return result_flag;
		},
		verifyCode:function(telephone, code){
			var flag = false;
			ajax.remoteCall(ctxPath+"/servlet/orderQuery?action=verifyCode", {telephone:telephone,code:code}, function (result) {
				var state = result.state;
				if(state=='1') {
					
					flag = true;
		        }
			},{async:false});
			return flag;
		},
		login:function(){
			layer.open({
		        type: 1
		        ,title:'用户登录'
		        ,offset: 'auto' 
		        ,id: 'layerAuto' 
		        ,area: ['500px', '330px']
		        ,content: div_login
		        ,btn: '关闭'
		        ,btn: ['确认', '取消']
		        ,btnAlign: 'c' 
		        ,shade: 0.8 
		        ,yes: function(){
		        	orderIndex.verifyLogin();
		        }
		      });
		},
		verifyLogin:function(){
			var j_username = $('#j_username').val();
			var j_password = $.base64.encode($('#j_password').val());
			var j_imagecode = $('#j_imagecode').val();
			ajax.remoteCall("/rs-portal/weblogin?action=login&j_username="+j_username+"&j_password="+j_password+"&j_imagecode="+j_imagecode+"&callback=/rs-portal?", {}, function (result) {
				var state = result.state;
				if(state=='0') {
					$("#j_imagecode").val("");
					orderIndex.reloadImageCodeRs();
					alert(result.msg);
		        }else{
		        	window.location.href="/yc-login/authen?action=success&ctxPath=/rs-portal&busiId=12345";
		        }
			});
		},
		reloadImageCode:function(){
			$("#imageCode").attr("src",ctxPath+"/servlet/orderQuery?action=ImageCode&ts"+new Date().getTime());
		},
		reloadImageCodeRs:function(){
			$("#imageCode").attr("src","/rs-portal/weblogin?action=ImageCode&ts"+new Date().getTime());
		},
		imageBlock:function(){
			$('#smsSpan').html("");
			if($('#contact_tel').val()!=""){
				$('#myOrder').removeAttr("style","padding-top");
				$('#smsSpan').append('<img id="imageCode" style="cursor: pointer;" onclick="orderIndex.reloadImageCode();" title="点击刷新验证码" src="/cf-web/servlet/orderQuery?action=ImageCode&st='+1790504682396+'" alt="">');
				$('#smsCol').removeAttr("style","display");
				orderIndex.reloadImageCode();
				//$('#j_imagecode').focus();
			}else{
				$('#myOrder').css("padding-top","50px");
				$('#smsSpan').html("");
				$('#smsCol').css("display","none");
			}
		},
		getSessionId:function(){
			var flag = false;
			ajax.remoteCall(ctxPath+"/servlet/orderQuery/getSessionId", {}, function (result) {
				if(result=='0') {
					flag = true;
		        }else{
		        	flag = false;
		        }
			},{async:false});
			return flag;
		}

}
var div_open = '<form class="page-form" id="myOrder" style="padding-top: 50px;">'+
'<div class="index-panel">'+
'<div class="index-content pd-40" style="padding: 10px;">'+
'<div class="row" style="padding: 0px 50px 0px 50px;">'+
'<div class="col-12">'+
'<div class="form-group">'+
'<div class="form-label" style="width: 130px;">'+
'<span class="require-label">手机号码</span>'+
'</div>	'+
'<div class="form-control">'+
'<input type="text" id="contact_tel" name="CONTACT_TEL" onchange="orderIndex.imageBlock()" placeholder="请输入您的手机号码" class="form-input" />'+
'</div>'+
'</div>'+
'</div>'+
'<div class="col-12">'+
'<div class="form-group">'+
'<div class="form-label" style="width: 130px;">'+
'<span class="">'+
'<button type="button" id="smsCodeButton" title="获取验证码" onclick=orderIndex.sendSms("smsCodeButton") class="btn" style="background-color: #ec551b;">获取验证码</button>'+
'</span>'+
'</div>'+
'<div class="form-control">'+
'<input type="text" id="smsCode" placeholder="请输入短信验证码" class="form-input" maxlength="10" />'+
'</div>'+
'</div>'+
'</div>'+
'<div class="col-12" id="smsCol" style="display:none;">'+
'<div class="form-group">'+
'<div class="form-label" style="width: 130px;">'+
'<span class="" id="smsSpan">'+
'</span>'+
'</div>'+
'<div class="form-control">'+
'<input type="text" id="j_imagecode" placeholder="请先输入图形验证码再获取短信验证码" class="form-input" maxlength="10" />'+
'</div>'+
'</div>'+
'</div>'+
'</div></div></div></form>';

var div_login = '<form class="page-form" id="myOrder">'+
'<div class="index-panel">'+
'<div class="index-content pd-40" style="padding: 10px;">'+
'<div class="row" style="padding: 0px 50px 0px 50px;">'+
'<div class="col-12">'+
'<div class="form-group">'+
'<div class="form-label" style="width: 130px;">'+
'<span class="require-label">账号</span>'+
'</div>	'+
'<div class="form-control">'+
'<input type="text" id="j_username" name="j_username" placeholder="请输入账号" class="form-input" maxlength="30"/>'+
'</div>'+
'</div>'+
'</div>'+
'<div class="col-12">'+
'<div class="form-group">'+
'<div class="form-label" style="width: 130px;">'+
'<span class="require-label">密码</span>'+
'</div>'+
'<div class="form-control">'+
'<input type="password" id="j_password" name="j_password" placeholder="请输入密码" class="form-input" maxlength="30" />'+
'</div></div></div>'+
'<div class="col-12">'+
'<div class="form-group">'+
'<div class="form-label" style="width: 130px;">'+
'<span class="">'+
'<img id="imageCode" style="cursor: pointer;" onclick="orderIndex.reloadImageCodeRs();" title="点击刷新验证码" src="/rs-portal/weblogin?action=ImageCode&st='+1790504682396+'" alt="">'+
'</span>'+
'</div>'+
'<div class="form-control">'+
'<input type="text" id="j_imagecode" placeholder="请输入验证码" class="form-input" maxlength="10" />'+
'</div></div></div>'+
'</div></div></div></form>';


</script>
</body>
