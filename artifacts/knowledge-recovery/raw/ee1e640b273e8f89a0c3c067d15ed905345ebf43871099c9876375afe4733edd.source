<script language="JavaScript">
    //阳历
    var c_Calendar256272EnDateString;
    //
    var c_Calendar256272WeekDayString;
    //阴历
    var c_Calendar256272CnDateString;
    //节气
    var c_Calendar256272JQString;
    //年
    var c_Calendar256272YearString;
    //月
    var c_Calendar256272MonthString;
    //日
    var c_Calendar256272DayString;
    //周
    var c_Calendar256272WeekString;
    //显示
    var c_Calendar256272ShowString;

    function RunGLNL256272() {
        var sc = new Simple_Calendar();
        sc.init();
        c_Calendar256272CnDateString = sc.getCnDateString();
        c_Calendar256272WeekDayString = sc.getCalendarWeekString();
        c_Calendar256272JQString = sc.getJQString();
        c_Calendar256272EnDateString = sc.getEnDateString();
        c_Calendar256272YearString = sc.getYearString();
        c_Calendar256272MonthString = sc.getMonthString();
        c_Calendar256272DayString = sc.getDayString();
        c_Calendar256272ShowString= "";
    }

    RunGLNL256272();

    function update() {
        $.ajax({
            type: "post",
            data: {
                "sdate": "2013-02-06",
                "edate": "2099-12-31",
                "showtext": "第",
                "isNotStart": "学期未开始",
                "isEnd": "学期已结束",
            },
            dataType: "json",
            async: false,
            url: "/system/resource/calendar/getCurrentWeekMap.jsp",
            success: function (result) {
                if(result.code==200){
                    c_Calendar256272WeekString = result.data;
                }
            },
            error: function () {
                console.log("出错了")
            }
        });
    }
    update();

    c_Calendar256272ShowString+=c_Calendar256272EnDateString;
    c_Calendar256272ShowString+="&nbsp;&nbsp;"+c_Calendar256272WeekDayString;
    c_Calendar256272ShowString+="&nbsp;&nbsp;"+c_Calendar256272CnDateString;c_Calendar256272ShowString+="&nbsp;&nbsp;"+c_Calendar256272JQString;
</script>
