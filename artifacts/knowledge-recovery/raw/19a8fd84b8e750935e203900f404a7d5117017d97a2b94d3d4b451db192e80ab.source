                    window.open(url + "?query=" + query);
                } else {
                    alert("请填写搜索内容")
                }
            },
        }
    })
</script>

<script>
   var appElementu2 = document.querySelector("#appu2");
   if (appElementu2 && appElementu2.__vue__) {

   } else {
      $("#divu2").html($("#htmlu2").text());
      var appOwner = "1370093333";   
      var urlPrefix = "/aop_component/";
      var ifLogin="";
