   <td align="center" valign="middle"><p>石嘉</p></td>
  </tr>
  <tr height="66">
   <td height="67" align="center" valign="middle"><p>5</p></td>
   <td align="center" valign="middle"><p>TE206004</p></td>
   <td width="27" style="-ms-word-break: break-all;"><p>深度学习</p></td>
   <td width="267" align="left" valign="middle"><p>Deep Learning</p></td>
   <td align="center" valign="middle"><p>通信工程学院</p></td>
   <td align="center" valign="middle"><p>肖潇</p></td>
  </tr>
  <tr height="66">
   <td height="67" align="center" valign="middle"><p>6</p></td>
   <td align="center" valign="middle"><p>TE206005</p></td>
   <td width="27" style="-ms-word-break: break-all;"><p>大数据网络</p></td>
