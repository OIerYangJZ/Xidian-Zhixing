<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replacement for allowBackup/fullBackupContent.  Both transports
  are excluded outright: app-private storage holds the session token and cached
  campus data, and neither cloud backup nor device-to-device transfer should
  carry them off the device that the Keystore key is bound to.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
