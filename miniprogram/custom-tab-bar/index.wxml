<view class="social-tabs {{themeClass}}" role="navigation" aria-label="{{english ? 'Main navigation' : '主导航'}}">
  <button wx:for="{{items}}" wx:key="pagePath" class="tab {{selected === item.pagePath ? 'selected' : ''}}" data-path="{{item.pagePath}}" bindtap="navigate" aria-label="{{english ? item.en : item.text}}" aria-current="{{selected === item.pagePath ? 'page' : 'false'}}" hover-class="pressed">
    <view class="tab-symbol {{item.icon === 'ai' ? 'ai-symbol' : ''}}"><view class="ui-icon icon-{{item.icon}}" aria-hidden="true"></view></view>
  </button>
</view>
