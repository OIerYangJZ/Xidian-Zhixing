/* Shown only when the link is refused or fails to load. */
.webview-page { min-height: 100vh; background: var(--zx-bg); }
.empty-icon { width: 72rpx; height: 72rpx; margin: 0 auto 20rpx; color: var(--zx-text-3); }
.empty-actions { display: flex; justify-content: center; gap: 16rpx; margin-top: 32rpx; }
