/* 校园公告: summary card, type chips, rows. */
@import "../../../styles/zx-list-page.wxss";

.daily { margin: 24rpx 24rpx 0; }
.daily-head { gap: 12rpx; color: var(--zx-primary); }
.daily-text { margin-top: 12rpx; line-height: 1.6; }
.types { white-space: nowrap; padding: 24rpx 24rpx 8rpx; box-sizing: border-box; }
.type {
  display: inline-block; margin-right: 16rpx; padding: 10rpx 28rpx; border-radius: 32rpx;
  background: var(--zx-bg-sunk); color: var(--zx-text-2); font-size: 26rpx;
}
.type--on { background: var(--zx-primary); color: #fff; }
.row { padding: 28rpx 32rpx; border-bottom: 2rpx solid var(--zx-line); }
.row-head { gap: 12rpx; }
.row-title { margin-top: 12rpx; }
.row-summary { margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
