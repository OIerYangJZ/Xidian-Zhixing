.tag-posts-page {
  height: 100vh;
  background: var(--app-background);
}

.tag-appbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 16rpx;
  padding-left: 16rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
  box-sizing: border-box;
}

.tag-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 64rpx;
  flex: 0 0 auto;
  color: var(--app-text-primary);
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.tag-heading {
  flex: 1;
  min-width: 0;
}

.tag-name {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-count {
  margin-top: 2rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.25;
}

.tag-list {
  height: 100vh;
  box-sizing: border-box;
  background: var(--app-background);
}

.tag-empty {
  padding: 140rpx 40rpx;
  text-align: center;
}

.tag-empty-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.tag-empty-desc {
  margin-top: 10rpx;
  color: var(--app-primary);
  font-size: 26rpx;
}

/* Approved reference layout. */
.tag-appbar { border-bottom:1px solid var(--app-divider); }
.tag-name { font-size:34rpx; }
.tag-count { color:var(--app-text-secondary); font-size:26rpx; }
.tag-empty-title { font-size:36rpx; }
.tag-empty-desc { font-size:30rpx; }
