.tag-posts-page {
  height: 100vh;
  background: var(--app-background);
}

.tag-appbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 260rpx;
  padding-left: 16rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
  box-sizing: border-box;
}

.tag-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 64rpx;
  flex: 0 0 auto;
  color: var(--app-text-primary);
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.tag-heading {
  flex: 1;
  min-width: 0;
}

.tag-name {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 760;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-count {
  margin-top: 2rpx;
  color: #8e8e93;
  font-size: 24rpx;
  line-height: 1.25;
}

.tag-list {
  height: 100vh;
  box-sizing: border-box;
  background: var(--app-background);
}

.thread-post {
  display: flex;
  gap: 20rpx;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 36rpx;
  background: var(--app-card);
  box-shadow: 0 2rpx 8rpx rgba(178, 58, 46, 0.04);
}

.thread-avatar-wrap {
  position: relative;
  width: 78rpx;
  flex: 0 0 78rpx;
}

.thread-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: center;
}

.thread-follow-dot {
  position: absolute;
  right: -8rpx;
  top: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--app-surface);
  border-radius: 50%;
  background: var(--app-text-primary);
  color: var(--app-surface);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.thread-body {
  flex: 1;
  min-width: 0;
}

.thread-head {
  display: flex;
  align-items: center;
  min-height: 36rpx;
}

.thread-author {
  max-width: 360rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.thread-time {
  margin-left: 10rpx;
  color: var(--app-text-tertiary);
  font-size: 28rpx;
  line-height: 1.2;
}

.thread-menu-dot {
  position: relative;
  width: 48rpx;
  height: 44rpx;
  margin-left: auto;
}

.thread-menu-dot::before,
.thread-menu-dot::after {
  content: '';
  position: absolute;
  top: 20rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--app-text-tertiary);
}

.thread-menu-dot::before {
  left: 14rpx;
}

.thread-menu-dot::after {
  right: 14rpx;
}

.thread-text {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.38;
  word-break: break-word;
}

.inline-tag {
  color: var(--app-primary);
}

.thread-actions {
  display: flex;
  align-items: center;
  gap: 48rpx;
  min-height: 54rpx;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.thread-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 56rpx;
}

.thread-action.active {
  color: #ff2d55;
}

.thread-action.favorited {
  color: #ff9500;
}

.thread-action .feed-action-icon {
  width: 36rpx;
  height: 36rpx;
}

.thread-images {
  width: 100%;
  height: 360rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--app-divider);
}

.post-image {
  width: 100%;
  height: 100%;
  background: var(--app-divider);
}

.tag-empty {
  padding: 140rpx 40rpx;
  text-align: center;
}

.tag-empty-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.tag-empty-desc {
  margin-top: 10rpx;
  color: var(--app-primary);
  font-size: 26rpx;
}
