  mask-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M15%2C4A2%2C2%200%200%2C1%2017%2C6V12A2%2C2%200%200%2C1%2015%2C14H6L2%2C18V6A2%2C2%200%200%2C1%204%2C4H15M15%2C5.5A0.5%2C0.5%200%200%2C0%2014.5%2C6V11A0.5%2C0.5%200%200%2C0%2015%2C11.5H15.58L18.16%2C14.08V6A0.5%2C0.5%200%200%2C0%2017.66%2C5.5H15M21%2C8A2%2C2%200%200%2C1%2023%2C10V22L19%2C18H10A2%2C2%200%200%2C1%208%2C16V14.1H10V16H19.58L22%2C18.42V10A1%2C1%200%200%2C0%2021%2C9H18V7H21A2%2C2%200%200%2C1%2023%2C9%22/%3E%3C/svg%3E");
}

