  mask-image: url("data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M9%2012c2.21%200%204-1.79%204-4s-1.79-4-4-4-4%201.79-4%204%201.79%204%204%204zm0-6c1.1%200%202%20.9%202%202s-.9%202-2%202-2-.9-2-2%20.9-2%202-2zm0%207c-2.67%200-8%201.34-8%204v3h16v-3c0-2.66-5.33-4-8-4zm6%205H3v-1.1c.57-1.46%203.83-2.9%206-2.9s5.43%201.44%206%202.9V18zm5-8V7h-2v3h-3v2h3v3h2v-3h3v-2z%22/%3E%3C/svg%3E");
