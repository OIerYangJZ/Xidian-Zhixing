.post-detail-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--app-surface);
}

.detail-loading,
.detail-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-appbar {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.detail-nav-button,
.detail-nav-more {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  flex: 0 0 auto;
  color: var(--app-text-primary);
}

.detail-nav-more {
  position: absolute;
  right: 260rpx;
  bottom: 8rpx;
}

.back-icon {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.more-dots {
  display: flex;
  gap: 6rpx;
}

.more-dots view {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.main-scroll {
  flex: 1;
  overflow-y: scroll;
  padding-bottom: 128rpx;
  background: var(--app-surface);
}

.post-card {
  padding: 30rpx 24rpx 22rpx;
  margin: 0;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
  border-radius: 0;
  box-shadow: none;
}

.post-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 0;
}

.post-avatar {
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 auto;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: center;
}

.post-avatar-text {
  display: block;
}

.post-meta {
  flex: 1;
  min-width: 0;
}

.post-author {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-author-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.post-time {
  margin-top: 0;
  color: var(--app-text-tertiary);
  font-size: 28rpx;
}

.post-subline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 2rpx;
}

.resolved-badge {
  height: 28rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
  background: rgba(52, 199, 89, .1);
  color: var(--app-success);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 28rpx;
}

.post-title {
  padding: 16rpx 0 0 98rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.38;
}

.post-content {
  padding: 10rpx 0 0 98rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.42;
  word-break: break-word;
}

.post-images {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 0 0 98rpx;
}

.post-image {
  width: 100%;
  border-radius: 20rpx;
  background: var(--app-divider);
}

.post-footer {
  display: flex;
  align-items: center;
  gap: 48rpx;
  min-height: 54rpx;
  padding: 18rpx 0 0 98rpx;
  color: var(--app-text-secondary);
}

.header-actions {
  display: flex;
  align-items: center;
}

.header-action-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 20rpx;
  background: transparent;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 52rpx;
  white-space: nowrap;
}

.mini-chat-icon,
.mini-follow-icon {
  display: inline-block;
  vertical-align: middle;
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  flex: 0 0 auto;
  background-color: currentColor;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

