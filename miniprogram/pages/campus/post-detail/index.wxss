.detail-action,
.detail-share-button {
  display: flex;
  align-items: center;
  min-width: 44rpx;
  height: 72rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 72rpx;
}

.detail-action {
  gap: 8rpx;
}

.detail-share-button {
  justify-content: flex-end;
  margin-left: 0;
}

.detail-action-icon {
  display: inline-block;
  vertical-align: middle;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
  background-color: currentColor;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.detail-action.active {
  color: #ff2d55;
}

.detail-action.favorited {
  color: #ff9500;
}

.active {
  color: var(--app-accent);
  font-weight: 650;
}

.danger {
  color: var(--app-error);
}

.inline-tag {
  color: #2563eb;
}

.md-heading {
  margin: 16rpx 0;
  font-weight: 800;
}

.md-quote {
  display: block;
  padding-left: 18rpx;
  border-left: 6rpx solid var(--app-primary);
  color: var(--app-text-secondary);
}

.md-list,
.md-p {
  display: block;
  margin: 10rpx 0;
}

.comments-section {
  min-height: 50vh;
  padding: 0;
  background: var(--app-surface);
}

.comments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 80rpx;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.comment-sort-trigger {
  display: flex;
  align-items: center;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.comment-sort-arrow {
  margin-left: 4rpx;
  color: var(--app-text-tertiary);
  font-size: 34rpx;
  line-height: 34rpx;
}

.comment-item {
  display: flex;
  padding: 24rpx;
  margin-top: 0 !important;
  margin-right: 0;
  margin-bottom: 0;
  background: var(--app-surface);
  border: 0;
  border-bottom: 1rpx solid var(--app-divider);
  border-radius: 0;
  box-shadow: none;
}

.comment-item.target {
  background: var(--app-primary-soft);
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  margin: 0 20rpx 0 0;
  border-radius: 16rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.comment-avatar-text {
  display: block;
}

.comment-content-box {
  flex: 1;
  min-width: 0;
  padding-bottom: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.comment-author {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.comment-time {
  color: var(--app-text-tertiary);
  font-size: 26rpx;
}

.comment-text {
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.42;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 36rpx;
}

.comment-action.active {
  color: var(--app-accent);
}

.comment-action-icon {
  display: inline-block;
  vertical-align: middle;
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  background-color: currentColor;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.bottom-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 104rpx;
  padding: 16rpx 16rpx calc(16rpx + env(safe-area-inset-bottom)) 24rpx;
  background: transparent;
  border-top: 0;
}

.reply-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  width: 100%;
  padding: 10rpx 0 12rpx;
}

.reply-banner-left {
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 500;
}

.reply-banner-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.reply-banner-icon::after {
  content: '';
  position: absolute;
  left: 6rpx;
  bottom: -6rpx;
  width: 8rpx;
  height: 8rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(45deg);
  background: var(--app-background);
}

.reply-banner-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.reply-banner-close {
  color: var(--app-primary);
  font-size: 36rpx;
  line-height: 1;
}

.comment-compose {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 44rpx;
  background: var(--app-control);
}

.comment-input {
  flex: 1;
  min-height: 72rpx;
  margin-right: 16rpx;
  padding: 0 32rpx;
  border-radius: 36rpx;
  background: transparent;
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.emoji-toggle {
  width: 80rpx;
  height: 80rpx;
  margin: 0 0 0 -8rpx;
  color: var(--app-text-secondary);
  font-size: 48rpx;
  line-height: 80rpx;
  text-align: center;
}

.emoji-panel {
  position: fixed;
  right: 0;
  bottom: 120rpx;
  left: 0;
  z-index: 19;
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
  padding: 24rpx 30rpx;
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
  font-size: 42rpx;
}

.send-btn {
  width: 112rpx !important;
  height: 72rpx;
  padding: 0;
  margin: 0;
  border-radius: 36rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.send-btn[disabled] {
  background: var(--app-control) !important;
  color: var(--app-text-tertiary) !important;
}

.reply-banner-icon {
  position: relative;
}

/* Upgraded Markdown Styling */
.md-inline-code {
  background-color: var(--app-control);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-family: monospace, Consolas, Courier;
  font-size: 0.9em;
  word-break: break-all;
  color: var(--app-accent);
}

.md-code {
  background-color: var(--app-control);
  border: 1rpx solid var(--app-divider);
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 16rpx 0;
  overflow-x: auto;
  display: block;
}

.md-code-inner {
  font-family: monospace, Consolas, Courier;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--app-text-primary);
  white-space: pre;
}

.md-link {
  color: var(--app-primary);
  text-decoration: underline;
  word-break: break-all;
}

.md-table {
  border-collapse: collapse;
  width: 100%;
  margin: 16rpx 0;
  border: 1rpx solid var(--app-divider);
  font-size: 26rpx;
}

.md-th {
  background-color: var(--app-control);
  font-weight: bold;
  border: 1rpx solid var(--app-divider);
  padding: 12rpx 16rpx;
}

.md-td {
  border: 1rpx solid var(--app-divider);
  padding: 12rpx 16rpx;
  color: var(--app-text-primary);
}
