<view class="page post-detail-page {{themeClass}}">
  <view class="detail-appbar" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px; background: var(--app-surface);">
    <view class="detail-nav-button" bindtap="goBack" aria-label="返回">
      <view class="back-icon"></view>
    </view>
    <view wx:if="{{post}}" class="detail-nav-more" bindtap="showPostOptions" aria-label="更多">
      <view class="more-dots"><view></view><view></view><view></view></view>
    </view>
  </view>

  <scroll-view wx:if="{{!loading && post}}" scroll-y class="main-scroll" scroll-into-view="{{targetAnchor}}" scroll-with-animation style="padding-top: {{navTop + navHeight + 8}}px;">
    <view class="post-card">
      <view class="post-header">
        <view wx:if="{{post.isAnonymous}}" class="post-avatar post-avatar-text">{{post.authorInitial || '匿'}}</view>
        <block wx:else>
          <image wx:if="{{post.authorAvatarUrl}}" class="post-avatar" src="{{post.authorAvatarUrl}}" mode="aspectFill" bindtap="openAuthorProfile"></image>
          <view wx:else class="post-avatar post-avatar-text" bindtap="openAuthorProfile">{{post.authorInitial}}</view>
        </block>
        
        <view class="post-meta" bindtap="openAuthorProfile">
          <view class="post-author-row">
            <view class="post-author">{{post.authorAlias || post.authorName || '匿名用户'}}</view>
            <view wx:if="{{post.isAnonymous}}" class="zx-badge zx-badge--outline-seal" style="margin-left: 12rpx;">匿名</view>
          </view>
          <view class="post-subline">
            <text class="post-time" style="color: var(--text-secondary);">{{post.timeText || post.createdAt}}</text>
            <text wx:if="{{post.statusLabel}}" class="zx-badge {{post.statusKey === 'resolved' ? 'zx-badge--success' : post.statusKey === 'closed' ? 'zx-badge--neutral' : 'zx-badge--info'}}" style="margin-left: 12rpx;">{{post.statusLabel}}</text>
            <text wx:if="{{post.isEdited}}" class="zx-badge zx-badge--neutral" style="margin-left: 12rpx;">已编辑</text>
          </view>
        </view>
        <view class="header-actions" wx:if="{{(post.canMessageAuthor && post.authorUserId && !post.isAnonymous) || (post.canFollowAuthor && post.authorUserId && !(post.followingAuthor || post.isFollowingAuthor || post.isFollowing))}}">
          <view wx:if="{{post.canMessageAuthor && post.authorUserId && !post.isAnonymous}}" class="header-action-button" bindtap="messageAuthor">
            <view class="mini-chat-icon"></view>
            <text>私信</text>
          </view>
          <view wx:if="{{post.canFollowAuthor && post.authorUserId && !(post.followingAuthor || post.isFollowingAuthor || post.isFollowing)}}" class="header-action-button" bindtap="toggleFollowAuthor">
            <view class="mini-follow-icon"></view>
            <text>关注</text>
          </view>
        </view>
      </view>
      <view class="post-title" wx:if="{{post.titleSegments && post.titleSegments.length}}">
        <block wx:for="{{post.titleSegments}}" wx:for-item="segment" wx:key="index">
          <text wx:if="{{segment.type === 'tag'}}" class="inline-tag" data-tag="{{segment.tag}}" catchtap="goTagPosts">{{segment.text}}</text>
          <text wx:elif="{{segment.type === 'mention'}}" class="inline-tag" data-user-id="{{segment.userId}}" catchtap="openMention">{{segment.text}}</text>
          <text wx:else>{{segment.text}}</text>
        </block>
      </view>
      <view class="post-content" wx:if="{{post.contentFormat === 'markdown'}}">
        <rich-text nodes="{{contentNodes}}"></rich-text>
      </view>
      <view class="post-content" wx:else>
        <block wx:for="{{post.contentSegments}}" wx:for-item="segment" wx:key="index">
          <text wx:if="{{segment.type === 'tag'}}" class="inline-tag" data-tag="{{segment.tag}}" catchtap="goTagPosts">{{segment.text}}</text>
          <text wx:elif="{{segment.type === 'mention'}}" class="inline-tag" data-user-id="{{segment.userId}}" catchtap="openMention">{{segment.text}}</text>
          <text wx:else>{{segment.text}}</text>
        </block>
      </view>
      <view class="post-images" wx:if="{{post.displayImages && post.displayImages.length > 0}}">
        <image wx:for="{{post.displayImages}}" wx:for-item="img" wx:key="*this" src="{{img}}" data-url="{{img}}" bindtap="previewPostImage" mode="widthFix" class="post-image"></image>
      </view>
      <view class="post-footer">
        <view class="detail-action {{post.liked ? 'active' : ''}}" bindtap="handleLike">
          <view class="zx-i {{post.liked ? 'zx-i-heart-fill' : 'zx-i-heart'}}"></view>
          <text wx:if="{{post.likeCount > 0}}" class="{{post.liked ? 'active' : ''}}">{{post.likeCount}}</text>
        </view>
        <view class="detail-action {{post.favorited ? 'favorited' : ''}}" bindtap="handleFavorite">
          <view class="zx-i {{post.favorited ? 'zx-i-star-fill' : 'zx-i-star'}}"></view>
          <text wx:if="{{post.favoriteCount > 0}}" class="{{post.favorited ? 'active' : ''}}">{{post.favoriteCount}}</text>
        </view>
        <view class="detail-action" bindtap="scrollToComments">
          <view class="zx-i zx-i-comment"></view>
          <text wx:if="{{post.commentCount > 0}}">{{post.commentCount}}</text>
        </view>
        <view class="detail-action {{post.reposted ? 'reposted' : ''}}" bindtap="handleRepost" aria-label="转发到主页">
          <view class="zx-i zx-i-forward"></view>
          <text wx:if="{{post.repostCount > 0}}">{{post.repostCount}}</text>
        </view>
        <button class="detail-share-button" open-type="share">
          <view class="zx-i zx-i-share"></view>
        </button>
      </view>
    </view>

    <view id="comments-section" class="comments-section">
      <view class="comments-head">
        <view class="comment-sort-trigger" bindtap="showCommentSortMenu">
          <text>{{commentSortLabel}}</text>
          <text class="comment-sort-arrow">⌄</text>
        </view>
      </view>
      <view class="empty-state" wx:if="{{post.allowComment === false}}">作者已关闭评论</view>
      <view class="empty-state" wx:elif="{{comments.length === 0}}">暂无评论，快来抢沙发~</view>

      <view id="{{item.anchorId}}" class="comment-item {{item.isTarget ? 'target' : ''}}" wx:for="{{comments}}" wx:key="id" style="{{item.indentStyle}}" data-index="{{index}}" bindlongpress="showCommentMenu">
        <view wx:if="{{item.isAnonymous}}" class="comment-avatar comment-avatar-text">{{item.authorInitial || '匿'}}</view>
        <block wx:else>
          <image wx:if="{{item.authorAvatarUrl}}" class="comment-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill" data-id="{{item.authorUserId}}" bindtap="openCommentAuthor"></image>
          <view wx:else class="comment-avatar comment-avatar-text" data-id="{{item.authorUserId}}" bindtap="openCommentAuthor">{{item.authorInitial}}</view>
        </block>
        <view class="comment-content-box">
          <view class="comment-header">
            <text class="comment-author" data-id="{{item.authorUserId}}" bindtap="openCommentAuthor">{{item.authorAlias || item.authorName || '匿名用户'}}</text>
            <text wx:if="{{item.isPostAuthor}}" class="zx-badge zx-badge--seal" style="margin-left: 8rpx;">洞主</text>
            <text class="comment-time">{{item.timeText || item.createdAt}}</text>
            <text wx:if="{{item.isEdited}}" class="comment-time">已编辑</text>
            <text wx:if="{{item.reviewStatus === 'pending'}}" class="zx-badge zx-badge--warning" style="margin-left: 8rpx;">审核中，仅自己可见</text>
          </view>
          <view class="comment-text">
            <block wx:for="{{item.contentSegments}}" wx:for-item="segment" wx:for-index="segmentIndex" wx:key="segmentIndex">
              <text wx:if="{{segment.type === 'mention'}}" class="inline-tag" data-user-id="{{segment.userId}}" catchtap="openMention">{{segment.text}}</text>
              <text wx:else>{{segment.text}}</text>
            </block>
          </view>
          <view class="comment-actions">
            <view class="comment-action {{item.liked ? 'active' : ''}}" data-index="{{index}}" bindtap="likeComment">
              <view class="zx-i zx-i--sm {{item.liked ? 'zx-i-heart-fill' : 'zx-i-heart'}}"></view>
              <text wx:if="{{item.likeCount}}">{{item.likeCount || 0}}</text>
            </view>
            <view class="comment-action" data-index="{{index}}" bindtap="setReplyTarget">
              <view class="zx-i zx-i--sm zx-i-reply"></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="zx-empty" wx:if="{{loading}}" style="padding-top: {{navTop + navHeight + 48}}px;"><view class="zx-empty__message">加载中…</view></view>
  <view class="zx-empty" wx:if="{{!loading && errorMessage && !post}}" style="padding-top: {{navTop + navHeight + 48}}px;">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small detail-retry" bindtap="retryLoadDetail">重试</view>
  </view>
  <view class="zx-empty" wx:elif="{{!loading && !post}}" style="padding-top: {{navTop + navHeight + 48}}px;">
    <view class="zx-empty__title">帖子不存在或已被删除</view>
  </view>

  <view class="emoji-panel" wx:if="{{!loading && post && showEmojiPanel}}">
    <text wx:for="{{emojis}}" wx:key="*this" data-emoji="{{item}}" bindtap="insertEmoji">{{item}}</text>
  </view>
  <view class="bottom-bar" wx:if="{{!loading && post && (post.allowComment !== false || editingCommentId)}}">
    <!-- @ while typing a name: people to mention. -->
    <view wx:if="{{mentionCandidates.length}}" class="mention-panel">
      <view wx:for="{{mentionCandidates}}" wx:key="id" class="mention-row" data-index="{{index}}" bindtap="pickMention">
        <view class="zx-avatar zx-avatar--sm mention-avatar">
          <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{item.avatarInitial}}</text>
        </view>
        <text class="mention-name">{{item.nickname}}</text>
      </view>
    </view>
    <view wx:if="{{editingCommentId}}" class="reply-banner">
      <view class="reply-banner-left">
        <view class="reply-banner-icon"></view>
        <text class="reply-banner-text">编辑评论</text>
      </view>
      <view class="reply-banner-close" bindtap="cancelEditComment">×</view>
    </view>
    <view wx:elif="{{replyToId}}" class="reply-banner">
      <view class="reply-banner-left">
        <view class="reply-banner-icon"></view>
        <text class="reply-banner-text">回复 @{{replyToName}}</text>
      </view>
      <view class="reply-banner-close" bindtap="clearReplyTarget">×</view>
    </view>
    <view class="comment-compose">
      <view class="emoji-toggle" bindtap="toggleEmojiPanel">☺</view>
      <input class="comment-input" maxlength="2000" placeholder="温柔地回应一下" placeholder-class="comment-placeholder" value="{{commentContent}}" cursor="{{composeCursor}}" bindinput="onCommentInput" confirm-type="send" bindconfirm="submitComment" cursor-spacing="20" />
      <button class="send-btn" bindtap="submitComment" disabled="{{isSending || !canSendComment}}">{{editingCommentId ? '保存' : '发送'}}</button>
    </view>
  </view>
</view>
