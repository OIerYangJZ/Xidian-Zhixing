<view class="zx-page auth-center-page safe-bottom {{themeClass}}">
  <view class="zx-caption intro">本机只记住登录时间和打码后的账号，密码不会保存。</view>

  <view class="system-grid">
    <view
      wx:for="{{systems}}"
      wx:key="id"
      class="system-card {{activeSystem === item.id ? 'system-card--on' : ''}}"
      data-system="{{item.id}}"
      bindtap="switchSystem"
    >
      <view class="zx-row">
        <view class="zx-i zx-i-{{item.icon}} system-icon"></view>
        <view class="zx-spacer"></view>
        <view wx:if="{{item.verified}}" class="zx-badge zx-badge--success"><view class="zx-i zx-i-check zx-i--sm"></view>已验证</view>
      </view>
      <view class="zx-label zx-ellipsis system-name">{{item.name}}</view>
      <view class="zx-caption system-desc">{{item.desc}}</view>
    </view>
  </view>

  <view class="zx-card form-card">
    <view class="zx-row">
      <view class="zx-title zx-ellipsis form-title">{{activeInfo.name}}</view>
      <view wx:if="{{activeState}}" class="zx-btn zx-btn--ghost zx-btn--small" bindtap="clearCurrentState">清除</view>
    </view>

    <view wx:if="{{activeState}}" class="zx-inline-message saved-state">
      <view class="zx-i zx-i-check zx-i--sm"></view>
      <view>已登录{{activeState.studentId ? ' · ' + activeState.studentId : ''}} · {{activeState.updatedAt}}</view>
    </view>
    <view wx:if="{{formError}}" class="zx-inline-message zx-inline-message--danger form-error">{{formError}}</view>

    <block wx:if="{{activeInfo.type === 'schoolnet'}}">
      <view class="fields">
        <view class="field">
          <view class="field-label">账号</view>
          <input class="field-input" value="{{studentId}}" disabled placeholder="完成学号认证后自动填入" placeholder-class="field-placeholder" />
        </view>
        <view class="field">
          <view class="field-label">密码</view>
          <input class="field-input" password="{{true}}" value="{{password}}" placeholder="校园网查询密码" placeholder-class="field-placeholder" bindinput="onPasswordInput" />
        </view>
        <view class="field">
          <view class="field-label">验证码</view>
          <input class="field-input" value="{{schoolnetCaptcha}}" placeholder="图形验证码" placeholder-class="field-placeholder" bindinput="onSchoolnetCaptchaInput" />
          <view class="captcha" bindtap="refreshSchoolnetCaptcha">
            <image wx:if="{{schoolnetImageSrc && !captchaLoading}}" class="captcha-image" src="{{schoolnetImageSrc}}" mode="aspectFit"></image>
            <view wx:else class="captcha-empty">{{captchaLoading ? '加载中…' : '获取'}}</view>
          </view>
        </view>
      </view>
      <view class="zx-caption hint">看不清？点验证码图片换一张。</view>
      <view class="zx-btn zx-btn--primary zx-btn--block submit {{submitting ? 'zx-btn--disabled' : ''}}" bindtap="submitSchoolnetAuth">{{submitting ? '正在登录…' : '登录校园网自服务'}}</view>
    </block>

    <block wx:elif="{{activeInfo.type === 'phone'}}">
      <view class="fields">
        <view class="field">
          <view class="field-label">手机号</view>
          <input class="field-input" type="number" maxlength="11" value="{{dormWaterPhone}}" placeholder="请输入手机号" placeholder-class="field-placeholder" bindinput="onDormWaterPhoneInput" />
        </view>
        <view class="field">
          <view class="field-label">图形码</view>
          <input class="field-input" value="{{dormWaterImageCode}}" placeholder="图形验证码" placeholder-class="field-placeholder" bindinput="onDormWaterImageCodeInput" />
          <view class="captcha" bindtap="refreshDormWaterCaptcha">
            <image wx:if="{{dormWaterImageSrc && !captchaLoading}}" class="captcha-image" src="{{dormWaterImageSrc}}" mode="aspectFit"></image>
            <view wx:else class="captcha-empty">{{captchaLoading ? '加载中…' : '获取'}}</view>
          </view>
        </view>
        <view class="field">
          <view class="field-label">短信码</view>
          <input class="field-input" type="number" value="{{dormWaterSmsCode}}" placeholder="短信验证码" placeholder-class="field-placeholder" bindinput="onDormWaterSmsCodeInput" />
          <view class="sms-send {{smsSending || smsCountdown ? 'sms-send--off' : ''}}" bindtap="sendDormWaterCode">{{smsSending ? '发送中…' : (smsCountdown ? smsCountdown + ' 秒后重发' : '发送验证码')}}</view>
        </view>
      </view>
      <view class="zx-caption hint">先填图形码再发送短信；看不清就点图片换一张。</view>
      <view class="zx-btn zx-btn--primary zx-btn--block submit {{submitting ? 'zx-btn--disabled' : ''}}" bindtap="submitDormWaterAuth">{{submitting ? '正在登录…' : '登录宿舍水机'}}</view>
    </block>
  </view>
</view>
