/* 登录管理: pick a campus system, then sign in to it. */
.auth-center-page { min-height: 100vh; padding: 24rpx 32rpx 80rpx; box-sizing: border-box; background: var(--zx-bg); }
.intro { padding: 0 8rpx 24rpx; line-height: 36rpx; }

.system-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20rpx; }
.system-card {
  padding: 24rpx; border-radius: 32rpx; box-sizing: border-box;
  background: var(--zx-surface); border: 2rpx solid var(--zx-line);
}
.system-card--on { background: var(--zx-primary-soft); border-color: var(--zx-primary); }
.system-card:active { opacity: 0.85; }
.system-icon { width: 44rpx; height: 44rpx; color: var(--zx-primary); }
.system-name { margin-top: 20rpx; }
.system-desc {
  margin-top: 4rpx; height: 64rpx; line-height: 32rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.form-card { margin-top: 28rpx; padding: 32rpx; }
.form-title { flex: 1; min-width: 0; margin-right: 16rpx; }
.saved-state { display: flex; align-items: center; gap: 8rpx; margin-top: 20rpx; background: var(--zx-success-soft); color: var(--zx-success); }
.saved-state .zx-i { flex: none; }
.form-error { margin-top: 20rpx; }

.fields { margin-top: 24rpx; border: 2rpx solid var(--zx-line); border-radius: 28rpx; overflow: hidden; }
.field { display: flex; align-items: center; gap: 20rpx; min-height: 100rpx; padding: 0 12rpx 0 28rpx; }
.field + .field { border-top: 2rpx solid var(--zx-line); }
.field-label { width: 96rpx; flex: none; font-size: 26rpx; color: var(--zx-text-2); }
.field-input { flex: 1; min-width: 0; height: 96rpx; font-size: 28rpx; color: var(--zx-text); }
.field-placeholder { color: var(--zx-text-3); }
.captcha {
  display: flex; align-items: center; justify-content: center; flex: none;
  width: 184rpx; height: 72rpx; border-radius: 18rpx; overflow: hidden; background: var(--zx-bg-sunk);
}
.captcha-image { width: 100%; height: 100%; }
.captcha-empty { font-size: 24rpx; font-weight: 600; color: var(--zx-primary); }
.sms-send { flex: none; padding: 0 16rpx; font-size: 26rpx; font-weight: 600; color: var(--zx-primary); line-height: 72rpx; }
.sms-send--off { color: var(--zx-text-3); }

.hint { margin: 16rpx 8rpx 0; }
.submit { margin-top: 32rpx; }
