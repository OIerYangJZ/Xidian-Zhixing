.auth-center-page {
  min-height: 100vh;
  padding: 28rpx 0 80rpx;
  background: var(--app-background);
}

.hero-block {
  padding: 0 32rpx 22rpx;
}

.hero-kicker {
  color: var(--app-primary);
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-title {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 46rpx;
  font-weight: 750;
  line-height: 1.18;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 27rpx;
  line-height: 1.5;
}

.system-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 0 32rpx;
}

.system-card {
  min-height: 174rpx;
  padding: 20rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.system-card.active {
  border-color: var(--app-primary);
  background: var(--app-primary-soft);
}

.system-card:active {
  opacity: .84;
}

.system-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.system-tag,
.system-state {
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.system-tag {
  background: var(--app-primary);
  color: #ffffff;
}

.system-state {
  background: var(--app-surface);
  color: var(--app-success);
}

.system-name {
  margin-top: 18rpx;
  color: var(--app-text-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.3;
}

.system-desc {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
  line-height: 1.35;
}

.section-card {
  margin: 20rpx 32rpx 0;
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 26rpx;
  background: var(--app-surface);
}

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.section-title {
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.35;
}

.section-note {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.clear-link {
  flex: 0 0 auto;
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.35;
}

.saved-state {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--app-primary-soft);
}

.saved-title {
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.35;
}

.saved-meta {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
  line-height: 1.35;
}

.form-box {
  margin-top: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--app-divider);
  border-radius: 22rpx;
  background: var(--app-surface);
}

.form-row,
.captcha-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 98rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.captcha-row {
  align-items: stretch;
}

.form-row:last-child,
.captcha-row:last-child {
  border-bottom: none;
}

.field-label {
  width: 100rpx;
  flex: 0 0 auto;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.field-placeholder {
  color: var(--app-text-tertiary);
}

.captcha-input {
  flex: 1;
  min-width: 0;
}

.captcha-input .field-label {
  width: auto;
  padding-top: 14rpx;
}

.captcha-input .field-input {
  height: 52rpx;
}

.captcha-box {
  width: 184rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid var(--app-divider);
  background: var(--app-primary-soft);
}

.captcha-image {
  width: 100%;
  height: 100%;
}

.captcha-empty {
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.primary-action,
.secondary-action {
  height: 88rpx;
  margin-top: 16rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.primary-action {
  background: var(--app-primary);
  color: #ffffff;
}

.secondary-action {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.primary-action[disabled],
.secondary-action[disabled] {
  opacity: .62;
}

.result-card {
  overflow: hidden;
}

.result-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.result-row {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.result-key {
  width: 104rpx;
  flex: 0 0 auto;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.result-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}
