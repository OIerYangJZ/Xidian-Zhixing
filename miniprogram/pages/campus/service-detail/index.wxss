.service-page {
  min-height: 100vh;
  padding: 24rpx 0 80rpx;
  background: var(--app-background);
}

.loading-state {
  padding: 120rpx 32rpx 0;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  text-align: center;
}

.detail-head {
  padding: 0 32rpx 18rpx;
}

.detail-title {
  color: var(--app-text-primary);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-card {
  margin: 18rpx 32rpx 0;
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.section-head-tight {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.section-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-card {
  min-height: 112rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: var(--app-primary-soft);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--app-primary);
}

.action-label {
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.calendar-section {
  padding-bottom: 8rpx;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 32rpx 10rpx;
}

.calendar-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.calendar-nav {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.nav-button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
  text-align: center;
}

.date-picker {
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
  white-space: nowrap;
}

.week-strip {
  width: 100%;
  white-space: nowrap;
}

.week-card {
  display: inline-flex;
  flex-direction: column;
  width: 128rpx;
  min-height: 128rpx;
  margin-left: 16rpx;
  padding: 14rpx 12rpx;
  border-radius: 22rpx;
  background: transparent;
  vertical-align: top;
}

.week-card:first-child {
  margin-left: 32rpx;
}

.week-card:last-child {
  margin-right: 32rpx;
}

.week-card.active {
  background: var(--app-primary-soft);
}

.week-card-label {
  color: var(--app-text-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.week-card-range {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 19rpx;
  line-height: 1.2;
}

.week-card-dots {
  display: grid;
  grid-template-columns: repeat(7, 10rpx);
  gap: 6rpx;
  margin-top: 12rpx;
}

.week-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(120, 104, 179, 0.28);
}

.week-dot.active {
  background: var(--app-primary);
}

.schedule-grid-scroll {
  width: 100%;
  margin-top: 26rpx;
}

.schedule-grid {
  position: relative;
  display: grid;
  grid-template-columns: 74rpx repeat(7, 136rpx);
  grid-template-rows: 78rpx repeat(11, 104rpx);
  width: 1026rpx;
  min-height: 1222rpx;
  padding: 0 18rpx 24rpx 10rpx;
}

.schedule-corner,
.schedule-day-head,
.schedule-time-head,
.schedule-empty-cell {
  box-sizing: border-box;
}

.schedule-day-head {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--app-text-primary);
}

.schedule-day-name {
  font-size: 26rpx;
  line-height: 1.2;
}

.schedule-day-num {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.2;
}

.schedule-time-head {
  position: relative;
  padding-top: 4rpx;
  color: var(--app-text-primary);
  text-align: center;
}

.schedule-period {
  position: absolute;
  top: -22rpx;
  left: 0;
  width: 100%;
  color: var(--app-text-secondary);
  font-size: 22rpx;
  line-height: 1.1;
}

.schedule-section {
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.15;
}

.schedule-time-range {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 20rpx;
  line-height: 1.1;
}

.schedule-empty-cell {
  border-top: 1rpx solid rgba(120, 104, 179, 0.08);
}

.schedule-block {
  z-index: 2;
  overflow: hidden;
  margin: 4rpx 5rpx;
  padding: 10rpx 8rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 18rpx;
  color: #263049;
}

.schedule-block.exam {
  color: #4f1f30;
}

.schedule-block-title {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.22;
  word-break: break-all;
}

.schedule-block-meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.18;
  word-break: break-all;
}

.block--cyan {
  border-color: #43b9d8;
  background: #b9ecfa;
}

.block--purple {
  border-color: #9c65c9;
  background: #dbc0ed;
}

.block--indigo {
  border-color: #6973bf;
  background: #cbd0ef;
}

.block--pink {
  border-color: #d84b86;
  background: #f3bdd3;
}

.block--green {
  border-color: #84bc64;
  background: #d9efc4;
}

.block--blue {
  border-color: #5ba8d9;
  background: #c1def4;
}

.block--rose {
  border-color: #d56a72;
  background: #ffd0d3;
}

.map-row {
  padding-top: 14rpx;
}

.map-row + .map-row {
  margin-top: 14rpx;
  border-top: 1rpx solid var(--app-divider);
}

.map-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.map-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.section-link {
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 1.35;
}
