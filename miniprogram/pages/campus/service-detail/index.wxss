/* A campus service: its calendar (课表 grid or exam list), actions and maps. */
.service-page { min-height: 100vh; padding: 0 32rpx 80rpx; box-sizing: border-box; background: var(--zx-bg); overflow-x: hidden; }
.empty-action { margin-top: 24rpx; }

.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 80;
  display: flex; align-items: center; box-sizing: border-box;
  padding-left: 12rpx; padding-right: 200rpx;
  background: var(--zx-bg); border-bottom: 2rpx solid var(--zx-line);
}
.nav-back { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 64rpx; color: var(--zx-text); }
.nav-title { flex: 1; min-width: 0; padding-left: 8rpx; }

.calendar { margin-top: 16rpx; margin-bottom: 40rpx; padding: 28rpx 20rpx 20rpx; }
.toolbar { gap: 12rpx; padding: 0 8rpx; }
.toolbar-icon { flex: none; width: 38rpx; height: 38rpx; color: var(--zx-primary); }
.toolbar-title { flex: none; }
.week-switch { display: flex; align-items: center; flex: none; padding: 6rpx; border-radius: 22rpx; background: var(--zx-bg-sunk); }
.week-arrow { display: flex; align-items: center; justify-content: center; width: 56rpx; height: 56rpx; color: var(--zx-text-2); }
.week-current { padding: 0 8rpx; font-size: 24rpx; font-weight: 600; line-height: 56rpx; color: var(--zx-text); font-variant-numeric: tabular-nums; white-space: nowrap; }
.this-week-row { margin-top: 12rpx; padding: 0 8rpx; }
.this-week { height: 56rpx; padding: 0 20rpx; border-radius: 20rpx; border: 2rpx solid var(--zx-line-strong); font-size: 24rpx; font-weight: 600; line-height: 52rpx; color: var(--zx-text); }
.calendar-error { margin: 16rpx 8rpx 0; }
.calendar-empty { padding: 24rpx 8rpx 8rpx; text-align: center; }

/* 课表 grid: 84rpx time column, a 78rpx day header, 112rpx per section. */
.grid {
  position: relative; display: grid; margin-top: 20rpx;
  grid-template-columns: 84rpx repeat(7, minmax(0, 1fr));
  grid-template-rows: 78rpx repeat(10, 112rpx);
  width: 100%; box-sizing: border-box;
}
.day-head, .period, .cell, .block { box-sizing: border-box; min-width: 0; }
.day-head {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  margin: 0 3rpx 6rpx; border-radius: 20rpx; color: var(--zx-text);
}
.day-head--weekend { color: var(--zx-text-3); }
.day-head--today { background: var(--zx-primary); color: var(--zx-on-primary); }
.day-name { font-size: 22rpx; font-weight: 600; line-height: 30rpx; }
.day-num { font-size: 20rpx; line-height: 26rpx; font-variant-numeric: tabular-nums; }
.period { display: flex; flex-direction: column; justify-content: center; gap: 2rpx; padding-right: 8rpx; }
.period-label { font-size: 22rpx; font-weight: 600; color: var(--zx-text-2); }
.period-time { font-size: 18rpx; line-height: 24rpx; color: var(--zx-text-3); font-variant-numeric: tabular-nums; }
.cell { margin: 3rpx; border-radius: 20rpx; background: var(--zx-bg); }
.cell--weekend { opacity: 0.55; }
.cell--today { background: var(--zx-primary-soft); opacity: 1; }

.block {
  position: relative; z-index: 2; overflow: hidden;
  margin: 3rpx; padding: 12rpx 8rpx; border-radius: 20rpx;
  background: var(--zx-surface); color: var(--block-ink);
}
/* The tint: the channel colour at 15% over the surface. */
.block::before { content: ''; position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: var(--block-ink); opacity: 0.15; }
.block--absolute { position: absolute; margin: 0; }
.block-title, .block-meta { position: relative; word-break: break-all; }
.block-title { font-size: 21rpx; font-weight: 600; line-height: 28rpx; }
.block-meta { margin-top: 4rpx; font-size: 18rpx; line-height: 24rpx; color: var(--zx-text-2); }
.block--c1 { --block-ink: var(--zx-channel-1); }
.block--c2 { --block-ink: var(--zx-channel-2); }
.block--c3 { --block-ink: var(--zx-channel-3); }
.block--c4 { --block-ink: var(--zx-channel-4); }
.block--c5 { --block-ink: var(--zx-channel-5); }
.block--c6 { --block-ink: var(--zx-channel-6); }
.block--exam { --block-ink: var(--zx-danger); box-shadow: inset 0 0 0 2rpx var(--zx-danger); }

/* 考试安排 */
.exam-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 20rpx; }
.exam { display: flex; align-items: center; gap: 24rpx; padding: 20rpx 24rpx; border-radius: 28rpx; background: var(--zx-bg-sunk); }
.exam-date { display: flex; flex-direction: column; align-items: center; flex: none; width: 80rpx; }
.exam-day { font-size: 36rpx; font-weight: 600; line-height: 40rpx; color: var(--zx-text); font-variant-numeric: tabular-nums; }
.exam-body { flex: 1; min-width: 0; }
.exam-meta { margin-top: 4rpx; word-break: break-all; }

.section-head { margin-top: 0; }
.section-head-title { padding-bottom: 0; }
.zx-list { margin-bottom: 40rpx; }
.zx-section-title + .zx-list { margin-top: 0; }
.section-head + .zx-list { margin-top: 12rpx; }
.service-page .zx-section-title { padding-top: 24rpx; }
