.service-page {
  min-height: 100vh;
  padding: 24rpx 0 80rpx;
  background: var(--app-background);
}

.detail-head {
  padding: 0 32rpx 20rpx;
}

.detail-kicker {
  color: var(--app-text-secondary);
  font-size: 22rpx;
  line-height: 1.35;
}

.detail-title {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.detail-desc {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.55;
}

.head-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.meta-chip {
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.section-card {
  margin: 18rpx 32rpx 0;
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 28rpx;
  background: var(--app-surface);
}

.auth-entry-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-title,
.section-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.card-desc,
.section-note {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.card-arrow {
  color: var(--app-text-tertiary);
  font-size: 44rpx;
  line-height: 1;
}

.section-head-tight {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.action-panel,
.auth-panel,
.result-card,
.info-card {
  overflow: hidden;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-card {
  min-height: 112rpx;
  padding: 18rpx 16rpx;
  border-radius: 22rpx;
  background: var(--app-primary-soft);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--app-primary);
}

.action-label {
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.form-box {
  margin-top: 16rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 22rpx;
  overflow: hidden;
  background: var(--app-surface);
}

.form-row,
.captcha-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 98rpx;
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.captcha-row {
  align-items: stretch;
}

.form-row:last-child,
.captcha-row:last-child {
  border-bottom: none;
}

.field-label {
  width: 96rpx;
  flex: 0 0 auto;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.field-placeholder {
  color: var(--app-text-tertiary);
}

.captcha-input {
  flex: 1;
  min-width: 0;
}

.captcha-input .field-label {
  width: auto;
  padding-top: 14rpx;
}

.captcha-input .field-input {
  height: 52rpx;
}

.captcha-box {
  width: 182rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 1rpx solid var(--app-divider);
  background: var(--app-primary-soft);
}

.captcha-image {
  width: 100%;
  height: 100%;
}

.captcha-empty {
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.primary-action,
.secondary-action {
  height: 88rpx;
  margin-top: 16rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.primary-action {
  background: var(--app-primary);
  color: #ffffff;
}

.secondary-action {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.result-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.result-row,
.info-row {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.result-key,
.info-label {
  width: 96rpx;
  flex: 0 0 auto;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.result-value,
.info-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
  font-size: 24rpx;
  line-height: 1.45;
  word-break: break-all;
}

.week-strip {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  overflow-x: auto;
}

.day-tab {
  flex: 0 0 auto;
  width: 118rpx;
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  background: var(--app-primary-soft);
  text-align: center;
}

.day-tab.today {
  background: var(--app-primary);
}

.day-week,
.day-date,
.day-count {
  line-height: 1.35;
}

.day-week {
  color: var(--app-text-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.day-tab.today .day-week,
.day-tab.today .day-date,
.day-tab.today .day-count {
  color: #ffffff;
}

.day-date {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.day-count {
  margin-top: 6rpx;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}

.calendar-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 16rpx;
}

.calendar-day {
  overflow: hidden;
  border: 1rpx solid var(--app-divider);
  border-radius: 22rpx;
  background: var(--app-surface);
}

.calendar-day-head {
  padding: 18rpx 20rpx 0;
}

.calendar-day-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.calendar-day-date {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.schedule-list {
  padding: 0 20rpx 16rpx;
}

.schedule-row {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--app-divider);
}

.schedule-time {
  width: 146rpx;
  flex: 0 0 auto;
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.schedule-body {
  flex: 1;
  min-width: 0;
}

.schedule-title,
.map-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.schedule-meta,
.map-desc,
.day-empty {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.day-empty {
  padding: 14rpx 20rpx 18rpx;
}

.tag-wrap,
.field-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.feature-tag,
.field-chip {
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--app-primary-soft);
  color: var(--app-text-primary);
  font-size: 22rpx;
  line-height: 42rpx;
}

.map-row {
  padding-top: 14rpx;
}

.map-row + .map-row {
  margin-top: 14rpx;
  border-top: 1rpx solid var(--app-divider);
}

.section-link {
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 1.35;
}
