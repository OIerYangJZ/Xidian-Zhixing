.service-page {
  min-height: 100vh;
  padding: 24rpx 0 80rpx;
  background: var(--app-background);
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
}

.schedule-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  padding-right: 210rpx;
  padding-left: 18rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.schedule-back {
  position: relative;
  width: 72rpx;
  height: 64rpx;
  flex: 0 0 auto;
}

.schedule-back::before {
  content: '';
  position: absolute;
  left: 24rpx;
  top: 20rpx;
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid var(--app-text-primary);
  border-bottom: 4rpx solid var(--app-text-primary);
  transform: rotate(45deg);
}

.top-week-switch {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.top-week-arrow {
  width: 52rpx;
  height: 52rpx;
  color: var(--app-text-primary);
  font-size: 44rpx;
  line-height: 48rpx;
  text-align: center;
}

.top-week-current {
  max-width: 380rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 52rpx;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-service-title {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.loading-state {
  padding: 120rpx 32rpx 0;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  text-align: center;
}

.detail-head {
  padding: 0 32rpx 18rpx;
}

.detail-title {
  color: var(--app-text-primary);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.section-card {
  margin: 18rpx 32rpx 0;
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.section-head-tight {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.section-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-card {
  min-height: 112rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: var(--app-primary-soft);
}

.action-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  background: var(--app-primary);
}

.action-label {
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.35;
}

.calendar-section {
  padding-bottom: 8rpx;
  width: 100%;
  max-width: 100vw;
  overflow: hidden;
}

.calendar-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 0 32rpx 10rpx;
}

.calendar-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.calendar-nav {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.nav-button {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 52rpx;
  text-align: center;
}

.date-picker {
  height: 58rpx;
  max-width: 340rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 58rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.week-strip {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
}

.week-strip-inner {
  display: inline-flex;
  align-items: stretch;
}

.week-card {
  display: inline-flex;
  flex-direction: column;
  width: 128rpx;
  min-height: 128rpx;
  margin-left: 16rpx;
  padding: 14rpx 12rpx;
  border-radius: 22rpx;
  background: transparent;
  vertical-align: top;
}

.week-card:first-child {
  margin-left: 32rpx;
}

.week-card:last-child {
  margin-right: 32rpx;
}

.week-card.active {
  background: var(--app-primary-soft);
}

.week-card-label {
  color: var(--app-text-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.week-card-range {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 19rpx;
  line-height: 1.2;
}

.week-card-dots {
  display: grid;
  grid-template-columns: repeat(7, 10rpx);
  gap: 6rpx;
  margin-top: 12rpx;
}

.week-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(120, 104, 179, 0.28);
}

.week-dot.active {
  background: var(--app-primary);
}

.schedule-grid-scroll {
  display: block;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  margin-top: 26rpx;
}

.schedule-grid {
  position: relative;
  display: grid;
  grid-template-columns: 84rpx repeat(7, minmax(0, 1fr));
  grid-template-rows: 78rpx repeat(10, 112rpx);
  width: 100%;
  max-width: 100%;
  min-height: 1198rpx;
  padding: 0 0 28rpx;
  box-sizing: border-box;
}

.schedule-corner,
.schedule-day-head,
.schedule-time-head,
.schedule-empty-cell,
.schedule-block {
  box-sizing: border-box;
  min-width: 0;
}

.schedule-corner {
  grid-column: 1;
  grid-row: 1;
}

.schedule-day-head {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: var(--app-text-primary);
}

.schedule-day-name {
  font-size: 24rpx;
  line-height: 1.2;
}

.schedule-day-num {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.schedule-time-head {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 112rpx;
  padding: 0 2rpx 0 0;
  color: var(--app-text-primary);
  text-align: center;
}

.schedule-section {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.05;
}

.schedule-time-label {
  position: absolute;
  left: 0;
  width: 84rpx;
  padding-right: 10rpx;
  transform: translateY(-50%);
  box-sizing: border-box;
  color: var(--app-text-secondary);
  font-size: 18rpx;
  line-height: 1;
  text-align: right;
  z-index: 1;
  pointer-events: none;
}

.schedule-empty-cell {
  border-top: 1rpx solid var(--app-divider);
}

.schedule-block {
  z-index: 2;
  overflow: hidden;
  position: relative;
  margin: 6rpx 3rpx;
  padding: 11rpx 5rpx 9rpx 9rpx;
  border: 1rpx solid var(--schedule-line);
  border-left: 5rpx solid var(--schedule-accent);
  border-radius: 14rpx;
  background: var(--schedule-bg);
  color: var(--app-text-primary);
  box-shadow: 0 10rpx 24rpx rgba(45, 37, 34, 0.05);
}

.schedule-block.exam {
  position: absolute;
  margin: 0;
  color: var(--app-text-primary);
}

.schedule-block-title {
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.24;
  word-break: break-all;
}

.schedule-block-meta {
  margin-top: 5rpx;
  color: var(--app-text-secondary);
  font-size: 17rpx;
  font-weight: 500;
  line-height: 1.2;
  word-break: break-all;
}

.block--cyan {
  --schedule-accent: #a8332c;
  --schedule-line: rgba(168, 51, 44, 0.18);
  --schedule-bg: #fff7f6;
}

.block--purple {
  --schedule-accent: #8f514a;
  --schedule-line: rgba(143, 81, 74, 0.18);
  --schedule-bg: #fff8f4;
}

.block--indigo {
  --schedule-accent: #7b625d;
  --schedule-line: rgba(123, 98, 93, 0.18);
  --schedule-bg: #faf7f5;
}

.block--pink {
  --schedule-accent: #b45464;
  --schedule-line: rgba(180, 84, 100, 0.18);
  --schedule-bg: #fff6f8;
}

.block--green {
  --schedule-accent: #806a54;
  --schedule-line: rgba(128, 106, 84, 0.18);
  --schedule-bg: #fbf8f4;
}

.block--blue {
  --schedule-accent: #6f7773;
  --schedule-line: rgba(111, 119, 115, 0.18);
  --schedule-bg: #f7f9f8;
}

.block--rose {
  --schedule-accent: #a8332c;
  --schedule-line: rgba(168, 51, 44, 0.24);
  --schedule-bg: #fff1ef;
}

.color-mode-dark .block--cyan,
.color-mode-dark .block--purple,
.color-mode-dark .block--indigo,
.color-mode-dark .block--pink,
.color-mode-dark .block--green,
.color-mode-dark .block--blue,
.color-mode-dark .block--rose {
  --schedule-line: rgba(255, 255, 255, 0.14);
  --schedule-bg: rgba(255, 255, 255, 0.06);
}

.schedule-empty {
  margin: 18rpx 32rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--app-surface);
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
  text-align: center;
}

.exam-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 18rpx 32rpx 0;
}

.exam-card {
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.exam-date {
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
}

.exam-title {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.35;
}

.exam-row {
  display: flex;
  gap: 18rpx;
  margin-top: 14rpx;
}

.exam-label {
  width: 72rpx;
  flex: 0 0 auto;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.exam-value {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
  font-size: 25rpx;
  line-height: 1.4;
  word-break: break-all;
}

.map-row {
  padding-top: 14rpx;
}

.map-row + .map-row {
  margin-top: 14rpx;
  border-top: 1rpx solid var(--app-divider);
}

.map-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.map-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.section-link {
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 1.35;
}
