<view class="service-page safe-bottom {{themeClass}}" style="padding-top: {{service ? navTop + navHeight + 8 : 0}}px;">
  <view class="schedule-nav" wx:if="{{service}}" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px;">
    <view class="schedule-back" bindtap="goBack" aria-label="返回"></view>
    <view class="top-week-switch" wx:if="{{service.slug === 'classtable'}}">
      <view class="top-week-arrow" data-delta="-1" bindtap="shiftWeek">‹</view>
      <picker mode="selector" range="{{weekPickerLabels}}" value="{{weekPickerIndex}}" bindchange="pickWeek">
        <view class="top-week-current">{{selectedWeekText || '选择周次'}}</view>
      </picker>
      <view class="top-week-arrow" data-delta="1" bindtap="shiftWeek">›</view>
    </view>
    <view wx:else class="top-service-title">{{service.name || name}}</view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">正在加载</view>

  <block wx:elif="{{service}}">
    <view class="detail-head" wx:if="{{false}}">
      <view class="detail-title">{{service.name || name}}</view>
    </view>

    <view class="calendar-section" wx:if="{{service.kind === 'schedule' || service.calendarSource}}">
      <view class="calendar-toolbar" wx:if="{{service.slug !== 'classtable'}}">
        <view class="calendar-title">{{isExamList ? '考试安排' : '日程'}}</view>
        <view class="calendar-nav">
          <view class="nav-button" data-delta="-1" bindtap="shiftWeek">‹</view>
          <picker mode="date" value="{{selectedDate}}" bindchange="pickDate">
            <view class="date-picker">{{calendar.startDate}} - {{calendar.endDate}}</view>
          </picker>
          <view class="nav-button" data-delta="1" bindtap="shiftWeek">›</view>
        </view>
      </view>

      <block wx:if="{{isExamList}}">
        <view class="exam-list" wx:if="{{examItems.length}}">
          <view class="exam-card" wx:for="{{examItems}}" wx:key="id">
            <view class="exam-date">{{item.dateLabel}}</view>
            <view class="exam-title">{{item.title}}</view>
            <view class="exam-row">
              <view class="exam-label">时间</view>
              <view class="exam-value">{{item.timeLabel}}</view>
            </view>
            <view class="exam-row" wx:if="{{item.locationText}}">
              <view class="exam-label">地点</view>
              <view class="exam-value">{{item.locationText}}</view>
            </view>
            <view class="exam-row" wx:if="{{item.seatText}}">
              <view class="exam-label">座位号</view>
              <view class="exam-value">{{item.seatText}}</view>
            </view>
          </view>
        </view>
        <view wx:else class="schedule-empty">暂无考试安排</view>
      </block>

      <block wx:else>
        <scroll-view class="schedule-grid-scroll" scroll-x="true" show-scrollbar="false">
          <view class="schedule-grid" style="height: {{calendarGrid.heightRpx}}rpx;">
            <view class="schedule-corner"></view>
            <view
              class="schedule-day-head"
              wx:for="{{calendarGrid.columns}}"
              wx:for-index="dayIndex"
              wx:key="date"
              style="grid-column: {{dayIndex + 2}}; grid-row: 1;"
            >
              <view class="schedule-day-name">{{item.name}}</view>
              <view class="schedule-day-num">{{item.dayNumber}}</view>
            </view>
            <block wx:for="{{calendarGrid.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="section">
              <view class="schedule-time-head" style="grid-column: 1; grid-row: {{rowIndex + 2}};">
                <view class="schedule-section">{{row.section}}</view>
              </view>
              <view
                class="schedule-empty-cell"
                wx:for="{{calendarGrid.columns}}"
                wx:for-item="col"
                wx:for-index="colIndex"
                wx:key="date"
                style="grid-column: {{colIndex + 2}}; grid-row: {{rowIndex + 2}};"
              ></view>
            </block>
            <view
              class="schedule-time-label"
              wx:for="{{calendarGrid.timeLabels}}"
              wx:key="label"
              style="top: {{item.topRpx}}rpx;"
            >{{item.label}}</view>
            <view
              wx:for="{{calendarGrid.blocks}}"
              wx:key="id"
              class="schedule-block block--{{item.color}} {{item.isExam ? 'exam' : ''}}"
              style="{{item.blockStyle}}"
            >
              <view class="schedule-block-title">{{item.shortTitle}}</view>
              <view class="schedule-block-meta">{{item.locationText}}</view>
              <view wx:if="{{item.teacher}}" class="schedule-block-meta">{{item.teacher}}</view>
            </view>
          </view>
        </scroll-view>
        <view wx:if="{{!calendarGrid.blocks.length}}" class="schedule-empty">本周暂无课表或考试安排</view>
      </block>
    </view>

    <view class="section-card action-panel" wx:if="{{actions.length}}">
      <view class="section-title">操作</view>
      <view class="action-grid">
        <view class="action-card" wx:for="{{actions}}" wx:key="label" data-index="{{index}}" bindtap="runAction">
          <view class="action-icon"></view>
          <view class="action-label">{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="section-card" wx:if="{{maps.length}}">
      <view class="section-head-tight">
        <view class="section-title">相关地图</view>
        <view class="section-link" bindtap="openMap">打开地图</view>
      </view>
      <view class="map-row" wx:for="{{maps}}" wx:key="id">
        <view class="map-title">{{item.name}}</view>
        <view class="map-desc">{{item.description}}</view>
      </view>
    </view>
  </block>
</view>
