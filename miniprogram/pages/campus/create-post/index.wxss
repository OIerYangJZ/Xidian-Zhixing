/* 发帖 (handoff P1 / P2). */
.create-page { background: var(--zx-bg); padding-bottom: 220rpx; }

.create-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 200rpx; /* clear of the capsule */
  box-sizing: content-box;
  background: var(--zx-surface);
  border-bottom: 2rpx solid var(--zx-line);
}
.bar-cancel { flex: none; font-size: 28rpx; color: var(--zx-text); }
/* Centred on the screen, not between 取消 and the capsule. */
.bar-title { position: absolute; left: 0; right: 0; text-align: center; font-size: 32rpx; pointer-events: none; }

.create-body { padding: 16rpx 24rpx 0; }
.draft-line { display: flex; align-items: center; gap: 10rpx; padding: 8rpx 12rpx 16rpx; font-size: 24rpx; color: var(--zx-text-3); }
.draft-clear { color: var(--zx-text-2); }
.banner { margin-bottom: 20rpx; }
.banner-action { margin-left: 12rpx; font-weight: 600; text-decoration: underline; }

.card { padding: 28rpx; margin-bottom: 24rpx; }
.card--pin { border-color: var(--zx-accent); background: var(--zx-accent-soft); }

.title-row { display: flex; align-items: flex-start; gap: 16rpx; padding: 8rpx 0 20rpx; border-bottom: 2rpx solid var(--zx-line); }
.title-input { flex: 1; min-height: 56rpx; font-size: 36rpx; line-height: 52rpx; font-weight: 700; color: var(--zx-text); }
.field--error { border-bottom-color: var(--zx-danger); }
.counter { flex: none; font-size: 22rpx; color: var(--zx-text-3); padding-top: 12rpx; }
.field-error { display: flex; align-items: center; gap: 8rpx; margin-top: 10rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-danger); }

.mode-row { margin: 20rpx 0 12rpx; }
.md-switch { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: var(--zx-text-2); }
.segment { display: inline-flex; padding: 6rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.segment--full { display: flex; }
.segment--full .segment-option { flex: 1; justify-content: center; }
.segment-option { display: flex; align-items: center; gap: 8rpx; padding: 14rpx 28rpx; border-radius: 20rpx; font-size: 26rpx; color: var(--zx-text-2); }
.segment-option--on { background: var(--zx-surface); color: var(--zx-primary); font-weight: 600; box-shadow: var(--zx-shadow-1); }

.content-input { width: 100%; min-height: 300rpx; font-size: 30rpx; line-height: 48rpx; color: var(--zx-text); }
.preview { min-height: 300rpx; font-size: 30rpx; line-height: 48rpx; color: var(--zx-text); }
.content-foot { margin-top: 8rpx; }

.toolbar { display: flex; gap: 8rpx; margin: 20rpx -8rpx 0; padding-top: 16rpx; border-top: 2rpx solid var(--zx-line); }
.tool { width: 72rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; color: var(--zx-text-2); }
.tool-b { font-weight: 800; font-size: 30rpx; }
.tool-i { font-style: italic; font-size: 30rpx; font-family: Georgia, serif; }

.tag-panel { margin-top: 16rpx; padding: 20rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.tag-custom { gap: 12rpx; margin-top: 16rpx; }
.tag-input { flex: 1; height: 64rpx; padding: 0 20rpx; border-radius: 20rpx; background: var(--zx-surface); font-size: 26rpx; }

.images { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.image-tile, .image-add { position: relative; width: 150rpx; height: 150rpx; border-radius: 24rpx; overflow: hidden; }
.image { width: 100%; height: 100%; }
.image-cover { position: absolute; left: 10rpx; bottom: 10rpx; padding: 2rpx 10rpx; border-radius: 8rpx; background: var(--zx-scrim); color: #fff; font-size: 20rpx; }
.image-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--zx-scrim); color: #fff; font-size: 22rpx; }
.image-remove { position: absolute; top: 8rpx; right: 8rpx; width: 40rpx; height: 40rpx; border-radius: 20rpx; background: var(--zx-scrim); color: #fff; display: flex; align-items: center; justify-content: center; }
.image-add { border: 2rpx dashed var(--zx-line-strong); background: var(--zx-bg-sunk); color: var(--zx-text-3); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; font-size: 22rpx; }

.setting { padding: 20rpx 0; }
.setting + .setting { border-top: 2rpx solid var(--zx-line); }
.setting-title { margin-bottom: 16rpx; font-size: 28rpx; font-weight: 600; color: var(--zx-text); }
.setting-title--flat { margin-bottom: 0; }
.required { margin-left: 6rpx; color: var(--zx-primary); }
.setting-note { margin-top: 12rpx; }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chips--error { padding: 12rpx; border-radius: 24rpx; border: 3rpx solid var(--zx-danger); }
.chip { display: inline-flex; align-items: center; gap: 8rpx; padding: 12rpx 24rpx; border-radius: 999rpx; border: 2rpx solid var(--zx-line-strong); background: var(--zx-surface); font-size: 26rpx; color: var(--zx-text); }
.chip--on { border-color: var(--zx-primary); background: var(--zx-primary-soft); color: var(--zx-primary); font-weight: 600; }
.section-dot { width: 14rpx; height: 14rpx; border-radius: 7rpx; background: var(--zx-tone); }
.chip--tag { border: none; background: var(--zx-primary-soft); color: var(--zx-primary); font-weight: 600; }
.chip-x { margin-left: 4rpx; display: flex; opacity: 0.7; }
.chip--add { border-style: dashed; color: var(--zx-text-2); }

.anon-head { gap: 16rpx; }
.anon-main { flex: 1; }
.alias-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; padding: 12rpx 12rpx 12rpx 16rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.alias-input { flex: 1; font-size: 28rpx; color: var(--zx-text); }
.alias-row .counter { padding-top: 0; }
.club-row { gap: 12rpx; }
.pin-head { gap: 12rpx; margin-bottom: 16rpx; }

.publish-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--zx-surface); border-top: 2rpx solid var(--zx-line); }

/* @-mention picker under the text. */
.mention-panel { margin: 8rpx 0 16rpx; border: 2rpx solid var(--zx-line); border-radius: 20rpx; overflow: hidden; }
.mention-row { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; }
.mention-row:active { background: var(--zx-line); }
.mention-name { font-size: 28rpx; color: var(--zx-text); }
