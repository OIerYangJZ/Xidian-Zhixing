/* 校园地图: index switcher, schematic plate with pins, place list. */
@import "../../../styles/zx-list-page.wxss";

.map-page { min-height: 100vh; padding-bottom: 80rpx; background: var(--zx-bg); }
.map-head { padding: 32rpx 32rpx 8rpx; }
.map-button { margin-top: 20rpx; }

.group-scroll { width: 100%; white-space: nowrap; margin-top: 24rpx; }
.segment { display: inline-flex; margin: 0 32rpx; padding: 6rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.segment-option { flex: none; padding: 14rpx 28rpx; border-radius: 18rpx; font-size: 26rpx; color: var(--zx-text-2); }
.segment-option--on { background: var(--zx-surface); color: var(--zx-primary); font-weight: 600; box-shadow: var(--zx-shadow-1); }

.group-card { margin: 24rpx 32rpx 0; padding: 32rpx; }
.group-head { align-items: flex-start; gap: 16rpx; }
.group-main { flex: 1; min-width: 0; }
.group-desc { margin-top: 6rpx; }

.plate {
  position: relative; height: 400rpx; margin-top: 24rpx; border-radius: 28rpx; overflow: hidden;
  background: repeating-linear-gradient(135deg, var(--zx-bg-sunk) 0 16rpx, var(--zx-bg) 16rpx 32rpx);
}
.plate-label { position: absolute; left: 20rpx; top: 20rpx; padding: 6rpx 14rpx; border-radius: 10rpx; background: var(--zx-glass); font-size: 20rpx; color: var(--zx-text-3); }
.pin { position: absolute; padding: 12rpx; transform: translate(-50%, -100%); display: flex; flex-direction: column-reverse; align-items: center; color: var(--zx-text-3); }
.pin-icon { width: 24rpx; height: 24rpx; margin-bottom: -12rpx; border-radius: 50%; background: currentColor; border: 4rpx solid var(--zx-surface); box-shadow: var(--zx-shadow-1); }
.pin--on { z-index: 2; color: var(--zx-primary); }
.pin--on .pin-icon { width: 32rpx; height: 32rpx; margin-bottom: -16rpx; box-shadow: 0 0 0 8rpx var(--zx-primary-soft); }
.pin-name { margin-bottom: 4rpx; padding: 6rpx 14rpx; border-radius: 12rpx; background: var(--zx-surface); box-shadow: var(--zx-shadow-1); font-size: 22rpx; font-weight: 600; color: var(--zx-text); white-space: nowrap; }
/* Near the top edge: name under the pin, the pin's tip still on the spot. */
.pin--below { flex-direction: column; transform: translate(-50%, -24rpx); }
.pin--below.pin--on { transform: translate(-50%, -28rpx); }
.pin--below .pin-name { margin: 4rpx 0 0; }

.places { margin-top: 16rpx; }
.place { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 16rpx; border-radius: 20rpx; }
.place + .place { border-top: 2rpx solid var(--zx-line); }
.place--on { background: var(--zx-primary-soft); }
.place--on .place-name { color: var(--zx-primary); }
.place-main { flex: 1; min-width: 0; }
.place-name { font-size: 28rpx; font-weight: 600; color: var(--zx-text); }
