.campus-service-page {
  background: var(--app-background);
}

.ios-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-background);
  border-bottom: 1rpx solid var(--app-divider);
}

.nav-menu {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  width: 88rpx;
  height: 88rpx;
  color: var(--brand-deep);
}

.nav-menu view {
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.nav-title {
  flex: 1;
  min-width: 0;
}

.nav-name {
  color: var(--brand-deep);
  font-size: 31rpx;
  font-weight: 700;
}

.nav-subtitle {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.service-scroll {
  height: calc(100vh - env(safe-area-inset-bottom));
}

.campus-hero {
  padding: 34rpx 32rpx 24rpx;
  background: var(--app-background);
}

.hero-title {
  color: var(--brand-deep);
  font-size: 42rpx;
  font-weight: 750;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
}

.map-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 36rpx; /* card.radius = 18px = 36rpx */
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(178, 58, 46, 0.03);
}

.map-title {
  color: var(--brand-deep);
  font-size: 34rpx;
  font-weight: 700;
}

.map-desc {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.4;
}

.service-group {
  margin-top: 20rpx;
}

.group-title {
  padding: 24rpx 32rpx 14rpx;
  color: var(--brand-deep);
  font-size: 28rpx;
  font-weight: 700;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  background: transparent;
}

.service-item {
  min-height: 172rpx;
  padding: 28rpx 16rpx;
  background: #ffffff;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx; /* radius.sm = 12px = 24rpx */
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(178, 58, 46, 0.02);
}

.service-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 auto 14rpx;
  border: 4rpx solid var(--app-primary);
  border-radius: 16rpx;
}

.service-name {
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.25;
}

.service-status {
  margin-top: 8rpx;
  color: var(--app-primary);
  font-size: 22rpx;
  line-height: 1.2;
}

.menu-arrow {
  color: var(--app-text-tertiary);
  font-size: 30rpx;
}
