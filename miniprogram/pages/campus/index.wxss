.campus-page {
  min-height: 100vh;
  background: var(--app-background);
}

.ios-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-background);
  border-bottom: 1rpx solid var(--app-divider);
}

.nav-title {
  flex: 1;
  min-width: 0;
}

.nav-name {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
}

.nav-subtitle {
  margin-top: 2rpx;
  color: var(--app-text-secondary);
  font-size: 22rpx;
  line-height: 1.25;
}

.campus-scroll {
  height: 100vh;
}

.ids-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 128rpx;
  margin: 24rpx 32rpx 0;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 28rpx;
  background: var(--app-surface);
}

.ids-card:active {
  opacity: .82;
}

.ids-mark {
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 auto;
  border-radius: 18rpx;
  background: var(--app-primary);
  position: relative;
}

.ids-mark::before,
.ids-mark::after {
  content: '';
  position: absolute;
  background: #ffffff;
}

.ids-mark::before {
  left: 18rpx;
  top: 16rpx;
  width: 26rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.ids-mark::after {
  left: 18rpx;
  top: 32rpx;
  width: 26rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.ids-body {
  flex: 1;
  min-width: 0;
}

.ids-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.ids-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
}

.ids-arrow {
  color: var(--app-text-tertiary);
  font-size: 44rpx;
  line-height: 1;
}

.today-section,
.service-section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 32rpx 12rpx;
}

.section-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-subtitle {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
}

.today-list {
  margin: 0 32rpx;
  overflow: hidden;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.today-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.today-row:last-child {
  border-bottom: none;
}

.today-row.active {
  background: var(--app-primary-soft);
}

.today-time {
  width: 148rpx;
  flex: 0 0 auto;
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1.3;
}

.today-body {
  flex: 1;
  min-width: 0;
}

.today-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.35;
}

.today-meta {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.today-badge {
  flex: 0 0 auto;
  min-width: 74rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 19rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 38rpx;
  text-align: center;
}

.today-empty {
  min-height: 92rpx;
  margin: 0 32rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
}

.group-title {
  padding: 0 32rpx 12rpx;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
}

.service-card {
  min-height: 146rpx;
  padding: 24rpx 14rpx 18rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
  text-align: center;
}

.service-card:active {
  opacity: .82;
}

.service-symbol {
  width: 50rpx;
  height: 50rpx;
  margin: 0 auto 14rpx;
  border: 4rpx solid var(--app-primary);
  border-radius: 16rpx;
  position: relative;
}

.service-symbol::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--app-primary);
}

.service-symbol-map {
  border-radius: 50%;
}

.service-symbol-map::after {
  left: 14rpx;
  top: 8rpx;
  width: 14rpx;
  height: 24rpx;
  border-radius: 14rpx 14rpx 14rpx 0;
  transform: rotate(-45deg);
}

.service-symbol-schedule::after {
  left: 9rpx;
  top: 14rpx;
  width: 24rpx;
  height: 5rpx;
  border-radius: 3rpx;
  box-shadow: 0 10rpx 0 var(--app-primary);
}

.service-symbol-external::after,
.service-symbol-tool::after {
  left: 14rpx;
  top: 8rpx;
  width: 14rpx;
  height: 24rpx;
  border-radius: 0;
  transform: rotate(45deg);
}

.service-name {
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
