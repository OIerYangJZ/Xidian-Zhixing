.campus-service-page {
  background: var(--app-background);
}

.ios-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.nav-menu {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  width: 88rpx;
  height: 88rpx;
}

.nav-menu view {
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--app-text-primary);
}

.nav-title {
  flex: 1;
  min-width: 0;
}

.nav-name {
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
}

.nav-subtitle {
  color: var(--app-text-secondary);
  font-size: 22rpx;
}

.service-scroll {
  height: calc(100vh - env(safe-area-inset-bottom));
}

.campus-hero {
  padding: 34rpx 32rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.hero-title {
  color: var(--app-text-primary);
  font-size: 42rpx;
  font-weight: 750;
}

.hero-desc {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
}

.map-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.map-title {
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 700;
}

.map-desc {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.4;
}

.service-group {
  margin-top: 20rpx;
}

.group-title {
  padding: 0 32rpx 14rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  font-weight: 650;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rpx;
  background: var(--app-divider);
  border-top: 1rpx solid var(--app-divider);
  border-bottom: 1rpx solid var(--app-divider);
}

.service-item {
  min-height: 172rpx;
  padding: 24rpx 12rpx;
  background: var(--app-surface);
  text-align: center;
}

.service-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 14rpx;
  border: 4rpx solid var(--app-primary);
  border-radius: 14rpx;
}

.service-name {
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.25;
}

.service-status {
  margin-top: 8rpx;
  color: var(--app-primary);
  font-size: 22rpx;
  line-height: 1.2;
}
