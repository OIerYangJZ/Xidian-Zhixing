/* 校园 (handoff M2). */
.campus { height: 100vh; overflow: hidden; background: var(--zx-hero); }
.campus-scroll { height: 100vh; }
.campus-head { padding: 0 40rpx 32rpx; }
.campus-head-bar { display: flex; align-items: center; }
.campus-title { font-size: 44rpx; line-height: 56rpx; }
.campus-date { margin-top: 8rpx; font-size: 26rpx; color: var(--zx-text-2); }

.campus-body { padding: 0 24rpx 64rpx; }
.card-gap { margin-top: 24rpx; }
.auth { gap: 24rpx; }
.auth-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; background: var(--zx-success-soft); color: var(--zx-success); display: flex; align-items: center; justify-content: center; flex: none; }
.auth-main { flex: 1; min-width: 0; }

.card-head { gap: 12rpx; margin-bottom: 20rpx; }
.card-head-icon { color: var(--zx-primary); }
.card-head-title { font-size: 30rpx; }
.head-link { font-size: 24rpx; font-weight: 600; color: var(--zx-primary); }
.empty-line { padding: 24rpx 0; text-align: center; font-size: 26rpx; color: var(--zx-text-3); }

.today { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.today + .today { margin-top: 16rpx; }
.today--active { background: var(--zx-primary-soft); }
.today-time { width: 96rpx; flex: none; font-size: 28rpx; font-weight: 700; color: var(--zx-text); font-variant-numeric: tabular-nums; }
.today-main { flex: 1; min-width: 0; }
.today-now { background: var(--zx-primary); color: var(--zx-on-primary); }

.week-nav { gap: 4rpx; background: var(--zx-bg-sunk); border-radius: 22rpx; padding: 4rpx; }
.week-step { width: 52rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; color: var(--zx-text-2); }
.week-step--next .zx-i { transform: rotate(180deg); }
.week-label { font-size: 24rpx; font-weight: 600; color: var(--zx-text); }
.this-week { display: flex; justify-content: flex-end; margin: -8rpx 0 8rpx; }

.days { display: flex; padding-left: 76rpx; margin-bottom: 12rpx; }
.day { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 8rpx 0; border-radius: 20rpx; }
.day--today { background: var(--zx-primary); }
.day-label { font-size: 22rpx; color: var(--zx-text-3); }
.day-num { font-size: 32rpx; font-weight: 700; color: var(--zx-text); }
.day--today .day-label, .day--today .day-num { color: var(--zx-on-primary); }
.day-dots { display: flex; gap: 4rpx; height: 10rpx; }
.day-dot { width: 8rpx; height: 8rpx; border-radius: 4rpx; background: var(--zx-primary); }
.day--today .day-dot { background: var(--zx-on-primary); }

.grid-row { display: flex; gap: 8rpx; margin-top: 8rpx; }
.grid-label { width: 68rpx; flex: none; display: flex; align-items: center; font-size: 22rpx; color: var(--zx-text-3); }
.cell {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  border-radius: 14rpx;
  background: var(--zx-bg-sunk);
  opacity: 0.7;
  font-size: 22rpx;
  line-height: 60rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}
.cell--filled { position: relative; isolation: isolate; opacity: 1; background: var(--zx-surface); color: var(--zx-tone); font-weight: 600; }
/* Tints without color-mix(), which older WeChat WebViews lack. */
.cell--filled::before, .service-icon::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: var(--zx-tone);
  opacity: 0.14;
  z-index: -1;
}
.cell--exam { --zx-tone: var(--zx-danger); }
.grid-note { margin-top: 16rpx; }

.exam { display: flex; align-items: center; gap: 20rpx; padding: 22rpx 24rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.exam + .exam { margin-top: 16rpx; }
.exam-date { width: 72rpx; flex: none; text-align: center; }
.exam-day { font-size: 36rpx; font-weight: 700; color: var(--zx-text); }
.exam-main { flex: 1; min-width: 0; }
.exam-count { flex: none; padding: 6rpx 14rpx; border-radius: 12rpx; background: var(--zx-surface); font-size: 22rpx; font-weight: 600; color: var(--zx-text-2); }
.exam-count--soon { background: var(--zx-accent-soft); color: var(--zx-accent-ink); }

.service-group { padding-top: 12rpx; }
.services { display: flex; flex-wrap: wrap; }
.service { width: 25%; display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 16rpx 0; box-sizing: border-box; }
.service-icon {
  position: relative;
  isolation: isolate;
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--zx-surface);
  color: var(--zx-tone);
}
.service-ext { position: absolute; top: -8rpx; right: -8rpx; width: 32rpx; height: 32rpx; border-radius: 16rpx; background: var(--zx-surface); color: var(--zx-text-3); display: flex; align-items: center; justify-content: center; box-shadow: var(--zx-shadow-1); }
.service-ext .zx-i { width: 20rpx; height: 20rpx; }
.service-name { max-width: 150rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-text); text-align: center; }
