/* 学院专区: college chips, a hero card with its actions, shared post rows. */
@import "../../../styles/zx-post.wxss";
@import "../../../styles/zx-list-page.wxss";

.college-scroll { width: 100%; white-space: nowrap; }
.college-row { display: inline-flex; gap: 16rpx; padding: 24rpx 32rpx 8rpx; }
.chip {
  flex: none; padding: 14rpx 28rpx; border-radius: 999rpx;
  border: 2rpx solid var(--zx-line-strong); background: var(--zx-surface);
  font-size: 26rpx; color: var(--zx-text);
}
.chip--on { border-color: var(--zx-primary); background: var(--zx-primary-soft); color: var(--zx-primary); font-weight: 600; }

.college-card { display: flex; flex-wrap: wrap; align-items: center; gap: 24rpx; margin: 24rpx 32rpx 0; padding: 32rpx; }
.college-mark { flex: none; width: 88rpx; height: 88rpx; border-radius: 28rpx; background: var(--zx-surface); color: var(--zx-channel-3); display: flex; align-items: center; justify-content: center; }
.college-main { flex: 1; min-width: 0; }
.college-actions { display: flex; gap: 16rpx; width: 100%; }
.college-actions .zx-btn { flex: 1; }
.list-title { padding: 40rpx 40rpx 16rpx; }
