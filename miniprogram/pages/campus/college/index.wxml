<import src="/templates/post-row.wxml" />
<!-- 学院专区: pick a college, then its recent discussions. -->
<view class="zx-page list-page college-page {{themeClass}}">
  <scroll-view class="college-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="college-row">
      <view
        wx:for="{{colleges}}"
        wx:key="*this"
        class="chip {{activeCollege === item ? 'chip--on' : ''}}"
        data-name="{{item}}"
        bindtap="onCollegeTap"
      >{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{activeCollege}}" class="zx-card zx-hero college-card">
    <view class="college-mark"><view class="zx-i zx-i-campus"></view></view>
    <view class="college-main">
      <view class="zx-title zx-ellipsis">{{activeCollege}}</view>
      <view class="zx-caption">标题或正文提到本学院的讨论</view>
    </view>
    <view class="college-actions">
      <view class="zx-btn zx-btn--secondary zx-btn--small" bindtap="searchCollege"><view class="zx-i zx-i-search zx-i--sm"></view>搜索</view>
      <view class="zx-btn zx-btn--primary zx-btn--small" bindtap="askCollege"><view class="zx-i zx-i-ai zx-i--sm"></view>问 AI</view>
    </view>
  </view>

  <view class="zx-section-title list-title">相关讨论</view>
  <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="retryLoad">重试</view>
  </view>
  <view wx:elif="{{!posts.length}}" class="zx-empty">
    <view class="zx-i zx-i-comment empty-icon"></view>
    <view class="zx-empty__title">暂无相关讨论</view>
    <view class="zx-empty__message">可以去问 AI，或者在树洞发一条</view>
  </view>
  <view wx:else class="sheet">
    <block wx:for="{{posts}}" wx:key="id">
      <template is="post-row" data="{{item, index}}" />
    </block>
  </view>
</view>
