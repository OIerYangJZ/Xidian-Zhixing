/* 搜索 (handoff S1–S3). */
@import "../../../styles/zx-post.wxss";

.search-page { background: var(--zx-bg); padding-bottom: 48rpx; }

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx 16rpx 32rpx;
  background: var(--zx-surface);
}
.search-field {
  flex: 1;
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 16rpx 0 28rpx;
  border-radius: 40rpx;
  background: var(--zx-bg-sunk);
}
.search-icon { color: var(--zx-text-3); margin-right: 12rpx; }
.search-input { flex: 1; font-size: 28rpx; color: var(--zx-text); }
.search-clear { padding: 12rpx; color: var(--zx-text-3); }
.search-go { font-size: 28rpx; font-weight: 600; color: var(--zx-primary); padding: 12rpx 8rpx; }

.idle { padding: 8rpx 32rpx 0; }
.block { margin-top: 32rpx; }
.block-head { margin-bottom: 16rpx; }
.block-head .zx-section-title { padding: 0; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chips--center { justify-content: center; }
.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--zx-line);
  background: var(--zx-surface);
  font-size: 26rpx;
  color: var(--zx-text);
}
.chip--topic { color: var(--zx-primary); font-weight: 600; }
.hot-ai { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-primary); }
.hot-summary {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: var(--zx-accent-soft);
  color: var(--zx-accent-ink);
  font-size: 26rpx;
  line-height: 40rpx;
}
.hot-rank {
  flex: none;
  width: 48rpx;
  text-align: center;
  font-family: "STZhongsong", "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--zx-text-3);
}
.hot-rank--top { color: var(--zx-primary); }

.tabs { display: flex; gap: 48rpx; padding: 0 40rpx; background: var(--zx-surface); border-bottom: 2rpx solid var(--zx-line); }
.tab { padding: 20rpx 0 18rpx; font-size: 30rpx; color: var(--zx-text-3); border-bottom: 4rpx solid transparent; }
.tab--on { color: var(--zx-text); font-weight: 700; border-bottom-color: var(--zx-primary); }
.tab-count { margin-left: 10rpx; font-size: 24rpx; font-weight: 400; color: var(--zx-text-3); }

.results { padding-top: 24rpx; }
.sheet { background: var(--zx-surface); border-radius: 40rpx 40rpx 0 0; border-top: 2rpx solid var(--zx-line); }

.topic {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 0 32rpx 32rpx;
  padding: 28rpx 20rpx 28rpx 28rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--zx-line);
}
.topic-mark {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: var(--zx-surface);
  color: var(--zx-primary);
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  line-height: 88rpx;
}
.topic-main { flex: 1; min-width: 0; }
.topic-name { font-size: 40rpx; line-height: 52rpx; }
.sort { display: flex; padding: 6rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.sort-option { padding: 12rpx 24rpx; border-radius: 20rpx; font-size: 26rpx; color: var(--zx-text-3); }
.sort-option--on { background: var(--zx-surface); color: var(--zx-primary); font-weight: 600; box-shadow: var(--zx-shadow-1); }

.nothing { padding: 120rpx 64rpx 0; text-align: center; }
.nothing-mark {
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto;
  border-radius: 40rpx;
  border: 2rpx dashed var(--zx-primary);
  background: var(--zx-primary-soft);
  color: var(--zx-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nothing-title { margin-top: 44rpx; font-size: 40rpx; line-height: 60rpx; white-space: pre-line; }
.nothing-text { margin: 20rpx 0 40rpx; font-size: 28rpx; color: var(--zx-text-2); }

.users { background: var(--zx-surface); border-top: 2rpx solid var(--zx-line); }
.user { display: flex; align-items: center; gap: 24rpx; padding: 28rpx 40rpx; border-bottom: 2rpx solid var(--zx-line); }
.user-avatar { width: 92rpx; height: 92rpx; }
.user-main { flex: 1; min-width: 0; }
.user-meta { margin-top: 6rpx; }
.empty-action { margin-top: 24rpx; }
