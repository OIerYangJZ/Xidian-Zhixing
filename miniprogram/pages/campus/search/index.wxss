.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.search-row input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 20rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.search-button {
  width: 112rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: center;
}

.type-row {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.hot-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.hot-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.hot-summary-btn {
  min-width: 132rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 29rpx;
  background: var(--app-primary);
  color: var(--app-surface);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 58rpx;
  text-align: center;
}

.hot-summary-card {
  margin: 20rpx 24rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 18rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.55;
}

.hot-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.hot-rank {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 52rpx;
  text-align: center;
}

.hot-body {
  flex: 1;
  min-width: 0;
}

.hot-name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hot-summary {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.45;
}

.hot-meta {
  margin-top: 10rpx;
  color: var(--app-text-tertiary);
  font-size: 23rpx;
}

.type-chip {
  flex: 1;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--app-control);
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 64rpx;
  text-align: center;
}

.type-chip.active {
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-weight: 600;
}

.filter-scroll {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
  padding: 0 24rpx;
}

.filter-chip {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 25rpx;
  line-height: 58rpx;
}

.filter-chip.active {
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-weight: 600;
}

.sort-row {
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.sort-chip {
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 52rpx;
}

.sort-chip.active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-weight: 600;
}

.history {
  padding: 24rpx;
  margin-top: 0;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
}

.clear {
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.history-tag {
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 26rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 42rpx;
  background: var(--app-control);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.user-avatar.fallback {
  background: var(--app-primary-soft);
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.user-bio {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-action {
  color: var(--app-primary);
  font-size: 26rpx;
}

.inline-tag {
  color: var(--app-primary);
}

/* Approved reference layout. */
.search-page { padding:0 0 var(--tab-height); }
.type-row { gap:0; padding:0 16rpx; border-bottom:1px solid var(--app-divider); }
.type-chip { min-height:44px; height:auto; display:flex; align-items:center; justify-content:center; border-radius:0; background:transparent; font-size:34rpx; border-bottom:2px solid transparent; }
.type-chip.active { color:var(--app-text-primary); background:transparent; border-bottom-color:var(--app-primary); }
.sort-row { padding:12rpx 24rpx; }
.sort-chip { min-height:44px; display:flex; align-items:center; justify-content:center; }
.history { padding:32rpx 36rpx; }
.hot-row, .user-card { padding:28rpx 36rpx; }
.hot-rank { background:transparent; font-size:36rpx; }
.hot-name, .user-name { font-size:34rpx; }
.hot-summary, .user-bio { font-size:30rpx; }
.hot-meta { font-size:26rpx; }
.hot-summary-btn, .clear, .user-action { min-height:44px; display:flex; align-items:center; justify-content:center; }
