<view class="zx-page search-page {{themeClass}}">
  <view class="search-bar">
    <view class="search-field">
      <view class="zx-i zx-i-search zx-i--sm search-icon"></view>
      <input class="search-input" value="{{keyword}}" placeholder="搜索帖子、用户或 #话题" confirm-type="search" bindinput="onInput" bindconfirm="search" focus="{{!submitted}}" />
      <view wx:if="{{keyword}}" class="search-clear" bindtap="clearKeyword"><view class="zx-i zx-i-close zx-i--sm"></view></view>
    </view>
    <view class="search-go" bindtap="search">搜索</view>
  </view>

  <!-- Before searching: recent searches and the hot list. -->
  <view wx:if="{{!submitted}}" class="idle">
    <view wx:if="{{history.length}}" class="block">
      <view class="zx-row block-head">
        <view class="zx-section-title">最近搜索</view>
        <view class="zx-spacer"></view>
        <view class="zx-caption" bindtap="clearHistory">清空</view>
      </view>
      <view class="chips">
        <view wx:for="{{history}}" wx:key="*this" class="chip" data-keyword="{{item}}" bindtap="onHistoryTap">{{item}}</view>
      </view>
    </view>
    <view class="block">
      <view class="zx-row block-head">
        <view class="zx-section-title">试试这些话题</view>
      </view>
      <view class="chips">
        <view wx:for="{{suggestedTopics}}" wx:key="*this" class="chip chip--topic" data-topic="{{item}}" bindtap="onTopicTap">#{{item}}</view>
      </view>
    </view>
    <view class="block">
      <view class="zx-row block-head">
        <view class="zx-section-title">热榜</view>
        <view class="zx-spacer"></view>
        <view class="hot-ai" bindtap="summarizeHotTopics"><view class="zx-i zx-i-ai zx-i--sm"></view>AI 总结</view>
      </view>
      <view wx:if="{{hotSummary}}" class="hot-summary">{{hotSummary}}</view>
      <view wx:if="{{hotErrorMessage}}" class="zx-empty">
        <view class="zx-empty__message">{{hotErrorMessage}}</view>
        <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="loadHotTopics">重试</view>
      </view>
      <view wx:else class="zx-list">
        <view wx:for="{{hotTopics}}" wx:key="id" class="zx-list-item hot-row" data-post-id="{{item.postId}}" bindtap="goHotPost">
          <view class="hot-rank {{index < 3 ? 'hot-rank--top' : ''}}">{{item.rank}}</view>
          <view class="zx-list-item__main">
            <view class="zx-list-item__title zx-ellipsis">{{item.title}}</view>
            <view class="zx-list-item__subtitle zx-ellipsis">{{item.sectionName}} · 热度 {{item.hotScore}}</view>
          </view>
        </view>
        <view wx:if="{{!hotTopics.length}}" class="zx-empty"><view class="zx-empty__message">暂无热榜内容</view></view>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="tabs">
      <view class="tab {{tab === 'posts' ? 'tab--on' : ''}}" data-tab="posts" bindtap="onTabTap">帖子<text class="tab-count">{{posts.length}}</text></view>
      <view class="tab {{tab === 'users' ? 'tab--on' : ''}}" data-tab="users" bindtap="onTabTap">用户<text class="tab-count">{{users.length}}</text></view>
    </view>

    <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">搜索中…</view></view>
    <view wx:elif="{{errorMessage}}" class="zx-empty">
      <view class="zx-empty__title">搜索失败</view>
      <view class="zx-empty__message">{{errorMessage}}</view>
      <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="search">重试</view>
    </view>
    <!-- Handoff S3: nothing in either tab. -->
    <view wx:elif="{{!posts.length && !users.length}}" class="nothing">
      <view class="nothing-mark"><view class="zx-i zx-i-search zx-i--lg"></view></view>
      <view class="zx-display nothing-title">没有找到「{{submitted}}」\n相关的内容</view>
      <view class="nothing-text">换个关键词，或看看这些话题</view>
      <view class="chips chips--center">
        <view wx:for="{{suggestedTopics}}" wx:key="*this" class="chip chip--topic" data-topic="{{item}}" bindtap="onTopicTap">#{{item}}</view>
      </view>
    </view>

    <view wx:elif="{{tab === 'posts'}}" class="results">
      <!-- Handoff S1: the topic's card with its sort. -->
      <view wx:if="{{isTopic}}" class="topic zx-hero">
        <view class="topic-mark">#</view>
        <view class="topic-main">
          <view class="zx-display topic-name">{{topicName}}</view>
          <view class="zx-caption">{{posts.length}} 条帖子</view>
        </view>
        <view class="sort">
          <view class="sort-option {{sort === 'latest' ? 'sort-option--on' : ''}}" data-sort="latest" bindtap="onSortTap">最新</view>
          <view class="sort-option {{sort === 'hot' ? 'sort-option--on' : ''}}" data-sort="hot" bindtap="onSortTap">最热</view>
        </view>
      </view>
      <view wx:if="{{!posts.length}}" class="zx-empty"><view class="zx-empty__message">没有找到相关帖子</view></view>
      <view class="sheet" wx:else>
        <view class="post post--thread" wx:for="{{posts}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
          <view class="post-rail">
            <view wx:if="{{item.isAnonymous}}" class="zx-avatar zx-avatar--seal post-avatar">{{item.authorInitial || '匿'}}</view>
            <view wx:else class="zx-avatar post-avatar" data-user-id="{{item.authorUserId || item.authorId || ''}}" catchtap="openAuthorProfile">
              <image wx:if="{{item.authorAvatarUrl}}" src="{{item.authorAvatarUrl}}" mode="aspectFill"></image>
              <text wx:else>{{item.authorInitial}}</text>
            </view>
          </view>
          <view class="post-body">
            <view class="zx-row post-head">
              <view class="zx-label zx-ellipsis post-author">{{item.authorAlias || '匿名用户'}}</view>
              <view class="zx-caption post-time">· {{item.timeText}}</view>
            </view>
            <view class="post-badges">
              <view wx:if="{{item.isPinned}}" class="zx-badge zx-badge--accent"><view class="zx-i zx-i--sm zx-i-pin"></view>置顶</view>
              <view wx:if="{{item.isAnonymous}}" class="zx-badge zx-badge--outline-seal">匿名</view>
              <view wx:if="{{item.sectionName}}" class="zx-badge zx-badge--channel zx-tone-{{item.sectionTone}}"><view class="zx-dot"></view>{{item.sectionName}}</view>
            </view>
            <view class="post-title" wx:if="{{item.titleSegments && item.titleSegments.length}}">
              <block wx:for="{{item.titleSegments}}" wx:for-item="segment" wx:key="index">
                <text wx:if="{{segment.type === 'tag'}}" class="post-tag" data-tag="{{segment.tag}}" catchtap="goTagPosts">{{segment.text}}</text>
                <text wx:else>{{segment.text}}</text>
              </block>
            </view>
            <view class="post-summary" wx:if="{{item.summarySegments && item.summarySegments.length}}">
              <block wx:for="{{item.summarySegments}}" wx:for-item="segment" wx:key="index">
                <text wx:if="{{segment.type === 'tag'}}" class="post-tag" data-tag="{{segment.tag}}" catchtap="goTagPosts">{{segment.text}}</text>
                <text wx:else>{{segment.text}}</text>
              </block>
            </view>
            <swiper class="post-images" wx:if="{{item.displayImages && item.displayImages.length > 0}}" indicator-dots="{{item.displayImages.length > 1}}">
              <swiper-item wx:for="{{item.displayImages}}" wx:for-item="img" wx:key="*this">
                <image src="{{img}}" mode="aspectFill" class="post-image"></image>
              </swiper-item>
            </swiper>
            <view class="post-actions">
              <view class="action {{item.liked || item.isLiked ? 'action--liked' : ''}}"><view class="zx-i zx-i--sm {{item.liked || item.isLiked ? 'zx-i-heart-fill' : 'zx-i-heart'}}"></view><text>{{item.likeCount || 0}}</text></view>
              <view class="action"><view class="zx-i zx-i--sm zx-i-comment"></view><text>{{item.commentCount || 0}}</text></view>
              <view class="action"><view class="zx-i zx-i--sm zx-i-star"></view><text>{{item.favoriteCount || 0}}</text></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="results">
      <view wx:if="{{!users.length}}" class="zx-empty">
        <view class="zx-empty__message">没有找到相关用户\n只显示实名账号，匿名昵称不参与用户搜索</view>
      </view>
      <view wx:else class="users">
        <view wx:for="{{users}}" wx:key="id" class="user" data-id="{{item.id}}" bindtap="goUserDetail">
          <view class="zx-avatar user-avatar">
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            <text wx:else>{{item.avatarInitial}}</text>
          </view>
          <view class="user-main">
            <view class="zx-label zx-ellipsis">{{item.nickname}}</view>
            <view class="zx-caption zx-ellipsis user-meta">{{item.meta}}</view>
          </view>
          <view wx:if="{{item.canFollow !== false}}" class="zx-btn zx-btn--small {{item.isFollowing ? 'zx-btn--secondary' : 'zx-btn--primary'}}" data-index="{{index}}" catchtap="toggleFollow">{{item.followLabel}}</view>
        </view>
      </view>
    </view>
  </block>
</view>
