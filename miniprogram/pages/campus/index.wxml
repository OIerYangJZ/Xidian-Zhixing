<view class="page campus-service-page {{themeClass}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer"></radio-drawer>
  <view class="ios-nav" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px; background: var(--app-background);">
    <view class="nav-menu" bindtap="openDrawer" style="color: var(--brand-deep);"><view></view><view></view><view></view></view>
    <view class="nav-title">
      <view class="nav-name" style="color: var(--brand-deep);">校园</view>
      <view class="nav-subtitle" style="color: var(--text-secondary);">在学校里，需要的都在这里</view>
    </view>
  </view>

  <scroll-view scroll-y class="service-scroll" style="padding-top: {{navTop + navHeight + 8}}px;">
    <view class="schedule-panel">
      <view class="schedule-header">
        <view>
          <view class="schedule-title" style="color: var(--brand-deep);">今日日程</view>
          <view class="schedule-date" style="color: var(--text-secondary);">{{todayScheduleDate}}</view>
        </view>
      </view>
      <view wx:if="{{todaySchedules.length}}" class="schedule-list">
        <view class="schedule-item {{item.isEmphasized ? 'emphasized' : ''}}" wx:for="{{todaySchedules}}" wx:key="id">
          <view class="schedule-time">{{item.timeRange}}</view>
          <view class="schedule-body">
            <view class="schedule-name">{{item.title}}</view>
            <view class="schedule-meta">{{item.sourceLabel}} · {{item.location}}</view>
          </view>
          <view wx:if="{{item.isActive}}" class="schedule-state">进行中</view>
        </view>
      </view>
      <view wx:else class="schedule-empty">今天没有课表、考试或实验安排</view>
    </view>

    <view class="service-group" wx:for="{{groupedServices}}" wx:key="id">
      <view class="group-title" style="color: var(--brand-deep);">{{item.name}}</view>
      <view class="service-grid">
        <view class="service-item" wx:for="{{item.items}}" wx:for-item="service" wx:key="id" data-id="{{service.id}}" bindtap="openService">
          <view class="service-icon" style="border-color: var(--app-primary);"></view>
          <view class="service-name" style="color: var(--text-primary);">{{service.name}}</view>
          <view class="service-status" style="color: var(--app-primary);">{{service.status}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
