<view class="page campus-page {{themeClass}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer"></radio-drawer>

  <social-header fixed profile="{{userInfo}}" />

  <scroll-view scroll-y class="campus-scroll" style="padding-top: {{navTop + navHeight + 8}}px;">
    <view wx:if="{{errorMessage}}" class="today-empty">
      <view>{{errorMessage}}</view>
      <button bindtap="retryLoad">重新加载</button>
    </view>
    <view class="today-section">
      <view class="section-head">
        <view>
          <view class="section-title">今日日程</view>
          <view class="section-subtitle">{{todayScheduleDate}}</view>
        </view>
      </view>
      <view class="today-list" wx:if="{{todaySchedules.length}}">
        <view class="today-row {{item.isActive ? 'active' : ''}}" wx:for="{{todaySchedules}}" wx:key="id" data-source="{{item.source}}" bindtap="openScheduleService">
          <view class="today-time">{{item.timeRange}}</view>
          <view class="today-body">
            <view class="today-title">{{item.title}}</view>
            <view class="today-meta">{{item.sourceLabel}} · {{item.location}}</view>
          </view>
          <view wx:if="{{item.isActive}}" class="today-badge">进行中</view>
        </view>
      </view>
      <view wx:else class="today-empty">今天没有课表、考试或实验安排</view>
    </view>

    <view class="service-section" wx:for="{{groupedServices}}" wx:key="id">
      <view class="section-title group-title">{{item.name}}</view>
      <view class="service-grid">
        <view class="service-card" wx:for="{{item.items}}" wx:for-item="service" wx:key="id" data-id="{{service.id}}" bindtap="openService">
          <view class="ui-icon icon-{{service.kind === 'schedule' ? 'history' : service.kind === 'map' ? 'campus' : service.kind === 'external' ? 'share' : 'list'}}" aria-hidden="true"></view>
          <view class="service-name">{{service.name}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
