<view class="page campus-service-page {{themeClass}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer"></radio-drawer>
  <view class="ios-nav" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px;">
    <view class="nav-menu" bindtap="openDrawer"><view></view><view></view><view></view></view>
    <view class="nav-title">
      <view class="nav-name">校园</view>
      <view class="nav-subtitle">服务入口与地图</view>
    </view>
  </view>

  <scroll-view scroll-y class="service-scroll" style="padding-top: {{navTop + navHeight + 8}}px;">
    <view class="campus-hero">
      <view class="hero-title">校园服务</view>
      <view class="hero-desc">课表、水电、成绩、考试、地图和快速跳转已预留入口。</view>
    </view>

    <view class="map-entry" bindtap="openMap">
      <view>
        <view class="map-title">校园地图</view>
        <view class="map-desc">建筑位置、楼宇结构图、教室和办公室定位</view>
      </view>
      <view class="menu-arrow">></view>
    </view>

    <view class="service-group" wx:for="{{groupedServices}}" wx:key="id">
      <view class="group-title">{{item.name}}</view>
      <view class="service-grid">
        <view class="service-item" wx:for="{{item.items}}" wx:for-item="service" wx:key="id" data-id="{{service.id}}" bindtap="openService">
          <view class="service-icon"></view>
          <view class="service-name">{{service.name}}</view>
          <view class="service-status">{{service.status}}</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
