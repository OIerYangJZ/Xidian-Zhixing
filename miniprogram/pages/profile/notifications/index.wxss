.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.count {
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.read-all {
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.notice {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.notice.read {
  opacity: .72;
}

.dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: var(--app-error);
}

.notice-body {
  flex: 1;
  min-width: 0;
}

.notice-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 650;
}

.notice-content {
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.5;
}

.notice-time {
  margin-top: 14rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

/* Approved reference layout. */
.notification-page { padding:0 0 var(--tab-height); }
.head { min-height:60px; margin:0; padding:12rpx 36rpx; border-bottom:1px solid var(--app-divider); }
.read-all { min-height:44px; display:flex; align-items:center; }
.notice { padding:32rpx 36rpx; gap:20rpx; }
.notice.read { opacity:1; }
.notice.read .notice-title { font-weight:400; }
.notice-title { font-size:34rpx; }
.notice-content { font-size:32rpx; line-height:1.5; }
.notice-time { font-size:26rpx; }
.dot { background:var(--app-primary); }
