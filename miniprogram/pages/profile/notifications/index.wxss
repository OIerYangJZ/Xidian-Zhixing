.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 4rpx;
}

.count {
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.read-all {
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.notice {
  position: relative;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.notice.read {
  opacity: .72;
}

.dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: var(--app-error);
}

.notice-body {
  flex: 1;
  min-width: 0;
}

.notice-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 650;
}

.notice-content {
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.5;
}

.notice-time {
  margin-top: 14rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

.tabs {
  white-space: nowrap;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

.tab {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 28rpx;
  border: 2rpx solid var(--border-default);
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.tab-active {
  border-color: var(--app-primary);
  color: var(--app-primary);
  font-weight: 600;
}

.tab-count {
  margin-left: 8rpx;
  min-width: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--state-danger);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}
