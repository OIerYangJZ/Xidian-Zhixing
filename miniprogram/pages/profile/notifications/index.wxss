/* 通知 (handoff N1): chips, rows grouped by 今天 / 更早, unread tint and dot. */
.notification-page { background: var(--zx-surface); padding-bottom: 48rpx; }

.toolbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 20rpx 32rpx;
  border-bottom: 2rpx solid var(--zx-line);
}
.tabs { flex: 1; min-width: 0; white-space: nowrap; }
.tabs-row { display: inline-flex; gap: 16rpx; padding-right: 16rpx; }
.chip {
  display: inline-flex;
  align-items: flex-start;
  gap: 4rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--zx-line-strong);
  background: var(--zx-surface);
  font-size: 26rpx;
  color: var(--zx-text);
}
.chip--on { background: var(--zx-text); border-color: var(--zx-text); color: var(--zx-bg); font-weight: 600; }
.chip-count { font-size: 20rpx; line-height: 24rpx; }
.read-all {
  flex: none;
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: var(--zx-bg-sunk);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--zx-text);
}

.group-title { padding: 28rpx 40rpx 12rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-text-3); }

.notice { display: flex; align-items: flex-start; padding: 24rpx 40rpx 24rpx 16rpx; }
.notice--unread { background: var(--zx-primary-soft); }
.notice--pressed { opacity: 0.8; }
.notice-dot { width: 24rpx; flex: none; padding-top: 34rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 6rpx; background: var(--zx-danger); }
.notice-tile {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}
.notice-tile--info { background: var(--zx-info-soft); color: var(--zx-info); }
.notice-tile--success { background: var(--zx-success-soft); color: var(--zx-success); }
.notice-tile--danger { background: var(--zx-danger-soft); color: var(--zx-danger); }
.notice-tile--accent { background: var(--zx-accent-soft); color: var(--zx-accent-ink); }
.notice-tile--neutral { background: var(--zx-bg-sunk); color: var(--zx-text-2); }
.notice-body { flex: 1; min-width: 0; }
.notice-title { flex: 1; min-width: 0; font-size: 28rpx; line-height: 40rpx; font-weight: 600; color: var(--zx-text); }
.notice--unread .notice-title { font-weight: 700; }
.notice-time { flex: none; margin-left: 16rpx; }
.notice-quote {
  margin-top: 12rpx;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: var(--zx-bg-sunk);
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--zx-text-2);
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}
.empty-action { margin-top: 24rpx; }
