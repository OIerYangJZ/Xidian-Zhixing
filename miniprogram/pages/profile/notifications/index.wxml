<view class="page notification-page {{themeClass}}">
  <scroll-view class="tabs" scroll-x wx:if="{{items.length}}">
    <view class="tab {{category === item.key ? 'tab-active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectCategory">
      {{item.label}}<text class="tab-count" wx:if="{{item.unread}}">{{item.unread > 99 ? '99+' : item.unread}}</text>
    </view>
  </scroll-view>
  <view class="head" wx:if="{{items.length}}">
    <view class="count">{{unreadCount}} 条未读</view>
    <view class="read-all" bindtap="markAllRead">全部已读</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{errorMessage}}" class="empty">
    <view>{{errorMessage}}</view>
    <button bindtap="retryLoad">重新加载</button>
  </view>
  <view wx:elif="{{!items.length}}" class="empty">暂无通知</view>
  <view wx:elif="{{!visibleItems.length}}" class="empty">这一类还没有通知</view>
  <view wx:else>
    <view class="notice {{item.isRead ? 'read' : ''}}" wx:for="{{visibleItems}}" wx:key="id" data-index="{{item.sourceIndex}}" bindtap="openItem">
      <view class="dot" wx:if="{{!item.isRead}}"></view>
      <view class="notice-body">
        <view class="notice-title">{{item.title}}</view>
        <view class="notice-content">{{item.content}}</view>
        <view class="notice-time">{{item.timeText}}</view>
      </view>
    </view>
  </view>
</view>
