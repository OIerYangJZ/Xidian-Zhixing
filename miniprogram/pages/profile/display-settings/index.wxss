.display-page {
  background: var(--app-background);
}

.option-row.active .mobile-tile-title,
.check-mark {
  color: var(--app-primary);
  font-weight: 600;
}

.check-mark {
  margin-left: 16rpx;
  font-size: 30rpx;
}

.theme-picker-row {
  min-height: 112rpx;
}

.theme-swatches {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-left: 18rpx;
}

.theme-swatches text {
  display: block;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 50%;
}

.theme-swatches text:nth-child(1) {
  background: var(--app-primary);
}

.theme-swatches text:nth-child(2) {
  background: var(--app-background);
}

.theme-swatches text:nth-child(3) {
  background: var(--app-accent);
}

.picker-chevron {
  margin-left: 12rpx;
  color: var(--app-text-secondary);
  font-size: 34rpx;
  line-height: 1;
}
