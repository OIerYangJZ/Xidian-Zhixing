<view class="zx-page display-page {{themeClass}}">
  <view class="zx-section-title">深浅模式</view>
  <view class="modes">
    <view wx:for="{{modeOptions}}" wx:key="value" class="mode {{currentModeOption === item.value ? 'mode--on' : ''}}" data-mode="{{item.value}}" bindtap="onModeTap">
      <view class="mode-preview">
        <view wx:if="{{item.value !== 'dark'}}" class="half half--light"><view class="bar"></view><view class="bar bar--short"></view></view>
        <view wx:if="{{item.value !== 'light'}}" class="half half--dark"><view class="bar"></view><view class="bar bar--short"></view></view>
      </view>
      <view class="mode-label">{{item.label}}</view>
    </view>
  </view>

  <view class="zx-section-title">主题配色</view>
  <view class="zx-list">
    <view wx:for="{{themeOptions}}" wx:key="value" class="zx-list-item" data-index="{{index}}" bindtap="onThemeTap">
      <view class="swatches">
        <view class="swatch" style="background: {{item.swatches[0]}};"></view>
        <view class="swatch" style="background: {{item.swatches[1]}};"></view>
        <view class="swatch swatch--round" style="background: {{item.swatches[2]}};"></view>
      </view>
      <view class="zx-list-item__main">
        <view class="zx-list-item__title">{{item.label}}</view>
        <view class="zx-list-item__subtitle">{{item.desc}}</view>
      </view>
      <view wx:if="{{currentThemeOption === item.value}}" class="check"><view class="zx-i zx-i-check zx-i--sm"></view></view>
    </view>
  </view>

  <view class="zx-section-title">帖子布局 · 只影响树洞首页</view>
  <view class="layouts">
    <view wx:for="{{layoutOptions}}" wx:key="value" class="layout {{currentPostLayout === item.value ? 'layout--on' : ''}}" data-layout="{{item.value}}" bindtap="onLayoutTap">
      <view wx:if="{{item.value === 'threads'}}" class="layout-preview"><view class="lp-seal"></view><view class="lp-lines"><view class="bar"></view><view class="bar bar--short"></view></view></view>
      <view wx:else class="layout-preview layout-preview--card"><view class="lp-card"><view class="bar"></view><view class="bar bar--short"></view></view></view>
      <view class="layout-label">{{item.label}}</view>
    </view>
  </view>

  <view class="zx-section-title">语言</view>
  <view class="segment">
    <view wx:for="{{langOptions}}" wx:key="value" class="segment-option {{currentLanguage === item.value ? 'segment-option--on' : ''}}" data-lang="{{item.value}}" bindtap="onLangTap">{{item.label}}</view>
  </view>
</view>
