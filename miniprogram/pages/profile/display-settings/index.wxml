<view class="page display-page mobile-list-page {{themeClass}}">
  <view class="mobile-section-title">深浅模式</view>
  <view class="mobile-tile-card">
    <view
      wx:for="{{modeOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentModeOption === item.value ? 'active' : ''}}"
      data-mode="{{item.value}}"
      bindtap="onModeTap"
    >
      <text class="mobile-tile-icon">◑</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">显示模式</view>
      </view>
      <text wx:if="{{currentModeOption === item.value}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="mobile-section-title">主题配色</view>
  <view class="mobile-tile-card">
    <view
      wx:for="{{themeOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentThemeOption === item.value ? 'active' : ''}}"
      data-theme="{{item.value}}"
      bindtap="onThemeTap"
    >
      <text class="mobile-tile-icon">◐</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">配色主题</view>
      </view>
      <text wx:if="{{currentThemeOption === item.value}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="mobile-section-title">帖子布局</view>
  <view class="mobile-tile-card">
    <view
      wx:for="{{layoutOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentPostLayout === item.value ? 'active' : ''}}"
      data-layout="{{item.value}}"
      bindtap="onLayoutTap"
    >
      <text class="mobile-tile-icon">☰</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">树洞帖子样式</view>
      </view>
      <text wx:if="{{currentPostLayout === item.value}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="mobile-section-title">语言</view>
  <view class="mobile-tile-card">
    <view
      wx:for="{{langOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentLanguage === item.value ? 'active' : ''}}"
      data-lang="{{item.value}}"
      bindtap="onLangTap"
    >
      <text class="mobile-tile-icon">◎</text>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">多语言</view>
      </view>
      <text wx:if="{{currentLanguage === item.value}}" class="check-mark">✓</text>
    </view>
  </view>
</view>
