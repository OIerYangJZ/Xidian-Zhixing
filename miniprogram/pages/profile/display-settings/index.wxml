<view class="page display-page mobile-list-page {{themeClass}}">
  <view class="mobile-section-title">深浅模式</view>
  <view class="mobile-tile-card">
    <view
      wx:for="{{modeOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentModeOption === item.value ? 'active' : ''}}"
      data-mode="{{item.value}}"
      bindtap="onModeTap"
    >
      <view class="mobile-tile-icon ui-icon icon-display" aria-hidden="true"></view>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">显示模式</view>
      </view>
      <text wx:if="{{currentModeOption === item.value}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="mobile-section-title">语言</view>
  <view class="mobile-tile-card">
    <view
      wx:for="{{langOptions}}"
      wx:key="value"
      class="mobile-tile option-row {{currentLanguage === item.value ? 'active' : ''}}"
      data-lang="{{item.value}}"
      bindtap="onLangTap"
    >
      <view class="mobile-tile-icon ui-icon icon-language" aria-hidden="true"></view>
      <view class="mobile-tile-body">
        <view class="mobile-tile-title">{{item.label}}</view>
        <view class="mobile-tile-subtitle">多语言</view>
      </view>
      <text wx:if="{{currentLanguage === item.value}}" class="check-mark">✓</text>
    </view>
  </view>
</view>
