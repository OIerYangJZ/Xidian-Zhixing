.blocklist-page {
  background: var(--app-background);
  min-height: 100vh;
}

.empty {
  padding: 80rpx;
  text-align: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  color: var(--app-text-tertiary);
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: var(--app-text-secondary);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-card);
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 22rpx;
  background: var(--app-control);
}

.avatar-initial {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 36rpx;
  font-weight: bold;
}

.user-body {
  flex: 1;
  min-width: 0;
}

.name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.bio {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  margin-top: 6rpx;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}

.unblock-button {
  width: 120rpx !important;
  height: 60rpx;
  border-radius: 12rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 24rpx;
  line-height: 60rpx;
  padding: 0;
  margin: 0;
  font-weight: normal;
}

/* Approved reference layout. */
.page { padding:0 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.user-row { padding:28rpx 0; min-height:132rpx; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; margin:0; }
.avatar { border-radius:50%; width:88rpx; height:88rpx; }
.name { font-size:34rpx; }
.bio { font-size:28rpx; line-height:1.5; }
.message-button, .unblock-button { min-height:44px; border-radius:26px; border:1px solid var(--app-divider); background:transparent; color:var(--app-text-primary); }
