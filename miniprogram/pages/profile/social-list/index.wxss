/* 好友 / 关注 / 粉丝: one list with a switcher on top. */
@import "../../../styles/zx-list-page.wxss";

.tabs { display: flex; gap: 8rpx; margin: 24rpx 32rpx; padding: 6rpx; border-radius: 24rpx; background: var(--zx-bg-sunk); }
.tab { flex: 1; height: 64rpx; line-height: 64rpx; text-align: center; border-radius: 18rpx; font-size: 26rpx; color: var(--zx-text-2); }
.tab--on { background: var(--zx-surface); color: var(--zx-primary); font-weight: 600; box-shadow: var(--zx-shadow-1); }
.user { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 32rpx; border-bottom: 2rpx solid var(--zx-line); }
.user-avatar { width: 84rpx; height: 84rpx; flex: none; }
.user-body { flex: 1; min-width: 0; }
.user-bio { margin-top: 4rpx; }
