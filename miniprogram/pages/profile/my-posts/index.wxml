<import src="/templates/post-row.wxml" />
<view class="zx-page list-page {{themeClass}}">
  <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="retryLoad">重试</view>
  </view>
  <view wx:elif="{{!posts.length}}" class="zx-empty">
    <view class="zx-empty__title">还没有发过帖子</view>
    <view class="zx-empty__message">在树洞点「+」写下第一条</view>
  </view>
  <block wx:else>
    <view class="zx-caption list-count">共 {{posts.length}} 篇，包括匿名、仅自己可见和审核中的帖子</view>
    <view class="sheet">
      <view wx:for="{{posts}}" wx:key="id" class="row">
        <template is="post-row" data="{{item, index}}" />
        <view class="tools">
          <view class="segment">
            <view class="segment-option {{item.statusKey === 'none' ? 'segment-option--on' : ''}}" data-index="{{index}}" data-status="none" bindtap="changeStatus">不标记</view>
            <view class="segment-option {{item.statusKey === 'ongoing' ? 'segment-option--on' : ''}}" data-index="{{index}}" data-status="ongoing" bindtap="changeStatus">进行中</view>
            <view class="segment-option {{item.statusKey === 'resolved' ? 'segment-option--on' : ''}}" data-index="{{index}}" data-status="resolved" bindtap="changeStatus">已解决</view>
            <view class="segment-option {{item.statusKey === 'closed' ? 'segment-option--on' : ''}}" data-index="{{index}}" data-status="closed" bindtap="changeStatus">已结束</view>
          </view>
          <view class="zx-spacer"></view>
          <view class="tool-delete" data-index="{{index}}" bindtap="deleteOwnPost"><view class="zx-i zx-i-trash zx-i--sm"></view>删除</view>
        </view>
      </view>
    </view>
  </block>
</view>
