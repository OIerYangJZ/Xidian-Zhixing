/* 我的上传: a three-column grid with each image's review state. */
@import "../../../styles/zx-list-page.wxss";

.grid { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 24rpx 48rpx; }
.tile { position: relative; width: 226rpx; height: 226rpx; border-radius: 16rpx; overflow: hidden; background: var(--zx-bg-sunk); }
.tile-image { width: 100%; height: 100%; }
.tile-status { position: absolute; left: 8rpx; top: 8rpx; }
.tile-unused { position: absolute; right: 8rpx; bottom: 8rpx; padding: 2rpx 12rpx; border-radius: 12rpx; background: rgba(0, 0, 0, 0.5); color: #fff; font-size: 22rpx; }
