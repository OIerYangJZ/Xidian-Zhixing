/* 我的举报: reason, status badge, target and the admins' reply. */
@import "../../../styles/zx-list-page.wxss";

.report { padding: 28rpx 32rpx 24rpx; border-bottom: 2rpx solid var(--zx-line); }
.report-reason { flex: 1; min-width: 0; margin-right: 16rpx; }
.report-target { margin-top: 8rpx; }
.report-result {
  margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 20rpx;
  background: var(--zx-bg-sunk); font-size: 26rpx; line-height: 38rpx; color: var(--zx-text-2);
}
.report-meta { margin-top: 16rpx; }
.report-chevron { color: var(--zx-text-3); }
