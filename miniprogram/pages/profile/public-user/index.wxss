.public-page {
  padding: 42rpx 0;
  background: var(--app-background);
}

.profile-head {
  position: relative;
  overflow: hidden;
  margin: 0 30rpx;
  border-radius: 18rpx;
  padding: 34rpx 24rpx;
  background: var(--app-surface);
  text-align: center;
}

.cover {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  width: 100%;
  height: 180rpx;
  opacity: .32;
}

.avatar {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 34rpx;
  background: var(--app-control);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-primary);
  font-size: 48rpx;
  font-weight: 700;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.avatar.fallback {
  background: var(--app-primary-soft);
}

.name {
  margin-top: 20rpx;
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 800;
}

.bio {
  margin-top: 12rpx;
  color: var(--app-text-secondary);
  font-size: 27rpx;
  line-height: 1.5;
}

.school-meta {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.35;
}

.stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin: 42rpx 30rpx 0;
}

.primary,
.secondary {
  flex: 1;
  height: 78rpx;
  border-radius: 12rpx;
  font-size: 29rpx;
  line-height: 78rpx;
}

.primary {
  background: var(--app-primary);
  color: var(--app-on-primary);
}

.secondary {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.post-section {
  margin-top: 34rpx;
}

.section-title {
  margin: 0 30rpx 18rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 750;
}

.empty-small {
  padding: 34rpx 0;
  color: var(--app-text-secondary);
  font-size: 27rpx;
  text-align: center;
}

/* Approved reference layout. */
.public-page { padding:0 0 env(safe-area-inset-bottom); }
.profile-head { margin:0; padding:36rpx; border-radius:0; text-align:left; }
.avatar { border-radius:50%; }
.name { font-size:44rpx; font-weight:700; }
.bio { font-size:34rpx; line-height:1.5; }
.stats { justify-content:flex-start; font-size:28rpx; }
.actions { margin:20rpx 36rpx 0; }
.primary, .secondary { min-height:44px; border-radius:26px; border:1px solid var(--app-divider); }
.secondary { background:transparent; color:var(--app-text-primary); }
.post-section { border-top:1px solid var(--app-divider); padding-top:24rpx; }
