/* 主页 (handoff U1–U3). */
@import "../../../styles/zx-post.wxss";

.public-page { background: var(--zx-bg); padding-bottom: 64rpx; }

.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 210rpx; /* clear of the capsule */
  box-sizing: content-box;
}
.topbar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--zx-glass);
  color: var(--zx-text);
}
.topbar-more { margin-right: 8rpx; }
.page-state { padding-top: 320rpx; }

.cover { position: relative; overflow: hidden; background: var(--zx-hero); }
.cover-image { width: 100%; height: 100%; }

.head {
  position: relative;
  padding: 0 40rpx 32rpx;
  background: var(--zx-surface);
  border-bottom: 2rpx solid var(--zx-line);
}
.head-row { align-items: flex-end; gap: 16rpx; margin-top: -76rpx; }
.head-avatar { border: 6rpx solid var(--zx-surface); box-sizing: content-box; }
.head-btn { margin-bottom: 8rpx; }
.head-row .zx-btn { gap: 8rpx; margin-bottom: 8rpx; }
.name-row { gap: 12rpx; margin-top: 20rpx; }
.name { font-size: 44rpx; line-height: 56rpx; }
.bio { margin-top: 12rpx; font-size: 28rpx; line-height: 42rpx; color: var(--zx-text-2); }
.school { margin-top: 8rpx; }
.stats { display: flex; gap: 48rpx; margin-top: 24rpx; }
.stat { display: flex; align-items: baseline; gap: 8rpx; }
.stat-num { font-size: 34rpx; font-weight: 700; color: var(--zx-text); }
.stat-label { font-size: 24rpx; color: var(--zx-text-3); }

.tabs { display: flex; padding: 0 40rpx; background: var(--zx-surface); border-bottom: 2rpx solid var(--zx-line); }
.tab { padding: 20rpx 0 18rpx; font-size: 28rpx; color: var(--zx-text-3); border-bottom: 4rpx solid transparent; }
.tab--on { color: var(--zx-text); font-weight: 700; border-bottom-color: var(--zx-primary); }
.tab-count { margin-left: 10rpx; font-size: 24rpx; font-weight: 400; color: var(--zx-text-3); }
.sheet { background: var(--zx-surface); }

.blocked { padding: 160rpx 64rpx 0; text-align: center; }
.blocked-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  border-radius: 32rpx;
  background: var(--zx-bg-sunk);
  color: var(--zx-text-2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.blocked-title { margin-top: 32rpx; font-size: 36rpx; }
.blocked-text { margin-top: 12rpx; color: var(--zx-text-2); }
.empty-action { margin-top: 24rpx; }
