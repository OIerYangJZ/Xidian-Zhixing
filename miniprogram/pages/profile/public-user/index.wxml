<view class="page public-page {{themeClass}}">
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!profile}}" class="empty">用户不存在</view>
  <view wx:else>
    <view class="profile-head">
      <image class="cover" wx:if="{{profile.backgroundImageUrl}}" src="{{profile.backgroundImageUrl}}" mode="aspectFill"></image>
      <view class="avatar {{profile.avatarUrl ? 'has-image' : 'fallback'}}">
        <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else>{{profile.avatarInitial}}</text>
      </view>
      <view class="name">{{profile.nickname || profile.alias || '西电同学'}}</view>
      <view wx:if="{{profile.college || profile.major}}" class="school-meta">
        {{profile.college}}{{profile.college && profile.major ? ' · ' : ''}}{{profile.major}}
      </view>
      <view class="bio">{{profile.bio || '这个同学还没有填写简介'}}</view>
      <view class="stats">
        <text>关注 {{profile.followingCount || 0}}</text>
        <text>粉丝 {{profile.followerCount || 0}}</text>
      </view>
    </view>
    <view class="actions">
      <button class="primary" bindtap="toggleFollow">{{profile.isFollowing ? '已关注' : '关注'}}</button>
      <button class="secondary" bindtap="messageUser">私信</button>
    </view>
    <view class="post-section">
      <view class="section-title">TA 的发布</view>
      <view wx:if="{{!posts.length}}" class="empty-small">暂无公开发布</view>
      <view class="feed-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost">
        <image wx:if="{{item.authorAvatarUrl}}" class="feed-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="feed-avatar">{{item.authorInitial || profile.avatarInitial}}</view>
        <view class="feed-body">
          <view class="feed-head">
            <text class="feed-author">{{item.authorAlias || profile.nickname || profile.alias}}</text>
            <view wx:if="{{item.sectionName}}" class="feed-channel">{{item.sectionName}}</view>
            <text class="feed-time">{{item.timeText}}</text>
          </view>
          <view class="feed-title">{{item.displayTitle}}</view>
          <view class="feed-summary">{{item.summary}}</view>
          <view class="feed-actions">
            <view class="feed-action"><view class="feed-action-icon like-icon"></view><text>{{item.likeCount || 0}}</text></view>
            <view class="feed-action"><view class="feed-action-icon comment-icon"></view><text>{{item.commentCount || 0}}</text></view>
            <view class="feed-action"><view class="feed-action-icon bookmark-icon"></view><text>{{item.favoriteCount || 0}}</text></view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
