<import src="/templates/post-row.wxml" />
<view class="zx-page public-page {{themeClass}}">
  <view class="topbar" style="padding-top: {{navTop}}px; height: {{navHeight}}px;">
    <view class="topbar-btn" bindtap="goBack"><view class="zx-i zx-i-back"></view></view>
    <view class="zx-spacer"></view>
    <view wx:if="{{profile}}" class="topbar-btn topbar-more" bindtap="showMore"><view class="zx-i zx-i-more"></view></view>
  </view>

  <view wx:if="{{loading}}" class="zx-empty page-state"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty page-state">
    <view class="zx-empty__title">主页加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="retryLoad">重试</view>
  </view>
  <view wx:elif="{{!profile}}" class="zx-empty page-state"><view class="zx-empty__title">用户不存在</view></view>
  <block wx:else>
    <view class="cover" style="height: {{navTop + navHeight + 90}}px;">
      <image wx:if="{{profile.backgroundImageUrl}}" class="cover-image" src="{{profile.backgroundImageUrl}}" mode="aspectFill"></image>
    </view>

    <view class="head">
      <view class="zx-row head-row">
        <view class="zx-avatar zx-avatar--lg head-avatar">
          <image wx:if="{{profile.avatarUrl}}" src="{{profile.avatarUrl}}" mode="aspectFill"></image>
          <text wx:else>{{profile.avatarInitial}}</text>
        </view>
        <view class="zx-spacer"></view>
        <block wx:if="{{profile.isBlockedByMe}}">
          <view class="zx-btn zx-btn--secondary zx-btn--small" bindtap="unblock"><view class="zx-i zx-i-block zx-i--sm"></view>解除屏蔽</view>
        </block>
        <block wx:elif="{{!profile.isOwnProfile}}">
          <view wx:if="{{profile.canDirectMessage}}" class="zx-btn zx-btn--secondary zx-btn--small head-btn" bindtap="messageUser"><view class="zx-i zx-i-chat zx-i--sm"></view>私信</view>
          <view wx:if="{{profile.canFollow}}" class="zx-btn zx-btn--small head-btn {{profile.isFollowing ? 'zx-btn--secondary' : 'zx-btn--primary'}}" bindtap="toggleFollow">
            <view wx:if="{{!profile.isFollowing}}" class="zx-i zx-i-plus zx-i--sm"></view>{{profile.followLabel}}
          </view>
        </block>
      </view>
      <view class="zx-row name-row">
        <view class="zx-display name">{{profile.name}}</view>
        <view wx:if="{{profile.verified}}" class="zx-badge zx-badge--success"><view class="zx-i zx-i-check zx-i--sm"></view>已认证</view>
        <view class="zx-badge zx-badge--accent">{{profile.levelLabel}}</view>
      </view>
      <view wx:if="{{profile.bio}}" class="bio">{{profile.bio}}</view>
      <view wx:if="{{profile.schoolLine}}" class="zx-caption school">{{profile.schoolLine}}</view>
      <view class="stats">
        <view class="stat"><text class="stat-num">{{profile.postCount || 0}}</text><text class="stat-label">帖子</text></view>
        <view class="stat"><text class="stat-num">{{profile.followingCount || 0}}</text><text class="stat-label">关注</text></view>
        <view class="stat"><text class="stat-num">{{profile.followerCount || 0}}</text><text class="stat-label">粉丝</text></view>
      </view>
    </view>

    <!-- Handoff U3: blocked, the posts give way to a note. -->
    <view wx:if="{{profile.isBlockedByMe}}" class="blocked">
      <view class="blocked-mark"><view class="zx-i zx-i-block zx-i--lg"></view></view>
      <view class="zx-display blocked-title">你已屏蔽 TA</view>
      <view class="zx-caption blocked-text">不显示 TA 的帖子。解除屏蔽后恢复。</view>
    </view>
    <block wx:else>
      <view class="tabs"><view class="tab tab--on">TA 的动态<text class="tab-count">{{profile.postCount}}</text></view></view>
      <view wx:if="{{!posts.length}}" class="zx-empty"><view class="zx-empty__message">还没有公开的帖子或转发</view></view>
      <view wx:else class="sheet">
        <block wx:for="{{posts}}" wx:key="eventKey">
          <template is="post-row" data="{{item, index}}" />
        </block>
      </view>
    </block>
  </block>
</view>
