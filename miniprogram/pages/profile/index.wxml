<view class="zx-page me {{themeClass}}">
  <view class="me-hero" style="padding-top: {{navTop + navHeight + 8}}px;">
    <view class="me-mark">知</view>
    <view class="me-settings" style="top: {{navTop}}px;" bindtap="goToSettings" aria-label="设置"><view class="zx-i zx-i-sliders"></view></view>

    <view wx:if="{{profileError}}" class="zx-inline-message zx-inline-message--danger me-error" bindtap="refreshProfile">{{profileError}} · 点击重试</view>

    <view class="zx-row me-identity">
      <view class="zx-avatar zx-avatar--lg me-avatar" bindtap="goToEditProfile">
        <image wx:if="{{userInfo && userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        <text wx:else>{{userInfo ? userInfo.avatarInitial : '匿'}}</text>
      </view>
      <view class="me-names">
        <view class="zx-row me-name-row">
          <view class="zx-display me-name zx-ellipsis">{{userInfo ? (userInfo.nickname || userInfo.alias || '匿名同学') : ''}}</view>
          <view wx:if="{{userInfo && (userInfo.isVerified || userInfo.verified)}}" class="zx-badge zx-badge--success"><view class="zx-i zx-i--sm zx-i-check"></view>已认证</view>
        </view>
        <view wx:if="{{userInfo && (userInfo.college || userInfo.major)}}" class="zx-caption me-school">{{userInfo.college}}{{userInfo.college && userInfo.major ? ' · ' : ''}}{{userInfo.major}}</view>
      </view>
    </view>

    <view class="zx-row me-stats">
      <view class="me-stat" data-type="followers" bindtap="openFollowSheet"><text class="me-stat-value">{{profileError ? '--' : followers.length}}</text><text class="zx-caption">粉丝</text></view>
      <view class="me-stat" data-type="following" bindtap="openFollowSheet"><text class="me-stat-value">{{profileError ? '--' : following.length}}</text><text class="zx-caption">关注</text></view>
      <view class="zx-badge zx-badge--accent">{{(userInfo && userInfo.userLevelLabel) || 'Lv.1'}}</view>
      <view class="zx-spacer"></view>
      <view class="zx-btn zx-btn--secondary zx-btn--small me-edit" bindtap="goToEditProfile">编辑资料</view>
    </view>
  </view>

  <view class="me-body">
    <view class="zx-card quick">
      <view wx:for="{{quickEntries}}" wx:key="key" class="quick-item" data-url="{{item.url}}" bindtap="openEntry" hover-class="zx-btn-hover">
        <view class="quick-icon quick-icon--{{item.tone}}"><view class="zx-i zx-i-{{item.icon}}"></view></view>
        <view class="quick-label">{{item.label}}</view>
      </view>
    </view>

    <view class="zx-list menu">
      <view wx:for="{{menu}}" wx:key="key" class="zx-list-item" data-url="{{item.url}}" bindtap="openEntry" hover-class="menu-item--pressed">
        <view class="menu-icon menu-icon--{{item.tone}}"><view class="zx-i zx-i-{{item.icon}}"></view></view>
        <view class="zx-list-item__main zx-list-item__title">{{item.label}}</view>
        <view wx:if="{{item.note}}" class="zx-badge zx-badge--neutral">{{item.note}}</view>
        <view class="zx-list-item__chevron"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{showFollowSheet}}" class="sheet-mask" bindtap="closeFollowSheet" catchtouchmove="stopTouchMove">
    <view class="follow-sheet" catchtap="stopTouchMove">
      <view class="follow-handle"></view>
      <view class="zx-row follow-head">
        <text class="zx-title">{{followSheetTitle}}</text>
        <text class="zx-caption follow-count">{{followSheetUsers.length}}</text>
      </view>
      <scroll-view class="follow-list" scroll-y>
        <view wx:if="{{!followSheetUsers.length}}" class="zx-empty"><view class="zx-empty__message">暂无数据</view></view>
        <block wx:else>
          <view wx:if="{{followSheetMutualUsers.length}}" class="zx-section-title follow-section">好友</view>
          <view class="zx-row follow-row" wx:for="{{followSheetMutualUsers}}" wx:key="id">
            <view class="zx-avatar"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>{{item.avatarInitial}}</text></view>
            <view class="zx-label follow-name">{{item.nickname}}</view>
            <view class="zx-badge zx-badge--success">互相关注</view>
          </view>
          <view wx:if="{{followSheetMutualUsers.length && followSheetOtherUsers.length}}" class="zx-section-title follow-section">其他</view>
          <view class="zx-row follow-row" wx:for="{{followSheetOtherUsers}}" wx:key="id">
            <view class="zx-avatar"><image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"></image><text wx:else>{{item.avatarInitial}}</text></view>
            <view class="zx-label follow-name">{{item.nickname}}</view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
