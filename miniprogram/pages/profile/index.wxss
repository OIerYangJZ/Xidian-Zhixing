/* 我的 (handoff A4). */
.me { padding-bottom: 48rpx; }

.me-hero { position: relative; padding: 0 40rpx 40rpx; background: var(--zx-hero); overflow: hidden; }
.me-mark {
  position: absolute;
  right: -40rpx;
  top: 40rpx;
  font-family: "STZhongsong", "Songti SC", "STSong", serif;
  font-size: 320rpx;
  line-height: 1;
  color: var(--zx-primary);
  opacity: 0.07;
}
.me-settings {
  position: absolute;
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--zx-glass);
  color: var(--zx-text-2);
}
.me-error { margin-bottom: 20rpx; }
.me-identity { gap: 28rpx; position: relative; }
.me-avatar { box-shadow: 0 0 0 6rpx var(--zx-surface); }
.me-names { flex: 1; min-width: 0; }
.me-name-row { gap: 12rpx; }
.me-name { font-size: 44rpx; line-height: 58rpx; max-width: 70%; }
.me-school { margin-top: 6rpx; font-size: 26rpx; color: var(--zx-text-2); }
.me-stats { gap: 32rpx; margin-top: 32rpx; position: relative; }
.me-stat { display: flex; align-items: baseline; gap: 8rpx; }
.me-stat-value { font-size: 36rpx; font-weight: 700; color: var(--zx-text); }
.me-edit { background: var(--zx-surface); box-shadow: inset 0 0 0 2rpx var(--zx-line); }

.me-body { padding: 0 32rpx; margin-top: -8rpx; }
.quick { display: flex; padding: 28rpx 8rpx; }
.quick-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 14rpx; }
.quick-icon { width: 80rpx; height: 80rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; }
.quick-label { font-size: 24rpx; font-weight: 600; color: var(--zx-text); }

.quick-icon--primary, .menu-icon--primary { background: var(--zx-primary-soft); color: var(--zx-primary); }
.quick-icon--info, .menu-icon--info { background: var(--zx-info-soft); color: var(--zx-info); }
.quick-icon--accent, .menu-icon--accent { background: var(--zx-accent-soft); color: var(--zx-accent-ink); }
.quick-icon--seal, .menu-icon--seal { background: var(--zx-seal-soft); color: var(--zx-seal); }
.quick-icon--success, .menu-icon--success { background: var(--zx-success-soft); color: var(--zx-success); }
.quick-icon--danger, .menu-icon--danger { background: var(--zx-danger-soft); color: var(--zx-danger); }
.quick-icon--neutral, .menu-icon--neutral { background: var(--zx-bg-sunk); color: var(--zx-text-2); }

.menu { margin-top: 24rpx; }
.menu-icon { width: 56rpx; height: 56rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; flex: none; }
.menu-item--pressed { background: var(--zx-bg-sunk); }

.sheet-mask { position: fixed; inset: 0; z-index: 50; background: var(--zx-scrim); display: flex; align-items: flex-end; }
.follow-sheet { width: 100%; max-height: 70vh; background: var(--zx-raised); border-radius: 48rpx 48rpx 0 0; padding: 16rpx 32rpx 48rpx; box-sizing: border-box; }
.follow-handle { width: 72rpx; height: 8rpx; border-radius: 4rpx; background: var(--zx-line-strong); margin: 0 auto 24rpx; }
.follow-head { gap: 12rpx; padding-bottom: 16rpx; }
.follow-list { max-height: 56vh; }
.follow-section { padding-top: 16rpx; }
.follow-row { gap: 20rpx; padding: 16rpx 0; }
.follow-name { flex: 1; }
