page {
  background: var(--app-background);
}

.profile-page {
  min-height: 100vh;
  padding: 0;
  background: var(--app-background);
}

.ios-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 8px;
  background: var(--app-background);
  border-bottom: 1rpx solid var(--app-divider);
}

.profile-back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  margin-right: 8rpx;
  border-radius: 40rpx;
}

.profile-back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid var(--brand-deep);
  border-bottom: 4rpx solid var(--brand-deep);
  transform: rotate(45deg);
}

.nav-title {
  flex: 1;
  min-width: 0;
}

.nav-name {
  color: var(--brand-deep);
  font-size: 31rpx;
  font-weight: 700;
}

.nav-subtitle {
  color: var(--text-secondary);
  font-size: 22rpx;
}

.profile-header {
  position: relative;
  background: var(--app-surface);
}

.profile-background {
  position: relative;
  height: 120rpx;
  background: var(--app-primary-soft);
  overflow: hidden;
}

.profile-background.has-image {
  height: 240rpx;
  background: var(--app-surface);
}

.profile-background-image,
.profile-background-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.profile-background-image {
  background: var(--app-primary-soft);
}

.profile-background-overlay {
  background: rgba(255, 255, 255, .08);
}


.profile-avatar-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 32rpx;
}

.profile-avatar-wrap {
  position: relative;
  z-index: 2;
  width: 160rpx;
  height: 160rpx;
  margin-top: -48rpx;
  border: 8rpx solid var(--app-surface);
  border-radius: 36rpx;
  background: var(--app-primary-soft);
  overflow: hidden;
}

.profile-avatar {
  display: block;
  width: 144rpx;
  height: 144rpx;
  border-radius: 30rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 144rpx;
  text-align: center;
}

.profile-avatar-text {
  display: block;
}

.profile-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.profile-pill-button,
.profile-icon-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 40rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.profile-pill-button {
  padding: 0 32rpx;
}

.profile-icon-button {
  width: 80rpx;
  padding-bottom: 2rpx;
  font-size: 28rpx;
}

.profile-info {
  padding: 0 32rpx 24rpx;
  background: var(--app-surface);
}

.profile-info.with-background {
  background: var(--app-surface-translucent);
}


.profile-name {
  color: var(--app-text-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-bio {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
  word-break: break-word;
}

.profile-school-meta {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.35;
}

.profile-gender {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.25;
}

.profile-gender-icon {
  font-size: 28rpx;
  line-height: 1;
}

.profile-stats {
  display: flex;
  align-items: center;
  gap: 40rpx;
  margin-top: 16rpx;
}

.profile-stat {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  min-height: 32rpx;
}

.profile-stat-value {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
}

.profile-stat-label {
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1;
}

.profile-level {
  height: 34rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: var(--app-accent-soft);
  color: var(--app-accent);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.profile-divider {
  height: 1rpx;
  background: var(--app-divider);
}

.profile-tabs {
  display: flex;
  height: 92rpx;
  background: var(--app-surface);
}

.profile-tab {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  font-weight: 500;
}

.profile-tab.active {
  color: var(--app-text-primary);
  font-weight: 600;
}

.profile-tab-indicator {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 4rpx;
  background: var(--app-primary);
}

.profile-tab-body {
  min-height: 60vh;
  background: var(--app-background);
}

.profile-loading,
.profile-empty {
  min-height: 360rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--app-text-tertiary);
  font-size: 28rpx;
}

.profile-empty {
  flex-direction: column;
  gap: 24rpx;
}

.profile-empty-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  color: var(--app-divider);
}

.article-icon {
  border: 6rpx solid currentColor;
  border-radius: 10rpx;
}

.article-icon::before,
.article-icon::after {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.article-icon::before {
  top: 28rpx;
}

.article-icon::after {
  top: 48rpx;
}

.star-icon::before {
  content: '☆';
  position: absolute;
  inset: 0;
  font-size: 92rpx;
  line-height: 96rpx;
  text-align: center;
}

.comment-empty-icon {
  border: 6rpx solid currentColor;
  border-radius: 20rpx;
}

.comment-empty-icon::after {
  content: '';
  position: absolute;
  left: 24rpx;
  bottom: -12rpx;
  width: 28rpx;
  height: 28rpx;
  border-left: 6rpx solid currentColor;
  border-bottom: 6rpx solid currentColor;
  transform: rotate(-45deg);
  background: var(--app-background);
}

.activity-list {
  background: var(--app-surface);
}

.activity-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.activity-post {
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.activity-content {
  display: -webkit-box;
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  word-break: break-word;
}

.activity-time {
  margin-top: 8rpx;
  color: var(--app-text-tertiary);
  font-size: 24rpx;
}

.follow-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, .24);
}

.follow-sheet {
  width: 100%;
  max-height: 78vh;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 32rpx 32rpx 0 0;
  background: var(--app-surface);
  overflow: hidden;
}

.follow-sheet-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 20rpx auto;
  border-radius: 4rpx;
  background: var(--app-divider);
}

.follow-sheet-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 32rpx 24rpx;
}

.follow-sheet-title {
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 600;
}

.follow-sheet-count {
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.follow-sheet-divider {
  height: 1rpx;
  background: var(--app-divider);
}

.follow-sheet-list {
  max-height: calc(78vh - 120rpx);
}

.follow-sheet-empty {
  padding: 96rpx 32rpx;
  color: var(--app-text-tertiary);
  font-size: 28rpx;
  text-align: center;
}

.follow-sheet-section {
  padding: 24rpx 32rpx 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.follow-user-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 12rpx 32rpx;
}

.follow-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

.follow-avatar-text {
  display: block;
}

.follow-name {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-mutual-badge {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 20rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 40rpx;
}

/* Approved reference layout. */
.profile-header { background:var(--app-background); }
.profile-background { background:var(--app-background); }
.profile-avatar { border-radius:50%; }
.profile-avatar-row { padding:24rpx 36rpx 0; }
.profile-info { padding-left:36rpx; padding-right:36rpx; }
.profile-name { font-size:44rpx; }
.profile-bio { font-size:34rpx; line-height:1.5; }
.profile-pill-button { min-height:44px; display:flex; align-items:center; justify-content:center; border:1px solid var(--app-divider); border-radius:28px; background:transparent; color:var(--app-text-primary); }
.profile-icon-button { width:44px; height:44px; display:flex; align-items:center; justify-content:center; background:transparent; }
.profile-tabs { border-bottom:1px solid var(--app-divider); }
.profile-tab { min-height:52px; font-size:32rpx; }
.profile-tab-indicator { background:var(--app-primary); height:2px; }
.follow-avatar { border-radius:50%; }
.activity-item { margin:0; padding:28rpx 36rpx; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }

.profile-avatar-wrap { border-radius:50%; }
