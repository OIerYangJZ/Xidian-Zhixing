.legal-page {
  padding: 32rpx 32rpx 80rpx;
}

.legal-title {
  margin-bottom: 24rpx;
  color: var(--app-text-primary);
  font-size: 40rpx;
  font-weight: 700;
}

.section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--app-divider);
}

.section-heading {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.section-body {
  margin-top: 14rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.65;
}

/* Approved reference layout. */
.legal-page { padding:24rpx 36rpx calc(40rpx + env(safe-area-inset-bottom)); }
.legal-title { font-size:40rpx; line-height:1.4; }
.section { margin:0; padding:28rpx 0; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.section-heading { font-size:34rpx; font-weight:700; }
.section-body { font-size:32rpx; line-height:1.8; color:var(--app-text-primary); }
