/* 用户协议 / 隐私政策 / 社区规范 / 举报说明 / 致谢: numbered sections on a card. */
.legal-page { padding: 40rpx 32rpx 80rpx; background: var(--zx-bg); }
.legal-title { font-size: 48rpx; line-height: 64rpx; }
.legal-sub { margin-top: 8rpx; }
.legal-card { margin-top: 32rpx; padding: 8rpx 32rpx; }
.section { padding: 28rpx 0; }
.section + .section { border-top: 2rpx solid var(--zx-line); }
.section-heading { display: flex; align-items: center; font-size: 30rpx; }
.section-no {
  display: inline-flex; align-items: center; justify-content: center; flex: none;
  width: 40rpx; height: 40rpx; margin-right: 16rpx; border-radius: 12rpx;
  background: var(--zx-primary-soft); color: var(--zx-primary); font-size: 22rpx; font-weight: 700;
}
.section-body { margin-top: 12rpx; color: var(--zx-text-2); line-height: 1.75; }
