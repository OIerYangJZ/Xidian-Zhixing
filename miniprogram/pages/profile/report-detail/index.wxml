<view class="zx-page detail-page {{themeClass}}">
  <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view wx:if="{{reportId}}" class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="loadDetail">重试</view>
  </view>
  <view wx:elif="{{!report}}" class="zx-empty">
    <view class="zx-empty__title">举报记录不存在</view>
  </view>
  <block wx:else>
    <view class="zx-card summary">
      <view class="zx-row">
        <view class="zx-title zx-ellipsis summary-reason">{{report.reason || '举报'}}</view>
        <view class="zx-badge zx-badge--{{report.statusTone}}">{{report.statusText}}</view>
      </view>
      <view class="zx-caption summary-time">提交于 {{report.createdAt || '-'}}<block wx:if="{{report.handledAt}}"> · 处理于 {{report.handledAt}}</block></view>
    </view>

    <view class="zx-section-title">补充描述</view>
    <view class="zx-card block">
      <view class="zx-body {{report.description ? '' : 'block-empty'}}">{{report.description || '未填写补充描述'}}</view>
    </view>

    <view class="zx-section-title">处理结果</view>
    <view class="zx-card block">
      <view class="zx-body {{report.result ? '' : 'block-empty'}}">{{report.result || '管理员还没有处理，处理后结果会显示在这里'}}</view>
    </view>

    <view wx:if="{{report.targetType === 'post'}}" class="zx-btn zx-btn--secondary zx-btn--block target-button" bindtap="openTarget">查看被举报的帖子</view>
  </block>
</view>
