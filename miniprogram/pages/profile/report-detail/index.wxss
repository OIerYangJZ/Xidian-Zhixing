/* 举报详情: status card, then the description and the admins' reply. */
.detail-page { padding: 24rpx 32rpx 64rpx; background: var(--zx-bg); }
.summary { padding: 32rpx; margin-bottom: 40rpx; }
.summary-reason { flex: 1; min-width: 0; margin-right: 16rpx; }
.summary-time { margin-top: 12rpx; }
.block { padding: 28rpx 32rpx; margin-bottom: 40rpx; }
.block .zx-body { white-space: pre-wrap; word-break: break-all; color: var(--zx-text); }
.block .block-empty { color: var(--zx-text-3); }
.empty-action { margin-top: 24rpx; }
