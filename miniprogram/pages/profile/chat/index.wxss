/* 私信 (handoff H1–H4). */
.chat-page { background: var(--zx-bg); padding-bottom: 260rpx; }

.chat-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 16rpx;
  padding-right: 200rpx; /* clear of the capsule */
  box-sizing: content-box;
  background: var(--zx-surface);
  border-bottom: 2rpx solid var(--zx-line);
}
.bar-back, .bar-more { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: var(--zx-text); flex: none; }
.bar-peer { flex: 1; min-width: 0; display: flex; align-items: center; gap: 16rpx; }
.bar-name { min-width: 0; font-size: 30rpx; }
.bar-text { padding: 12rpx 16rpx; font-size: 28rpx; color: var(--zx-text); }
.bar-text--primary { color: var(--zx-primary); font-weight: 600; }
.bar-title { flex: 1; text-align: center; }

.message-list { padding: 16rpx 32rpx 32rpx; }
.first-note {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--zx-line);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.first-note-icon { width: 72rpx; height: 72rpx; border-radius: 22rpx; background: var(--zx-surface); color: var(--zx-primary); display: flex; align-items: center; justify-content: center; }
.first-note-title { margin-top: 16rpx; font-size: 30rpx; }
.first-note-text { margin-top: 8rpx; line-height: 40rpx; color: var(--zx-text-2); }

.time-label { display: flex; justify-content: center; margin: 20rpx 0; }
.time-label text { padding: 6rpx 20rpx; border-radius: 20rpx; background: var(--zx-bg-sunk); font-size: 22rpx; color: var(--zx-text-3); }
.recalled { margin: 16rpx 0; text-align: center; font-size: 24rpx; color: var(--zx-text-3); }

.row { display: flex; align-items: flex-end; gap: 16rpx; margin: 12rpx -12rpx; padding: 6rpx 12rpx; border-radius: 24rpx; }
.row--mine { justify-content: flex-end; }
.row--selected { background: var(--zx-primary-soft); }
.row-avatar { flex: none; }
.select-dot {
  flex: none;
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 16rpx;
  margin-right: auto;
  border-radius: 22rpx;
  border: 3rpx solid var(--zx-line-strong);
  color: var(--zx-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.row:not(.row--mine) .select-dot { margin-right: 0; }
.select-dot--on { background: var(--zx-primary); border-color: var(--zx-primary); }
.retry {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 44rpx;
  border-radius: 28rpx;
  background: var(--zx-danger);
  color: var(--zx-on-danger);
  display: flex;
  align-items: center;
  justify-content: center;
}
.bubble-col { max-width: 72%; display: flex; flex-direction: column; }
.row--mine .bubble-col { align-items: flex-end; }
.bubble {
  padding: 20rpx 28rpx 16rpx;
  border-radius: 36rpx 36rpx 36rpx 12rpx;
  background: var(--zx-surface);
  border: 2rpx solid var(--zx-line);
  box-shadow: var(--zx-shadow-1);
}
.bubble--mine {
  border: none;
  border-radius: 36rpx 36rpx 12rpx 36rpx;
  background: linear-gradient(180deg, var(--zx-primary), var(--zx-primary-pressed));
  box-shadow: 0 12rpx 28rpx var(--zx-primary-glow);
}
.bubble--faded { opacity: 0.55; }
.quote { margin-bottom: 12rpx; padding: 10rpx 20rpx; border-radius: 16rpx; background: var(--zx-bg-sunk); font-size: 24rpx; line-height: 34rpx; color: var(--zx-text-2); }
.bubble--mine .quote { background: rgba(255, 255, 255, 0.16); color: var(--zx-on-primary); }
.bubble-text { font-size: 30rpx; line-height: 46rpx; color: var(--zx-text); word-break: break-all; }
.bubble--mine .bubble-text { color: var(--zx-on-primary); }
.bubble-time { margin-top: 8rpx; text-align: right; font-size: 20rpx; color: var(--zx-text-3); }
.bubble--mine .bubble-time { color: var(--zx-on-primary); opacity: 0.75; }
.failed-note { margin-top: 8rpx; font-size: 22rpx; font-weight: 600; color: var(--zx-danger); }

.chat-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--zx-surface);
  border-top: 2rpx solid var(--zx-line);
}
.action-note { text-align: center; margin-bottom: 16rpx; }
.action-buttons { gap: 20rpx; }
.action-btn { flex: 1; }
.state-bar { display: flex; flex-direction: column; gap: 16rpx; }
.state-text { display: flex; align-items: center; justify-content: center; gap: 10rpx; font-size: 26rpx; color: var(--zx-text-2); }
.state-icon { color: var(--zx-danger); }
.state-text--wait { color: var(--zx-warning); font-weight: 600; font-size: 24rpx; }
.input-locked { height: 84rpx; line-height: 84rpx; padding: 0 32rpx; border-radius: 42rpx; background: var(--zx-bg-sunk); color: var(--zx-text-3); font-size: 28rpx; }

.reply-preview { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; padding: 8rpx 8rpx 8rpx 12rpx; }
.reply-bar { width: 6rpx; height: 64rpx; border-radius: 3rpx; background: var(--zx-primary); }
.reply-main { flex: 1; min-width: 0; }
.reply-title { font-size: 22rpx; font-weight: 600; color: var(--zx-primary); }
.reply-text { font-size: 24rpx; color: var(--zx-text-2); }
.reply-close { padding: 12rpx; color: var(--zx-text-3); }
.input-row { display: flex; align-items: center; gap: 16rpx; }
.chat-input { flex: 1; height: 84rpx; padding: 0 32rpx; border-radius: 42rpx; background: var(--zx-bg-sunk); font-size: 28rpx; color: var(--zx-text); }
.send { flex: none; width: 84rpx; height: 84rpx; border-radius: 42rpx; background: var(--zx-bg-sunk); color: var(--zx-text-3); display: flex; align-items: center; justify-content: center; }
.send--on { background: var(--zx-primary); color: var(--zx-on-primary); }

.picker-mask { position: fixed; inset: 0; z-index: 40; background: var(--zx-scrim); display: flex; align-items: flex-end; }
.picker-sheet { width: 100%; padding: 32rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; background: var(--zx-surface); box-sizing: border-box; }
.picker-title { padding: 0 8rpx 20rpx; }
.picker-cancel { margin-top: 20rpx; }
.empty-action { margin-top: 24rpx; }
