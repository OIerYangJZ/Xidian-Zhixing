<view class="page feedback-page safe-bottom {{themeClass}}">
  <view class="form-panel">
    <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
      <view class="category-picker">
        <text>类型</text>
        <text>{{categories[categoryIndex]}}</text>
      </view>
    </picker>
    <textarea class="content-input" maxlength="800" value="{{content}}" placeholder="写给西电知行信箱" bindinput="onContentInput" auto-height />
    <input class="contact-input" maxlength="80" value="{{contact}}" placeholder="联系方式（可选）" bindinput="onContactInput" />
  </view>
  <button class="primary-button submit" loading="{{submitting}}" bindtap="submitFeedback">提交</button>

  <view class="record-section">
    <view class="record-title">我的信箱记录</view>
    <view wx:if="{{loadingRecords}}" class="record-empty">正在加载...</view>
    <view wx:elif="{{recordsError}}" class="record-empty" bindtap="loadRecords">{{recordsError}} · 点击重试</view>
    <view wx:elif="{{!records.length}}" class="record-empty">暂无提交记录</view>
    <view wx:else>
      <view class="record-card" wx:for="{{records}}" wx:key="id">
        <view class="record-head">
          <view class="record-category">{{item.category}}</view>
          <view class="record-status {{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="record-content">{{item.content}}</view>
        <view wx:if="{{item.schoolReply}}" class="record-reply">回复：{{item.schoolReply}}</view>
        <view class="record-time">{{item.timeText}}</view>
      </view>
    </view>
  </view>
</view>
