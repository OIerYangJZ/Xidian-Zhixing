/* 信箱: the feedback form, then my earlier letters and their replies. */
.feedback-page { padding: 24rpx 32rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--zx-bg); }
.form { padding: 0 32rpx; }
.field { padding: 24rpx 0; }
.field + .field { border-top: 2rpx solid var(--zx-line); }
.field-label { font-size: 24rpx; font-weight: 600; color: var(--zx-text-3); }
.required { margin-left: 4rpx; color: var(--zx-danger); }
.field-input { margin-top: 12rpx; height: 56rpx; font-size: 30rpx; color: var(--zx-text); }
.field-textarea { margin-top: 12rpx; width: 100%; height: 240rpx; font-size: 30rpx; line-height: 44rpx; color: var(--zx-text); }
.field-placeholder { color: var(--zx-text-3); }
.field-count { text-align: right; }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.chip { padding: 12rpx 24rpx; border-radius: 20rpx; background: var(--zx-bg-sunk); font-size: 26rpx; color: var(--zx-text-2); border: 2rpx solid transparent; }
.chip--on { background: var(--zx-primary-soft); color: var(--zx-primary); border-color: var(--zx-primary); font-weight: 600; }

.submit { margin-top: 32rpx; }
.records-title { padding-top: 56rpx; }
.records-empty { padding: 40rpx 48rpx; }
.record { padding: 28rpx 32rpx; }
.record + .record { margin-top: 20rpx; }
.record-category { flex: 1; min-width: 0; margin-right: 16rpx; }
.record-content { margin-top: 12rpx; color: var(--zx-text); white-space: pre-wrap; word-break: break-all; }
.record-reply { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 20rpx; background: var(--zx-bg-sunk); font-size: 26rpx; line-height: 38rpx; color: var(--zx-text-2); white-space: pre-wrap; }
.record-reply-label { font-size: 22rpx; font-weight: 600; color: var(--zx-primary); margin-bottom: 4rpx; }
.record-time { margin-top: 16rpx; }
.empty-action { margin-top: 24rpx; }
