.feedback-page {
  padding: 32rpx;
  background: var(--app-background);
}

.form-panel {
  padding: 32rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.category-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 650;
}

.content-input {
  width: 100%;
  min-height: 280rpx;
  color: var(--app-text-primary);
  font-size: 29rpx;
  line-height: 1.6;
  border-radius: 16rpx;
}

.contact-input {
  height: 82rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 28rpx;
}

.submit {
  margin-top: 32rpx;
  height: 100rpx;
  border-radius: 24rpx;
  line-height: 100rpx;
}

.record-section {
  margin-top: 42rpx;
}

.record-title {
  margin-bottom: 18rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
}

.record-empty {
  padding: 42rpx 0;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  text-align: center;
}

.record-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 20rpx;
  background: var(--app-surface);
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.record-category {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.35;
}

.record-status {
  flex: 0 0 auto;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 38rpx;
}

.record-status.resolved {
  background: rgba(78, 125, 102, .14);
  color: var(--app-success);
}

.record-content {
  margin-top: 16rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  line-height: 1.55;
  word-break: break-word;
}

.record-reply {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: var(--app-primary-soft);
  color: var(--app-text-primary);
  font-size: 25rpx;
  line-height: 1.5;
}

.record-time {
  margin-top: 14rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

/* Approved reference layout. */
.feedback-page { padding:0 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.form-panel { padding:28rpx 0; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.content-input { border:1px solid var(--app-divider); padding:24rpx; font-size:32rpx; border-radius:24rpx; }
.contact-input { font-size:32rpx; min-height:44px; }
.submit { min-height:44px; border-radius:26px; }
.record-card { margin:0; padding:24rpx 0; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.record-content { font-size:32rpx; line-height:1.6; }
