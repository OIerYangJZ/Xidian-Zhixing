.about-page {
  background: var(--app-background);
}

.brand-card {
  margin-bottom: 40rpx;
  padding: 56rpx 32rpx 48rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--zx-line);
  background: var(--zx-hero);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.brand-seal { width: 136rpx; height: 136rpx; font-size: 68rpx; border-radius: 22rpx; }
.brand-title { margin-top: 28rpx; font-size: 52rpx; line-height: 68rpx; }
.brand-latin { margin-top: 4rpx; font-size: 20rpx; letter-spacing: 6rpx; color: var(--zx-text-3); }
.brand-subtitle { margin-top: 20rpx; font-size: 28rpx; color: var(--zx-text-2); }
.version { margin-top: 12rpx; font-size: 24rpx; color: var(--zx-text-3); }

.copyright {
  padding-top: 40rpx;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
  text-align: center;
}
