<view class="auth-page {{themeClass}}">
  <view class="auth-main">
    <view class="brand-block">
      <view class="brand-mark">电</view>
      <view class="brand-name">SeeRadio</view>
      <view class="brand-subtitle">西电统一身份认证登录</view>
    </view>

    <view class="auth-tip">账号登录时，学号和密码仅在西电官方统一身份认证页面输入，西电知行不会接触或保存该登录密码。完成认证后，请点击左上角返回小程序。</view>

    <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleLogin">
      {{attemptId ? '重新打开官方认证页面' : '前往西电官方认证'}}
    </button>

  </view>

  <view class="agreement-hint" wx:if="{{agreementHint}}">请先阅读并同意用户协议和隐私政策</view>
  <view class="agreement {{agreementHint ? 'agreement-shake' : ''}}" bindtap="toggleAgreement">
    <view class="agreement-box {{agreed ? 'agreement-box-on' : ''}} {{agreementHint ? 'agreement-box-error' : ''}}">{{agreed ? '✓' : ''}}</view>
    <text>我已阅读并同意</text>
    <text class="agreement-link" catchtap="goTerms">《用户协议》</text>
    <text>和</text>
    <text class="agreement-link" catchtap="goPrivacy">《隐私政策》</text>
  </view>
</view>
