<view class="auth-page {{themeClass}}">
  <view class="auth-main">
    <view class="brand-block">
      <view class="brand-mark">电</view>
      <view class="brand-name">SeeRadio</view>
      <view class="brand-subtitle">西电校园服务</view>
    </view>

    <view class="mode-control">
      <view class="mode-item {{authMode === 'xidian' ? 'active' : ''}}" data-mode="xidian" bindtap="switchAuthMode">西电统一认证</view>
      <view class="mode-item {{authMode === 'local' ? 'active' : ''}}" data-mode="local" bindtap="switchAuthMode">电台账号</view>
    </view>

    <view class="auth-tip" wx:if="{{authMode === 'xidian'}}">用于校园服务测试和一站式校内入口验证</view>

    <view class="form-list">
      <view class="form-row">
        <view class="field-label">账号</view>
        <input
          class="field-input"
          value="{{identifier}}"
          placeholder="{{authMode === 'xidian' ? '学号' : '学号或邮箱'}}"
          placeholder-class="field-placeholder"
          bindinput="onIdentifierInput"
        />
      </view>
      <view class="form-divider"></view>
      <view class="form-row">
        <view class="field-label">密码</view>
        <input
          class="field-input"
          type="password"
          value="{{password}}"
          placeholder="{{authMode === 'xidian' ? '统一认证密码' : '电台账号密码'}}"
          placeholder-class="field-placeholder"
          bindinput="onPasswordInput"
        />
      </view>
    </view>

    <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleLogin">
      {{authMode === 'xidian' ? '登录统一认证' : '登录'}}
    </button>

    <view class="aux-actions" wx:if="{{authMode === 'local'}}">
      <text class="aux-link" bindtap="handleEmailCodeLogin">验证码登录/注册</text>
      <text class="aux-dot"></text>
      <text class="aux-link" bindtap="handleResetPassword">忘记密码</text>
    </view>
  </view>

  <view class="agreement">
    <text>登录即代表您同意</text>
    <text class="agreement-link" bindtap="goTerms">用户协议</text>
    <text>与</text>
    <text class="agreement-link" bindtap="goPrivacy">隐私政策</text>
  </view>
</view>
