.auth-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 96rpx 32rpx 40rpx;
  background: var(--app-background);
}

.auth-main {
  width: 100%;
}

.brand-block {
  padding: 18rpx 4rpx 52rpx;
}

.brand-mark {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 76rpx;
  text-align: center;
}

.brand-name {
  margin-top: 28rpx;
  color: var(--app-text-primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}

.brand-subtitle {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.4;
}

.mode-control {
  display: flex;
  height: 68rpx;
  padding: 4rpx;
  border-radius: 14rpx;
  background: var(--app-control);
}

.mode-item {
  flex: 1;
  height: 60rpx;
  border-radius: 11rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 60rpx;
  text-align: center;
}

.mode-item.active {
  background: var(--app-surface);
  color: var(--app-text-primary);
  box-shadow: none;
}

.auth-tip {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  line-height: 1.4;
}

.form-list {
  margin-top: 28rpx;
  overflow: hidden;
  border-radius: 18rpx;
  border: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 28rpx;
}

.field-label {
  width: 116rpx;
  flex: 0 0 auto;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.3;
}

.field-input {
  flex: 1;
  min-width: 0;
  height: 104rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.field-placeholder {
  color: var(--app-text-tertiary);
}

.form-divider {
  height: 1rpx;
  margin-left: 144rpx;
  background: var(--app-divider);
}

.login-button {
  height: 92rpx;
  margin-top: 34rpx;
  border-radius: 18rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.login-button[disabled] {
  background: var(--app-divider) !important;
  color: var(--app-text-secondary) !important;
}

.aux-actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  min-height: 80rpx;
  margin-top: 18rpx;
}

.aux-link {
  color: var(--app-primary);
  font-size: 27rpx;
  line-height: 1.4;
}

.aux-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--app-divider);
}

.agreement {
  padding-top: 56rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.agreement-link {
  margin: 0 6rpx;
  color: var(--app-primary);
  font-weight: 600;
}

/* Approved reference layout. */
.auth-page { padding:0 36rpx calc(24rpx + env(safe-area-inset-bottom)); }
.brand-block { text-align:left; }
.brand-mark { border:0; border-radius:0; background:transparent; color:var(--app-text-primary); display:flex; align-items:center; justify-content:flex-start; box-shadow:none; }
.brand-mark .ui-icon { width:48px; height:48px; }
.brand-name { font-size:56rpx; }
.auth-tip { border:0; border-radius:0; background:transparent; padding:24rpx 0; font-size:30rpx; line-height:1.7; color:var(--app-text-secondary); }
.login-button { min-height:44px; border-radius:26px; background:var(--app-primary); color:var(--app-on-primary); }
.agreement { font-size:26rpx; line-height:1.7; }
