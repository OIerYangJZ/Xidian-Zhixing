/* 登录 (handoff L1 / L2). */
.auth-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}
.watermark {
  position: absolute;
  right: -120rpx;
  top: 260rpx;
  font-family: "STZhongsong", "Songti SC", "STSong", serif;
  font-size: 640rpx;
  line-height: 1;
  color: var(--zx-primary);
  opacity: 0.06;
  pointer-events: none;
}

.share-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 32rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: var(--zx-surface);
  border: 2rpx solid var(--zx-line);
}
/* Not .share-icon: app.wxss masks that class into the legacy share glyph. */
.share-tile {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: var(--zx-primary-soft);
  color: var(--zx-primary);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx; }
.brand-seal { width: 152rpx; height: 152rpx; font-size: 76rpx; border-radius: 24rpx; }
.brand-name { margin-top: 32rpx; font-size: 56rpx; line-height: 72rpx; }
.brand-latin { margin-top: 8rpx; font-size: 20rpx; letter-spacing: 6rpx; color: var(--zx-text-3); }
.brand-tagline { margin-top: 28rpx; font-size: 28rpx; color: var(--zx-text-2); font-family: "STZhongsong", "Songti SC", serif; }

.panel {
  position: relative;
  padding: 44rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--zx-surface);
  border-radius: 48rpx 48rpx 0 0;
  border-top: 2rpx solid var(--zx-line);
  box-shadow: var(--zx-shadow-2);
}
.panel .zx-btn { gap: 12rpx; }
.panel-note { margin-top: 20rpx; text-align: center; font-size: 24rpx; color: var(--zx-text-3); }
.panel-safe { margin-top: 8rpx; text-align: center; font-size: 22rpx; color: var(--zx-text-3); }

.hint-wrap { min-height: 24rpx; margin-top: 16rpx; }
.hint {
  display: inline-block;
  margin-bottom: 12rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: var(--zx-raised);
  border: 2rpx solid var(--zx-line);
  box-shadow: var(--zx-shadow-1);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--zx-text);
}
.agreement { display: flex; align-items: center; flex-wrap: wrap; gap: 4rpx; font-size: 26rpx; color: var(--zx-text-2); }
.agreement--shake { animation: shake 0.42s ease-out; }
@keyframes shake {
  20% { transform: translateX(-10rpx); }
  40% { transform: translateX(10rpx); }
  60% { transform: translateX(-6rpx); }
  80% { transform: translateX(4rpx); }
}
.box {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  border: 3rpx solid var(--zx-line-strong);
  color: var(--zx-on-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.box--on { background: var(--zx-primary); border-color: var(--zx-primary); }
.box--error { border-color: var(--zx-danger); }
.link { color: var(--zx-primary); font-weight: 600; }

/* 管理员登录: quiet, under the agreement. */
.admin-entry { margin-top: 40rpx; text-align: center; font-size: 26rpx; color: var(--zx-text-3); text-decoration: underline; }
