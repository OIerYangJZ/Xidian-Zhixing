/* 我的评论: each comment under the post it was left on. */
@import "../../../styles/zx-list-page.wxss";

.comment { padding: 28rpx 32rpx 24rpx; border-bottom: 2rpx solid var(--zx-line); }
.comment-post {
  display: inline-flex; align-items: center; gap: 8rpx; vertical-align: top;
  max-width: 100%; box-sizing: border-box; padding: 8rpx 16rpx; border-radius: 16rpx;
  background: var(--zx-bg-sunk); font-size: 24rpx; color: var(--zx-text-2);
}
.comment-post .zx-i { flex: none; color: var(--zx-text-3); }
.comment-content { margin-top: 16rpx; color: var(--zx-text); white-space: pre-wrap; word-break: break-all; }
.comment-meta { margin-top: 16rpx; }
.tool-delete { display: flex; align-items: center; gap: 6rpx; font-size: 24rpx; color: var(--zx-danger); }
