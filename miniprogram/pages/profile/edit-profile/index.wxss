/* 编辑资料: cover + avatar card, the editable fields, read-only identity. */
.edit-page { padding: 24rpx 32rpx 80rpx; background: var(--zx-bg); }
.edit-page .zx-section-title { padding-top: 40rpx; }

.identity { overflow: hidden; }
.cover { position: relative; height: 240rpx; }
.cover-image, .cover-wash { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.cover-actions { position: absolute; right: 20rpx; bottom: 20rpx; display: flex; gap: 12rpx; }
.cover-chip {
  display: flex; align-items: center; gap: 8rpx; padding: 12rpx 20rpx; border-radius: 16rpx;
  background: var(--zx-surface); opacity: 0.94; font-size: 24rpx; font-weight: 600; color: var(--zx-text);
}
.avatar-row { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 28rpx; }
.avatar { width: 112rpx; height: 112rpx; flex: none; font-size: 44rpx; }
.avatar-text { flex: 1; min-width: 0; }

.form { padding: 0 32rpx; }
.field { padding: 24rpx 0; }
.field + .field { border-top: 2rpx solid var(--zx-line); }
.field-label { font-size: 24rpx; font-weight: 600; color: var(--zx-text-3); }
.field-input { margin-top: 12rpx; height: 56rpx; font-size: 30rpx; color: var(--zx-text); }
.field-textarea { margin-top: 12rpx; width: 100%; height: 150rpx; font-size: 30rpx; line-height: 44rpx; color: var(--zx-text); }
.field-placeholder { color: var(--zx-text-3); }
.field-count { text-align: right; }

.segment { display: flex; margin-top: 16rpx; padding: 4rpx; border-radius: 20rpx; background: var(--zx-bg-sunk); }
.segment-option { flex: 1; height: 60rpx; line-height: 60rpx; text-align: center; border-radius: 16rpx; font-size: 26rpx; color: var(--zx-text-2); }
.segment-option--on { background: var(--zx-surface); color: var(--zx-primary); font-weight: 600; box-shadow: var(--zx-shadow-1); }

.readonly-value { max-width: 60%; }
.save { margin-top: 48rpx; }
.empty-action { margin-top: 24rpx; }
