.settings-list-page {
  background: var(--app-background);
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.logout-button {
  height: 100rpx;
  margin: 16rpx 8rpx 0;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: transparent;
  color: var(--app-error);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 100rpx;
}

.settings-brand {
  padding: 40rpx 0 0;
  color: var(--app-divider);
  font-size: 24rpx;
  text-align: center;
}

/* Approved reference layout. */
.logout-button { min-height:44px; margin:28rpx 0 0; border-radius:26px; }
.settings-brand { color:var(--app-text-secondary); }
