.settings-list-page {
  background: var(--zx-bg);
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.logout-button {
  width: 100% !important;
  height: 96rpx;
  margin: 16rpx 0 0;
  border: none;
  border-radius: 28rpx;
  background: var(--zx-bg-sunk);
  color: var(--zx-danger);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 96rpx;
}
.logout-button::after { border: none; }

.settings-brand {
  padding: 40rpx 0 0;
  color: var(--zx-text-3);
  font-size: 24rpx;
  text-align: center;
}
