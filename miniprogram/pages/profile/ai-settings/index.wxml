<view class="page ai-settings-page {{themeClass}}">
  <view class="section">
    <view class="section-title">AI 服务</view>
    <view class="switch-row">
      <text>运行状态</text>
      <text>{{statusText}}</text>
    </view>
    <view class="field" wx:if="{{configured}}">
      <view class="label">当前模型</view>
      <view class="picker-value">{{model}}</view>
    </view>
    <view class="field" wx:if="{{configured && models.length}}">
      <view class="label">服务器可用模型</view>
      <view class="picker-value">{{modelsText}}</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">知识检索</view>
    <view class="switch-row"><text>校园知识库</text><text>服务器统一维护</text></view>
    <view class="switch-row"><text>论坛公开帖子</text><text>自动检索</text></view>
  </view>

  <button class="save-button" loading="{{loading}}" bindtap="refresh">刷新状态</button>
</view>
