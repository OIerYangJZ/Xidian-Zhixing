.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
  background: var(--app-background);
}

.section {
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.section-title {
  padding: 24rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid var(--app-divider);
}

.field {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.preset-row {
  padding: 24rpx 24rpx 0;
}

.preset-button {
  margin: 0;
  width: 100%;
}

.label {
  margin-bottom: 12rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
}

.input,
.picker-value {
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.secondary-button,
.save-button,
.minor-button {
  border-radius: 24rpx;
  font-size: 29rpx;
}

.secondary-button {
  margin: 24rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
}

.switch-row {
  min-height: 92rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--app-text-primary);
  font-size: 29rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.hint {
  padding: 0 24rpx 16rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.knowledge-input {
  width: auto;
  min-height: 360rpx;
  margin: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: var(--app-control);
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.action-row {
  padding: 0 24rpx 24rpx;
}

.minor-button {
  height: 76rpx;
  line-height: 76rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.save-button {
  margin-top: 36rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
}

/* Approved reference layout. */
.section { margin:0; padding:28rpx 36rpx; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.section-title { font-size:34rpx; }
.field { margin-top:24rpx; }
.picker-value { min-height:44px; border:1px solid var(--app-divider); border-radius:24rpx; font-size:32rpx; }
.save-button { min-height:44px; border-radius:26px; }
