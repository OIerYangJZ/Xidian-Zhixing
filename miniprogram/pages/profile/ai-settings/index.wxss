/* AI 设置: two read-only lists and 刷新状态. */
.settings-page { min-height: 100vh; padding: 32rpx 32rpx 64rpx; box-sizing: border-box; background: var(--zx-bg); }
.section-gap { margin-top: 40rpx; }
.models { white-space: normal; }
.tile--success { background: var(--zx-success-soft); color: var(--zx-success); }
.tile--warning { background: var(--zx-warning-soft); color: var(--zx-warning); }
.tile--danger { background: var(--zx-danger-soft); color: var(--zx-danger); }
.tile--neutral { background: var(--zx-bg-sunk); color: var(--zx-text-3); }
.refresh { margin-top: 48rpx; gap: 10rpx; }
