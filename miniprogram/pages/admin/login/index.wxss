/* 管理员登录. */
.admin-login { padding: 48rpx 32rpx; }
.head { display: flex; flex-direction: column; align-items: center; text-align: center; }
.head-seal { width: 112rpx; height: 112rpx; font-size: 48rpx; }
.head-title { margin-top: 24rpx; font-size: 44rpx; color: var(--zx-text); }
.head-note { margin-top: 16rpx; line-height: 1.6; }
.form { margin-top: 48rpx; }
.label { margin-top: 24rpx; font-size: 26rpx; color: var(--zx-text-2); }
.label:first-child { margin-top: 0; }
.input { margin-top: 12rpx; height: 88rpx; padding: 0 24rpx; border-radius: 20rpx; background: var(--zx-bg-sunk); font-size: 30rpx; color: var(--zx-text); }
.error { margin-top: 24rpx; }
.submit { margin-top: 36rpx; }
.foot { margin-top: 32rpx; text-align: center; }
