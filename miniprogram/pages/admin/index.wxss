.admin-page {
  min-height: 100vh;
  background: var(--app-background);
}

.admin-tabs {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx 10rpx;
  white-space: nowrap;
}

.admin-tab {
  flex: 0 0 auto;
  height: 62rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--app-primary-soft);
  color: var(--app-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 62rpx;
}

.admin-tab.active {
  background: var(--app-primary);
  color: var(--app-on-primary);
}

.admin-body {
  padding: 0 20rpx 40rpx;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.metric-card,
.admin-card {
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.metric-card {
  padding: 24rpx;
}

.metric-value {
  color: var(--app-text-primary);
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
}

.metric-label {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0 8rpx;
  white-space: nowrap;
}

.filter-chip {
  flex: 0 0 auto;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--app-primary-soft);
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 54rpx;
}

.filter-chip.active {
  background: var(--app-primary);
  color: var(--app-on-primary);
}

.admin-card {
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.card-head,
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title,
.section-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.status-pill {
  flex: 0 0 auto;
  padding: 0 14rpx;
  border-radius: 14rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 22rpx;
  line-height: 40rpx;
}

.card-meta,
.card-content,
.card-time,
.user-stats,
.simple-name {
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.45;
}

.card-content {
  color: var(--app-text-primary);
}

.card-time {
  color: var(--app-text-tertiary);
}

.review-image {
  width: 100%;
  height: 320rpx;
  margin-bottom: 14rpx;
  border-radius: 18rpx;
  background: var(--app-divider);
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.action-button,
.small-button,
.full-button,
.text-button {
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 58rpx;
}

.action-button.primary,
.full-button {
  background: var(--app-primary);
  color: var(--app-on-primary);
}

.action-button.danger,
.danger-text {
  color: var(--app-error);
}

.text-button {
  background: transparent;
  padding: 0;
}

.full-button {
  width: 100%;
  margin-top: 14rpx;
}

.full-button.secondary {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.form-card .form-label {
  margin-top: 14rpx;
  margin-bottom: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  border: 1rpx solid var(--app-divider);
  border-radius: 18rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 26rpx;
}

.form-input {
  height: 80rpx;
  padding: 0 18rpx;
}

.form-textarea {
  min-height: 180rpx;
  padding: 16rpx 18rpx;
}

.form-textarea.code {
  min-height: 240rpx;
  font-family: var(--font-en-body);
}

.form-textarea.large {
  min-height: 300rpx;
}

.simple-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 82rpx;
  border-top: 1rpx solid var(--app-divider);
}

.simple-row:first-of-type {
  border-top: none;
}

.simple-name {
  flex: 1;
  min-width: 0;
  margin-top: 0;
  color: var(--app-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-card .user-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.compact {
  padding: 56rpx 0;
}

.knowledge-source-row {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--app-divider);
}

.knowledge-source-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Approved reference layout. */
.admin-tabs { border-bottom:1px solid var(--app-divider); background:var(--app-background); }
.admin-tab { min-height:52px; padding:24rpx; border-radius:0; background:transparent; border-bottom:2px solid transparent; }
.admin-tab.active { background:transparent; color:var(--app-primary); border-bottom-color:var(--app-primary); }
.admin-body { padding:0 36rpx 32rpx; }
.admin-card { margin:0; padding:28rpx 0; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.metric-grid { gap:0; }
.metric-card { border:0; border-bottom:1px solid var(--app-divider); border-radius:0; background:transparent; padding:32rpx 16rpx; }
.card-title { font-size:34rpx; }
.card-content { font-size:30rpx; line-height:1.6; }
.action-row { flex-wrap:wrap; gap:16rpx; }
.action-button, .small-button, .full-button, .text-button { min-height:44px; height:auto; line-height:44px; border-radius:26px; }
.form-input, .form-textarea { border:1px solid var(--app-divider); border-radius:24rpx; font-size:32rpx; padding:24rpx; }
.form-input { min-height:44px; }
.filter-chip { min-height:44px; border:1px solid var(--app-divider); border-radius:26px; }
