/* 管理: tabs, filter chips, then cards with their actions. */
.admin-page { min-height: 100vh; background: var(--zx-bg); padding-bottom: 64rpx; }
.empty-icon { width: 72rpx; height: 72rpx; margin: 0 auto 20rpx; color: var(--zx-text-3); }
.empty-action { margin-top: 24rpx; }
.zx-empty.compact { padding: 64rpx 32rpx; font-size: 26rpx; color: var(--zx-text-3); }

/* Tabs: underlined, scrolling sideways. */
.admin-tabs {
  display: flex;
  white-space: nowrap;
  padding: 0 16rpx;
  background: var(--zx-surface);
  border-bottom: 2rpx solid var(--zx-line);
}
.admin-tab {
  display: inline-block;
  flex: 0 0 auto;
  padding: 20rpx 20rpx 16rpx;
  font-size: 28rpx;
  color: var(--zx-text-2);
  border-bottom: 4rpx solid transparent;
}
.admin-tab.active { color: var(--zx-primary); font-weight: 600; border-bottom-color: var(--zx-primary); }

.admin-body { padding: 24rpx 32rpx 0; }
.scope-note { padding: 20rpx 32rpx 0; }

.filter-row { display: flex; white-space: nowrap; margin-bottom: 16rpx; }
.filter-chip {
  display: inline-block;
  flex: 0 0 auto;
  margin-right: 12rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--zx-line);
  background: var(--zx-surface);
  font-size: 24rpx;
  color: var(--zx-text-2);
}
.filter-chip.active { border-color: var(--zx-primary); background: var(--zx-primary-soft); color: var(--zx-primary); font-weight: 600; }

/* 概览 */
.metric-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.metric-card,
.admin-card {
  border: 2rpx solid var(--zx-line);
  border-radius: 28rpx;
  background: var(--zx-surface);
  box-shadow: var(--zx-shadow-1);
}
.metric-card { padding: 28rpx; }
.metric-value { font-size: 44rpx; font-weight: 700; line-height: 1.2; color: var(--zx-text); font-variant-numeric: tabular-nums; }
.metric-label { margin-top: 8rpx; font-size: 24rpx; color: var(--zx-text-3); }

/* Cards */
.admin-card { padding: 28rpx; margin-top: 16rpx; overflow: hidden; }
.card-head { display: flex; align-items: flex-start; gap: 16rpx; }
.card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 42rpx;
  color: var(--zx-text);
  word-break: break-all;
}
.status-pill { flex: none; }
.card-meta { margin-top: 8rpx; font-size: 24rpx; line-height: 34rpx; color: var(--zx-text-3); word-break: break-all; }
.card-content {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: var(--zx-text-2);
  white-space: pre-wrap;
  word-break: break-all;
  display: -webkit-box;
  -webkit-line-clamp: 6;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-time { margin-top: 12rpx; font-size: 22rpx; color: var(--zx-text-3); }
.review-image { display: block; width: calc(100% + 56rpx); height: 360rpx; margin: -28rpx -28rpx 24rpx; background: var(--zx-bg-sunk); }
.user-stats { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 12rpx; font-size: 24rpx; color: var(--zx-text-2); }

/* Actions */
.action-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 2rpx solid var(--zx-line); }
.action-button {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: var(--zx-bg-sunk);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--zx-text);
}
.action-button.primary { background: var(--zx-primary); color: var(--zx-on-primary); }
.action-button.danger { background: var(--zx-danger-soft); color: var(--zx-danger); }

/* 系统 */
.section-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 8rpx; }
.section-title { flex: 1; font-size: 30rpx; font-weight: 600; color: var(--zx-text); }
.small-button {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: var(--zx-primary-soft);
  color: var(--zx-primary);
  font-size: 24rpx;
  font-weight: 600;
}
.simple-row { display: flex; align-items: center; gap: 24rpx; min-height: 88rpx; border-top: 2rpx solid var(--zx-line); }
.simple-name { flex: 1; min-width: 0; font-size: 28rpx; color: var(--zx-text); }
.text-button { font-size: 26rpx; color: var(--zx-primary); }
.text-button.danger-text { color: var(--zx-danger); }

.form-label { margin: 24rpx 0 12rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-text-3); }
.form-label:first-child { margin-top: 0; }
.form-input,
.form-textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: var(--zx-bg-sunk);
  font-size: 28rpx;
  color: var(--zx-text);
}
.form-input { height: 80rpx; padding: 0 24rpx; }
.form-textarea { height: 200rpx; padding: 20rpx 24rpx; line-height: 40rpx; }
.form-textarea.code { font-family: Menlo, monospace; font-size: 24rpx; }
.form-textarea.large { height: 360rpx; }
.full-button {
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 28rpx;
  border-radius: 24rpx;
  background: var(--zx-primary);
  color: var(--zx-on-primary);
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}
.full-button.secondary { margin-top: 16rpx; background: var(--zx-bg-sunk); color: var(--zx-text); }

.knowledge-source-row { padding: 20rpx 0; border-top: 2rpx solid var(--zx-line); }
.knowledge-source-row .action-row { border-top: none; padding-top: 0; margin-top: 16rpx; }

/* Export scopes: more chips than fit one line. */
.filter-row.filter-wrap { flex-wrap: wrap; white-space: normal; gap: 12rpx 0; }
