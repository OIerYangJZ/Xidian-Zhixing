/* 校园 AI (handoff M2b). */
.ai-home { background: var(--zx-bg); padding-bottom: 48rpx; }
.ai-head { padding: 0 40rpx 72rpx; margin-bottom: -40rpx; background: var(--zx-hero); }
.ai-head-bar { display: flex; align-items: center; }
.ai-title { font-size: 44rpx; line-height: 56rpx; }
.ai-subtitle { margin-top: 12rpx; font-size: 26rpx; color: var(--zx-text-2); }

.ai-body {
  min-height: 70vh;
  padding: 32rpx 32rpx 0;
  background: var(--zx-bg);
  border-radius: 40rpx 40rpx 0 0;
}
.ai-note { margin-bottom: 20rpx; }

.status-head { gap: 24rpx; }
.status-icon {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: var(--zx-bg-sunk);
  color: var(--zx-text-2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.status-dot {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: var(--zx-accent-ink);
  color: var(--zx-on-primary);
  border: 4rpx solid var(--zx-surface);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.status-kind { margin-top: 4rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-accent-ink); }
.status-text { margin-top: 24rpx; font-size: 26rpx; line-height: 40rpx; color: var(--zx-text-2); }
.status-actions { gap: 16rpx; margin-top: 24rpx; }
.status-btn { flex: 1; }

.ask { display: flex; align-items: center; gap: 16rpx; padding: 20rpx 20rpx 20rpx 28rpx; }
.ask-icon { color: var(--zx-primary); }
.ask-placeholder { flex: 1; font-size: 28rpx; color: var(--zx-text-3); }
.ask-send {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, var(--zx-primary), var(--zx-primary-pressed));
  color: var(--zx-on-primary);
}

.ai-section { margin-top: 36rpx; }
.examples { display: flex; flex-wrap: wrap; gap: 16rpx; }
.example {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--zx-surface);
  border: 2rpx solid var(--zx-line);
  font-size: 26rpx;
  color: var(--zx-text-2);
}

.new-chat { margin-top: 32rpx; }
.history-head { margin: 40rpx 8rpx 16rpx; }
.history-more { font-size: 26rpx; font-weight: 600; color: var(--zx-primary); }
.history-icon { width: 56rpx; height: 56rpx; border-radius: 18rpx; }
.history-item--pressed { background: var(--zx-bg-sunk); }
.history-empty { padding: 48rpx 0; }
