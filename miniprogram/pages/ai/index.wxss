.ai-page {
  background: var(--app-background);
}

.ai-topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 24rpx;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-background);
  border-bottom: 1rpx solid var(--app-divider);
}

.ai-title {
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 750;
}

.ai-subtitle {
  color: var(--app-text-secondary);
  font-size: 23rpx;
  line-height: 1.35;
}

.ai-action-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 112rpx;
  margin-left: 24rpx;
  margin-right: 24rpx;
  padding: 32rpx;
  background: var(--app-dark-panel);
}

.new-chat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 4rpx;
  background: var(--app-coral);
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.new-chat-btn .icon {
  margin-right: 12rpx;
  font-size: 40rpx;
  font-weight: 400;
}

.settings-btn {
  flex: 0 0 auto;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 4rpx;
  background: var(--app-apricot);
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.history-section {
  padding: 0;
  background: transparent;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 32rpx;
}

.section-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.more-link {
  color: var(--app-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.history-list {
  background: transparent;
}

.history-item {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 28rpx 32rpx;
  margin: 16rpx 24rpx;
  background: var(--app-surface);
  border: 1rpx solid var(--app-divider);
  border-radius: 0;
}

.item-icon {
  width: 56rpx;
  margin-right: 20rpx;
  color: var(--app-primary);
  font-size: 34rpx;
  text-align: center;
}

.chat-glyph {
  position: relative;
  width: 34rpx;
  height: 28rpx;
  border: 3rpx solid var(--app-primary);
}

.chat-glyph::after {
  content: '';
  position: absolute;
  left: 4rpx;
  bottom: -10rpx;
  width: 10rpx;
  height: 10rpx;
  border-left: 3rpx solid var(--app-primary);
  border-bottom: 3rpx solid var(--app-primary);
  transform: skewY(-35deg);
}

.item-content {
  flex: 1;
  min-width: 0;
}

.item-title {
  max-width: 500rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-date {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.item-arrow {
  color: var(--app-text-tertiary);
  font-size: 30rpx;
}

/* Empty state styling */
.empty-state-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-image-placeholder {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 32rpx;
  background: var(--app-primary-soft);
  border-radius: 40rpx;
  border: 4rpx solid var(--app-primary);
  position: relative;
}

.empty-image-placeholder::after {
  content: '印';
  font-size: 80rpx;
  color: var(--app-primary);
  font-weight: 800;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-accent);
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  margin-bottom: 12rpx;
}

.empty-state-desc {
  font-size: 26rpx;
  color: var(--app-text-secondary);
  margin-bottom: 48rpx;
}

.empty-state-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}
