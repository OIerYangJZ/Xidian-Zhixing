.ai-page { height:100vh; overflow:hidden; background:var(--app-background); }
.ai-workspace { height:100%; display:flex; flex-direction:column; box-sizing:border-box; padding-left:22rpx; padding-right:22rpx; padding-bottom:calc(var(--tab-height) + 20rpx); }
.ai-welcome { flex:1; min-height:130px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:24rpx; }
.ai-emblem { width:77px; height:77px; color:var(--app-divider); }
.ai-greeting { font-size:34rpx; color:var(--app-text-secondary); }
.ai-status { font-size:26rpx; color:var(--app-text-secondary); }
.ai-shortcuts { display:flex; gap:16rpx; margin-bottom:16rpx; }
.ai-shortcuts button { flex:1; min-width:0; min-height:142rpx; padding:20rpx 24rpx; border:1px solid var(--app-divider); border-radius:24rpx; background:var(--app-control); color:var(--app-text-primary); text-align:left; display:flex; flex-direction:column; justify-content:space-between; gap:16rpx; font-size:30rpx; }
.ai-composer { min-height:116rpx; padding:18rpx 20rpx; border:1px solid var(--app-divider); border-radius:40rpx; display:flex; align-items:center; gap:16rpx; background:var(--app-control); }
.ai-composer input { flex:1; min-width:0; height:44px; font-size:34rpx; color:var(--app-text-primary); }
.ai-send { width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:var(--app-primary); color:var(--app-on-primary); }
.ai-send[disabled] { background:var(--app-divider); color:var(--app-text-secondary); }
.ai-recent { display:flex; gap:16rpx; align-items:center; min-height:88rpx; border-bottom:1px solid var(--app-divider); margin-bottom:24rpx; font-size:28rpx; }
.ai-recent-title { flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.ai-recent-date { color:var(--app-text-secondary); font-size:24rpx; }
.ai-error { color:var(--app-error); padding:20rpx 12rpx; font-size:28rpx; }
@media (max-height:560px) { .ai-workspace { overflow-y:auto; } .ai-welcome { min-height:90px; } .ai-emblem { width:48px; height:48px; } }
