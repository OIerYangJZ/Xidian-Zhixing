<view class="zx-page ai-home {{themeClass}}">
  <view class="ai-head" style="padding-top: {{navTop}}px;">
    <view class="ai-head-bar" style="height: {{navHeight}}px;">
      <view class="zx-display ai-title">{{t.ai}}</view>
    </view>
    <view class="ai-subtitle">问问小电：课程、办事与校园生活</view>
  </view>

  <view class="ai-body">
    <view wx:if="{{userErrorMessage}}" class="zx-inline-message zx-inline-message--danger ai-note" bindtap="retryLoadUserInfo">{{userErrorMessage}} · 点击重试</view>

    <!-- M2b: not configured → the status card; configured → the ask box. -->
    <view wx:if="{{statusLoaded && !configured}}" class="zx-card zx-card--pad status">
      <view class="zx-row status-head">
        <view class="status-icon">
          <view class="zx-i zx-i-server"></view>
          <view class="status-dot"><view class="zx-i zx-i--sm zx-i-info"></view></view>
        </view>
        <view>
          <view class="zx-title">小电暂时无法回答</view>
          <view class="status-kind">{{configError ? 'AI 状态加载失败' : '服务器 AI 尚未配置'}}</view>
        </view>
      </view>
      <view class="status-text">管理员完成配置后即可提问。历史对话仍可查看。</view>
      <view class="zx-row status-actions">
        <view class="zx-btn zx-btn--secondary status-btn" bindtap="goToSettings"><view class="zx-i zx-i--sm zx-i-sliders"></view>AI 设置</view>
        <view class="zx-btn zx-btn--secondary status-btn" bindtap="retryLoadAiStatus"><view class="zx-i zx-i--sm zx-i-refresh"></view>重新检查</view>
      </view>
    </view>
    <view wx:elif="{{configured}}" class="zx-card ask" bindtap="startNewChat" hover-class="zx-btn-hover">
      <view class="zx-i zx-i-ai ask-icon"></view>
      <view class="ask-placeholder">问点什么…</view>
      <view class="ask-send"><view class="zx-i zx-i--sm zx-i-send"></view></view>
    </view>

    <view class="zx-section-title ai-section">可以这样问</view>
    <view class="examples">
      <view wx:for="{{examples}}" wx:key="*this" class="example" data-q="{{item}}" bindtap="askExample" hover-class="zx-btn-hover">{{item}}</view>
    </view>

    <view class="zx-btn zx-btn--secondary zx-btn--block new-chat" bindtap="startNewChat"><view class="zx-i zx-i--sm zx-i-plus"></view>发起新对话</view>

    <view class="zx-row history-head">
      <view class="zx-title">历史对话</view>
      <view class="zx-spacer"></view>
      <view wx:if="{{history.length}}" class="history-more" bindtap="goToHistory">查看全部</view>
    </view>
    <view wx:if="{{history.length}}" class="zx-list">
      <view class="zx-list-item" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" data-question="{{item.question}}" bindtap="continueChat" hover-class="history-item--pressed">
        <view class="zx-icon-tile history-icon"><view class="zx-i zx-i--sm zx-i-chat"></view></view>
        <view class="zx-list-item__main zx-list-item__title zx-ellipsis">{{item.title}}</view>
        <view class="zx-caption">{{item.date}}</view>
      </view>
    </view>
    <view wx:else class="zx-empty history-empty">
      <view class="zx-empty__title">还没有对话</view>
      <view class="zx-empty__message">可以从一个校园问题开始。</view>
    </view>
  </view>
</view>
