<view class="page ai-page {{themeClass}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer"></radio-drawer>
  <view class="ai-topbar" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px; box-sizing: border-box; background: var(--app-background);">
    <view class="nav-avatar-button" bindtap="openDrawer" aria-label="打开抽屉">
      <image wx:if="{{userInfo && userInfo.avatarUrl}}" class="nav-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="nav-avatar nav-avatar-text">{{userInfo ? userInfo.avatarInitial : '匿'}}</view>
    </view>
    <view>
      <view class="ai-title">{{t.ai}}</view>
      <view class="ai-subtitle">{{t.ai_subtitle}}</view>
    </view>
  </view>
  
  <view class="ai-action-bar" style="margin-top: {{navTop + navHeight + 8}}px;">
    <view wx:if="{{userErrorMessage}}" class="empty-state-desc">
      {{userErrorMessage}}
      <button bindtap="retryLoadUserInfo">重新加载</button>
    </view>
    <view wx:if="{{configError}}" class="empty-state-desc">
      {{configError}}
      <button bindtap="retryLoadAiStatus">重新加载</button>
    </view>
    <button class="new-chat-btn" bindtap="startNewChat">
      <text class="icon">+</text>
      <text>发起新对话</text>
    </button>
    <button class="settings-btn" bindtap="goToSettings">AI 设置</button>
  </view>

  <view class="history-section">
    <view class="section-header">
      <view class="section-title" style="margin-bottom: 0;">历史对话</view>
      <view class="more-link" bindtap="goToHistory" wx:if="{{history.length}}">查看全部</view>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{history}}" wx:key="id" data-id="{{item.id}}" data-question="{{item.question}}" bindtap="continueChat">
        <view class="item-icon"><view class="chat-glyph"></view></view>
        <view class="item-content">
          <view class="item-title">{{item.title}}</view>
          <view class="item-date">{{item.date}}</view>
        </view>
        <view class="item-arrow">></view>
      </view>
      
      <view wx:if="{{!history.length}}" class="empty-state-container" style="padding: 80rpx 40rpx;">
        <!-- 标注：此处如果需要图片，可使用 empty_state_ai.png -->
        <view class="empty-image-placeholder"></view>
        <view class="empty-state-title">还没有对话</view>
        <view class="empty-state-desc" style="margin-bottom: 24rpx;">可以从一个校园问题开始。</view>
        <button class="primary-button empty-state-btn" bindtap="startNewChat" style="width: 240rpx; height: 72rpx; line-height: 72rpx;">问问 AI</button>
      </view>
    </view>
  </view>
</view>
