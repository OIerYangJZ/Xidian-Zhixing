<view class="page ai-page {{themeClass}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer" />
  <social-header fixed profile="{{userInfo}}" brand="{{false}}">
    <view slot="actions" class="social-icon-button" bindtap="goToHistory" role="button" aria-label="历史对话"><view class="ui-icon icon-history"></view></view>
  </social-header>
  <view class="ai-workspace" style="padding-top: {{navTop + navHeight + 8}}px;">
    <view wx:if="{{userErrorMessage}}" class="ai-error" bindtap="retryLoadUserInfo">{{userErrorMessage}} · 重试</view>
    <view wx:if="{{configError}}" class="ai-error" bindtap="retryLoadAiStatus">{{configError}} · 重试</view>
    <view class="ai-welcome">
      <view class="ui-icon icon-ai ai-emblem" aria-label="小电"></view>
      <view class="ai-greeting">{{currentLanguage === 'en' ? 'What would you like to know?' : '今天想了解什么？'}}</view>
      <view wx:if="{{!configured && !configError}}" class="ai-status">{{subtitleText}}</view>
    </view>
    <view wx:if="{{history.length}}" class="ai-recent" data-id="{{history[0].id}}" data-question="{{history[0].question}}" bindtap="continueChat">
      <view class="ui-icon icon-history"></view><view class="ai-recent-title">{{history[0].title}}</view><text class="ai-recent-date">{{history[0].date}}</text>
    </view>
    <view class="ai-shortcuts">
      <button bindtap="startNewChat"><view class="ui-icon icon-plus"></view><text>{{currentLanguage === 'en' ? 'New chat' : '新对话'}}</text></button>
      <button bindtap="goToHistory"><view class="ui-icon icon-history"></view><text>{{currentLanguage === 'en' ? 'History' : '历史对话'}}</text></button>
      <button bindtap="goToSettings"><view class="ui-icon icon-settings"></view><text>{{currentLanguage === 'en' ? 'AI settings' : 'AI 设置'}}</text></button>
    </view>
    <view class="ai-composer">
      <input value="{{draft}}" bindinput="onDraftInput" bindconfirm="submitQuestion" confirm-type="send" placeholder="{{currentLanguage === 'en' ? 'Ask anything' : '问问小电'}}" aria-label="输入问题" />
      <button class="ai-send" bindtap="submitQuestion" disabled="{{!draft || !configured}}" aria-label="{{currentLanguage === 'en' ? 'Send question' : '发送问题'}}"><view class="ui-icon icon-arrow"></view></button>
    </view>
  </view>
</view>
