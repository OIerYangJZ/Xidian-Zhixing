.ai-chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--app-background);
}

.config-bar,
.model-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  text-align: center;
}

.config-bar {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.model-bar {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.chat-scroll {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 120rpx;
}

.chat-list {
  padding: 30rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.message-user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

.avatar-user {
  background: var(--app-primary-soft);
}

.avatar-assistant {
  background: var(--app-primary);
  color: var(--app-on-primary);
  border-radius: 20rpx; /* square seal avatar */
}

.message-user .avatar {
  margin-left: 20rpx;
}

.message-assistant .avatar {
  margin-right: 20rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx 30rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 20rpx;
  font-size: 32rpx;
  line-height: 1.5;
  word-wrap: break-word;
}

.message-text {
  white-space: pre-wrap;
}

.references {
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(142, 142, 147, .2);
}

.reference-title,
.reference-item {
  color: var(--app-text-secondary);
  font-size: 23rpx;
  line-height: 1.5;
}

.reference-title {
  margin-bottom: 8rpx;
  font-weight: 600;
}

.reference-link {
  padding: 6rpx 0;
  color: var(--app-primary);
  font-weight: 600;
}

.message-user .references {
  border-top-color: var(--app-divider);
}

.message-user .reference-title,
.message-user .reference-item {
  color: var(--app-text-secondary);
}

.message-user .message-bubble {
  background: var(--app-primary-soft);
  color: var(--app-text-primary);
  border-color: var(--app-divider);
  border-top-right-radius: 4rpx;
}

.message-assistant .message-bubble {
  background: var(--app-surface);
  color: var(--app-text-primary);
  border-top-left-radius: 4rpx;
}

.typing-indicator {
  display: flex;
  align-items: center;
  height: 40rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin: 0 6rpx;
  border-radius: 50%;
  background: var(--app-text-tertiary);
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.input-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  height: 120rpx;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
}

.input {
  flex: 1;
  height: 76rpx;
  margin-right: 20rpx;
  padding: 0 30rpx;
  border-radius: 38rpx;
  background: var(--app-background);
  color: var(--app-text-primary);
  font-size: 30rpx;
  border: 1rpx solid var(--app-divider);
}

.send-btn {
  width: 140rpx !important;
  height: 76rpx;
  padding: 0;
  margin: 0;
  border-radius: 38rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-size: 28rpx;
  line-height: 76rpx;
}

/* Approved reference layout. */
.ai-chat-page { height:100vh; }
.model-bar { background:transparent; color:var(--app-text-secondary); font-size:26rpx; border-bottom:1px solid var(--app-divider); }
.chat-scroll { min-height:0; padding-bottom:0; }
.chat-list { padding:32rpx 24rpx; }
.message-user .avatar { display:none; }
.avatar-assistant { display:flex; align-items:center; justify-content:center; width:44rpx; height:44rpx; border-radius:0; background:transparent; color:var(--app-text-primary); margin-top:12rpx; }
.message-assistant .message-bubble { flex:1; max-width:100%; border:0; background:transparent; padding:12rpx; color:var(--app-text-primary); }
.message-user .message-bubble { max-width:86%; background:var(--app-control); color:var(--app-text-primary); border:1px solid var(--app-divider); border-radius:28rpx; }
.message-text { font-size:34rpx; line-height:1.6; }
.input-bar { position:static; flex-shrink:0; background:var(--app-background); border-top:1px solid var(--app-divider); padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); }
.input { background:var(--app-control); border:1px solid var(--app-divider); border-radius:28px; min-height:44px; font-size:32rpx; }
.send-btn { min-height:44px; border-radius:26px; background:var(--app-primary); color:var(--app-on-primary); }
