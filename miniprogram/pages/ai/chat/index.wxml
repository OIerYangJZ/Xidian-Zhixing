<view class="page ai-chat-page {{themeClass}}">
  <view class="config-bar" wx:if="{{configLoading}}">正在读取服务器 AI 状态</view>
  <view class="config-bar" wx:elif="{{configError}}" bindtap="refreshConfigState">{{configError}} ></view>
  <view class="config-bar" wx:elif="{{!configured}}" bindtap="goSettings">服务器 AI 尚未配置 ></view>
  <view class="model-bar" wx:else>当前模型：{{currentModel}}</view>
  <scroll-view class="chat-scroll" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <view class="chat-list">
      <view wx:for="{{messages}}" wx:for-index="messageIndex" wx:key="id" class="message-item {{item.role === 'user' ? 'message-user' : 'message-assistant'}}">
        <view class="avatar {{item.role === 'user' ? 'avatar-user' : 'avatar-assistant'}}">
          {{item.role === 'user' ? '我' : '印'}}
        </view>
        <view class="message-bubble">
          <text class="message-text">{{item.content}}</text>
          <view class="references" wx:if="{{item.references && item.references.length}}">
            <view class="reference-title">
              <text class="seal-badge-hollow" style="font-size: 16rpx; height: 32rpx; line-height: 28rpx; padding: 0 6rpx; margin-right: 8rpx; display: inline-block; vertical-align: middle;">来源</text>
              <text style="vertical-align: middle;">参考资料</text>
            </view>
            <view class="reference-item" wx:for="{{item.references}}" wx:for-item="ref" wx:for-index="referenceIndex" wx:key="key">
              <view class="reference-link" data-message-index="{{messageIndex}}" data-reference-index="{{referenceIndex}}" bindtap="openReference">
                {{ref.type === 'post' ? '帖子' : '资料'}} · {{ref.title}}
              </view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- Loading indicator for assistant -->
      <view class="message-item message-assistant" wx:if="{{isSending}}">
        <view class="avatar avatar-assistant">印</view>
        <view class="message-bubble">
          <view class="typing-indicator">
            <view class="dot"></view>
            <view class="dot"></view>
            <view class="dot"></view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="input-bar">
    <input class="input" placeholder="输入问题..." value="{{inputVal}}" bindinput="onInput" confirm-type="send" bindconfirm="sendMessage" cursor-spacing="20" />
    <button class="send-btn" bindtap="sendMessage" disabled="{{isSending || !inputVal || !configured || configLoading}}">发送</button>
  </view>
</view>
