<view class="zx-page club-page {{themeClass}}">
  <view class="zx-card intro">
    <view class="zx-icon-tile intro-tile"><view class="zx-i zx-i-users"></view></view>
    <view class="intro-text">
      <view class="zx-label">社团分区</view>
      <view class="zx-caption intro-sub">社团以社团身份发布活动和通知</view>
    </view>
    <view class="zx-btn zx-btn--secondary zx-btn--small" bindtap="apply"><view class="zx-i zx-i-plus zx-i--sm"></view>申请</view>
  </view>

  <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="retryLoad">重试</view>
  </view>
  <view wx:elif="{{!clubs.length}}" class="zx-empty">
    <view class="zx-empty__title">还没有社团分区</view>
    <view class="zx-empty__message">社团负责人可以点「申请」开通分区</view>
  </view>
  <block wx:else>
    <view class="zx-section-title">全部社团 · {{clubs.length}}</view>
    <view class="zx-list">
      <view wx:for="{{clubs}}" wx:key="id" class="zx-list-item" data-id="{{item.id}}" bindtap="openDetail">
        <view class="zx-avatar club-avatar">{{item.initial}}</view>
        <view class="zx-list-item__main">
          <view class="zx-row">
            <view class="zx-list-item__title zx-ellipsis">{{item.name}}</view>
            <view wx:if="{{item.category}}" class="zx-badge zx-badge--neutral club-category">{{item.category}}</view>
          </view>
          <view wx:if="{{item.description}}" class="zx-list-item__subtitle club-desc">{{item.description}}</view>
        </view>
        <view class="zx-list-item__chevron"></view>
      </view>
    </view>
  </block>
</view>
