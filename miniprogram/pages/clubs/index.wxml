<view class="page club-page">
  <button class="apply-btn" bindtap="apply">申请社团分区</button>
  <view class="club-row" wx:for="{{clubs}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
    <view class="club-name">{{item.name}}</view>
    <view class="club-desc">{{item.description}}</view>
  </view>
</view>
