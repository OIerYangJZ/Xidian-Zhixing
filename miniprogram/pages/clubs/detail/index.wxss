.club-detail { padding: 32rpx 0; background: var(--app-background); }
.club-title { color: var(--app-text-primary); font-size: 42rpx; font-weight: 750; line-height: 1.25; }
.club-title,
.club-owner,
.club-text,
.section-title { margin-left: 32rpx; margin-right: 32rpx; }
.club-owner { margin-top: 12rpx; color: var(--app-primary); font-size: 25rpx; font-weight: 650; }
.club-text { margin-top: 24rpx; color: var(--app-text-primary); font-size: 29rpx; line-height: 1.6; }
.section-title { margin-top: 36rpx; color: var(--app-text-secondary); font-size: 25rpx; font-weight: 650; }
.empty-posts { padding: 28rpx 0; color: var(--app-text-secondary); font-size: 26rpx; text-align: center; }
