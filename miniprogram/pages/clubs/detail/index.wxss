/* 社团详情: the club header, then its posts as shared post rows. */
@import "../../../styles/zx-post.wxss";

.club-detail { background: var(--zx-bg); padding-bottom: 64rpx; }
.head { padding: 48rpx 40rpx 40rpx; text-align: center; }
.head-avatar { margin: 0 auto; }
.head-name { margin-top: 20rpx; }
.head-meta { justify-content: center; gap: 12rpx; margin-top: 12rpx; }
.head-desc { margin-top: 20rpx; color: var(--zx-text-2); white-space: pre-wrap; text-align: left; }
.posts-title { padding: 40rpx 40rpx 16rpx; }
.posts-empty { padding: 48rpx; }
.sheet { background: var(--zx-surface); border-top: 2rpx solid var(--zx-line); }
.empty-action { margin-top: 24rpx; }
