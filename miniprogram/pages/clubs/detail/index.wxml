<import src="/templates/post-row.wxml" />
<view class="zx-page club-detail {{themeClass}}">
  <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="loadDetail">重试</view>
  </view>
  <block wx:elif="{{club}}">
    <view class="zx-hero head">
      <view class="zx-avatar zx-avatar--lg head-avatar">{{club.initial}}</view>
      <view class="zx-title head-name">{{club.name}}</view>
      <view class="zx-row head-meta">
        <view wx:if="{{club.category}}" class="zx-badge zx-badge--neutral">{{club.category}}</view>
        <view class="zx-caption">负责人 {{club.ownerName || '—'}}<block wx:if="{{club.memberCount}}"> · {{club.memberCount}} 位成员</block></view>
      </view>
      <view wx:if="{{club.description}}" class="zx-body head-desc">{{club.description}}</view>
    </view>

    <view class="zx-section-title posts-title">社团发布</view>
    <view wx:if="{{!club.posts.length}}" class="zx-empty posts-empty">
      <view class="zx-empty__message">还没有发布</view>
    </view>
    <view wx:else class="sheet">
      <block wx:for="{{club.posts}}" wx:key="id"><template is="post-row" data="{{item, index}}" /></block>
    </view>
  </block>
</view>
