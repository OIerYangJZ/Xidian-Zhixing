/* 社团分区: an intro card with 申请, then every active club. */
.club-page { padding: 24rpx 32rpx 64rpx; background: var(--zx-bg); }
.intro { display: flex; align-items: center; gap: 24rpx; padding: 28rpx; margin-bottom: 40rpx; }
.intro-tile { width: 80rpx; height: 80rpx; }
.intro-text { flex: 1; min-width: 0; }
.intro-sub { margin-top: 4rpx; }
.intro .zx-btn { gap: 8rpx; }
.club-avatar { width: 80rpx; height: 80rpx; flex: none; }
.club-category { flex: none; margin-left: 12rpx; }
.club-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.empty-action { margin-top: 24rpx; }
