.club-page { padding: 24rpx 32rpx; background: var(--app-background); }
.apply-btn { height: 76rpx; border-radius: 18rpx; background: var(--app-primary); color: #fff; font-size: 28rpx; line-height: 76rpx; }
.club-row { margin-top: 20rpx; padding: 24rpx; border: 1rpx solid var(--app-divider); border-radius: 22rpx; background: var(--app-surface); }
.club-name { color: var(--app-text-primary); font-size: 31rpx; font-weight: 700; }
.club-desc { margin-top: 8rpx; color: var(--app-text-secondary); font-size: 25rpx; line-height: 1.45; }
