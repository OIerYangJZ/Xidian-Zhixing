/* 社团申请: the form card, then my earlier applications. */
.apply-page { padding: 24rpx 32rpx 64rpx; background: var(--zx-bg); }
.form { padding: 8rpx 32rpx; }
.field { padding: 24rpx 0; }
.field + .field { border-top: 2rpx solid var(--zx-line); }
.field-label { font-size: 26rpx; font-weight: 600; color: var(--zx-text-2); }
.required { margin-left: 4rpx; color: var(--zx-danger); }
.field-input { margin-top: 12rpx; height: 56rpx; font-size: 30rpx; color: var(--zx-text); }
.field-textarea { margin-top: 12rpx; width: 100%; height: 200rpx; font-size: 30rpx; line-height: 44rpx; color: var(--zx-text); }
.field-placeholder { color: var(--zx-text-3); }
.field-count { text-align: right; }
.submit-error { margin-top: 24rpx; }
.submit { margin-top: 32rpx; }
.history-title { padding-top: 56rpx; }
.history-empty { padding: 40rpx 48rpx; }
.review-note { margin-top: 8rpx; font-size: 24rpx; line-height: 34rpx; color: var(--zx-text-2); }
.zx-list-item .zx-badge { flex: none; }
.empty-action { margin-top: 24rpx; }
