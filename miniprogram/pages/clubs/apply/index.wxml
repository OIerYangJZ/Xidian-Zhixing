<view class="page apply-page">
  <view class="field-label">社团名称</view>
  <input class="app-input" value="{{name}}" data-field="name" bindinput="onInput" placeholder="输入社团名称" />
  <view class="field-label">类型</view>
  <input class="app-input" value="{{category}}" data-field="category" bindinput="onInput" placeholder="学术 / 文体 / 志愿等" />
  <view class="field-label">申请说明</view>
  <textarea class="app-textarea" value="{{description}}" data-field="description" bindinput="onInput" placeholder="说明社团情况、负责人身份和分区用途" />
  <view class="field-label">联系方式</view>
  <input class="app-input" value="{{contact}}" data-field="contact" bindinput="onInput" placeholder="邮箱或微信" />
  <button class="submit-btn" bindtap="submit">提交申请</button>
  <view class="history-title">我的申请</view>
  <view class="history-row" wx:for="{{applications}}" wx:key="id">
    <view class="history-name">{{item.name}}</view>
    <view class="history-status">{{item.status}}</view>
  </view>
</view>
