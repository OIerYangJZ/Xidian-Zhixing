.announcement-detail-page {
  background: var(--app-background);
}

.detail-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-paper-card {
  padding: 36rpx;
  background: var(--app-surface);
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
}

.detail-type {
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 700;
}

.detail-title {
  margin-top: 16rpx;
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
}

.detail-meta {
  margin-top: 12rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.summary-card {
  box-sizing: border-box;
  margin: 24rpx 0;
  padding: 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-primary-soft);
}

.summary-head {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 700;
}

.summary-text {
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 26rpx;
  line-height: 1.5;
}

.summary-button {
  margin-top: 20rpx;
  width: 100%;
  height: 68rpx;
  border-radius: 18rpx;
  background: var(--app-primary);
  color: #fff;
  font-size: 27rpx;
  line-height: 68rpx;
}

.detail-content {
  margin-top: 32rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}
