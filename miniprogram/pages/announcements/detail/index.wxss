.announcement-detail { padding: 32rpx; background: var(--app-background); }
.detail-type { color: var(--app-primary); font-size: 25rpx; font-weight: 700; }
.detail-title { margin-top: 12rpx; color: var(--app-text-primary); font-size: 42rpx; font-weight: 750; line-height: 1.28; }
.detail-meta { margin-top: 14rpx; color: var(--app-text-secondary); font-size: 24rpx; line-height: 1.4; }
.summary-card { margin-top: 28rpx; padding: 24rpx; border: 1rpx solid var(--app-divider); border-radius: 24rpx; background: var(--app-surface); }
.summary-head { color: var(--app-text-primary); font-size: 28rpx; font-weight: 700; }
.summary-text { margin-top: 10rpx; color: var(--app-text-secondary); font-size: 26rpx; line-height: 1.5; }
.summary-button { margin-top: 20rpx; height: 72rpx; border-radius: 18rpx; background: var(--app-primary); color: #fff; font-size: 27rpx; line-height: 72rpx; }
.detail-content { margin-top: 32rpx; color: var(--app-text-primary); font-size: 30rpx; line-height: 1.7; white-space: pre-wrap; }
