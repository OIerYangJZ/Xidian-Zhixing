.announcement-detail-page {
  background: var(--app-background);
}

.detail-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.detail-paper-card {
  padding: 36rpx;
  background: #ffffff;
  border: 1rpx solid var(--app-divider);
  border-radius: 36rpx; /* card.radius = 18px = 36rpx */
  box-shadow: 0 4rpx 16rpx rgba(178, 58, 46, 0.03);
}

.detail-type {
  color: var(--brand-seal);
  font-size: 25rpx;
  font-weight: 700;
}

.summary-button {
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--app-primary);
  color: #fff;
  font-size: 27rpx;
  line-height: 72rpx;
}
