<view class="page announcement-detail-page {{themeClass}}" wx:if="{{item}}" style="background: var(--app-background); padding: 32rpx; min-height: 100vh; box-sizing: border-box;">
  <view class="detail-paper-card">
    <view class="detail-header-row">
      <view class="detail-type">{{item.type || item.sourceName}}</view>
      <view wx:if="{{item.isImportant || item.isOfficial || item.publisher === '官方' || item.publisher === '管理员'}}" class="seal-badge-solid" style="margin-left: auto;">官方</view>
    </view>
    <view class="detail-title">{{item.title}}</view>
    <view class="detail-meta">{{item.publisher}} · {{item.timeText}}</view>
    
    <view class="summary-card">
      <view class="summary-head">AI 摘要</view>
      <view class="summary-text">{{aiSummary || '尚未生成摘要'}}</view>
      <button class="summary-button" bindtap="summarize">生成摘要</button>
    </view>
    
    <view class="detail-content">{{item.content}}</view>
  </view>
</view>
