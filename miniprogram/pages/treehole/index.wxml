<view class="page campus-page {{themeClass}} treehole-layout-threads" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer"></radio-drawer>

  <social-header fixed profile="{{userInfo}}">
    <view slot="actions" class="social-icon-button" bindtap="toggleFilterMenu" role="button" aria-label="筛选分区"><view class="ui-icon icon-filter"></view></view>
  </social-header>

  <view class="filter-menu-mask" wx:if="{{showFilterMenu}}" bindtap="closeFilterMenu"></view>
  <view class="filter-menu" wx:if="{{showFilterMenu}}" style="top: {{navTop + navHeight + 8}}px;">
    <view class="filter-menu-section"><view class="filter-menu-title">排序</view></view>
    <view wx:for="{{sortOptions}}" wx:key="value" data-sort="{{item.value}}" class="filter-menu-item {{activeSort === item.value ? 'active' : ''}}" bindtap="onSortTap">
      <text>{{item.label}}</text><text wx:if="{{activeSort === item.value}}" class="check-mark">✓</text>
    </view>
    <view class="filter-menu-section"><view class="filter-menu-title">分区</view></view>
    <view wx:for="{{sectionTree.sections}}" wx:key="id" data-section="{{item}}" class="filter-menu-item {{activeSection && activeSection.id === item.id ? 'active' : ''}}" bindtap="selectSection">
      <text>{{item.sectionName}}</text><text wx:if="{{activeSection && activeSection.id === item.id}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="refresh-feedback" wx:if="{{refreshFeedbackVisible}}" style="padding-top: {{navTop + navHeight + 8}}px;">
    <view class="refresh-feedback-pill">正在刷新</view>
  </view>

  <scroll-view
    class="feed-list"
    scroll-y
    refresher-enabled
    refresher-triggered="{{refreshTriggered}}"
    refresher-background="transparent"
    bindrefresherrefresh="onRefresherRefresh"
    bindscrolltolower="onReachBottom"
    bindscroll="onScroll"
    style="padding-top: {{navTop + navHeight + 8}}px;"
  >
    <view class="feed-tabs">
      <view wx:for="{{sortOptions}}" wx:key="value" data-sort="{{item.value}}" class="feed-tab {{activeSort === item.value ? 'active' : ''}}" bindtap="onSortTap" role="button" aria-label="{{item.label}}">{{item.label}}</view>
    </view>
    <view class="active-filter-bar" wx:if="{{activeSection}}">
      <view class="filter-info">
        <text class="filter-text">当前筛选：#{{activeSection.sectionName || activeSection.name}}</text>
      </view>
      <view class="filter-clear-btn" bindtap="clearActiveSection">清除筛选</view>
    </view>
    <view class="section-rule" wx:if="{{activeSection && activeSection.ruleText}}">{{activeSection.ruleText}}</view>
    <block>
      <post-row
        wx:for="{{posts}}"
        wx:key="id"
        item="{{item}}"
        index="{{index}}"
        bind:open="goToDetail"
        bind:author="openAuthorProfile"
        bind:tag="goTagPosts"
        bind:like="togglePostLike"
        bind:favorite="togglePostFavorite"
      />
    </block>
    <view class="loading-state" wx:if="{{loading}}">加载中...</view>

    <view class="empty-state-container" wx:if="{{!loading && errorMessage && posts.length === 0}}">
      <view class="empty-state-title">加载失败</view>
      <view class="empty-state-desc">{{errorMessage}}</view>
      <button class="primary-button empty-state-btn" bindtap="retryFeed">重新加载</button>
    </view>

    <view class="empty-state-container" wx:elif="{{!loading && posts.length === 0}}">
      <!-- 标注：此处如果需要图片，可使用 empty_state_treehole.png -->
      <view class="social-empty-illustration ui-icon icon-chat" aria-hidden="true"></view>
      <view class="empty-state-title">这里还没有声音</view>
      <view class="empty-state-desc">分享你的第一条校园动态。</view>
      <button class="primary-button empty-state-btn" bindtap="goCreatePost">写入树洞</button>
    </view>
    
    <view class="no-more" wx:if="{{!loading && !hasMore && posts.length > 0}}">没有更多了</view>
  </scroll-view>

  <view class="floating-publish {{showPublishButton ? '' : 'hidden'}}" bindtap="goCreatePost">+</view>
</view>
