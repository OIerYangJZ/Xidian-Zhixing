<view class="page campus-page {{themeClass}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <radio-drawer open="{{drawerOpen}}" bind:close="closeDrawer"></radio-drawer>

  <view class="home-appbar" style="padding-top: {{navTop}}px; height: {{navTop + navHeight + 8}}px;">
    <view class="channel-trigger" bindtap="openDrawer" aria-label="打开抽屉">
      <view class="menu-lines"><view></view><view></view><view></view></view>
    </view>
    <view class="appbar-title">
      <view class="appbar-name">树洞</view>
      <view class="appbar-subtitle">{{activeSection ? activeSection.sectionName : '学校总分区'}}</view>
    </view>
    <view class="icon-button" bindtap="toggleChannelMenu" aria-label="筛选">
      <view class="filter-icon"></view>
    </view>
    <view class="icon-button" bindtap="goSearch" aria-label="搜索">
      <view class="search-icon"></view>
    </view>
  </view>

  <view class="channel-menu-mask" wx:if="{{showChannelMenu}}" bindtap="closeChannelMenu"></view>
  <view class="channel-menu" wx:if="{{showChannelMenu}}" style="top: {{navTop + navHeight + 8}}px;">
    <view class="channel-menu-section"><view class="channel-menu-title">频道</view></view>
    <view wx:for="{{channels}}" wx:key="*this" data-channel="{{item}}" class="channel-menu-item {{activeChannel === item ? 'active' : ''}}" bindtap="onChannelTap">
      <text>{{item}}</text><text wx:if="{{activeChannel === item}}" class="check-mark">✓</text>
    </view>
    <view class="channel-menu-section"><view class="channel-menu-title">排序</view></view>
    <view wx:for="{{sortOptions}}" wx:key="value" data-sort="{{item.value}}" class="channel-menu-item {{activeSort === item.value ? 'active' : ''}}" bindtap="onSortTap">
      <text>{{item.label}}</text><text wx:if="{{activeSort === item.value}}" class="check-mark">✓</text>
    </view>
  </view>

  <view class="treehole-tabs" style="top: {{navTop + navHeight + 8}}px;">
    <view class="treehole-tab {{currentTab === 'community' ? 'active' : ''}}" data-tab="community" bindtap="switchTab">论坛</view>
    <view class="treehole-tab {{currentTab === 'sections' ? 'active' : ''}}" data-tab="sections" bindtap="switchTab">分区</view>
    <view class="treehole-tab" bindtap="goHot">热榜</view>
    <view class="treehole-tab {{currentTab === 'clubs' ? 'active' : ''}}" data-tab="clubs" bindtap="switchTab">社团</view>
  </view>

  <scroll-view class="feed-list" scroll-y wx:if="{{currentTab === 'community'}}" bindscrolltolower="onReachBottom" bindscroll="onScroll" style="padding-top: {{navTop + navHeight + 64}}px;">
    <view class="section-rule" wx:if="{{activeSection && activeSection.ruleText}}">{{activeSection.ruleText}}</view>
    <view class="feed-card" wx:for="{{posts}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <image wx:if="{{item.authorAvatarUrl}}" class="feed-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill" data-user-id="{{item.authorUserId || item.authorId || ''}}" data-anonymous="{{item.isAnonymous ? 1 : 0}}" catchtap="openAuthorProfile"></image>
      <view wx:else class="feed-avatar" data-user-id="{{item.authorUserId || item.authorId || ''}}" data-anonymous="{{item.isAnonymous ? 1 : 0}}" catchtap="openAuthorProfile">{{item.authorInitial}}</view>
      <view class="feed-body">
        <view class="feed-head">
          <view class="feed-author">{{item.authorAlias || item.authorName || '匿名用户'}}</view>
          <view wx:if="{{item.isAnonymous}}" class="anonymous-badge">匿名</view>
          <view class="feed-dot" style="background: {{item.channelColor}}"></view>
          <view class="feed-channel" style="color: {{item.channelColor}}">{{item.sectionName || item.displayChannel || item.channel || '综合'}}</view>
          <view wx:if="{{item.isPinned}}" class="pin-icon"></view>
          <view class="feed-time">{{item.timeText}}</view>
        </view>
        <view class="feed-title" wx:if="{{item.title}}">{{item.title}}</view>
        <view class="feed-summary" wx:if="{{!(item.images && item.images.length > 0)}}"><text>{{item.summary || item.content}}</text></view>
        <view class="feed-tags" wx:if="{{item.tags && item.tags.length}}">
          <text class="feed-tag" wx:for="{{item.tags}}" wx:key="*this">#{{item}}</text>
        </view>
        <swiper class="post-images" wx:if="{{item.images && item.images.length > 0}}" indicator-dots="{{item.images.length > 1}}" indicator-color="rgba(255,255,255,.5)" indicator-active-color="#ffffff">
          <swiper-item wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
            <image src="{{img}}" mode="aspectFill" class="post-image"></image>
          </swiper-item>
        </swiper>
        <view class="feed-actions">
          <view class="feed-action {{item.liked || item.isLiked ? 'active' : ''}}"><view class="feed-action-icon like-icon"></view><text>{{item.likeCount || 0}}</text></view>
          <view class="feed-action"><view class="feed-action-icon comment-icon"></view><text>{{item.commentCount || 0}}</text></view>
          <view class="feed-action"><view class="feed-action-icon share-icon"></view><text>{{item.favoriteCount || 0}}</text></view>
        </view>
      </view>
    </view>
    <view class="loading-state" wx:if="{{loading}}">加载中...</view>
    <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">暂无内容</view>
    <view class="no-more" wx:if="{{!loading && !hasMore && posts.length > 0}}">没有更多了</view>
  </scroll-view>

  <scroll-view class="secondary-page section-page" scroll-y wx:if="{{currentTab === 'sections'}}" style="padding-top: {{navTop + navHeight + 64}}px;">
    <view class="section-group">
      <view class="section-heading">学校总分区</view>
      <view class="section-cell" data-section="{{sectionTree.school}}" bindtap="selectSection">
        <view><view class="section-name">{{sectionTree.school.sectionName || '学校总分区'}}</view><view class="section-desc">全校公共讨论入口</view></view>
        <view class="menu-arrow">></view>
      </view>
    </view>
    <view class="section-group">
      <view class="section-heading">学院分区</view>
      <view class="section-cell" wx:for="{{sectionTree.colleges}}" wx:key="id" data-section="{{item}}" bindtap="selectSection">
        <view><view class="section-name">{{item.sectionName}}</view><view class="section-desc">{{item.ruleText}}</view></view>
        <view class="menu-arrow">></view>
      </view>
    </view>
    <view class="section-group">
      <view class="section-heading">频道分区</view>
      <view class="section-cell" wx:for="{{sectionTree.channels}}" wx:key="id" data-section="{{item}}" bindtap="selectSection">
        <view><view class="section-name">{{item.sectionName}}</view><view class="section-desc">{{item.description}}</view></view>
        <view class="menu-arrow">></view>
      </view>
    </view>
    <view class="section-group">
      <view class="section-heading">社团分区</view>
      <view class="section-cell" wx:for="{{sectionTree.clubs}}" wx:key="id" data-section="{{item}}" bindtap="selectSection">
        <view><view class="section-name">{{item.sectionName}}</view><view class="section-desc">{{item.ruleText}}</view></view>
        <view class="menu-arrow">></view>
      </view>
    </view>
  </scroll-view>

  <scroll-view class="secondary-page clubs-page" scroll-y wx:if="{{currentTab === 'clubs'}}" style="padding-top: {{navTop + navHeight + 64}}px;">
    <view class="club-apply-card" bindtap="goClubApply">
      <view class="club-apply-title">申请社团分区</view>
      <view class="club-apply-desc">负责人可申请社团分区，通过后支持社团名义发布。</view>
    </view>
    <view class="section-cell" wx:for="{{clubs}}" wx:key="id" data-id="{{item.id}}" bindtap="goClubDetail">
      <view><view class="section-name">{{item.name}}</view><view class="section-desc">{{item.description}}</view></view>
      <view class="menu-arrow">></view>
    </view>
    <view class="empty-state" wx:if="{{clubs.length === 0}}">暂无社团分区，先提交申请</view>
  </scroll-view>

  <view class="floating-publish {{showPublishButton ? '' : 'hidden'}}" wx:if="{{currentTab === 'community'}}" bindtap="goCreatePost">＋</view>
</view>
