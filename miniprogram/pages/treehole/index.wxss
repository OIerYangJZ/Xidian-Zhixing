.campus-page {
  background: var(--app-background);
}

.home-appbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-left: 24rpx;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-background);
  border-bottom: 1rpx solid var(--app-divider);
}

.treehole-tabs {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 55;
  display: flex;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.treehole-tab {
  flex: 1;
  height: 52rpx;
  border-radius: 16rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  font-weight: 650;
  line-height: 52rpx;
  text-align: center;
}

.treehole-tab.active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
}

.section-rule {
  margin: 18rpx 24rpx 6rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 1.45;
}

.section-page,
.clubs-page {
  height: 100vh;
  background: var(--app-background);
}

.section-group {
  margin-top: 20rpx;
  background: var(--app-surface);
}

.section-heading {
  padding: 18rpx 32rpx 10rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.section-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.section-name {
  color: var(--app-text-primary);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
}

.section-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
}

.club-apply-card {
  margin: 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.club-apply-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.club-apply-desc {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.avatar-button,
.channel-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background: transparent;
}

.top-avatar {
  display: block;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.top-avatar-text {
  display: block;
}

.channel-trigger.active {
  background: var(--app-primary-soft);
}

.menu-lines {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 20px;
}

.menu-lines view {
  height: 2px;
  border-radius: 1px;
  background: var(--app-text-primary);
}

.channel-trigger.active .menu-lines view {
  background: var(--app-primary);
}

.toolbar-spacer {
  flex: 1;
}

.icon-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 22px;
}

.search-icon {
  position: relative;
  width: 18px;
  height: 18px;
  border: 2px solid var(--app-text-primary);
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -6px;
  bottom: -4px;
  width: 10px;
  height: 2px;
  border-radius: 1px;
  background: var(--app-text-primary);
  transform: rotate(45deg);
}

.bell-icon {
  position: relative;
  width: 18px;
  height: 20px;
  border: 2px solid var(--app-text-primary);
  border-bottom: none;
  border-radius: 10px 10px 4px 4px;
}

.bell-icon::before {
  content: '';
  position: absolute;
  left: -4px;
  right: -4px;
  bottom: -4px;
  height: 2px;
  border-radius: 1px;
  background: var(--app-text-primary);
}

.bell-icon::after {
  content: '';
  position: absolute;
  left: 6px;
  bottom: -9px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--app-text-primary);
}

.badge {
  position: absolute;
  top: 5px;
  right: 5px;
}

.channel-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: transparent;
}

.channel-menu {
  position: fixed;
  left: 16rpx;
  z-index: 70;
  width: 392rpx;
  max-height: 68vh;
  overflow-y: auto;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.channel-menu-section {
  min-height: 58rpx;
  padding: 18rpx 28rpx 0;
  background: var(--app-surface);
}

.channel-menu-title {
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.channel-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.channel-menu-item:last-child {
  border-bottom: none;
}

.channel-menu-item.active {
  color: var(--app-primary);
  font-weight: 650;
}

.check-mark {
  color: var(--app-primary);
  font-size: 30rpx;
}

.menu-arrow {
  color: var(--app-text-tertiary);
  font-size: 30rpx;
}

.feed-list,
.news-list {
  height: 100vh;
  background: var(--app-background);
}

.post-images {
  width: 100%;
  height: 560rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--app-divider);
}

.post-image {
  width: 100%;
  height: 100%;
  background: var(--app-divider);
}

.floating-publish {
  position: fixed;
  right: 32rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 48rpx;
  line-height: 92rpx;
  text-align: center;
  transition: transform 0.28s ease, opacity 0.28s ease;
  z-index: 20;
}

.floating-publish.hidden {
  transform: translateY(150rpx);
  opacity: 0;
  pointer-events: none;
}

.secondary-page {
  min-height: 100vh;
  background: var(--app-background);
}

.sub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 20rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.tool-button {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  white-space: nowrap;
}

.sub-title {
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sub-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.news-card {
  padding: 28rpx 32rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.news-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.news-excerpt {
  display: -webkit-box;
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.news-more-link {
  color: var(--app-primary);
}

.college-list {
  background: var(--app-surface);
}

.college-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.college-icon {
  width: 56rpx;
  color: var(--app-primary);
  font-size: 38rpx;
  text-align: center;
}

.college-name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 500;
}

/* Empty state styles */
.empty-state-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-image-placeholder {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 32rpx;
  background: var(--app-primary-soft);
  border-radius: 40rpx;
  border: 4rpx solid var(--app-primary);
  position: relative;
}

.empty-image-placeholder::after {
  content: '印';
  font-size: 80rpx;
  color: var(--app-primary);
  font-weight: 800;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-family: serif;
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  margin-bottom: 12rpx;
}

.empty-state-desc {
  font-size: 26rpx;
  color: var(--app-text-secondary);
  margin-bottom: 48rpx;
}

.empty-state-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}
