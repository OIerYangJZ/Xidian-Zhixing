/* 树洞 (handoff M1 · Threads, and the card layout from 显示设置). */

.treehole { height: 100vh; overflow: hidden; background: var(--zx-hero); position: relative; }

.appbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding-left: 40rpx;
  padding-right: 220rpx; /* keeps clear of the capsule */
  box-sizing: content-box;
  background: var(--zx-glass);
  backdrop-filter: blur(16px);
}
.appbar-title { font-size: 44rpx; line-height: 56rpx; margin-right: 12rpx; }
.appbar-action {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--zx-text-2);
}

.filter-mask { position: fixed; inset: 0; z-index: 30; background: var(--zx-scrim); }
.filter-menu {
  position: fixed;
  left: 32rpx;
  z-index: 31;
  width: 420rpx;
  max-height: 60vh;
  overflow-y: auto;
  padding: 16rpx 12rpx;
  box-shadow: var(--zx-shadow-2);
}
.filter-title { padding: 16rpx 16rpx 8rpx; }
.filter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--zx-text);
}
.filter-item--on { background: var(--zx-primary-soft); color: var(--zx-primary); font-weight: 600; }

.feed { height: 100vh; box-sizing: border-box; }

.intro { position: relative; padding: 16rpx 40rpx 40rpx; overflow: hidden; }
.intro-mark {
  position: absolute;
  right: -30rpx;
  top: -20rpx;
  font-family: "STZhongsong", "Songti SC", "STSong", serif;
  font-size: 240rpx;
  line-height: 1;
  color: var(--zx-primary);
  opacity: 0.06;
}
.intro-title { font-size: 40rpx; line-height: 52rpx; }
.intro-tagline { margin-top: 8rpx; font-size: 26rpx; color: var(--zx-text-2); }

.section-head { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 40rpx 24rpx; }
.section-title { font-size: 40rpx; line-height: 52rpx; }
.section-rule { margin: 0 32rpx 24rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: var(--zx-accent-soft); color: var(--zx-accent-ink); font-size: 26rpx; line-height: 38rpx; }

.sheet {
  min-height: 70vh;
  padding: 8rpx 0 220rpx;
  background: var(--zx-surface);
  border-radius: 40rpx 40rpx 0 0;
  border-top: 2rpx solid var(--zx-line);
}

.post { display: flex; gap: 20rpx; }
.post--thread { padding: 28rpx 32rpx 24rpx 24rpx; border-bottom: 2rpx solid var(--zx-line); }
.post--card { margin: 24rpx 24rpx 0; padding: 28rpx; }

.post-rail { position: relative; display: flex; flex-direction: column; align-items: center; flex: none; }
.post-avatar { width: 80rpx; height: 80rpx; }
.post-follow {
  position: absolute;
  top: 52rpx;
  right: -8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: var(--zx-primary);
  color: var(--zx-on-primary);
  border: 4rpx solid var(--zx-surface);
  font-size: 24rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}
.post-line { flex: 1; width: 3rpx; margin-top: 12rpx; background: var(--zx-line); border-radius: 2rpx; }

.post-body { flex: 1; min-width: 0; }
.post-head { gap: 8rpx; }
.post-author { flex: none; max-width: 60%; }
.post-time { flex: none; }
.post-more { color: var(--zx-text-3); }
.post-badges { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.post-title { margin-top: 14rpx; font-size: 32rpx; line-height: 46rpx; font-weight: 700; color: var(--zx-text); }
.post-summary { margin-top: 8rpx; font-size: 28rpx; line-height: 44rpx; color: var(--zx-text-2); }
.post-tag { color: var(--zx-primary); font-weight: 600; }
.post-images { height: 400rpx; margin-top: 16rpx; border-radius: 24rpx; overflow: hidden; }
.post-image { width: 100%; height: 100%; }

.post-actions { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; margin-left: -12rpx; }
.action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--zx-text-2);
}
.action--liked { color: var(--zx-primary); }
.action--saved { background: var(--zx-accent-soft); color: var(--zx-accent-ink); }

.empty-action { margin-top: 24rpx; }
.no-more { padding: 40rpx 0; text-align: center; font-size: 24rpx; color: var(--zx-text-3); }

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 48rpx;
  z-index: 10;
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, var(--zx-primary), var(--zx-primary-pressed));
  color: var(--zx-on-primary);
  box-shadow: 0 12rpx 32rpx var(--zx-primary-glow);
  transition: transform 0.2s, opacity 0.2s;
}
.fab--hidden { transform: translateY(200rpx); opacity: 0; }
