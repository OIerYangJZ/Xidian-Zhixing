.campus-page {
  background: var(--app-background);
}

.treehole-layout-threads {
  background: var(--app-surface);
}

.treehole-layout-threads .home-appbar {
  background: var(--app-surface);
}

.treehole-layout-threads .section-rule {
  margin: 0;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  border-radius: 0;
  background: var(--app-surface);
  color: var(--app-text-secondary);
}

.editorial-intro {
  margin: 24rpx;
  background: var(--app-dark-panel);
  color: var(--app-on-dark-panel);
}

.editorial-kicker {
  padding: 24rpx 26rpx 0;
  color: var(--app-on-dark-panel);
  font-family: var(--font-accent);
  font-size: 24rpx;
}

.editorial-title {
  padding: 52rpx 26rpx 58rpx;
  color: var(--app-on-dark-panel);
  font-family: var(--font-display);
  font-size: 58rpx;
  font-weight: 600;
  line-height: 1.08;
}

.editorial-color-bar {
  display: flex;
  height: 16rpx;
}

.editorial-coral {
  flex: 1;
  background: var(--app-coral);
}

.editorial-apricot {
  width: 148rpx;
  background: var(--app-apricot);
}

.home-appbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 60;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-left: 24rpx;
  padding-right: 260rpx;
  padding-bottom: 8px;
  background: var(--app-background);
  border-bottom: 1rpx solid var(--app-divider);
}

.section-rule {
  margin: 18rpx 24rpx 6rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 24rpx;
  line-height: 1.45;
}

.section-page,
.clubs-page {
  height: 100vh;
  background: var(--app-background);
}

.section-group {
  margin-top: 20rpx;
  background: var(--app-surface);
}

.section-heading {
  padding: 18rpx 32rpx 10rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 650;
}

.section-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 18rpx 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.section-name {
  color: var(--app-text-primary);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.35;
}

.section-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
}

.club-apply-card {
  margin: 24rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.club-apply-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.club-apply-desc {
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.filter-trigger {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background: transparent;
}

.filter-trigger.active {
  background: var(--app-primary-soft);
}

.menu-lines {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 20px;
}

.menu-lines view {
  height: 2px;
  border-radius: 1px;
  background: var(--app-text-primary);
}

.filter-trigger.active .menu-lines view {
  background: var(--app-primary);
}

.toolbar-spacer {
  flex: 1;
}

.icon-button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 22px;
}

.search-icon {
  position: relative;
  width: 18px;
  height: 18px;
  border: 2px solid var(--app-text-primary);
  border-radius: 50%;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -6px;
  bottom: -4px;
  width: 10px;
  height: 2px;
  border-radius: 1px;
  background: var(--app-text-primary);
  transform: rotate(45deg);
}

.bell-icon {
  position: relative;
  width: 18px;
  height: 20px;
  border: 2px solid var(--app-text-primary);
  border-bottom: none;
  border-radius: 10px 10px 4px 4px;
}

.bell-icon::before {
  content: '';
  position: absolute;
  left: -4px;
  right: -4px;
  bottom: -4px;
  height: 2px;
  border-radius: 1px;
  background: var(--app-text-primary);
}

.bell-icon::after {
  content: '';
  position: absolute;
  left: 6px;
  bottom: -9px;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--app-text-primary);
}

.badge {
  position: absolute;
  top: 5px;
  right: 5px;
}

.filter-menu-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: transparent;
}

.filter-menu {
  position: fixed;
  left: 16rpx;
  z-index: 70;
  width: 392rpx;
  max-height: 68vh;
  overflow-y: auto;
  border: 1rpx solid var(--app-divider);
  border-radius: 24rpx;
  background: var(--app-surface);
}

.filter-menu-section {
  min-height: 58rpx;
  padding: 18rpx 28rpx 0;
  background: var(--app-surface);
}

.filter-menu-title {
  color: var(--app-text-secondary);
  font-size: 24rpx;
  font-weight: 600;
}

.filter-menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.filter-menu-item:last-child {
  border-bottom: none;
}

.filter-menu-item.active {
  color: var(--app-primary);
  font-weight: 650;
}

.check-mark {
  color: var(--app-primary);
  font-size: 30rpx;
}

.menu-arrow {
  color: var(--app-text-tertiary);
  font-size: 30rpx;
}

.feed-list,
.news-list {
  height: 100vh;
  background: var(--app-background);
}

.refresh-feedback {
  position: fixed;
  inset: 0;
  z-index: 45;
  display: flex;
  justify-content: center;
  background: var(--app-surface-translucent);
  pointer-events: none;
}

.refresh-feedback-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-top: 18rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 28rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: none;
}

.color-mode-dark .refresh-feedback {
  background: var(--app-scrim);
}

.color-mode-dark .refresh-feedback-pill {
  box-shadow: none;
}

.treehole-layout-threads .feed-list {
  background: var(--app-surface);
}

.treehole-layout-threads .active-filter-bar {
  margin: 0;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  border-radius: 0;
  background: var(--app-surface);
  color: var(--app-text-primary);
}

.treehole-layout-threads .filter-clear-btn {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.thread-post {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 24rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.thread-avatar-wrap {
  position: relative;
  width: 78rpx;
  flex: 0 0 78rpx;
}

.thread-avatar {
  width: 78rpx;
  height: 78rpx;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: center;
}

.thread-follow-dot {
  position: absolute;
  right: -8rpx;
  top: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--app-surface);
  border-radius: 50%;
  background: var(--app-text-primary);
  color: var(--app-surface);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  text-align: center;
  box-sizing: border-box;
}

.thread-body {
  flex: 1;
  min-width: 0;
}

.thread-head {
  display: flex;
  align-items: center;
  min-height: 36rpx;
}

.thread-author {
  max-width: 360rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.thread-time {
  margin-left: 10rpx;
  color: var(--app-text-tertiary);
  font-size: 28rpx;
  line-height: 1.2;
}

.thread-menu-dot {
  position: relative;
  width: 48rpx;
  height: 44rpx;
  margin-left: auto;
}

.thread-menu-dot::before,
.thread-menu-dot::after {
  content: '';
  position: absolute;
  top: 20rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--app-text-tertiary);
}

.thread-menu-dot::before {
  left: 14rpx;
}

.thread-menu-dot::after {
  right: 14rpx;
}

.thread-text {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.38;
  word-break: break-word;
}

.inline-tag {
  color: var(--app-primary);
}

.thread-actions {
  display: flex;
  align-items: center;
  gap: 48rpx;
  min-height: 54rpx;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
}

.thread-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 56rpx;
}

.thread-action.active {
  color: var(--app-like);
}

.thread-action.favorited {
  color: var(--app-favorite);
}

.thread-action .feed-action-icon {
  width: 36rpx;
  height: 36rpx;
}

.thread-images {
  height: 360rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
}

.treehole-layout-threads .floating-publish {
  width: 112rpx;
  height: 112rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 32rpx;
  background: var(--app-translucent-surface);
  color: var(--app-text-tertiary);
  line-height: 106rpx;
  box-shadow: none;
}

.theme-minimal.color-mode-dark.treehole-layout-threads .floating-publish,
.color-mode-dark.treehole-layout-threads .floating-publish {
  background: var(--app-translucent-surface);
  box-shadow: none;
}

.feed-list .feed-card {
  gap: 16rpx;
  margin: 14rpx 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
}

.feed-list .feed-title {
  margin-top: 4rpx;
}

.feed-list .feed-summary {
  margin-top: 4rpx;
  line-height: 1.38;
  -webkit-line-clamp: 3;
}

.feed-list .feed-actions {
  min-height: 40rpx;
  margin-top: 8rpx;
}

.feed-list .feed-action.favorited {
  color: var(--app-favorite);
  font-weight: 650;
}

.post-images {
  width: 100%;
  height: 560rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--app-divider);
}

.post-image {
  width: 100%;
  height: 100%;
  background: var(--app-divider);
}

.floating-publish {
  position: fixed;
  right: 32rpx;
  bottom: calc(126rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  background: var(--app-primary);
  color: var(--app-on-primary);
  font-size: 58rpx;
  font-weight: 300;
  line-height: 90rpx;
  text-align: center;
  transition: transform 0.28s ease, opacity 0.28s ease;
  z-index: 20;
}

.floating-publish.hidden {
  transform: translateY(150rpx);
  opacity: 0;
  pointer-events: none;
}

.secondary-page {
  min-height: 100vh;
  background: var(--app-background);
}

.sub-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 20rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.tool-button {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  white-space: nowrap;
}

.sub-title {
  color: var(--app-text-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.sub-desc {
  margin-top: 6rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.news-card {
  padding: 28rpx 32rpx;
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.news-title {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.news-excerpt {
  display: -webkit-box;
  margin-top: 10rpx;
  color: var(--app-text-primary);
  font-size: 28rpx;
  line-height: 1.5;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.news-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.news-more-link {
  color: var(--app-primary);
}

.college-list {
  background: var(--app-surface);
}

.college-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.college-icon {
  width: 56rpx;
  color: var(--app-primary);
  font-size: 38rpx;
  text-align: center;
}

.college-name {
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 500;
}

/* Empty state styles */
.empty-state-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-image-placeholder {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 32rpx;
  background: var(--app-primary-soft);
  border-radius: 40rpx;
  border: 4rpx solid var(--app-primary);
  position: relative;
}

.empty-image-placeholder::after {
  content: '印';
  font-size: 80rpx;
  color: var(--app-primary);
  font-weight: 800;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-accent);
}

.empty-state-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--app-text-primary);
  margin-bottom: 12rpx;
}

.empty-state-desc {
  font-size: 26rpx;
  color: var(--app-text-secondary);
  margin-bottom: 48rpx;
}

.empty-state-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.active-filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 18rpx 24rpx 6rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 26rpx;
}

.filter-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-text {
  font-weight: 600;
}

.filter-clear-btn {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}
