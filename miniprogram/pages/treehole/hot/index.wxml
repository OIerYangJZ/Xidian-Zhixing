<view class="zx-page hot-page {{themeClass}}">
  <view class="intro">
    <view class="intro-text">
      <view class="zx-title">正在被大家讨论</view>
      <view class="zx-caption intro-sub">按浏览、点赞、评论、收藏和发布时间综合排序</view>
    </view>
    <view class="zx-btn zx-btn--secondary zx-btn--small {{summarizing ? 'zx-btn--disabled' : ''}}" bindtap="summarize">
      <view class="zx-i zx-i-ai zx-i--sm"></view>{{summarizing ? '总结中…' : 'AI 总结'}}
    </view>
  </view>

  <view wx:if="{{summary}}" class="zx-card summary">
    <view class="zx-row summary-head"><view class="zx-i zx-i-ai zx-i--sm"></view>AI 总结 · 仅供参考</view>
    <view class="zx-body summary-text">{{summary}}</view>
  </view>
  <view wx:if="{{summaryError}}" class="zx-inline-message zx-inline-message--danger summary-error">{{summaryError}}</view>

  <view wx:if="{{loading}}" class="zx-empty"><view class="zx-empty__message">加载中…</view></view>
  <view wx:elif="{{errorMessage}}" class="zx-empty">
    <view class="zx-empty__title">加载失败</view>
    <view class="zx-empty__message">{{errorMessage}}</view>
    <view class="zx-btn zx-btn--secondary zx-btn--small empty-action" bindtap="retryLoad">重试</view>
  </view>
  <view wx:elif="{{!topics.length}}" class="zx-empty">
    <view class="zx-i zx-i-fire empty-icon"></view>
    <view class="zx-empty__title">暂无热榜内容</view>
  </view>
  <view wx:else class="sheet">
    <view wx:for="{{topics}}" wx:key="id" class="topic" data-post-id="{{item.postId}}" bindtap="openPost">
      <view class="rank {{item.rank <= 3 ? 'rank--top' : ''}}">{{item.rank}}</view>
      <view class="topic-body">
        <view class="zx-label topic-title">{{item.title}}</view>
        <view wx:if="{{item.summary}}" class="zx-caption topic-summary">{{item.summary}}</view>
        <view class="zx-row topic-meta">
          <view wx:if="{{item.sectionName}}" class="zx-caption">{{item.sectionName}} · </view>
          <view class="zx-i zx-i-fire zx-i--sm topic-fire"></view>
          <view class="zx-caption">{{item.hotScore}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
