/* 热榜: ranked rows (top three in the primary colour) and an AI summary. */
@import "../../../styles/zx-list-page.wxss";

.hot-page { background: var(--zx-bg); padding-bottom: 64rpx; }
.intro { display: flex; align-items: center; gap: 24rpx; padding: 32rpx 32rpx 24rpx; }
.intro-text { flex: 1; min-width: 0; }
.intro-sub { margin-top: 4rpx; }
.intro .zx-btn { gap: 8rpx; }
.summary { margin: 0 32rpx 24rpx; padding: 28rpx 32rpx; }
.summary-head { gap: 8rpx; font-size: 24rpx; font-weight: 600; color: var(--zx-primary); }
.summary-text { margin-top: 12rpx; color: var(--zx-text); white-space: pre-wrap; }
.summary-error { margin: 0 32rpx 24rpx; }
.topic { display: flex; gap: 24rpx; padding: 28rpx 32rpx; border-bottom: 2rpx solid var(--zx-line); }
.rank {
  flex: none; width: 48rpx; padding-top: 2rpx; text-align: center;
  font-size: 34rpx; font-weight: 700; line-height: 42rpx; color: var(--zx-text-3);
  font-variant-numeric: tabular-nums;
}
.rank--top { color: var(--zx-primary); }
.topic-body { flex: 1; min-width: 0; }
.topic-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.topic-summary { margin-top: 8rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.topic-meta { margin-top: 12rpx; gap: 4rpx; }
.topic-fire { color: var(--zx-accent-ink); }
