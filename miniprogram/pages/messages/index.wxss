.messages-page { background: linear-gradient(var(--zx-surface), var(--zx-surface)) bottom / 100% 50% no-repeat, var(--zx-hero); padding-bottom: 48rpx; }
.messages-head { padding-left: 40rpx; padding-right: 0; box-sizing: content-box; }
.messages-title { font-size: 52rpx; line-height: 68rpx; }

.entry-row { display: flex; gap: 20rpx; padding: 24rpx 32rpx 32rpx; }
.entry { flex: 1; padding: 28rpx 0 24rpx; display: flex; flex-direction: column; align-items: center; }
.entry-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.entry-icon--bell { background: var(--zx-primary-soft); color: var(--zx-primary); }
.entry-icon--comment { background: var(--zx-info-soft); color: var(--zx-info); }
.entry-icon--heart { background: var(--zx-danger-soft); color: var(--zx-danger); }
.head-action { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; color: var(--zx-text-2); }
.entry-count { position: absolute; top: -12rpx; right: -18rpx; }
.entry-label { margin-top: 16rpx; font-size: 26rpx; font-weight: 600; color: var(--zx-text); }

.sheet {
  min-height: 60vh;
  background: var(--zx-surface);
  border-radius: 40rpx 40rpx 0 0;
  border-top: 2rpx solid var(--zx-line);
  padding: 24rpx 24rpx 0;
}


.conversation {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 16rpx;
  border-radius: 24rpx;
}
.conversation--pressed { background: var(--zx-bg-sunk); }
.conversation-avatar { width: 96rpx; height: 96rpx; border-radius: 24rpx; }
.conversation-main { flex: 1; min-width: 0; }
.conversation-name { flex: none; max-width: 60%; }
.conversation-flag { margin-left: 12rpx; }
.conversation-second { margin-top: 6rpx; gap: 16rpx; }
.conversation-preview { flex: 1; font-size: 26rpx; color: var(--zx-text-2); }
.conversation-preview--unread { color: var(--zx-text); font-weight: 600; }
.empty-action { margin-top: 24rpx; }
