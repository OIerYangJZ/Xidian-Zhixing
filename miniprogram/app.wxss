page {
  --app-primary: #155e75;
  --app-primary-dark: #4dd0e1;
  --app-accent: #e06c4e;
  --app-background: #ffffff;
  --app-surface: #ffffff;
  --app-card: #ffffff;
  --app-text-primary: #1d1d1f;
  --app-text-secondary: #8e8e93;
  --app-text-tertiary: #c7c7cc;
  --app-divider: #e8e8e8;
  --app-success: #34c759;
  --app-warning: #ff9500;
  --app-error: #ff3b30;
  --app-control: rgba(142, 142, 147, .12);
  --app-primary-soft: rgba(21, 94, 117, .1);
  --app-accent-soft: rgba(224, 108, 78, .12);

  min-height: 100vh;
  background: var(--app-background);
  color: var(--app-text-primary);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page,
.container {
  min-height: 100vh;
  padding: 0;
  background: var(--app-background);
  color: var(--app-text-primary);
}

.theme-light {
  --app-primary: #155e75;
  --app-primary-dark: #4dd0e1;
  --app-accent: #e06c4e;
  --app-background: #ffffff;
  --app-surface: #ffffff;
  --app-card: #ffffff;
  --app-text-primary: #1d1d1f;
  --app-text-secondary: #8e8e93;
  --app-text-tertiary: #c7c7cc;
  --app-divider: #e8e8e8;
  --app-success: #34c759;
  --app-warning: #ff9500;
  --app-error: #ff3b30;
  --app-control: rgba(142, 142, 147, .12);
  --app-primary-soft: rgba(21, 94, 117, .1);
  --app-accent-soft: rgba(224, 108, 78, .12);
}

.theme-dark {
  --app-primary: #4dd0e1;
  --app-primary-dark: #4dd0e1;
  --app-accent: #e06c4e;
  --app-background: #121212;
  --app-surface: #1c1c1e;
  --app-card: #1c1c1e;
  --app-text-primary: #f2f2f7;
  --app-text-secondary: #aeaeb2;
  --app-text-tertiary: #48484a;
  --app-divider: #2c2c2e;
  --app-success: #30d158;
  --app-warning: #ff9f0a;
  --app-error: #ff453a;
  --app-control: rgba(255, 255, 255, .08);
  --app-primary-soft: rgba(77, 208, 225, .16);
  --app-accent-soft: rgba(224, 108, 78, .16);
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.app-section,
.app-card,
.feed-card {
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.app-section {
  padding: 24rpx 28rpx;
}

.app-title {
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.app-subtitle {
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.empty,
.loading-state,
.empty-state,
.no-more {
  padding: 72rpx 32rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.primary-button,
.secondary-button,
.pill-button,
.app-input,
.app-textarea {
  min-height: 44rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  background: var(--app-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.primary-button:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.primary-button[disabled],
.send-btn[disabled] {
  background: var(--app-primary-soft) !important;
  color: var(--app-text-secondary) !important;
}

.secondary-button,
.pill-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.secondary-button:active,
.pill-button:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.app-input,
.app-textarea {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 20rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 29rpx;
  transition: border-color 0.2s ease-in-out;
}

.app-input:focus,
.app-textarea:focus {
  border-color: var(--app-primary);
}

.app-input {
  height: 82rpx;
}

.app-textarea {
  min-height: 220rpx;
  padding-top: 18rpx;
  line-height: 1.55;
}

.app-avatar,
.feed-avatar {
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  text-align: center;
}

.feed-card {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 24rpx;
  background: transparent;
  border-bottom: 1rpx solid var(--app-divider);
}

.feed-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
  object-fit: cover;
}

.feed-body {
  flex: 1;
  min-width: 0;
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.feed-author {
  max-width: 250rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.anonymous-badge {
  flex: 0 0 auto;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: rgba(21, 94, 117, .1);
  color: var(--app-primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
}

.feed-channel {
  color: var(--app-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.feed-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.pin-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 auto;
  color: var(--app-primary);
  transform: rotate(35deg);
}

.pin-icon::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 1rpx;
  width: 8rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.pin-icon::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 2rpx;
  height: 8rpx;
  background: currentColor;
}

.feed-time {
  margin-left: auto;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}

.feed-title {
  margin-top: 6rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-summary {
  display: -webkit-box;
  margin-top: 6rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  word-break: break-word;
}

.feed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.feed-tag {
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.feed-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 48rpx;
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

.feed-actions .active {
  color: #ff2d55;
  font-weight: 650;
}

.feed-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.feed-action.share {
  margin-left: auto;
}

.feed-action-icon {
  display: inline-block;
  vertical-align: middle;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
  background-color: currentColor;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

