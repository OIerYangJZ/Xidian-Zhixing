.post-tools {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 8rpx;
  color: var(--app-text-secondary);
  font-size: 24rpx;
}

.app-badge,
.badge,
.header-badge {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: var(--app-error);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.badge-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--app-error);
}

.app-chip,
.channel-chip,
.sort-chip,
.tag-chip {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: var(--app-control);
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 56rpx;
  white-space: nowrap;
  transition: all 0.2s ease-in-out;
}

.app-chip:active,
.channel-chip:active,
.sort-chip:active,
.tag-chip:active {
  transform: scale(0.95);
}

.app-chip.active,
.channel-chip.active,
.sort-chip.active,
.tag-chip.active {
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-weight: 600;
}

.menu-list,
.app-list {
  background: var(--app-surface);
}

.menu-item,
.app-list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.menu-item:last-child,
.app-list-row:last-child {
  border-bottom: none;
}

.menu-text,
.menu-title {
  color: var(--app-text-primary);
  font-size: 30rpx;
}

.menu-arrow {
  color: var(--app-text-tertiary);
  font-size: 30rpx;
}

.bottom-input-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 120rpx;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--app-surface);
  border-top: 1rpx solid var(--app-divider);
}

.mobile-list-page {
  min-height: 100vh;
  padding: 16rpx 32rpx 64rpx;
  background: var(--app-background);
}

.mobile-tile-card {
  margin-bottom: 32rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 232, 232, .5);
  border-radius: 24rpx;
  background: var(--app-card);
}


.mobile-section-title {
  padding: 0 8rpx 16rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
}

.mobile-tile {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 8rpx 32rpx;
  background: var(--app-card);
}

.mobile-tile + .mobile-tile {
  border-top: 1rpx solid var(--app-divider);
}

.mobile-tile-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  margin-right: 28rpx;
  color: var(--app-text-secondary);
  font-size: 36rpx;
  line-height: 1;
}

.mobile-tile-body {
  flex: 1;
  min-width: 0;
}

.mobile-tile-title {
  color: var(--app-text-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.mobile-tile-subtitle {
  margin-top: 4rpx;
  color: var(--app-text-tertiary);
  font-size: 24rpx;
  line-height: 1.35;
}

.mobile-tile-arrow {
  margin-left: 16rpx;
  color: var(--app-text-tertiary);
  font-size: 36rpx;
  line-height: 1;
}

.mobile-user-card {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(232, 232, 232, .5);
  border-radius: 32rpx;
  background: var(--app-card);
}


.mobile-user-avatar {
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 120rpx;
  text-align: center;
}

.mobile-user-info {
  flex: 1;
  min-width: 0;
  margin-left: 32rpx;
}

.mobile-user-name {
  color: var(--app-text-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mobile-user-meta {
  margin-top: 4rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Micro-interactions & animations */
@keyframes popLike {
  0% { transform: scale(1); }
  50% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

@keyframes popStar {
  0% { transform: scale(1); }
  50% { transform: scale(1.35); }
  100% { transform: scale(1); }
}

.feed-actions .active .like-icon {
  animation: popLike 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.feed-actions .active .bookmark-icon {
  animation: popStar 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.feed-action {
  transition: opacity 0.15s ease;
}

.feed-action:active {
  opacity: 0.6;
}

/* ─────────────────────────────────────────────────────────────────────────────
 * 字体样式规范应用
 * ───────────────────────────────────────────────────────────────────────────── */

/* 1. 品牌大标题 (思源宋体 SC SemiBold) */
.appbar-name,
.nav-name,
.ai-title,
.product-name,
.auth-body .title,
.detail-title,
.brand-card .brand-title {
  font-family: var(--font-serif) !important;
  font-weight: 600 !important;
  color: var(--brand-deep) !important;
}

/* 2. 情绪化辅助字体 (霞鹜文楷) */
.appbar-subtitle,
.reply-banner-text,
.empty-state-desc,
.comment-placeholder,
.textarea-placeholder {
  font-family: var(--font-quote) !important;
}

/* 3. 公告正文规范 (思源宋体 SC Regular) */
.detail-content {
  font-family: var(--font-serif) !important;
  line-height: 1.75 !important;
}

