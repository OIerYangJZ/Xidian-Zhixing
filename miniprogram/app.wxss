@import "styles/zx-tokens.wxss";
@import "styles/zx.wxss";
@import "styles/zx-icons.wxss";

page {
  --brand-primary: #A43B32;
  --brand-deep: #7E2924;
  --brand-bright: #D9775F;
  --brand-seal: #A43B32;
  --background-paper: #F7F6F2;
  --background-softRed: #F1E5DF;
  --text-primary: #181816;
  --text-secondary: #66635D;
  --border-default: #D8D5CC;
  --state-success: #4F725E;
  --state-warning: #9A672A;
  --state-danger: #97382F;

  --app-primary: var(--brand-primary);
  --app-primary-dark: var(--brand-deep);
  --app-accent: var(--brand-bright);
  --app-coral: #D9775F;
  --app-apricot: #E8B65D;
  --app-dark-panel: #1E1E1B;
  --app-on-dark-panel: #F7F6F2;
  --app-on-primary: #F7F6F2;
  --app-like: var(--brand-primary);
  --app-favorite: #A86E1C;
  --app-scrim: rgba(24, 24, 22, .42);
  --app-translucent-surface: rgba(255, 254, 250, .92);
  --app-background: var(--background-paper);
  --app-surface: #FFFEFA;
  --app-surface-translucent: rgba(255, 255, 255, 0.72);
  --app-card: #FFFEFA;
  --app-text-primary: var(--text-primary);
  --app-text-secondary: var(--text-secondary);
  --app-text-tertiary: #A2948E;
  --app-divider: var(--border-default);
  --app-success: var(--state-success);
  --app-warning: var(--state-warning);
  --app-error: var(--state-danger);
  --app-control: rgba(178, 58, 46, .06);
  --app-primary-soft: var(--background-softRed);
  --app-accent-soft: var(--background-softRed);

  --font-zh-display: "STZhongsong", "华文中宋", "STSong", "华文宋体", "SimSun", "宋体";
  --font-zh-body: "STSong", "华文宋体", "SimSun", "宋体";
  --font-zh-accent: "STKaiti", "华文楷体", "KaiTi", "楷体";
  --font-en-display: "Anthropic Serif Web", "Anthropic Serif Web Text", "Times New Roman";
  --font-en-body: "Times New Roman", "Anthropic Serif Web";
  --font-en-accent: "Apple Chancery", "Times New Roman";
  --font-display: var(--font-zh-display);
  --font-body: var(--font-zh-body);
  --font-accent: var(--font-zh-accent);
  --font-serif: var(--font-display);
  --font-sans: var(--font-body);
  --font-quote: var(--font-accent);

  min-height: 100vh;
  background: var(--app-background);
  color: var(--app-text-primary);
  font-family: var(--font-sans);
}

.lang-en {
  --font-display: var(--font-en-display);
  --font-body: var(--font-en-body);
  --font-accent: var(--font-en-accent);
  --font-serif: var(--font-display);
  --font-sans: var(--font-body);
  --font-quote: var(--font-accent);
  font-family: var(--font-body);
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page,
.container {
  min-height: 100vh;
  padding: 0;
  background: var(--app-background);
  color: var(--app-text-primary);
}


.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.app-section,
.app-card,
.feed-card {
  background: var(--app-surface);
  border-bottom: 1rpx solid var(--app-divider);
}

.app-section {
  padding: 24rpx 28rpx;
}

.app-title {
  color: var(--app-text-primary);
  font-size: 34rpx;
  font-weight: 700;
  font-family: var(--font-display);
  line-height: 1.35;
}

.app-subtitle {
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.empty,
.loading-state,
.empty-state,
.no-more {
  padding: 72rpx 32rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.primary-button,
.secondary-button,
.pill-button,
.app-input,
.app-textarea {
  min-height: 44rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 4rpx;
  background: var(--app-dark-panel);
  color: var(--app-on-dark-panel);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.primary-button:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.primary-button[disabled],
.send-btn[disabled] {
  background: var(--app-primary-soft) !important;
  color: var(--app-text-secondary) !important;
}

.secondary-button,
.pill-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 4rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.secondary-button:active,
.pill-button:active {
  transform: scale(0.96);
  opacity: 0.85;
}

.app-input,
.app-textarea {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 4rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 29rpx;
  transition: border-color 0.2s ease-in-out;
}

.app-input:focus,
.app-textarea:focus {
  border-color: var(--app-primary);
}

.app-input {
  height: 82rpx;
}

.app-textarea {
  min-height: 220rpx;
  padding-top: 18rpx;
  line-height: 1.55;
}

.app-avatar,
.feed-avatar {
  flex: 0 0 auto;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  text-align: center;
}

.nav-avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 22px;
  background: transparent;
}

.nav-avatar {
  display: block;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.nav-avatar-text {
  display: block;
}

/* 篆刻印章头像 */
.seal-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 24rpx; /* 12px roundness */
  border: 4rpx solid var(--app-primary);
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
}

.feed-card {
  display: flex;
  gap: 20rpx;
  padding: 32rpx;
  margin: 24rpx 32rpx;
  background: var(--app-card);
  border: 1rpx solid var(--app-divider);
  border-radius: 36rpx; /* card.radius = 18px = 36rpx */
  box-shadow: 0 2rpx 8rpx rgba(178, 58, 46, 0.04);
}

.feed-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
  object-fit: cover;
}

.feed-body {
  flex: 1;
  min-width: 0;
}

.feed-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.feed-author {
  max-width: 250rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.anonymous-badge {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--brand-seal);
  border-radius: 8rpx;
  background: #ffffff;
  color: var(--brand-seal);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}

/* 实章标签: 红底白字 */
.seal-badge-solid {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--brand-seal);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}

/* 空章标签: 白底红字红边 */
.seal-badge-hollow {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--brand-seal);
  border-radius: 8rpx;
  background: #ffffff;
  color: var(--brand-seal);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}

/* 淡章标签: 浅红底深红字 */
.seal-badge-light {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--background-softRed);
  color: var(--brand-deep);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.feed-channel {
  color: var(--app-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.feed-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
}

.pin-icon {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 auto;
  color: var(--app-primary);
  transform: rotate(35deg);
}

.pin-icon::before {
  content: '';
  position: absolute;
  left: 5rpx;
  top: 1rpx;
  width: 8rpx;
  height: 10rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.pin-icon::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 10rpx;
  width: 2rpx;
  height: 8rpx;
  background: currentColor;
}

.feed-time {
  margin-left: auto;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
}

.feed-title {
  margin-top: 6rpx;
  color: var(--app-text-primary);
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-summary {
  display: -webkit-box;
  margin-top: 6rpx;
  color: var(--app-text-primary);
  font-size: 27rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  word-break: break-word;
}

.feed-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.feed-tag {
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.feed-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 48rpx;
  margin-top: 10rpx;
  color: var(--app-text-secondary);
  font-size: 23rpx;
}

.feed-actions .active {
  color: #ff2d55;
  font-weight: 650;
}

.feed-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.feed-action.share {
  margin-left: auto;
}

.feed-action-icon {
  display: inline-block;
  vertical-align: middle;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
  background-color: currentColor;
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

