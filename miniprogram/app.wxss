@import "./styles/tokens.wxss";
@import "./styles/icons.wxss";

page { min-height: 100vh; background: var(--app-background); color: var(--app-text-primary); font-family: var(--font-body); }
view, text, input, textarea, button, picker { font-family: inherit; }
view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: none;
}

.page,
.container {
  min-height: 100vh;
  padding: 0;
  background: var(--app-background);
  color: var(--app-text-primary);
}


.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.empty,
.loading-state,
.empty-state,
.no-more {
  padding: 72rpx 32rpx;
  color: var(--app-text-secondary);
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
}

.primary-button,
.secondary-button,
.pill-button,
.app-input,
.app-textarea {
  min-height: 44rpx;
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 4rpx;
  background: var(--app-dark-panel);
  color: var(--app-on-dark-panel);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  transition: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.primary-button:active {

  opacity: 0.9;
}

.primary-button[disabled],
.send-btn[disabled] {
  background: var(--app-primary-soft) !important;
  color: var(--app-text-secondary) !important;
}

.secondary-button,
.pill-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 4rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 25rpx;
  font-weight: 600;
  line-height: 56rpx;
  transition: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    color 0.2s cubic-bezier(0.4, 0, 0.2, 1),
    opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.secondary-button:active,
.pill-button:active {

  opacity: 0.85;
}

.app-input,
.app-textarea {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid var(--app-divider);
  border-radius: 4rpx;
  background: var(--app-surface);
  color: var(--app-text-primary);
  font-size: 29rpx;
  transition: border-color 0.2s ease-in-out;
}

.app-input:focus,
.app-textarea:focus {
  border-color: var(--app-primary);
}

.app-input {
  height: 82rpx;
}

.app-textarea {
  min-height: 220rpx;
  padding-top: 18rpx;
  line-height: 1.55;
}

.app-avatar {
  flex: 0 0 auto;
  border-radius: 20rpx;
  background: var(--app-control);
  color: var(--app-primary);
  text-align: center;
}

.nav-avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  flex: 0 0 auto;
  border-radius: 22px;
  background: transparent;
}

.nav-avatar {
  display: block;
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.nav-avatar-text {
  display: block;
}


.seal-avatar {
  width: 80rpx;
  height: 80rpx;
  flex: 0 0 auto;
  border-radius: 24rpx;
  border: 4rpx solid var(--app-primary);
  background: var(--app-primary-soft);
  color: var(--app-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
  box-sizing: border-box;
}


.seal-badge-solid {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--brand-seal);
  color: var(--app-on-primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}


.seal-badge-hollow {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border: 2rpx solid var(--brand-seal);
  border-radius: 8rpx;
  background: var(--app-surface);
  color: var(--brand-seal);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 30rpx;
}


.seal-badge-light {
  flex: 0 0 auto;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 8rpx;
  background: var(--background-softRed);
  color: var(--brand-deep);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}

