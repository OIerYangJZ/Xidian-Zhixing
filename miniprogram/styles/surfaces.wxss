/* Shared mobile surfaces, matching secondary-pages.css and mobile-reference.css. */
.theme-reference { font-family:var(--font-body); color:var(--app-text-primary); }
.page, .container { background:var(--app-background); }
.social-tab-page { padding:0 0 var(--tab-height); min-height:100vh; }
.social-icon-button { width:44px; height:44px; display:flex; align-items:center; justify-content:center; color:var(--app-text-primary); }
.social-search { display:flex; align-items:center; gap:12rpx; min-width:0; width:100%; height:38px; padding:0 20rpx; margin:0 12rpx; border-radius:30px; background:var(--app-control); color:var(--app-text-secondary); }
.social-search .ui-icon { width:18px; height:18px; }
.social-search input { min-width:0; flex:1; height:38px; font-size:32rpx; color:var(--app-text-primary); }
.mobile-list-page { padding:8rpx 36rpx calc(32rpx + env(safe-area-inset-bottom)); }
.mobile-tile-card { margin:0; border:0; border-radius:0; background:var(--app-surface); overflow:visible; }
.mobile-tile, .switch-row { min-height:120rpx; padding:24rpx 0; gap:24rpx; border-bottom:1px solid var(--app-divider); }
.mobile-tile-icon { width:24px; height:24px; margin:0; color:var(--app-text-primary); }
.mobile-tile-body { min-width:0; flex:1; }
.mobile-tile-title { color:var(--app-text-primary); font-size:34rpx; line-height:1.4; font-weight:400; }
.mobile-tile-subtitle { color:var(--app-text-secondary); font-size:28rpx; line-height:1.5; margin-top:8rpx; white-space:normal; }
.mobile-section-title { padding:32rpx 0 12rpx; margin:0; font-size:28rpx; color:var(--app-text-secondary); }
.mobile-user-card { padding:28rpx 0; margin:0; background:transparent; border:0; border-bottom:1px solid var(--app-divider); border-radius:0; }
.mobile-user-avatar, .app-avatar, .seal-avatar, .nav-avatar { border-radius:50%; }
.mobile-user-name { font-size:38rpx; }
.mobile-user-meta { color:var(--app-text-secondary); font-size:28rpx; }
.primary-button, .secondary-button, .pill-button { min-height:44px; border-radius:26px; font-size:32rpx; }
.secondary-button, .pill-button { border:1px solid var(--app-divider); background:var(--app-background); color:var(--app-text-primary); }
.app-input, .app-textarea { border:1px solid var(--app-divider); border-radius:24rpx; font-size:32rpx; min-height:44px; }
.app-textarea { line-height:1.6; }
button { font-family:var(--font-body); }
button:active, .social-icon-button:active, .mobile-tile:active { opacity:.65; }
.empty, .loading-state, .empty-state, .no-more { font-size:30rpx; line-height:1.6; }
.seal-badge-solid { background:var(--app-control); color:var(--app-text-primary); border:1px solid var(--app-divider); }
.seal-badge-hollow { background:transparent; color:var(--app-text-secondary); border:1px solid var(--app-divider); }
.empty-state-title { font-size:36rpx; color:var(--app-text-primary); }
.empty-state-desc { color:var(--app-text-secondary); font-size:30rpx; line-height:1.6; }
@media (prefers-reduced-motion:reduce) { .primary-button, .secondary-button, .pill-button { transition:none; } }

.social-empty-illustration { width:40px; height:40px; color:var(--app-text-secondary); margin-bottom:24rpx; }
.social-icon-button:active, .post-action:active { opacity:.65; }
