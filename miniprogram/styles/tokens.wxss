/* Approved thread-social-design palette and bilingual type stack. */
page, .theme-reference {
  --app-background: #ffffff;
  --app-surface: #ffffff;
  --app-card: #ffffff;
  --app-text-primary: #101010;
  --app-text-secondary: #626262;
  --app-text-tertiary: #707070;
  --app-divider: #e8e8e8;
  --app-control: #f5f5f5;
  --app-primary: #101010;
  --app-on-primary: #ffffff;
  --app-primary-dark: var(--app-primary);
  --app-primary-soft: var(--app-control);
  --app-accent: var(--app-primary);
  --app-accent-soft: var(--app-control);
  --app-dark-panel: var(--app-primary);
  --app-on-dark-panel: var(--app-on-primary);
  --app-like: #d62450;
  --app-favorite: var(--app-primary);
  --app-error: #b42318;
  --app-success: #287348;
  --app-warning: #805700;
  --app-scrim: rgba(0, 0, 0, .38);
  --app-translucent-surface: var(--app-surface);
  --app-surface-translucent: var(--app-surface);
  --app-coral: var(--app-primary);
  --app-apricot: var(--app-control);
  --brand-primary: var(--app-primary);
  --brand-deep: var(--app-primary);
  --brand-bright: var(--app-primary);
  --brand-seal: var(--app-primary);
  --background-paper: var(--app-background);
  --background-softRed: var(--app-control);
  --text-primary: var(--app-text-primary);
  --text-secondary: var(--app-text-secondary);
  --border-default: var(--app-divider);
  --state-success: var(--app-success);
  --state-warning: var(--app-warning);
  --state-danger: var(--app-error);
  --font-body: "Times New Roman", "STZhongsong", "华文中宋", serif;
  --font-display: var(--font-body);
  --font-accent: var(--font-body);
  --font-serif: var(--font-body);
  --font-sans: var(--font-body);
  --font-quote: var(--font-body);
  --font-en-body: var(--font-body);
  --font-en-display: var(--font-body);
  --font-en-accent: var(--font-body);
  --font-zh-body: var(--font-body);
  --font-zh-display: var(--font-body);
  --font-zh-accent: var(--font-body);
  --tab-height: calc(64px + env(safe-area-inset-bottom));
}
.color-mode-dark {
  --app-background: #101010;
  --app-surface: #101010;
  --app-card: #101010;
  --app-text-primary: #f2f2f2;
  --app-text-secondary: #ababab;
  --app-text-tertiary: #a0a0a0;
  --app-divider: #282828;
  --app-control: #1b1b1b;
  --app-primary: #f2f2f2;
  --app-on-primary: #101010;
  --app-error: #ff8a80;
  --app-success: #83caa0;
  --app-warning: #e3bf71;
  --app-like: #ff7598;
  --app-scrim: rgba(0, 0, 0, .58);
}
