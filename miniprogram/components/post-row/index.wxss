@import "../../styles/icons.wxss";
.post-row {
  display: flex;
  gap: 20rpx;
  padding: 26rpx 24rpx 24rpx;
  border-bottom: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.post-avatar-wrap {
  position: relative;
  width: 78rpx;
  flex: 0 0 78rpx;
}

.post-avatar {
  display: block;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: center;
}

.post-follow-dot {
  position: absolute;
  right: -8rpx;
  bottom: -2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid var(--app-surface);
  border-radius: 50%;
  background: var(--app-text-primary);
  color: var(--app-surface);
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  box-sizing: border-box;
}

.post-body {
  flex: 1;
  min-width: 0;
}

.post-head {
  display: flex;
  align-items: center;
  min-height: 36rpx;
}

.post-author {
  max-width: 360rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-time {
  margin-left: 10rpx;
  color: var(--app-text-tertiary);
  font-size: 24rpx;
  line-height: 1.2;
}

.post-text {
  margin-top: 8rpx;
  color: var(--app-text-primary);
  font-size: 30rpx;
  line-height: 1.38;
  word-break: break-word;
}

.post-tag {
  color: var(--app-primary);
}

.post-media {
  width: 100%;
  height: 360rpx;
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--app-divider);
}

.post-image {
  width: 100%;
  height: 100%;
}

.post-actions {
  display: flex;
  align-items: center;
  gap: 48rpx;
  min-height: 54rpx;
  margin-top: 18rpx;
  color: var(--app-text-secondary);
  font-size: 26rpx;
}

.post-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 56rpx;
  min-height: 44rpx;
}

.post-action.active { color: var(--app-like); }
.post-action.favorited { color: var(--app-favorite); }


.post-row { font-family:var(--font-body); gap:14rpx; padding:22rpx 16rpx 16rpx; }
.post-avatar-wrap { width:86rpx; flex-basis:86rpx; }
.post-avatar { width:86rpx; height:86rpx; line-height:86rpx; }
.post-author { font-size:34rpx; }
.post-time { font-size:26rpx; }
.post-text { font-size:34rpx; line-height:1.35; margin-top:6rpx; }
.post-actions { justify-content:space-between; gap:12rpx; margin-top:8rpx; font-size:26rpx; }
.post-action { min-width:44px; min-height:44px; }
.post-action .ui-icon { width:19px; height:19px; }
.post-media { border-radius:24rpx; border:1px solid var(--app-divider); }
.post-action.active, .post-action.favorited { font-weight:700; }
