.drawer-root {
  position: fixed;
  inset: 0;
  z-index: 900;
}

.drawer-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, .42);
}

.drawer-panel {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 612rpx;
  max-width: 82vw;
  display: flex;
  flex-direction: column;
  background: var(--app-surface);
  border-right: 1rpx solid var(--app-divider);
}

.drawer-safe {
  height: calc(52rpx + env(safe-area-inset-top));
  flex: 0 0 auto;
}

.drawer-profile {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  min-height: 132rpx;
  padding: 16rpx 28rpx 24rpx;
}

.drawer-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: var(--app-primary-soft);
}

.text-avatar {
  color: var(--app-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 86rpx;
  text-align: center;
}

.drawer-user {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.drawer-name {
  color: var(--app-text-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-meta,
.drawer-row-subtitle,
.mini-message {
  color: var(--app-text-secondary);
  font-size: 24rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawer-main {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  border-top: 1rpx solid var(--app-divider);
  padding-bottom: 16rpx;
}

.drawer-bottom {
  flex: 0 0 auto;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--app-divider);
  background: var(--app-surface);
}

.message-section-head {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid var(--app-divider);
}

.drawer-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 28rpx;
}

.drawer-row + .drawer-row {
  border-top: 1rpx solid var(--app-divider);
}

.drawer-symbol {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin-right: 22rpx;
  color: var(--app-primary);
}

.message-symbol {
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
}

.message-symbol::after {
  content: '';
  position: absolute;
  left: 9rpx;
  bottom: -7rpx;
  width: 14rpx;
  height: 14rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  background: var(--app-surface);
  transform: rotate(-45deg);
}

.mail-symbol {
  border: 3rpx solid currentColor;
  border-radius: 8rpx;
}

.mail-symbol::before,
.mail-symbol::after {
  content: '';
  position: absolute;
  top: 12rpx;
  width: 25rpx;
  height: 3rpx;
  background: currentColor;
}

.mail-symbol::before {
  left: 0;
  transform: rotate(32deg);
}

.mail-symbol::after {
  right: 0;
  transform: rotate(-32deg);
}

.settings-symbol {
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.settings-symbol::after {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}

.drawer-row-body {
  flex: 1;
  min-width: 0;
}

.drawer-row-title {
  color: var(--app-text-primary);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.3;
}

.drawer-chevron {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid var(--app-text-tertiary);
  border-right: 3rpx solid var(--app-text-tertiary);
  transform: rotate(45deg);
}

.drawer-conversations {
  padding: 8rpx 0 0;
}

.drawer-conversation {
  display: flex;
  align-items: flex-start;
  min-height: 92rpx;
  padding: 14rpx 28rpx;
}

.mini-avatar {
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--app-control);
  color: var(--app-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 56rpx;
  text-align: center;
}

.mini-body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.mini-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.mini-name {
  flex: 1;
  min-width: 0;
  color: var(--app-text-primary);
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-time {
  flex: 0 0 auto;
  color: var(--app-text-tertiary);
  font-size: 22rpx;
  line-height: 1.35;
}

.mini-badge {
  min-width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--app-error);
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.drawer-empty-message {
  padding: 32rpx 28rpx;
  color: var(--app-text-secondary);
  font-size: 25rpx;
  line-height: 1.4;
}
